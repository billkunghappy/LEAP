      (by
        intro i hi
        have h1 := hA2 (k + 1 + 2 * d + 2 * i)
          (hQs _ (by omega) (Or.inr ⟨by omega, by omega, by omega⟩)) (by intro i' hi'; omega)
        exact adjc _ _ _ _ _ h1 (by omega) (by omega))
    have hv : a₀ + cs + 1 + 2 * t + 2 * T = y + (y - k) := by omega
    have hL : prescribedLengths y k a₀ 0 cs + Multiset.replicate (2 * t) y +
        Multiset.replicate (2 * T) (y - k) = prescribedLengths y k a₀ (2 * T) (cs + 2 * t) := by
      unfold prescribedLengths
      rw [Multiset.replicate_add]
      simp only [Multiset.replicate_zero, add_zero]
      abel
    rw [hv, hL] at hp₂
    refine ⟨p₂, hp₂, endc _ _ _ (hB3 _ (hA3 _ hQe)) (by omega), ?_, ?_⟩
    · intro z hz1 hz2
      by_cases hzt : z < 2 * t
      · have h1 := hA1 (z / 2) (by omega)
        have h2 := hB2 _ h1 (by intro i' hi'; omega)
        exact adjc _ _ _ _ _ h2 (by omega) (by omega)
      · have hε1 : ε = 1 := by omega
        have h1 := hA2 0 (hQ0 hε1) (by intro i' hi'; omega)
        have h2 := hB2 _ h1 (by intro i' hi'; omega)
        exact adjc _ _ _ _ _ h2 (by omega) (by omega)
    · intro z hz1 hz2 hz3
      by_cases hzv : z + 2 ≤ a₀ + cs + 1 + 2 * t
      · have h1 := hA2 (z - 2 * t) (hQs _ (by omega) (Or.inl ⟨by omega, by omega⟩))
          (by intro i' hi'; omega)
        have h2 := hB2 _ h1 (by intro i' hi'; omega)
        exact adjc _ _ _ _ _ h2 (by omega) (by omega)
      · have h1 := hB1 ((z - (a₀ + cs + 1 + 2 * t)) / 2) (by omega)
        exact adjc _ _ _ _ _ h1 (by omega) (by omega)
  
  
  
  have hclose : ∀ (a₀ B c s u : ℕ) (p : List ℕ), 2 * (s + u) + 1 = y - k →
      IsLinearRealization (y + (y - k)) (prescribedLengths y k a₀ B c) p → IsEnd p (2 * s) →
      (∀ z : ℕ, z % 2 = 0 → z < 2 * s → Adj p z (z + 1)) →
      (∀ z : ℕ, z % 2 = 1 → 2 * s < z → z + 2 ≤ y + (y - k) → Adj p z (z + 1)) →
      ∃ p' : List ℕ, IsLinearRealization (y + (y - k) + 2 * u + 1)
          (prescribedLengths y k a₀ (B + 2 * u + 1) c) p' ∧
        BotEndInv (y - k) p' ∧ TopPairInv y (y + (y - k) + 2 * u + 1) p' := by
    intro a₀ B c s u p hsu hp hpe hev hod
    obtain ⟨p₃, hp₃, hC1, hC2, hC3⟩ := bot_pairs (y - k) (y + (y - k)) u _ p (by omega)
      (by omega) (by omega) hp
      (by
        intro i hi
        exact adjc _ _ _ _ _ (hod (y - k - 2 - 2 * i) (by omega) (by omega) (by omega))
          rfl (by omega))
    obtain ⟨p₄, hp₄, hD1, hD2, -⟩ := bot_attach (y - k) (y + (y - k) + 2 * u) _ p₃ (by omega)
      (by omega) hp₃ (endc _ _ _ (hC3 _ hpe) (by omega))
    have hL : prescribedLengths y k a₀ B c + Multiset.replicate (2 * u) (y - k) +
        Multiset.replicate 1 (y - k) = prescribedLengths y k a₀ (B + 2 * u + 1) c := by
      unfold prescribedLengths
      rw [Multiset.replicate_add, Multiset.replicate_add]
      abel
    rw [hL] at hp₄
    refine ⟨p₄, hp₄, ⟨hD1, ?_, fun he => absurd he hnotEven⟩, hyEven, ?_⟩
    · intro j hj1 hj2
      by_cases hju : j - 1 < u
      · have h1 := hD2 _ (hC1 (j - 1) hju)
        exact adjc _ _ _ _ _ h1 (by omega) (by omega)
      · have h1 := hC2 (2 * j - 2 - 2 * u) (hev _ (by omega) (by omega))
          (by intro i' hi'; omega)
        have h2 := hD2 _ h1
        exact adjc _ _ _ _ _ h2 (by omega) (by omega)
    · intro j hj
      have h1 := hC2 (y + (y - k) - 2 - 2 * j) (hod _ (by omega) (by omega) (by omega))
        (by intro i' hi'; omega)
      have h2 := hD2 _ h1
      exact adj_symm _ _ _ (adjc _ _ _ _ _ h2 (by omega) (by omega))
  
  
  
  have hlift1 : ∀ (a₀ b c : ℕ) (p : List ℕ), (y - k) + y ≤ a₀ + b + c + 2 →
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p →
      BotEndInv (y - k) p → TopPairInv y (a₀ + b + c + 1) p →
      ∃ p' : List ℕ, IsLinearRealization (a₀ + b + (c + 2) + 1)
          (prescribedLengths y k a₀ b (c + 2)) p' ∧
        BotEndInv (y - k) p' ∧ TopPairInv y (a₀ + b + (c + 2) + 1) p' := by
    intro a₀ b c p hv hp hBE hTP
    obtain ⟨hB0, hBp, hBe⟩ := hBE
    obtain ⟨-, hTp⟩ := hTP
    obtain ⟨p', hp', hE1, hE2, hE3⟩ := top_pairs y (a₀ + b + c + 1) 1 _ p (by omega)
      (by omega) (by omega) hp
      (by
        intro i hi
        have h1 := hTp (y / 2 - 1) (by omega)
        exact adj_symm _ _ _ (adjc _ _ _ _ _ h1 (by omega) (by omega)))
    have hv' : a₀ + b + c + 1 + 2 * 1 = a₀ + b + (c + 2) + 1 := by omega
    have hL : prescribedLengths y k a₀ b c + Multiset.replicate (2 * 1) y =
        prescribedLengths y k a₀ b (c + 2) := by
      unfold prescribedLengths
      rw [Multiset.replicate_add]
      abel
    rw [hv', hL] at hp'
    refine ⟨p', hp', ⟨hE3 _ hB0, ?_, fun he => hE3 _ (hBe he)⟩, hyEven, ?_⟩
    · intro j hj1 hj2
      have h1 := hE2 (2 * j - 1) (adjc _ _ _ _ _ (hBp j hj1 hj2) rfl (by omega))
        (by intro i hi; omega)
      exact adjc _ _ _ _ _ h1 rfl (by omega)
    · intro j hj
      by_cases hj0 : j = 0
      · subst hj0
        have h1 := hE1 0 (by omega)
        exact adj_symm _ _ _ (adjc _ _ _ _ _ h1 (by omega) (by omega))
      · have h1 := hTp (j - 1) (by omega)
        have h2 := hE2 (a₀ + b + c + 1 - 2 * j)
          (adj_symm _ _ _ (adjc _ _ _ _ _ h1 (by omega) (by omega))) (by intro i hi; omega)
        exact adj_symm _ _ _ (adjc _ _ _ _ _ h2 (by omega) (by omega))
  have hlift : ∀ (j a₀ b c : ℕ) (p : List ℕ), (y - k) + y ≤ a₀ + b + c + 2 →
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p →
      BotEndInv (y - k) p → TopPairInv y (a₀ + b + c + 1) p →
      ∃ p' : List ℕ, IsLinearRealization (a₀ + b + (c + 2 * j) + 1)
          (prescribedLengths y k a₀ b (c + 2 * j)) p' ∧
        BotEndInv (y - k) p' ∧ TopPairInv y (a₀ + b + (c + 2 * j) + 1) p' := by
    intro j
    induction j with
    | zero =>
      intro a₀ b c p _ hp hB hT
      simp only [Nat.mul_zero, Nat.add_zero]
      exact ⟨p, hp, hB, hT⟩
    | succ j ih =>
      intro a₀ b c p hv hp hB hT
      obtain ⟨p₁, hp₁, hB₁, hT₁⟩ := hlift1 a₀ b c p hv hp hB hT
      obtain ⟨p₂, hp₂, hB₂, hT₂⟩ := ih a₀ b (c + 2) p₁ (by omega) hp₁ hB₁ hT₁
      have e : c + 2 + 2 * j = c + 2 * (j + 1) := by ring
      rw [e] at hp₂ hT₂
      exact ⟨p₂, hp₂, hB₂, hT₂⟩
  
  
  
  have hbase : ∀ (bb e : ℕ), bb % 2 = 1 → bb < 2 * (y - k) → e ≤ 1 →
      ∃ a₀ c₀ : ℕ, a₀ ≤ y ∧ c₀ ≤ y ∧ c₀ % 2 = e ∧ y + (y - k) ≤ a₀ + bb + c₀ ∧
        ∃ p : List ℕ, IsLinearRealization (a₀ + bb + c₀ + 1) (prescribedLengths y k a₀ bb c₀) p ∧
          BotEndInv (y - k) p ∧ TopPairInv y (a₀ + bb + c₀ + 1) p := by
    intro bb e hbb1 hbb2 he
    obtain ⟨h, hh⟩ : ∃ h, 2 * h + 1 = y - k := ⟨(y - k) / 2, by omega⟩
    have fin : ∀ (a₀ cs d ε t T u : ℕ) (Q : List ℕ), ε ≤ 1 → a₀ + cs = y + 2 * d →
        d + t + T = h → t + ε + u = h → 2 * T + 2 * u + 1 = bb → a₀ ≤ y → cs + 2 * t ≤ y →
        (cs + 2 * t) % 2 = e →
        IsLinearRealization (a₀ + cs + 1) (prescribedLengths y k a₀ 0 cs) Q →
        IsEnd Q (2 * ε) → (ε = 1 → Adj Q 0 1) →
        (∀ x : ℕ, x + 2 ≤ a₀ + cs + 1 →
          ((x % 2 = 1 ∧ 2 * ε < x) ∨ (x % 2 = 0 ∧ 2 ≤ x ∧ x + 2 ≤ y)) → Adj Q x (x + 1)) →
        ∃ a₀ c₀ : ℕ, a₀ ≤ y ∧ c₀ ≤ y ∧ c₀ % 2 = e ∧ y + (y - k) ≤ a₀ + bb + c₀ ∧
          ∃ p : List ℕ, IsLinearRealization (a₀ + bb + c₀ + 1)
              (prescribedLengths y k a₀ bb c₀) p ∧
            BotEndInv (y - k) p ∧ TopPairInv y (a₀ + bb + c₀ + 1) p := by
      intro a₀ cs d ε t T u Q hε hn hdtT htu hbb ha₀ hc₀ hce hQ hQe hQ0 hQs
      obtain ⟨p, hp, hpe, hpev, hpod⟩ := hopen a₀ cs d ε t T Q hε hn (by omega) hQ hQe hQ0 hQs
      obtain ⟨p', hp', hB, hT⟩ := hclose a₀ (2 * T) (cs + 2 * t) (t + ε) u p (by omega) hp hpe
        hpev hpod
      have hv : y + (y - k) + 2 * u + 1 = a₀ + bb + (cs + 2 * t) + 1 := by omega
      rw [hv, hbb] at hp'
      rw [hv] at hT
      exact ⟨a₀, cs + 2 * t, ha₀, hc₀, hce, by omega, p', hp', hB, hT⟩
    rcases (show bb % 4 = 1 ∨ bb % 4 = 3 by omega) with h4 | h4
    · obtain ⟨t, ht⟩ : ∃ t, bb + 4 * t = 2 * (y - k) - 1 :=
        ⟨(2 * (y - k) - 1 - bb) / 4, by omega⟩
      rcases (show e = 0 ∨ e = 1 by omega) with rfl | rfl
      · 
        obtain ⟨hR, hRs, hR0, -⟩ := path_range (y + 1) (by omega)
        refine fin y 0 0 0 t (h - t) (h - t) (List.range (y + 1)) (by omega) (by omega)
          (by omega) (by omega) (by omega) le_rfl (by omega) (by omega) ?_
          (endc _ _ _ hR0 (by omega)) (by intro h'; omega) ?_
        · have e1 : y + 0 + 1 = y + 1 := by omega
          have e2 : prescribedLengths y k y 0 0 = Multiset.replicate (y + 1 - 1) 1 := by
            simp [prescribedLengths]
          rw [e1, e2]
          exact hR
        · intro x hx _
          exact hRs x (by omega)
      · 
        obtain ⟨Q, hQ, -, hQb, hQ0, -⟩ := path_II (y + 1) 1 le_rfl (by omega)
        refine fin (y - 1) 1 0 0 t (h - t) (h - t) Q (by omega) (by omega)
          (by omega) (by omega) (by omega) (by omega) (by omega) (by omega) ?_
          (endc _ _ _ hQ0 (by omega)) (by intro h'; omega) ?_
        · have e1 : y - 1 + 1 + 1 = y + 1 := by omega
          have e2 : prescribedLengths y k (y - 1) 0 1 =
              Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - 1) := by
            unfold prescribedLengths
            rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - 1 = y by omega]
            simp
          rw [e1, e2]
          exact hQ
        · intro x hx hx'
          exact hQb x (by omega) (by omega)
    · obtain ⟨t, ht⟩ : ∃ t, bb + 4 * t = 2 * (y - k) - 3 :=
        ⟨(2 * (y - k) - 3 - bb) / 4, by omega⟩
      rcases (show e = 0 ∨ e = 1 by omega) with rfl | rfl
      · 
        obtain ⟨Q, hQ, hQ0, hQs⟩ := seedA4
        refine fin y 2 1 0 t (h - 1 - t) (h - t) Q (by omega) (by omega)
          (by omega) (by omega) (by omega) le_rfl (by omega) (by omega) ?_
          (endc _ _ _ hQ0 (by omega)) (by intro h'; omega) ?_
        · have e1 : y + 2 + 1 = y + 3 := by omega
          have e2 : prescribedLengths y k y 0 2 =
              Multiset.replicate y 1 + Multiset.replicate 2 y := by
            simp [prescribedLengths]
          rw [e1, e2]
          exact hQ
        · intro x hx hx'
          exact hQs x (by omega) (by omega) (by omega)
      · 
        obtain ⟨Q, hQ, hQ2, hQ01, hQs⟩ := seedIII2
        refine fin (y - 1) 1 0 1 t (h - t) (h - t - 1) Q (by omega) (by omega)
          (by omega) (by omega) (by omega) (by omega) (by omega) (by omega) ?_
          (endc _ _ _ hQ2 (by omega)) (fun _ => hQ01) ?_
        · have e1 : y - 1 + 1 + 1 = y + 1 := by omega
          have e2 : prescribedLengths y k (y - 1) 0 1 =
              Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y := by
            simp [prescribedLengths]
          rw [e1, e2]
          exact hQ
        · intro x hx hx'
          exact hQs x (by omega) (by omega)
  
  
  
  rcases Nat.mod_two_eq_zero_or_one b with hbe | hbo
  · obtain ⟨bb, rfl⟩ : ∃ bb, b = bb + (y - k) := ⟨b - (y - k), by omega⟩
    obtain ⟨a₀, c₀, ha₀, hc₀, hce, hv, p, hp, hB, hT⟩ :=
      hbase bb (c % 2) (by omega) (by omega) (by omega)
    obtain ⟨p₁, hp₁, hB₁, hA₁, -⟩ := grow_bot_end_iter (y - k) (a₀ + bb + c₀ + 1) 1 _ p
      (by omega) (by omega) hp hB
    have hT₁ : TopPairInv y (a₀ + bb + c₀ + 1 + 1 * (y - k)) p₁ := by
      refine ⟨hyEven, ?_⟩
      intro j hj
      have h1 := hA₁ _ _ (by omega) (by omega) (hT.2 j hj)
      exact adjc _ _ _ _ _ h1 (by omega) (by omega)
    have ev : a₀ + bb + c₀ + 1 + 1 * (y - k) = a₀ + (bb + (y - k)) + c₀ + 1 := by omega
    have hL : prescribedLengths y k a₀ bb c₀ + Multiset.replicate (1 * (y - k)) (y - k) =
        prescribedLengths y k a₀ (bb + (y - k)) c₀ := by
      unfold prescribedLengths
      rw [one_mul, Multiset.replicate_add]
      abel
    rw [ev, hL] at hp₁
    rw [ev] at hT₁
    obtain ⟨p', hp', hB', hT'⟩ := hlift ((c - c₀) / 2) a₀ (bb + (y - k)) c₀ p₁ (by omega) hp₁
      hB₁ hT₁
    have ec : c₀ + 2 * ((c - c₀) / 2) = c := by omega
    rw [ec] at hp' hT'
    exact ⟨a₀, ha₀, p', hp', Or.inl hB', Or.inr hT', Or.inl hB'⟩
  · obtain ⟨a₀, c₀, ha₀, hc₀, hce, hv, p, hp, hB, hT⟩ :=
      hbase b (c % 2) hbo hb2 (by omega)
    obtain ⟨p', hp', hB', hT'⟩ := hlift ((c - c₀) / 2) a₀ b c₀ p (by omega) hp hB hT
    have ec : c₀ + 2 * ((c - c₀) / 2) = c := by omega
    rw [ec] at hp' hT'
    exact ⟨a₀, ha₀, p', hp', Or.inl hB', Or.inr hT', Or.inl hB'⟩

theorem reflect_realization : ∀ (v : ℕ) (L : Multiset ℕ) (p : List ℕ), IsLinearRealization v L p →
    IsLinearRealization v L (p.map (fun x => v - 1 - x)) ∧
    (∀ u w : ℕ, u < v → w < v → Adj p u w → Adj (p.map (fun x => v - 1 - x)) (v - 1 - u) (v - 1 - w)) ∧
    (∀ x : ℕ, x < v → IsEnd p x → IsEnd (p.map (fun x => v - 1 - x)) (v - 1 - x)) :=
by
  intro v L p hp
  obtain ⟨hperm, hedge⟩ := hp
  have hmem : ∀ x ∈ p, x < v := fun x hx => List.mem_range.mp (hperm.mem_iff.mp hx)
  refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
  · 
    unfold IsVertexPerm
    refine (hperm.map _).trans ?_
    have hnd : ((List.range v).map (fun x => v - 1 - x)).Nodup := by
      refine List.Nodup.map_on ?_ List.nodup_range
      intro x hx y hy hxy
      rw [List.mem_range] at hx hy
      omega
    have hsub : ((List.range v).map (fun x => v - 1 - x)).Subperm (List.range v) := by
      refine List.Nodup.subperm hnd ?_
      intro z hz
      rw [List.mem_map] at hz
      obtain ⟨x, hx, rfl⟩ := hz
      rw [List.mem_range] at hx ⊢
      omega
    exact hsub.perm_of_length_le (by simp)
  · 
    rw [← hedge]
    unfold edgeLengths
    congr 1
    clear hedge hperm
    revert hmem
    induction p with
    | nil => intro _; simp
    | cons a t ih =>
      intro hl
      cases t with
      | nil => simp
      | cons b t' =>
        have ha : a < v := hl a (by simp)
        have hb : b < v := hl b (by simp)
        have ih' := ih (fun x hx => hl x (List.mem_cons_of_mem _ hx))
        simp only [List.pure_def, List.bind_eq_flatMap, List.flatMap_cons, List.cons_append,
          List.nil_append, List.map_cons, List.tail_cons, List.zipWith_cons_cons] at ih' ⊢
        rw [ih']
        congr 1
        show Int.natAbs (((v - 1 - b : ℕ) : ℤ) - ((v - 1 - a : ℕ) : ℤ)) =
          Int.natAbs ((b : ℤ) - (a : ℤ))
        have h1 : ((v - 1 - b : ℕ) : ℤ) - ((v - 1 - a : ℕ) : ℤ) = -((b : ℤ) - (a : ℤ)) := by
          omega
        rw [h1, Int.natAbs_neg]
  · 
    intro u w _ _ h
    obtain ⟨l₁, l₂, h⟩ := h
    refine ⟨l₁.map (fun x => v - 1 - x), l₂.map (fun x => v - 1 - x), ?_⟩
    rcases h with h | h
    · left; subst h; simp
    · right; subst h; simp
  · 
    intro x _ h
    unfold IsEnd at h ⊢
    rw [List.head?_map, List.getLast?_map]
    rcases h with h | h
    · left; rw [h]; rfl
    · right; rw [h]; rfl

theorem famR : ∀ (y k s s₂ : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 2 * s ≤ y - k → y - k ≤ 2 * (s + s₂) → (s = 0 ∨ 2 * (s + s₂) = y - k) → 2 * s₂ + 1 ≤ y → ∃ p : List ℕ, IsLinearRealization ((y - 1) + 2 * s + (y + 2 * s₂ - 2 * s) + 1) (prescribedLengths y k (y - 1) (2 * s) (y + 2 * s₂ - 2 * s)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + 2 * s + (y + 2 * s₂ - 2 * s) + 1) p :=
by
  intro y k s s₂ hk hyk hy hk2 h1 h2 h3 h4
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjsymm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  obtain ⟨s₃, hs₃⟩ : ∃ t, 2 * t + 2 * s + 1 = y := ⟨(y - 1) / 2 - s, by omega⟩
  
  obtain ⟨hQ, hQa, hQ0, -⟩ := path_range y (by omega)
  
  obtain ⟨p₁, hp₁, hA1, hK1, hE1⟩ := bot_pairs (y - k) y s _ _ (by omega) (by omega) h1 hQ (by
    intro i hi
    exact adjc _ _ _ _ _ (hQa (y - k - 2 - 2 * i) (by omega)) rfl (by omega))
  
  obtain ⟨p₂, hp₂, hA2, hK2, hE2⟩ := top_pairs y (y + 2 * s) s₂ _ p₁ (by omega) (by omega)
    (by omega) hp₁ (by
      intro i hi
      have h := hK1 (2 * i) (hQa (2 * i) (by omega)) (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega))
  
  obtain ⟨p₃, hp₃, hA3, hK3, hE3⟩ := bot_pairs y (y + 2 * s + 2 * s₂) s₃ _ p₂ (by omega)
    (by omega) (by omega) hp₂ (by
      intro i hi
      have h := hK1 (y - 2 - 2 * i - 2 * s) (hQa _ (by omega)) (by intro i' hi'; omega)
      have h' := hK2 _ h (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h' (by omega) (by omega))
  have hEnd : IsEnd p₃ (y - 1) := by
    have h := hE3 _ (hE2 _ (hE1 _ hQ0))
    exact endc _ _ _ h (by omega)
  
  obtain ⟨p₄, hp₄, hE40, hK4, -⟩ :=
    bot_attach y (y + 2 * s + 2 * s₂ + 2 * s₃) _ p₃ (by omega) (by omega) hp₃ hEnd
  
  obtain ⟨hr, hrA, hrE⟩ := reflect_realization (y + 2 * s + 2 * s₂ + 2 * s₃ + 1) _ p₄ hp₄
  have hL : Multiset.replicate (y - 1) 1 + Multiset.replicate (2 * s) (y - k) +
      Multiset.replicate (2 * s₂) y + Multiset.replicate (2 * s₃) y + Multiset.replicate 1 y =
      prescribedLengths y k (y - 1) (2 * s) (y + 2 * s₂ - 2 * s) := by
    have hc' : Multiset.replicate (y + 2 * s₂ - 2 * s) y = Multiset.replicate (2 * s₂) y +
        Multiset.replicate (2 * s₃) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    unfold prescribedLengths
    rw [hc']
    abel
  rw [show (y - 1) + 2 * s + (y + 2 * s₂ - 2 * s) + 1 = y + 2 * s + 2 * s₂ + 2 * s₃ + 1 by omega,
    ← hL]
  refine ⟨_, hr, ⟨Nat.even_iff.mpr (by omega), ?_⟩, ⟨?_, ?_, ?_⟩⟩
  · intro j hj
    have hw : Adj p₂ (y + 2 * s + 2 * s₂ - 2 - 2 * j) (y + 2 * s + 2 * s₂ - 2 - 2 * j + 1) := by
      by_cases hjs : j < s₂
      · have h := hA2 (s₂ - 1 - j) (by omega)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
      · have h := hK1 (y - 2 - 2 * (j - s₂)) (hQa _ (by omega)) (by intro i hi; omega)
        have h' := hK2 _ h (by intro i hi; omega)
        exact adjc _ _ _ _ _ h' (by omega) (by omega)
    have h3' := hK3 _ hw (by intro i hi; omega)
    have h4' := hK4 _ h3'
    have h5 := hrA _ _ (by omega) (by omega) h4'
    exact adjsymm _ _ _ (adjc _ _ _ _ _ h5 (by omega) (by omega))
  · have h := hrE 0 (by omega) hE40
    exact endc _ _ _ h (by omega)
  · intro j hj1 hj2
    have hw : Adj p₃ (2 * j - 2) (2 * j - 2 + 1) := by
      by_cases hjs : j - 1 < s₃
      · have h := hA3 (j - 1) hjs
        exact adjc _ _ _ _ _ h (by omega) (by omega)
      · have h := hA1 (j - 1 - s₃) (by omega)
        have h' := hK2 _ h (by intro i hi; omega)
        have h'' := hK3 _ h' (by intro i hi; omega)
        exact adjc _ _ _ _ _ h'' (by omega) (by omega)
    have h4' := hK4 _ hw
    have h5 := hrA _ _ (by omega) (by omega) h4'
    exact adjc _ _ _ _ _ h5 (by omega) (by omega)
  · intro he
    have := Nat.even_iff.mp he
    omega

theorem famC : ∀ (y k s : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 2 * s + 2 ≤ y - k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (2 + 2 * s) + ((y - k) + y - 2 - 4 * s) + 1) (prescribedLengths y k (y - 1) (2 + 2 * s) ((y - k) + y - 2 - 4 * s)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (2 + 2 * s) + ((y - k) + y - 2 - 4 * s) + 1) p :=
by
  intro y k s hk hyk hy hk2 hs
  have adj_symm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  obtain ⟨s₂, h₂⟩ : ∃ t, 2 * t + 2 + 2 * s = y - k := ⟨(y - k - 2 - 2 * s) / 2, by omega⟩
  obtain ⟨s₃, h₃⟩ : ∃ t, 2 * t + 2 * s + 1 = y := ⟨(y - 1 - 2 * s) / 2, by omega⟩
  
  obtain ⟨Q0, hQ0, hQa, hQb, -, hQ0j⟩ := path_II (y + 1) (k + 1) (by omega) (by omega)
  obtain ⟨hQ1, hA1, hE1⟩ := reflect_realization (y + 1) _ Q0 hQ0
  generalize Q0.map (fun x => y + 1 - 1 - x) = Q1 at hQ1 hA1 hE1
  obtain ⟨Q, hQ, hQ0end, hQK, -⟩ := bot_attach (y - k) (y + 1) _ Q1 (by omega) (by omega) hQ1
    (endc _ _ _ (hE1 (k + 1) (by omega) hQ0j) (by omega))
  have hseed : ∀ x : ℕ, 1 ≤ x → x ≤ y → x ≠ y - k → Adj Q x (x + 1) := by
    intro x h1 h2 h3
    have h0 : Adj Q0 (y - x) (y - x + 1) := by
      rcases Nat.lt_or_gt_of_ne h3 with h | h
      · exact hQb _ (by omega) (by omega)
      · exact hQa _ (by omega)
    have h4 := adj_symm _ _ _ (hA1 _ _ (by omega) (by omega) h0)
    have h5 := hQK (x - 1) (adjc _ _ _ _ _ h4 (by omega) (by omega))
    exact adjc _ _ _ _ _ h5 (by omega) (by omega)
  
  obtain ⟨P1, hP1, hN1, hK1, hEP1⟩ := bot_pairs (y - k) (y + 1 + 1) s _ Q (by omega) (by omega)
    (by omega) hQ
    (fun i hi => adjc _ _ _ _ _ (hseed (y - k - 2 - 2 * i) (by omega) (by omega) (by omega))
      rfl (by omega))
  obtain ⟨P, hP, hN2, hK2, hEP⟩ := top_pairs y (y + 1 + 1 + 2 * s) s₂ _ P1 (by omega) (by omega)
    (by omega) hP1
    (by
      intro i hi
      have h := hK1 (2 + 2 * i) (hseed _ (by omega) (by omega) (by omega))
        (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega))
  have hPend : IsEnd P (2 * s) := hEP _ (endc _ _ _ (hEP1 0 hQ0end) (by omega))
  have hPeven : ∀ x : ℕ, x % 2 = 0 → x < 2 * s → Adj P x (x + 1) := by
    intro x hx1 hx2
    have h := adjc _ _ _ _ _ (hN1 (x / 2) (by omega)) (show 2 * (x / 2) = x by omega)
      (show 2 * (x / 2) + 1 = x + 1 by omega)
    exact hK2 _ h (by intro i hi; omega)
  have hPodd : ∀ x : ℕ, x % 2 = 1 → 2 * s + 1 ≤ x → x + 2 ≤ y + (y - k) → Adj P x (x + 1) := by
    intro x hx1 hx2 hx3
    by_cases hx : x ≤ y + 2 * s
    · have h := hK1 (x - 2 * s) (hseed _ (by omega) (by omega) (by omega))
        (by intro i hi; omega)
      have h' := adjc _ _ _ _ _ h (show x - 2 * s + 2 * s = x by omega)
        (show x - 2 * s + 2 * s + 1 = x + 1 by omega)
      exact hK2 _ h' (by intro i hi; omega)
    · have h := hN2 ((x - y - 2 - 2 * s) / 2) (by omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega)
  
  obtain ⟨P3, hP3, hN3, hK3, hEP3⟩ := bot_pairs y (y + 1 + 1 + 2 * s + 2 * s₂) s₃ _ P
    (by omega) (by omega) (by omega) hP
    (fun i hi => adjc _ _ _ _ _ (hPodd (y - 2 - 2 * i) (by omega) (by omega) (by omega))
      rfl (by omega))
  obtain ⟨P4, hP4, hP40, hK4, -⟩ := bot_attach y (y + 1 + 1 + 2 * s + 2 * s₂ + 2 * s₃) _ P3
    (by omega) (by omega) hP3 (endc _ _ _ (hEP3 _ hPend) (by omega))
  obtain ⟨hp, hA5, hE5⟩ := reflect_realization (y + 1 + 1 + 2 * s + 2 * s₂ + 2 * s₃ + 1) _ P4 hP4
  generalize P4.map (fun x => y + 1 + 1 + 2 * s + 2 * s₂ + 2 * s₃ + 1 - 1 - x) = p at hp hA5 hE5
  have hv : (y - 1) + (2 + 2 * s) + ((y - k) + y - 2 - 4 * s) + 1 =
      y + 1 + 1 + 2 * s + 2 * s₂ + 2 * s₃ + 1 := by omega
  have hL : prescribedLengths y k (y - 1) (2 + 2 * s) ((y - k) + y - 2 - 4 * s) =
      Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - (k + 1)) +
        Multiset.replicate 1 (y - k) + Multiset.replicate (2 * s) (y - k) +
        Multiset.replicate (2 * s₂) y + Multiset.replicate (2 * s₃) y + Multiset.replicate 1 y := by
    rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - (k + 1) = y - k by omega]
    unfold prescribedLengths
    rw [show 2 + 2 * s = 1 + 1 + 2 * s by omega, Multiset.replicate_add, Multiset.replicate_add,
      show (y - k) + y - 2 - 4 * s = 2 * s₂ + 2 * s₃ + 1 by omega, Multiset.replicate_add,
      Multiset.replicate_add]
    abel
  rw [hv, hL]
  refine ⟨p, hp, ⟨Nat.even_iff.mpr (by omega), ?_⟩, ?_, ?_, ?_⟩
  · intro j hj
    have h1 := hPodd (y + (y - k) - 2 - 2 * j) (by omega) (by omega) (by omega)
    have h2 := hK3 _ h1 (by intro i hi; omega)
    have h3 := hK4 _ h2
    have h4 := adj_symm _ _ _ (hA5 _ _ (by omega) (by omega) h3)
    exact adjc _ _ _ _ _ h4 (by omega) (by omega)
  · exact endc _ _ _ (hE5 0 (by omega) hP40) (by omega)
  · intro j hj1 hj2
    have hslot : Adj P3 (2 * j - 2) (2 * j - 2 + 1) := by
      by_cases hj : j - 1 < s₃
      · exact adjc _ _ _ _ _ (hN3 (j - 1) hj) (by omega) (by omega)
      · have h0 := hPeven (2 * j - 2 - 2 * s₃) (by omega) (by omega)
        have h := hK3 _ h0 (by intro i hi; omega)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
    have h3 := hK4 _ hslot
    have h4 := hA5 _ _ (by omega) (by omega) h3
    exact adjc _ _ _ _ _ h4 (by omega) (by omega)
  · intro he
    have := Nat.even_iff.mp he
    omega

theorem famA : ∀ (y k s : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 2 * s + 2 ≤ y - k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (1 + 2 * s) + ((y - k) + y - 3 - 4 * s) + 1) (prescribedLengths y k (y - 1) (1 + 2 * s) ((y - k) + y - 3 - 4 * s)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (1 + 2 * s) + ((y - k) + y - 3 - 4 * s) + 1) p :=
by
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjsymm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have adjget : ∀ (p : List ℕ) (i : ℕ) (h : i + 1 < p.length), Adj p p[i] p[i + 1] := by
    intro p i h
    refine ⟨p.take i, p.drop (i + 2), Or.inl ?_⟩
    conv_lhs => rw [← List.take_append_drop i p]
    congr 1
    rw [List.drop_eq_getElem_cons (i := i) (by omega), List.drop_eq_getElem_cons (i := i + 1) h]
  
  have seed : ∀ d k' : ℕ, ∃ Q : List ℕ,
      IsLinearRealization (d + k' + 4) (Multiset.replicate (d + k' + 1) 1 +
        Multiset.replicate 1 (d + 2) + Multiset.replicate 1 (d + k' + 2)) Q ∧
      Adj Q 0 1 ∧ (∀ x : ℕ, 2 ≤ x → x + 1 ≤ d + 2 → Adj Q x (x + 1)) ∧
      (∀ x : ℕ, d + 3 ≤ x → x ≤ d + k' + 2 → Adj Q x (x + 1)) ∧ IsEnd Q 2 := by
    intro d k'
    set Q : List ℕ := (List.range (d + 1)).map (fun x => 2 + x) ++
      0 :: 1 :: ((List.range (k' + 1)).map (fun x => 2 + (d + 1) + x)).reverse with hQdef
    have hlen : Q.length = d + k' + 4 := by
      simp [hQdef]; omega
    have hQ : ∀ (i : ℕ) (h : i < Q.length), Q[i] =
        if i < d + 1 then 2 + i else if i = d + 1 then 0 else if i = d + 2 then 1
        else 2 + (d + 1) + (k' - (i - (d + 3))) := by
      intro i h
      simp only [hQdef, List.getElem_append, List.getElem_cons, List.getElem_reverse,
        List.getElem_map, List.getElem_range, List.length_map, List.length_range]
      split_ifs <;> omega
    refine ⟨Q, ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · show List.Perm _ _
      have e1 : Q = ((List.range (d + 1)).map (fun x => 2 + x) ++ [0, 1]) ++
          ((List.range (k' + 1)).map (fun x => 2 + (d + 1) + x)).reverse := by
        simp [hQdef]
      rw [e1, show d + k' + 4 = 2 + (d + 1) + (k' + 1) by omega,
        @List.range_add (2 + (d + 1)) (k' + 1), @List.range_add 2 (d + 1)]
      have h2 : List.range 2 = [0, 1] := by decide
      rw [h2]
      exact List.perm_append_comm.append (List.reverse_perm _)
    · have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a)) (Q.map (fun a : ℕ => (a : ℤ)))
          (Q.tail.map (fun a : ℕ => (a : ℤ))) =
          List.replicate d 1 ++ (d + 2) :: 1 :: (d + k' + 2) :: List.replicate k' 1 := by
        apply List.ext_getElem
        · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
            List.length_append, List.length_replicate, List.length_cons]
          omega
        · intro i h1 h2
          simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
          rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail, hQ, hQ]
          simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
            List.length_replicate]
          rw [Int.natAbs_eq_iff]
          split_ifs <;> omega
      have he : edgeLengths Q = ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (Q.map (fun a : ℕ => (a : ℤ))) (Q.tail.map (fun a : ℕ => (a : ℤ))) : List ℕ) :
          Multiset ℕ) := by
        unfold edgeLengths
        simp only [List.map_eq_flatMap]
        rfl
      rw [he, hl]
      rw [show d + k' + 1 = d + (1 + k') by omega, Multiset.replicate_add,
        Multiset.replicate_add]
      simp only [← Multiset.coe_add, ← Multiset.cons_coe, Multiset.coe_replicate,
        ← Multiset.singleton_add, Multiset.replicate_one]
      abel
    · have h := adjget Q (d + 1) (by omega)
      rw [hQ, hQ] at h
      exact adjc _ _ _ _ _ h (by split_ifs <;> omega) (by split_ifs <;> omega)
    · intro x hx1 hx2
      have h := adjget Q (x - 2) (by omega)
      rw [hQ, hQ] at h
      exact adjc _ _ _ _ _ h (by split_ifs <;> omega) (by split_ifs <;> omega)
    · intro x hx1 hx2
      have h := adjget Q (2 * d + k' + 5 - x) (by omega)
      rw [hQ, hQ] at h
      exact adjsymm _ _ _ (adjc _ _ _ _ _ h (by split_ifs <;> omega) (by split_ifs <;> omega))
    · left
      simp [hQdef, List.head?_range]
  intro y k s hk hyk hy hk2 hs
  obtain ⟨s₂, hs₂⟩ : ∃ t, 2 * t = (y - k) - 2 - 2 * s := ⟨((y - k) - 2 - 2 * s) / 2, by omega⟩
  obtain ⟨s₃, hs₃⟩ : ∃ t, 2 * t = y - 3 - 2 * s := ⟨(y - 3 - 2 * s) / 2, by omega⟩
  obtain ⟨Q, hQ, hQ0, hQ1, hQ2, hQe⟩ := seed (y - k - 2) k
  rw [show y - k - 2 + k + 4 = y + 2 by omega] at hQ
  
  obtain ⟨p₁, hp₁, hB1, hK1, hE1⟩ := bot_pairs (y - k) (y + 2) s _ Q (by omega) (by omega)
    (by omega) hQ (fun i hi => adjc _ _ _ _ _ (hQ1 (y - k - 2 - 2 * i) (by omega) (by omega))
      rfl (by omega))
  
  obtain ⟨p₂, hp₂, hT2, hK2, hE2⟩ := top_pairs y (y + 2 + 2 * s) s₂ _ p₁ (by omega) (by omega)
    (by omega) hp₁ (by
      intro i hi
      have h := hK1 (2 + 2 * i) (hQ1 _ (by omega) (by omega)) (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega))
  have G1 : ∀ e : ℕ, e % 2 = 0 → e ≤ 2 * s → Adj p₂ e (e + 1) := by
    intro e he1 he2
    have h1 : Adj p₁ e (e + 1) := by
      by_cases hlt : e < 2 * s
      · exact adjc _ _ _ _ _ (hB1 (e / 2) (by omega)) (by omega) (by omega)
      · have h := hK1 0 hQ0 (by intro i hi; omega)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
    exact hK2 e h1 (by intro i hi; omega)
  have G2 : ∀ z : ℕ, z % 2 = 1 → 3 ≤ z → z ≤ y → Adj p₂ (z + 2 * s) (z + 2 * s + 1) := by
    intro z hz1 hz2 hz3
    have h0 : Adj Q z (z + 1) := by
      by_cases hzm : z + 1 ≤ y - k
      · exact hQ1 z (by omega) (by omega)
      · exact hQ2 z (by omega) (by omega)
    have h1 := hK1 z h0 (by intro i hi; omega)
    exact hK2 _ h1 (by intro i hi; omega)
  have G3 : IsEnd p₂ (2 + 2 * s) := hE2 _ (hE1 _ hQe)
  
  obtain ⟨P, hP, hB3, hK3, hE3⟩ := bot_pairs y (y + 2 + 2 * s + 2 * s₂) s₃ _ p₂ (by omega)
    (by omega) (by omega) hp₂ (by
      intro i hi
      have h := G2 (y - 2 - 2 * i - 2 * s) (by omega) (by omega) (by omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega))
  have hv3 : y + 2 + 2 * s + 2 * s₂ + 2 * s₃ = y + (y - k) + 2 * s₃ := by omega
  rw [hv3] at hP
  have C1 : IsEnd P (y - 1) := by
    have h := hE3 _ G3
    rwa [show 2 + 2 * s + 2 * s₃ = y - 1 by omega] at h
  have C2 : ∀ j : ℕ, 2 * j + 3 ≤ y → Adj P (2 * j) (2 * j + 1) := by
    intro j hj
    by_cases hjs : j < s₃
    · exact hB3 j hjs
    · have h := hK3 (2 * j - 2 * s₃) (G1 _ (by omega) (by omega)) (by intro i hi; omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega)
  have C3 : ∀ j : ℕ, 2 * j + 2 ≤ y - k →
      Adj P (y + (y - k) + 2 * s₃ - 2 - 2 * j) (y + (y - k) + 2 * s₃ - 1 - 2 * j) := by
    intro j hj
    have h0 : Adj p₂ (y + (y - k) - 2 - 2 * j) (y + (y - k) - 2 - 2 * j + 1) := by
      by_cases hjs : j < s₂
      · exact adjc _ _ _ _ _ (hT2 (s₂ - 1 - j) (by omega)) (by omega) (by omega)
      · exact adjc _ _ _ _ _ (G2 (y + (y - k) - 2 - 2 * j - 2 * s) (by omega) (by omega)
          (by omega)) (by omega) (by omega)
    have h := hK3 _ h0 (by intro i hi; omega)
    exact adjc _ _ _ _ _ h (by omega) (by omega)
  
  obtain ⟨P4, hP4, hP40, hK4, -⟩ := bot_attach y (y + (y - k) + 2 * s₃) _ P (by omega)
    (by omega) hP C1
  obtain ⟨hr, hrA, hrE⟩ := reflect_realization (y + (y - k) + 2 * s₃ + 1) _ P4 hP4
  have hV : (y - 1) + (1 + 2 * s) + ((y - k) + y - 3 - 4 * s) + 1 =
      y + (y - k) + 2 * s₃ + 1 := by omega
  have hLeq : Multiset.replicate (y - k - 2 + k + 1) 1 + Multiset.replicate 1 (y - k - 2 + 2) +
      Multiset.replicate 1 (y - k - 2 + k + 2) + Multiset.replicate (2 * s) (y - k) +
      Multiset.replicate (2 * s₂) y + Multiset.replicate (2 * s₃) y + Multiset.replicate 1 y =
      prescribedLengths y k (y - 1) (1 + 2 * s) ((y - k) + y - 3 - 4 * s) := by
    have hc' : Multiset.replicate ((y - k) + y - 3 - 4 * s) y = Multiset.replicate 1 y +
        Multiset.replicate (2 * s₂) y + Multiset.replicate (2 * s₃) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    have hb' : Multiset.replicate (1 + 2 * s) (y - k) =
        Multiset.replicate 1 (y - k) + Multiset.replicate (2 * s) (y - k) := by
      rw [Multiset.replicate_add]
    unfold prescribedLengths
    rw [show y - k - 2 + k + 1 = y - 1 by omega,
      show y - k - 2 + 2 = y - k by omega, show y - k - 2 + k + 2 = y by omega, hc', hb']
    abel
  rw [hV]
  refine ⟨P4.map (fun x => y + (y - k) + 2 * s₃ + 1 - 1 - x), ?_, ?_, ?_⟩
  · rw [← hLeq]
    exact hr
  · refine ⟨⟨(y - k) / 2, by omega⟩, ?_⟩
    intro j hj
    have h := C3 j hj
    have h' := hK4 _ (adjc _ _ _ (y + (y - k) + 2 * s₃ - 2 - 2 * j)
      (y + (y - k) + 2 * s₃ - 2 - 2 * j + 1) h rfl (by omega))
    have h'' := hrA _ _ (by omega) (by omega) h'
    exact adjsymm _ _ _ (adjc _ _ _ _ _ h'' (by omega) (by omega))
  · refine ⟨?_, ?_, ?_⟩
    · have h := hrE 0 (by omega) hP40
      rwa [show y + (y - k) + 2 * s₃ + 1 - 1 - 0 = y + (y - k) + 2 * s₃ + 1 - 1 by omega] at h
    · intro j hj1 hj2
      have h := hK4 _ (C2 (j - 1) (by omega))
      have h' := hrA _ _ (by omega) (by omega) h
      exact adjc _ _ _ _ _ h' (by omega) (by omega)
    · intro he
      have := Nat.even_iff.mp he
      omega

theorem famB : ∀ (y k s : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 2 * s + 2 ≤ y - k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (1 + 2 * s) + ((y - k) + y - 1 - 4 * s) + 1) (prescribedLengths y k (y - 1) (1 + 2 * s) ((y - k) + y - 1 - 4 * s)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (1 + 2 * s) + ((y - k) + y - 1 - 4 * s) + 1) p :=
by
  intro y k s hk hyk hy hk2 hs
  have adj_symm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  
  have seed : ∀ m : ℕ, m = y - k → ∃ Q : List ℕ,
      IsLinearRealization (y + 1 + 1) (prescribedLengths y k (y - 1) 1 1) Q ∧
