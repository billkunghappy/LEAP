theorem seed_S3 : ∀ y : ℕ, 5 ≤ y → ∃ Q : List ℕ, IsLinearRealization (y + 4) (Multiset.replicate y 1 + Multiset.replicate 3 y) Q ∧ IsEnd Q 0 ∧ IsEnd Q 2 ∧ Adj Q 1 2 ∧ (∀ x : ℕ, 3 ≤ x → x + 1 ≤ y → Adj Q x (x + 1)) ∧ Adj Q (y + 1) (y + 2) ∧ Adj Q (y + 2) (y + 3) :=
by
  intro y hy
  
  have f0 : seedS3Fn y 0 = 0 := by simp [seedS3Fn]
  have fD : ∀ i, 1 ≤ i → i + 2 ≤ y → seedS3Fn y i = y + 1 - i := by
    intro i h1 h2
    unfold seedS3Fn
    rw [if_neg (by omega), if_pos h2]
  have fA : ∀ i, i + 1 = y → seedS3Fn y i = y + 3 := by
    intro i h
    unfold seedS3Fn
    rw [if_neg (by omega), if_neg (by omega), if_pos h]
  have fB : seedS3Fn y y = y + 2 := by
    unfold seedS3Fn
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos rfl]
  have fC : seedS3Fn y (y + 1) = y + 1 := by
    unfold seedS3Fn
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos rfl]
  have fE : seedS3Fn y (y + 2) = 1 := by
    unfold seedS3Fn
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
      if_neg (by omega), if_pos rfl]
  have fF : seedS3Fn y (y + 3) = 2 := by
    unfold seedS3Fn
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
      if_neg (by omega), if_neg (by omega)]
  have hv : ∀ i : ℕ, i < y + 4 → ∀ v : ℕ, seedS3Fn y i = v →
      ((List.range (y + 4)).map (seedS3Fn y))[i]? = some v := by
    intro i hi v hfv
    rw [List.getElem?_map, List.getElem?_range hi, ← hfv]
    rfl
  have hadj : ∀ (p : List ℕ) (i u w : ℕ), p[i]? = some u → p[i + 1]? = some w →
      Adj p u w ∧ Adj p w u := by
    intro p i u w h1 h2
    rw [List.getElem?_eq_some_iff] at h1 h2
    obtain ⟨hi1, rfl⟩ := h1
    obtain ⟨hi2, rfl⟩ := h2
    have e : p = p.take i ++ p[i] :: p[i + 1] :: p.drop (i + 1 + 1) := by
      conv_lhs => rw [← List.take_append_drop i p]
      rw [List.drop_eq_getElem_cons hi1, List.drop_eq_getElem_cons hi2]
    exact ⟨⟨_, _, Or.inl e⟩, ⟨_, _, Or.inr e⟩⟩
  have hlen : ((List.range (y + 4)).map (seedS3Fn y)).length = y + 4 := by simp
  refine ⟨(List.range (y + 4)).map (seedS3Fn y), ⟨?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · 
    show List.Perm _ _
    have hsub : List.range (y + 4) ⊆ (List.range (y + 4)).map (seedS3Fn y) := by
      intro a ha
      rw [List.mem_range] at ha
      rw [List.mem_map]
      have key : ∃ i, i < y + 4 ∧ seedS3Fn y i = a := by
        rcases (by omega : a = 0 ∨ a = 1 ∨ a = 2 ∨ (3 ≤ a ∧ a ≤ y) ∨ a = y + 1 ∨ a = y + 2 ∨
            a = y + 3) with h | h | h | h | h | h | h
        · exact ⟨0, by omega, by rw [f0]; omega⟩
        · exact ⟨y + 2, by omega, by rw [fE]; omega⟩
        · exact ⟨y + 3, by omega, by rw [fF]; omega⟩
        · exact ⟨y + 1 - a, by omega, by rw [fD _ (by omega) (by omega)]; omega⟩
        · exact ⟨y + 1, by omega, by rw [fC]; omega⟩
        · exact ⟨y, by omega, by rw [fB]; omega⟩
        · exact ⟨y - 1, by omega, by rw [fA _ (by omega)]; omega⟩
      obtain ⟨i, hi, hfi⟩ := key
      exact ⟨i, List.mem_range.mpr hi, hfi⟩
    exact ((List.subperm_of_subset List.nodup_range hsub).perm_of_length_le (by simp)).symm
  · 
    have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        (((List.range (y + 4)).map (seedS3Fn y)).map (fun a : ℕ => (a : ℤ)))
        (((List.range (y + 4)).map (seedS3Fn y)).tail.map (fun a : ℕ => (a : ℤ))) =
        y :: (List.replicate (y - 3) 1 ++ [y, 1, 1, y, 1]) := by
      apply List.ext_getElem
      · simp only [List.length_zipWith, List.length_map, List.length_tail, List.length_range,
          List.length_cons, List.length_append, List.length_replicate, List.length_nil]
        omega
      · intro i h1 h2
        simp only [List.length_zipWith, List.length_map, List.length_tail,
          List.length_range] at h1
        have hR : (y :: (List.replicate (y - 3) 1 ++ [y, 1, 1, y, 1]))[i] =
            if i = 0 ∨ i = y - 2 ∨ i = y + 1 then y else 1 := by
          simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
            List.length_replicate]
          split_ifs <;> omega
        rw [hR]
        simp only [List.getElem_zipWith, List.getElem_map, List.getElem_tail, List.getElem_range]
        rw [Int.natAbs_eq_iff]
        rcases (by omega : i = 0 ∨ (1 ≤ i ∧ i + 3 ≤ y) ∨ i + 2 = y ∨ i + 1 = y ∨ i = y ∨
            i = y + 1 ∨ i = y + 2) with h | h | h | h | h | h | h
        · rw [if_pos (by omega), h, f0, fD (0 + 1) (by omega) (by omega)]
          omega
        · rw [if_neg (by omega), fD i (by omega) (by omega), fD (i + 1) (by omega) (by omega)]
          omega
        · rw [if_pos (by omega), fD i (by omega) (by omega), fA (i + 1) (by omega)]
          omega
        · rw [if_neg (by omega), fA i h, show i + 1 = y by omega, fB]
          omega
        · rw [if_neg (by omega), h, fB, fC]
          omega
        · rw [if_pos (by omega), h, fC, fE]
          omega
        · rw [if_neg (by omega), h, fE, fF]
          omega
    have he : edgeLengths ((List.range (y + 4)).map (seedS3Fn y)) =
        ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        (((List.range (y + 4)).map (seedS3Fn y)).map (fun a : ℕ => (a : ℤ)))
        (((List.range (y + 4)).map (seedS3Fn y)).tail.map (fun a : ℕ => (a : ℤ))) : List ℕ) :
          Multiset ℕ) := by
      unfold edgeLengths
      simp only [List.map_eq_flatMap]
      rfl
    rw [he, hl]
    ext a
    simp only [Multiset.coe_count, List.count_cons, List.count_append, List.count_replicate,
      List.count_nil, Multiset.count_add, Multiset.count_replicate, beq_iff_eq]
    split_ifs <;> omega
  · 
    left
    rw [List.head?_eq_getElem?, hv 0 (by omega) 0 f0]
  · 
    right
    rw [List.getLast?_eq_getElem?, hlen, show y + 4 - 1 = y + 3 by omega,
      hv (y + 3) (by omega) 2 fF]
  · 
    exact (hadj _ (y + 2) 1 2 (hv _ (by omega) _ fE) (hv _ (by omega) _ fF)).1
  · 
    intro x hx1 hx2
    exact (hadj _ (y - x) (x + 1) x
      (hv _ (by omega) _ (by rw [fD _ (by omega) (by omega)]; omega))
      (hv _ (by omega) _ (by rw [fD _ (by omega) (by omega)]; omega))).2
  · 
    exact (hadj _ y (y + 2) (y + 1) (hv _ (by omega) _ fB) (hv _ (by omega) _ fC)).2
  · 
    exact (hadj _ (y - 1) (y + 3) (y + 2) (hv _ (by omega) _ (fA _ (by omega)))
      (hv _ (by omega) _ (by rw [show y - 1 + 1 = y by omega, fB]))).2

