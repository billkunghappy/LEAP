theorem bko11_P7 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → c ≤ k → c ≤ b → b + 2 * k + 1 ≤ y + c → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
