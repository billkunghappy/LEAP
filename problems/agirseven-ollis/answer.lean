  have hEnd : IsEnd p₃ (y - k - 1) := by
    have h := hE₃ _ (hE₂ _ (hE₁ _ hEs1) (by omega))
    rw [show s - 1 + 2 * t + 1 = y - k - 1 by omega] at h
    exact h
  obtain ⟨q, hq, hz, hS₄, -⟩ := bot_attach (y - k) (s + d + 2 * t + 1 + 2 * 3) _ p₃ (by omega)
    (by omega) hp₃ hEnd
  have hV : y - 1 + (2 * t + 2) + 7 + 1 = s + d + 2 * t + 1 + 2 * 3 + 1 := by omega
  refine ⟨y - 1, by omega, by omega, q, ?_, ?_, hz⟩
  · rw [hV]
    refine ⟨hq.1, ?_⟩
    rw [hq.2]
    unfold prescribedLengths
    rw [show s + d - 2 = y - 1 by omega, show s + d - 1 = y by omega,
      show 2 * t + 2 = 2 * t + 1 + 1 by omega, Multiset.replicate_add (2 * t + 1) 1,
      Multiset.replicate_add (2 * t) 1, show (7 : ℕ) = 1 + 2 * 3 by norm_num,
