  have memRr : ∀ i, i < N + 1 → 4 * μ + 2 * κ + 2 - i ∈ ldvList μ κ t n s (N + 1) :=
    fun i hi => memW _ (List.mem_append_right _ (Rmem _ _ i hi))
  have cv : ∀ z x : ℕ, z ∈ ldvList μ κ t n s (N + 1) → z = x → x ∈ ldvList μ κ t n s (N + 1) :=
    fun z x h e => e ▸ h
  
  
  
  have Zlen : ∀ m, (ldvZR μ t m).length = 4 * m := by
    intro m
    induction m with
    | zero => simp [ldvZR]
    | succ m ih => rw [Zsucc, List.length_append, ih]; simp [ldvBlock]; ring
  have Ulen : ∀ r, (ldvUnits μ κ r).length = 6 * r := by
    intro r
    induction r with
    | zero => simp [ldvUnits]
    | succ r ih => rw [Usucc, List.length_append, ih]; simp [ldvUnit]; ring
  have hlen : (ldvList μ κ t n s (N + 1)).length = 4 * μ + 2 * κ + 2 * t + 2 := by
    unfold ldvList
    simp only [List.length_cons, List.length_append, Zlen, Ulen, ldvRun, List.length_map,
      List.length_range]
    omega
  have cover : ∀ x, x < 4 * μ + 2 * κ + 2 * t + 2 → x ∈ ldvList μ κ t n s (N + 1) := by
    intro x hx
    obtain ⟨q, rfl | rfl⟩ : ∃ q, x = 2 * q ∨ x = 2 * q + 1 := ⟨x / 2, by omega⟩
    · by_cases c1 : q < t
      · exact memY _ (List.mem_range.2 (by omega))
      by_cases c2 : q < μ
      · exact cv (2 * (t + (q - t))) _ (memZb (q - t) (by omega) _ (by simp [ldvBlock])) (by omega)
      by_cases c3 : q = μ
      · exact cv _ _ mem2 (by omega)
      by_cases c4 : q ≤ μ + s
      · exact cv (2 * μ + 2 * (q - μ - 1) + 2) _
          (memUu (q - μ - 1) (by omega) _ (by simp [ldvUnit])) (by omega)
      by_cases c5 : q < 2 * μ
      · exact cv (2 * μ + 2 * (t + (q - μ - t))) _
          (memZb (q - μ - t) (by omega) _ (by simp [ldvBlock])) (by omega)
      by_cases c6 : q = 2 * μ
      · exact cv _ _ mem4 (by omega)
      by_cases c7 : q ≤ 2 * μ + s
      · exact cv (4 * μ + 2 * (q - 2 * μ - 1) + 2) _
          (memUu (q - 2 * μ - 1) (by omega) _ (by simp [ldvUnit])) (by omega)
      by_cases c8 : q ≤ 2 * μ + κ + 1
      · exact cv _ _ (memRr (4 * μ + 2 * κ + 2 - 2 * q) (by omega)) (by omega)
      by_cases c9 : q ≤ 2 * μ + κ + t
      · exact cv (4 * μ + 2 * κ + 2 * (q - 2 * μ - κ - 2) + 4) _
          (memUu (q - 2 * μ - κ - 2) (by omega) _ (by simp [ldvUnit])) (by omega)
      omega
    · by_cases c1 : q < t
      · exact memY _ (List.mem_range.2 (by omega))
      by_cases c2 : q < μ
      · exact cv (2 * (t + (q - t)) + 1) _ (memZb (q - t) (by omega) _ (by simp [ldvBlock]))
          (by omega)
      by_cases c3 : q < μ + s
      · exact cv (2 * μ + 2 * (q - μ) + 1) _
          (memUu (q - μ) (by omega) _ (by simp [ldvUnit])) (by omega)
      by_cases c4 : q = μ + s
      · exact cv _ _ memb (by omega)
      by_cases c5 : q < 2 * μ
      · exact cv (2 * μ + 2 * (t + (q - μ - t)) + 1) _
          (memZb (q - μ - t) (by omega) _ (by simp [ldvBlock])) (by omega)
      by_cases c6 : q < 2 * μ + s
      · exact cv (4 * μ + 2 * (q - 2 * μ) + 1) _
          (memUu (q - 2 * μ) (by omega) _ (by simp [ldvUnit])) (by omega)
      by_cases c7 : q ≤ 2 * μ + κ
      · exact cv _ _ (memRr (4 * μ + 2 * κ + 1 - 2 * q) (by omega)) (by omega)
      by_cases c8 : q < 2 * μ + κ + t
      · exact cv (4 * μ + 2 * κ + 2 * (q - 2 * μ - κ - 1) + 3) _
          (memUu (q - 2 * μ - κ - 1) (by omega) _ (by simp [ldvUnit])) (by omega)
      by_cases c9 : q = 2 * μ + κ + t
      · exact cv _ _ memH (by omega)
      omega
  have hperm : (ldvList μ κ t n s (N + 1)).Perm (List.range (4 * μ + 2 * κ + 2 * t + 2)) := by
    have hsub : List.range (4 * μ + 2 * κ + 2 * t + 2) ⊆ ldvList μ κ t n s (N + 1) :=
      fun x hx => cover x (List.mem_range.1 hx)
    have h1 := List.subperm_of_subset List.nodup_range hsub
    exact (h1.perm_of_length_le (by rw [hlen, List.length_range])).symm
  
  
  
  have hedges : edgeLengths (ldvList μ κ t n s (N + 1)) =
      {2 * μ + 2 * κ + 1} + (Multiset.replicate (2 * n) (2 * μ) + Multiset.replicate (2 * n) 1 +
        ({2 * μ} + ({2 * μ} + ((Multiset.replicate (2 * s + 1) 1 + {2 * μ}) +
          ({2 * μ + 2 * κ + 1} + (Multiset.replicate (2 * s) 1 + Multiset.replicate (2 * s) (2 * μ) +
            Multiset.replicate (2 * s) (2 * μ + 2 * κ + 1) + Multiset.replicate N 1)))))) := by
    obtain ⟨R', hR'⟩ := Rhead (4 * μ + 2 * κ + 2) N
    obtain ⟨T1, hT1⟩ := Uhead s R'
    have hEW : edgeLengths (ldvUnits μ κ s ++ ldvRun (4 * μ + 2 * κ + 2) (N + 1)) =
        Multiset.replicate (2 * s) 1 + Multiset.replicate (2 * s) (2 * μ) +
          Multiset.replicate (2 * s) (2 * μ + 2 * κ + 1) + Multiset.replicate N 1 := by
      rw [hR', UE s R', ← hR', RE _ N (by omega)]
    have hEbW : edgeLengths ((2 * μ + 2 * t - 1) ::
        (ldvUnits μ κ s ++ ldvRun (4 * μ + 2 * κ + 2) (N + 1))) =
        {2 * μ + 2 * κ + 1} + edgeLengths (ldvUnits μ κ s ++ ldvRun (4 * μ + 2 * κ + 2) (N + 1)) := by
      rw [hR', hT1, econs' (2 * μ + 2 * t - 1) (4 * μ + 2 * κ + 2 * s + 2) (2 * μ + 2 * κ + 1) _
        (by omega)]
    have hRb : edgeLengths (List.range (2 * t) ++ [2 * μ + 2 * t - 1]) =
        Multiset.replicate (2 * s + 1) 1 + {2 * μ} := by
      have h2t : List.range (2 * t) = List.range (2 * s + 1) ++ [2 * s + 1] := by
        rw [show 2 * t = 2 * s + 1 + 1 by omega, List.range_succ]
      rw [h2t, List.append_assoc, List.singleton_append, G, ← List.range_succ, RgE,
        econs' (2 * s + 1) (2 * μ + 2 * t - 1) (2 * μ) _ (by omega), esing, add_zero]
    obtain ⟨R0, hR0⟩ : ∃ R0, List.range (2 * t) = 0 :: R0 :=
      ⟨_, by rw [show 2 * t = 2 * s + 1 + 1 by omega, List.range_succ_eq_map]⟩
    have hE2 : ∀ W : List ℕ, edgeLengths (2 * μ :: (List.range (2 * t) ++ (2 * μ + 2 * t - 1) :: W)) =
        {2 * μ} + edgeLengths (List.range (2 * t) ++ (2 * μ + 2 * t - 1) :: W) := by
      intro W
      rw [hR0, List.cons_append, econs' (2 * μ) 0 (2 * μ) _ (by omega)]
    obtain ⟨T0, hT0⟩ := Zhead n (4 * μ :: 2 * μ :: (List.range (2 * t) ++
      (2 * μ + 2 * t - 1) :: (ldvUnits μ κ s ++ ldvRun (4 * μ + 2 * κ + 2) (N + 1)))) hn1
    have hE1 : edgeLengths (ldvList μ κ t n s (N + 1)) = {2 * μ + 2 * κ + 1} +
        edgeLengths (ldvZR μ t n ++ (4 * μ :: 2 * μ :: (List.range (2 * t) ++
          (2 * μ + 2 * t - 1) :: (ldvUnits μ κ s ++ ldvRun (4 * μ + 2 * κ + 2) (N + 1))))) := by
      unfold ldvList
      rw [hT0, econs' (4 * μ + 2 * κ + 2 * t + 1) (2 * μ + 2 * t) (2 * μ + 2 * κ + 1) _ (by omega)]
    rw [hE1, ZE n (4 * μ) _ (by omega), econs' (4 * μ) (2 * μ) (2 * μ) _ (by omega), hE2, G, hRb,
      hEbW, hEW]
  
  
  
  rw [show (y - 1) + (y - k + 1) + 2 * t + 1 = 4 * μ + 2 * κ + 2 * t + 2 by omega]
  refine ⟨ldvList μ κ t n s (N + 1), ⟨hperm, ?_⟩, ⟨Nat.even_iff.mpr (by omega), ?_⟩, ?_, ?_, ?_⟩
  · 
    unfold prescribedLengths
    rw [hedges, show y - 1 = 2 * n + (2 * s + 1) + 2 * s + N by omega,
      show y - k + 1 = 2 * n + 2 * s + 1 + 1 + 1 by omega, show y - k = 2 * μ by omega,
      show 2 * t = 2 * s + 1 + 1 by omega, hμ]
    simp only [Multiset.replicate_add, Multiset.replicate_one]
    abel
  · 
    intro j hj
    by_cases hjt : j < t
    · exact liftY _ _ (adjR (RgA (2 * t) (2 * j) (by omega)))
    · exact liftZ _ _ (adjc _ _ _ _ _ (ZA n _ (j - t) (by omega)) (by omega) (by omega))
  · 
    left
    unfold ldvList
    rw [show 4 * μ + 2 * κ + 2 * t + 2 - 1 = 4 * μ + 2 * κ + 2 * t + 1 by omega]
    rfl
  · 
    intro j hj1 hj2
    by_cases c1 : j ≤ s
    · exact liftW _ _ (adjc _ _ _ _ _ (UA s _ (s - j) (by omega)).1 (by omega) (by omega))
    by_cases c2 : j ≤ κ + 1
    · exact liftW _ _ (adjL (adjc _ _ _ _ _ (RA (4 * μ + 2 * κ + 2) (N + 1) (2 * j - 2 * t)
        (by omega)) (by omega) (by omega)))
    by_cases c3 : j ≤ κ + t
    · exact liftW _ _ (adjc _ _ _ _ _ (UA s _ (κ + t - j) (by omega)).2 (by omega) (by omega))
    · exact liftZ _ _ (adjsymm _ _ _ (adjc _ _ _ _ _ (ZB n (4 * μ) _ (by omega) (μ + κ - j)
        (by omega)) (by omega) (by omega)))
  · 
    intro he
    have := Nat.even_iff.mp he
    omega

theorem lowC1 : ∀ (y k : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (y - k) + 1 + 1) (prescribedLengths y k (y - 1) (y - k) 1) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (y - k) + 1 + 1) p :=
by
  intro y k hk hyk hy hk2
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjsymm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  obtain ⟨μ, hμ⟩ : ∃ μ, 2 * μ = y - k := ⟨(y - k) / 2, by omega⟩
  
  obtain ⟨hR, hRa, -, hRe⟩ := path_range y (by omega)
  
  obtain ⟨P1, hP1, hP10, hK1, -⟩ := bot_attach y y _ _ (by omega) le_rfl hR hRe
  
  obtain ⟨hQ, hQA, hQE⟩ := reflect_realization (y + 1) _ P1 hP1
  have hQadj : ∀ z : ℕ, z + 2 ≤ y → Adj (P1.map (fun x => y + 1 - 1 - x)) z (z + 1) := by
    intro z hz
    have h1 := hK1 (y - 2 - z) (hRa (y - 2 - z) (by omega))
    have h2 := hQA _ _ (by omega) (by omega) h1
    exact adjsymm _ _ _ (adjc _ _ _ _ _ h2 (by omega) (by omega))
  have hQend : IsEnd (P1.map (fun x => y + 1 - 1 - x)) y :=
    endc _ _ _ (hQE 0 (by omega) hP10) (by omega)
  
  obtain ⟨P, hP, hB, hK, hE⟩ := bot_pairs (y - k) (y + 1) μ _ _ (by omega) (by omega) (by omega)
    hQ (by
      intro i hi
      exact adjc _ _ _ _ _ (hQadj (y - k - 2 - 2 * i) (by omega)) rfl (by omega))
  have hL : Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y +
      Multiset.replicate (2 * μ) (y - k) = prescribedLengths y k (y - 1) (y - k) 1 := by
    unfold prescribedLengths
    rw [hμ]
    abel
  rw [show (y - 1) + (y - k) + 1 + 1 = y + 1 + 2 * μ by omega, ← hL]
  refine ⟨P, hP, ⟨Nat.even_iff.mpr (by omega), fun j hj => hB j (by omega)⟩, ⟨?_, ?_, ?_⟩⟩
  · exact endc _ _ _ (hE _ hQend) (by omega)
  · intro j hj1 hj2
    have h := hK (y - 2 * j) (hQadj _ (by omega)) (by intro i hi; omega)
    exact adjsymm _ _ _ (adjc _ _ _ _ _ h (by omega) (by omega))
  · intro he
    have := Nat.even_iff.mp he
    omega

theorem lowCodd : ∀ (y k t : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 1 ≤ t → 2 * t + 1 ≤ k → 2 * t + 1 + k ≤ y - k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (y - k) + (2 * t + 1) + 1) (prescribedLengths y k (y - 1) (y - k) (2 * t + 1)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (y - k) + (2 * t + 1) + 1) p :=
by
  
  have T1 : ∀ (c d : ℕ) (l : List ℕ), edgeLengths (c :: d :: l) =
      Int.natAbs ((d : ℤ) - c) ::ₘ edgeLengths (d :: l) := fun c d l => rfl
  have E1 : ∀ c : ℕ, edgeLengths [c] = 0 := fun c => rfl
  have T2 : ∀ (l₁ : List ℕ) (c : ℕ) (l₂ : List ℕ),
      edgeLengths (l₁ ++ c :: l₂) = edgeLengths (l₁ ++ [c]) + edgeLengths (c :: l₂) := by
    intro l₁ c l₂
    induction l₁ with
    | nil => rw [List.nil_append, List.nil_append, E1, zero_add]
    | cons d l₁ ih =>
      cases l₁ with
      | nil =>
        simp only [List.nil_append, List.cons_append]
        rw [T1, T1, E1, Multiset.cons_add, zero_add]
      | cons e l₁ =>
        simp only [List.cons_append] at ih ⊢
        rw [T1, T1, ih, Multiset.cons_add]
  
  have adjc : ∀ (l : List ℕ) (u w u' w' : ℕ), Adj l u w → u = u' → w = w' → Adj l u' w' := by
    rintro l u w u' w' h rfl rfl
    exact h
  have swap : ∀ (l : List ℕ) (u w : ℕ), Adj l u w → Adj l w u := by
    rintro l u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adjL : ∀ (p l : List ℕ) (u w : ℕ), Adj l u w → Adj (p ++ l) u w := by
    rintro p l u w ⟨l₁, l₂, rfl | rfl⟩
    · exact ⟨p ++ l₁, l₂, Or.inl (by simp)⟩
    · exact ⟨p ++ l₁, l₂, Or.inr (by simp)⟩
  have adjR : ∀ (l q : List ℕ) (u w : ℕ), Adj l u w → Adj (l ++ q) u w := by
    rintro l q u w ⟨l₁, l₂, rfl | rfl⟩
    · exact ⟨l₁, l₂ ++ q, Or.inl (by simp)⟩
    · exact ⟨l₁, l₂ ++ q, Or.inr (by simp)⟩
  have adjAt : ∀ (l₁ l₂ : List ℕ) (u w : ℕ), Adj (l₁ ++ u :: w :: l₂) u w :=
    fun l₁ l₂ u w => ⟨l₁, l₂, Or.inl rfl⟩
  have adjMem : ∀ (l : List ℕ) (u w : ℕ), Adj l u w → u ∈ l ∧ w ∈ l := by
    rintro l u w ⟨l₁, l₂, rfl | rfl⟩ <;> simp
  have consEq : ∀ (x x' : ℕ) (r : List ℕ), x = x' → x :: r = x' :: r := by
    rintro x x' r rfl
    rfl
  
  have GC : ∀ (f : ℕ → List ℕ) (h : ℕ → ℕ) (B : Multiset ℕ), (∀ i, ∃ r, f i = h i :: r) →
      (∀ i, edgeLengths (f i ++ [h (i + 1)]) = B) → ∀ (n : ℕ) (X : List ℕ),
      edgeLengths ((List.range n).flatMap f ++ h n :: X) = n • B + edgeLengths (h n :: X) ∧
      (∃ r, (List.range n).flatMap f ++ h n :: X = h 0 :: r) ∧
      (∀ i, i < n → ∀ u w, Adj (f i ++ [h (i + 1)]) u w →
        Adj ((List.range n).flatMap f ++ h n :: X) u w) := by
    intro f h B hf hB n
    induction n with
    | zero =>
      intro X
      exact ⟨by simp, ⟨X, by simp⟩, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
    | succ n ih =>
      intro X
      obtain ⟨r, hr⟩ := hf n
      have eq : (List.range (n + 1)).flatMap f ++ h (n + 1) :: X =
          (List.range n).flatMap f ++ h n :: (r ++ h (n + 1) :: X) := by
        rw [List.range_succ, List.flatMap_append, List.flatMap_singleton, List.append_assoc, hr,
          List.cons_append]
      obtain ⟨e, hd, ad⟩ := ih (r ++ h (n + 1) :: X)
      rw [eq]
      refine ⟨?_, hd, ?_⟩
      · rw [e, show h n :: (r ++ h (n + 1) :: X) = (h n :: r) ++ h (n + 1) :: X from rfl, T2, ← hr,
          hB, succ_nsmul, add_assoc]
      · intro i hi u w hadj
        rcases Nat.lt_or_ge i n with h' | h'
        · exact ad i h' u w hadj
        · have hin : i = n := by omega
          rw [hin] at hadj
          have e' : (List.range n).flatMap f ++ h n :: (r ++ h (n + 1) :: X) =
              (List.range n).flatMap f ++ ((f n ++ [h (n + 1)]) ++ X) := by
            rw [hr]; simp
          rw [e']
          exact adjL _ _ u w (adjR _ _ u w hadj)
  have LC : ∀ (f : ℕ → List ℕ) (c : ℕ), (∀ i, (f i).length = c) → ∀ n,
      ((List.range n).flatMap f).length = n * c := by
    intro f c hc n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [List.range_succ, List.flatMap_append, List.flatMap_singleton, List.length_append, ih, hc]
      ring
  
  intro y k t hk hyk hy hk2 ht h1 h2
  obtain ⟨m, rfl⟩ : ∃ m, y = m + k := ⟨y - k, by omega⟩
  have hv : (m + k - 1) + (m + k - k) + (2 * t + 1) + 1 = 2 * m + k + 2 * t + 1 := by omega
  rw [hv]
  obtain ⟨a, ha⟩ : ∃ a, k = 2 * t + 2 * a + 1 := ⟨(k - 1 - 2 * t) / 2, by omega⟩
  obtain ⟨b, hb⟩ : ∃ b, m = k + 2 * t + 2 * b + 1 := ⟨(m - k - 2 * t - 1) / 2, by omega⟩
  
  have Madd : ∀ x y z x' y' z' : ℕ,
      lcoM m k x y z + lcoM m k x' y' z' = lcoM m k (x + x') (y + y') (z + z') := by
    intro x y z x' y' z'
    simp only [lcoM, Multiset.replicate_add]
    abel
  have Msmul : ∀ n x y z : ℕ, n • lcoM m k x y z = lcoM m k (n * x) (n * y) (n * z) := by
    intro n x y z
    simp only [lcoM, smul_add, Multiset.nsmul_replicate]
  have Mkey : ∀ x y z x' y' z' : ℕ, x = x' → y = y' → z = z' →
      lcoM m k x y z = lcoM m k x' y' z' := by
    rintro x y z x' y' z' rfl rfl rfl
    rfl
  have s1 : ∀ (c d : ℕ) (l : List ℕ), Int.natAbs ((d : ℤ) - c) = 1 →
      edgeLengths (c :: d :: l) = lcoM m k 1 0 0 + edgeLengths (d :: l) := by
    intro c d l h
    rw [T1, h]
    simp [lcoM]
  have sm : ∀ (c d : ℕ) (l : List ℕ), Int.natAbs ((d : ℤ) - c) = m →
      edgeLengths (c :: d :: l) = lcoM m k 0 1 0 + edgeLengths (d :: l) := by
    intro c d l h
    rw [T1, h]
    simp [lcoM]
  have sy : ∀ (c d : ℕ) (l : List ℕ), Int.natAbs ((d : ℤ) - c) = m + k →
      edgeLengths (c :: d :: l) = lcoM m k 0 0 1 + edgeLengths (d :: l) := by
    intro c d l h
    rw [T1, h]
    simp [lcoM]
  
  have hBZ1 : ∀ i, edgeLengths (lcoZ1 m t i ++ [2 * t + 2 * (i + 1) + 1]) = lcoM m k 2 2 0 := by
    intro i
    simp only [lcoZ1, List.cons_append, List.nil_append]
    rw [sm, s1, sm, s1, E1]
    · simp only [Madd, add_zero]
    all_goals omega
  have hBZ2 : ∀ i, edgeLengths (lcoZ2 m k t i ++ [m + k + 2 * t + 2 * (i + 1) + 1]) =
      lcoM m k 2 2 0 := by
    intro i
    simp only [lcoZ2, List.cons_append, List.nil_append]
    rw [sm, s1, sm, s1, E1]
    · simp only [Madd, add_zero]
    all_goals omega
  have hBU : ∀ i, edgeLengths (lcoU m k i ++ [2 * m + 2 * (i + 1)]) = lcoM m k 4 4 2 := by
    intro i
    simp only [lcoU, List.cons_append, List.nil_append]
    rw [sm, sy, s1, sm, s1, sy, s1, sm, sm, s1, E1]
    · simp only [Madd, add_zero]
    all_goals omega
  have hBR0 : ∀ i, edgeLengths ([k + i] ++ [k + (i + 1)]) = lcoM m k 1 0 0 := by
    intro i
    rw [List.singleton_append, s1, E1, add_zero]
    omega
  have hBRR : ∀ i, edgeLengths ([2 * m + 2 * t + i] ++ [2 * m + 2 * t + (i + 1)]) =
      lcoM m k 1 0 0 := by
    intro i
    rw [List.singleton_append, s1, E1, add_zero]
    omega
  have GZ1 := GC (lcoZ1 m t) (fun i => 2 * t + 2 * i + 1) (lcoM m k 2 2 0) (fun i => ⟨_, rfl⟩) hBZ1
  have GR0 := GC (fun i => [k + i]) (fun i => k + i) (lcoM m k 1 0 0) (fun i => ⟨_, rfl⟩) hBR0
  have GZ2 := GC (lcoZ2 m k t) (fun i => m + k + 2 * t + 2 * i + 1) (lcoM m k 2 2 0)
    (fun i => ⟨_, rfl⟩) hBZ2
  have GU := GC (lcoU m k) (fun i => 2 * m + 2 * i) (lcoM m k 4 4 2) (fun i => ⟨_, rfl⟩) hBU
  have GRR := GC (fun i => [2 * m + 2 * t + i]) (fun i => 2 * m + 2 * t + i) (lcoM m k 1 0 0)
    (fun i => ⟨_, rfl⟩) hBRR
  
  obtain ⟨e6, ⟨r6, hr6⟩, ad6⟩ := GRR (2 * a) []
  beta_reduce at e6 hr6 ad6
  have hS6 : lcoS6 m t a = (2 * m + 2 * t) :: r6 := hr6.trans (consEq _ _ _ (by omega))
  have hE6 : edgeLengths (lcoS6 m t a) = (2 * a) • lcoM m k 1 0 0 := by
    rw [lcoS6, e6, E1, add_zero]
  
  obtain ⟨e5, ⟨r5, hr5⟩, ad5⟩ := GU t r6
  beta_reduce at e5 hr5 ad5
  have e5' : lcoS5 m k t a = (List.range t).flatMap (lcoU m k) ++ (2 * m + 2 * t) :: r6 := by
    rw [lcoS5, hS6]
  have hS5 : lcoS5 m k t a = (m + k + 2 * t + 2 * b + 1) :: r5 :=
    (e5'.trans hr5).trans (consEq _ _ _ (by omega))
  have hE5 : edgeLengths (lcoS5 m k t a) = t • lcoM m k 4 4 2 + edgeLengths (lcoS6 m t a) := by
    rw [e5', e5, hS6]
  
  obtain ⟨e4, ⟨r4, hr4⟩, ad4⟩ := GZ2 b r5
  beta_reduce at e4 hr4 ad4
  have e4' : lcoS4 m k t a b =
      (List.range b).flatMap (lcoZ2 m k t) ++ (m + k + 2 * t + 2 * b + 1) :: r5 := by
    rw [lcoS4, hS5]
  have hS4 : lcoS4 m k t a b = (m + k + 2 * t + 1) :: r4 :=
    (e4'.trans hr4).trans (consEq _ _ _ (by omega))
  have hE4 : edgeLengths (lcoS4 m k t a b) = b • lcoM m k 2 2 0 + edgeLengths (lcoS5 m k t a) := by
    rw [e4', e4, hS5]
  
  have hE3 : edgeLengths (lcoS3 m k t a b) =
      lcoM m k 0 1 0 + (lcoM m k 1 0 0 + edgeLengths (lcoS4 m k t a b)) := by
    rw [lcoS3, hS4, sm, s1]
    all_goals omega
  
  obtain ⟨e2, ⟨r2, hr2⟩, ad2⟩ := GR0 (2 * t) ((m + k + 2 * t) :: lcoS4 m k t a b)
  beta_reduce at e2 hr2 ad2
  have hS2 : lcoS2 m k t a b = (2 * t + 2 * a + 1) :: r2 :=
    (hr2 : lcoS2 m k t a b = _).trans (consEq _ _ _ (by omega))
  have hE2 : edgeLengths (lcoS2 m k t a b) =
      (2 * t) • lcoM m k 1 0 0 + edgeLengths (lcoS3 m k t a b) := e2
  
  obtain ⟨e1, ⟨r1, hr1⟩, ad1⟩ := GZ1 a r2
  beta_reduce at e1 hr1 ad1
  have e1' : lcoS1 m k t a b = (List.range a).flatMap (lcoZ1 m t) ++ (2 * t + 2 * a + 1) :: r2 := by
    rw [lcoS1, hS2]
  have hS1 : lcoS1 m k t a b = (2 * t + 1) :: r1 :=
    (e1'.trans hr1).trans (consEq _ _ _ (by omega))
  have hE1 : edgeLengths (lcoS1 m k t a b) = a • lcoM m k 2 2 0 + edgeLengths (lcoS2 m k t a b) := by
    rw [e1', e1, hS2]
  
  have hH : edgeLengths [2 * m + k + 2 * t, m + 2 * t, 2 * t, 2 * t + 1] = lcoM m k 1 1 1 := by
    rw [sy, sm, s1, E1]
    · simp only [Madd, add_zero]
    all_goals omega
  have hEL : edgeLengths (lcoList m k t a b) = lcoM m k 1 1 1 + edgeLengths (lcoS1 m k t a b) := by
    rw [lcoList, hS1, T2]
    simp only [List.cons_append, List.nil_append]
    rw [hH]
  have hE : edgeLengths (lcoList m k t a b) = lcoM m k (m + k - 1) m (2 * t + 1) := by
    rw [hEL, hE1, hE2, hE3, hE4, hE5, hE6]
    simp only [Msmul, Madd]
    apply Mkey <;> omega
  
  have hlen : (lcoList m k t a b).length = 2 * m + k + 2 * t + 1 := by
    simp only [lcoList, lcoS1, lcoS2, lcoS3, lcoS4, lcoS5, lcoS6, List.length_append,
      List.length_cons, List.length_nil]
    rw [LC (lcoZ1 m t) 4 (fun _ => rfl), LC (fun i => [k + i]) 1 (fun _ => rfl),
      LC (lcoZ2 m k t) 4 (fun _ => rfl), LC (lcoU m k) 10 (fun _ => rfl),
      LC (fun i => [2 * m + 2 * t + i]) 1 (fun _ => rfl)]
    omega
  
  have tr1 : ∀ u w, Adj (lcoS1 m k t a b) u w → Adj (lcoList m k t a b) u w :=
    fun u w h => adjL [2 * m + k + 2 * t, m + 2 * t, 2 * t] _ u w h
  have tr2 : ∀ u w, Adj (lcoS2 m k t a b) u w → Adj (lcoList m k t a b) u w :=
    fun u w h => tr1 u w (adjL ((List.range a).flatMap (lcoZ1 m t)) _ u w h)
  have tr3 : ∀ u w, Adj (lcoS3 m k t a b) u w → Adj (lcoList m k t a b) u w :=
    fun u w h => tr2 u w (adjL ((List.range (2 * t)).flatMap (fun i => [k + i])) _ u w h)
  have tr4 : ∀ u w, Adj (lcoS4 m k t a b) u w → Adj (lcoList m k t a b) u w :=
    fun u w h => tr3 u w (adjL [k + 2 * t, m + k + 2 * t] _ u w h)
  have tr5 : ∀ u w, Adj (lcoS5 m k t a) u w → Adj (lcoList m k t a b) u w :=
    fun u w h => tr4 u w (adjL ((List.range b).flatMap (lcoZ2 m k t)) _ u w h)
  have tr6 : ∀ u w, Adj (lcoS6 m t a) u w → Adj (lcoList m k t a b) u w :=
    fun u w h => tr5 u w (adjL ((List.range t).flatMap (lcoU m k)) _ u w h)
  have aZ1 : ∀ i, i < a → ∀ u w, Adj (lcoZ1 m t i ++ [2 * t + 2 * (i + 1) + 1]) u w →
      Adj (lcoList m k t a b) u w := by
    intro i hi u w h
    apply tr1
    rw [e1']
    exact ad1 i hi u w h
  have aR0 : ∀ i, i < 2 * t → ∀ u w, Adj ([k + i] ++ [k + (i + 1)]) u w →
      Adj (lcoList m k t a b) u w := by
    intro i hi u w h
    apply tr2
    exact ad2 i hi u w h
  have aZ2 : ∀ i, i < b → ∀ u w, Adj (lcoZ2 m k t i ++ [m + k + 2 * t + 2 * (i + 1) + 1]) u w →
      Adj (lcoList m k t a b) u w := by
    intro i hi u w h
    apply tr4
    rw [e4']
    exact ad4 i hi u w h
  have aU : ∀ i, i < t → ∀ u w, Adj (lcoU m k i ++ [2 * m + 2 * (i + 1)]) u w →
      Adj (lcoList m k t a b) u w := by
    intro i hi u w h
    apply tr5
    rw [e5']
    exact ad5 i hi u w h
  have aRR : ∀ i, i < 2 * a → ∀ u w, Adj ([2 * m + 2 * t + i] ++ [2 * m + 2 * t + (i + 1)]) u w →
      Adj (lcoList m k t a b) u w := by
    intro i hi u w h
    apply tr6
    exact ad6 i hi u w h
  have j0 : Adj (lcoList m k t a b) (2 * t) (2 * t + 1) := by
    rw [lcoList, hS1]
    exact adjAt [2 * m + k + 2 * t, m + 2 * t] r1 _ _
  have j3 : Adj (lcoList m k t a b) (m + k + 2 * t) (m + k + 2 * t + 1) := by
    apply tr3
    rw [lcoS3, hS4]
    exact adjAt [k + 2 * t] r4 _ _
  
  have hbot : ∀ j, 2 * j + 2 ≤ m → Adj (lcoList m k t a b) (2 * j) (2 * j + 1) := by
    intro j hj
    by_cases c1 : j < t
    · exact aU j c1 _ _ (adjAt [2 * m + 2 * j, m + 2 * j, 2 * m + k + 2 * j, 2 * m + k + 2 * j + 1,
        m + k + 2 * j + 1, m + k + 2 * j] _ (2 * j) (2 * j + 1))
    by_cases c2 : j = t
    · rw [c2]; exact j0
    by_cases c3 : 2 * j ≤ k - 1
    · obtain ⟨i, rfl⟩ : ∃ i, j = t + 1 + i := ⟨j - t - 1, by omega⟩
      exact adjc _ _ _ _ _ (aZ1 i (by omega) _ _ (adjAt [2 * t + 2 * i + 1, m + 2 * t + 2 * i + 1,
        m + 2 * t + 2 * i + 2] [] (2 * t + 2 * i + 2) (2 * t + 2 * (i + 1) + 1))) (by omega) (by omega)
    by_cases c4 : 2 * j ≤ k + 2 * t - 1
    · exact adjc _ _ _ _ _ (aR0 (2 * j - k) (by omega) _ _ (adjAt [] [] (k + (2 * j - k))
        (k + (2 * j - k + 1)))) (by omega) (by omega)
    · obtain ⟨i, hi⟩ : ∃ i, 2 * j = k + 2 * t + 2 * i + 1 := ⟨(2 * j - k - 2 * t - 1) / 2, by omega⟩
      exact adjc _ _ _ _ _ (aZ2 i (by omega) _ _ (adjAt [m + k + 2 * t + 2 * i + 1] _
        (k + 2 * t + 2 * i + 1) (k + 2 * t + 2 * i + 2))) (by omega) (by omega)
  
  have htop : ∀ j, 1 ≤ j → 2 * j + 1 ≤ m + k →
      Adj (lcoList m k t a b) (2 * m + k + 2 * t + 1 - 2 * j) (2 * m + k + 2 * t + 1 - 1 - 2 * j) := by
    intro j hj1 hj2
    suffices H : ∀ w, w = 2 * m + k + 2 * t - 2 * j → Adj (lcoList m k t a b) (w + 1) w by
      exact adjc _ _ _ _ _ (H _ rfl) (by omega) (by omega)
    intro w hw
    by_cases c1 : w ≤ m + k - 2
    · obtain ⟨i, hi⟩ : ∃ i, w = m + 2 * t + 2 * i + 1 := ⟨(w - m - 2 * t - 1) / 2, by omega⟩
      exact swap _ _ _ (adjc _ _ _ _ _ (aZ1 i (by omega) _ _ (adjAt [2 * t + 2 * i + 1] _
        (m + 2 * t + 2 * i + 1) (m + 2 * t + 2 * i + 2))) (by omega) (by omega))
    by_cases c2 : w ≤ m + k + 2 * t - 2
    · obtain ⟨i, hi⟩ : ∃ i, w = m + k + 2 * i := ⟨(w - m - k) / 2, by omega⟩
      exact adjc _ _ _ _ _ (aU i (by omega) _ _ (adjAt [2 * m + 2 * i, m + 2 * i, 2 * m + k + 2 * i,
        2 * m + k + 2 * i + 1] _ (m + k + 2 * i + 1) (m + k + 2 * i))) (by omega) (by omega)
    by_cases c3 : w = m + k + 2 * t
    · exact swap _ _ _ (adjc _ _ _ _ _ j3 (by omega) (by omega))
    by_cases c4 : w ≤ 2 * m - 1
    · obtain ⟨i, hi⟩ : ∃ i, w = m + k + 2 * t + 2 * i + 2 :=
        ⟨(w - m - k - 2 * t - 2) / 2, by omega⟩
      exact swap _ _ _ (adjc _ _ _ _ _ (aZ2 i (by omega) _ _ (adjAt [m + k + 2 * t + 2 * i + 1,
        k + 2 * t + 2 * i + 1, k + 2 * t + 2 * i + 2] [] (m + k + 2 * t + 2 * i + 2)
        (m + k + 2 * t + 2 * (i + 1) + 1))) (by omega) (by omega))
    by_cases c5 : w ≤ 2 * m + 2 * t - 1
    · obtain ⟨i, hi⟩ : ∃ i, w = 2 * m + 2 * i + 1 := ⟨(w - 2 * m - 1) / 2, by omega⟩
      exact swap _ _ _ (adjc _ _ _ _ _ (aU i (by omega) _ _ (adjAt [2 * m + 2 * i, m + 2 * i,
        2 * m + k + 2 * i, 2 * m + k + 2 * i + 1, m + k + 2 * i + 1, m + k + 2 * i, 2 * i, 2 * i + 1,
        m + 2 * i + 1] [] (2 * m + 2 * i + 1) (2 * m + 2 * (i + 1)))) (by omega) (by omega))
    by_cases c6 : w ≤ 2 * m + k - 2
    · obtain ⟨i, hi⟩ : ∃ i, w = 2 * m + 2 * t + i := ⟨w - 2 * m - 2 * t, by omega⟩
      exact swap _ _ _ (adjc _ _ _ _ _ (aRR i (by omega) _ _ (adjAt [] [] (2 * m + 2 * t + i)
        (2 * m + 2 * t + (i + 1)))) (by omega) (by omega))
    · obtain ⟨i, hi⟩ : ∃ i, w = 2 * m + k + 2 * i := ⟨(w - 2 * m - k) / 2, by omega⟩
      exact swap _ _ _ (adjc _ _ _ _ _ (aU i (by omega) _ _ (adjAt [2 * m + 2 * i, m + 2 * i] _
        (2 * m + k + 2 * i) (2 * m + k + 2 * i + 1))) (by omega) (by omega))
  
  have hcov : ∀ w, w < 2 * m + k + 2 * t + 1 → w ∈ lcoList m k t a b := by
    intro w hw
    by_cases c1 : w < m
    · have h := adjMem _ _ _ (hbot (w / 2) (by omega))
      rcases (show w = 2 * (w / 2) ∨ w = 2 * (w / 2) + 1 by omega) with h' | h'
      · rw [h']; exact h.1
      · rw [h']; exact h.2
    by_cases c2 : w < m + 2 * t
    · obtain ⟨i, hi⟩ : ∃ i, w = m + 2 * i ∨ w = m + 2 * i + 1 := ⟨(w - m) / 2, by omega⟩
      have hit : i < t := by omega
      rcases hi with hi | hi
      · rw [hi]
        exact (adjMem _ _ _ (aU i hit _ _ (adjAt [2 * m + 2 * i] _ (m + 2 * i) (2 * m + k + 2 * i)))).1
      · rw [hi]
        exact (adjMem _ _ _ (aU i hit _ _ (adjAt [2 * m + 2 * i, m + 2 * i, 2 * m + k + 2 * i,
          2 * m + k + 2 * i + 1, m + k + 2 * i + 1, m + k + 2 * i, 2 * i, 2 * i + 1] _
          (m + 2 * i + 1) (2 * m + 2 * i + 1)))).1
    by_cases c3 : w = m + 2 * t
    · rw [c3, lcoList]; simp
    by_cases c4 : w = 2 * m + k + 2 * t
    · rw [c4, lcoList]; simp
    · obtain ⟨j, hj⟩ : ∃ j, (w = 2 * m + k + 2 * t + 1 - 2 * j ∨
          w = 2 * m + k + 2 * t + 1 - 1 - 2 * j) ∧ 1 ≤ j ∧ 2 * j + 1 ≤ m + k :=
        ⟨(2 * m + k + 2 * t + 1 - w) / 2, by omega⟩
      have h := adjMem _ _ _ (htop j hj.2.1 hj.2.2)
      rcases hj.1 with h' | h'
      · rw [h']; exact h.1
      · rw [h']; exact h.2
  
  refine ⟨lcoList m k t a b, ⟨?_, ?_⟩, ⟨⟨m / 2, by omega⟩, fun j hj => hbot j (by omega)⟩,
    Or.inl ?_, htop, fun he => ?_⟩
  · show (lcoList m k t a b).Perm (List.range (2 * m + k + 2 * t + 1))
    exact ((List.subperm_of_subset List.nodup_range
      (fun w hw => hcov w (List.mem_range.mp hw))).perm_of_length_le
      (by rw [hlen, List.length_range])).symm
  · rw [hE]
    unfold prescribedLengths lcoM
    rw [show m + k - k = m by omega]
  · rw [show 2 * m + k + 2 * t + 1 - 1 = 2 * m + k + 2 * t by omega, lcoList, List.cons_append,
      List.head?_cons]
  · obtain ⟨r, hr⟩ := he
    omega

theorem lcwA_perm : ∀ μ : ℕ, 3 ≤ μ → (lcwA μ).Perm (List.range (6 * μ + 2)) :=
by
  intro μ hμ
  have hZlen : ∀ t n : ℕ, (lcwZ μ t n).length = 4 * n + 3 := by
    intro t n
    induction n with
    | zero => simp [lcwZ]
    | succ n ih =>
      simp only [lcwZ, List.length_append, List.range_succ, List.flatMap_append,
        List.flatMap_cons, List.flatMap_nil, List.append_nil, List.length_cons,
        List.length_nil] at ih ⊢
      omega
  have hZmem : ∀ t n x : ℕ, (2 * t ≤ x ∧ x ≤ 2 * t + 2 * n + 1) ∨
      (2 * μ + 2 * t ≤ x ∧ x ≤ 2 * μ + 2 * t + 2 * n) → x ∈ lcwZ μ t n := by
    intro t n x h
    unfold lcwZ
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · by_cases hx : x ≤ 2 * t + 1
      · apply List.mem_append_left
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
      · apply List.mem_append_right
        refine List.mem_flatMap.2 ⟨(x - 2 * t - 2) / 2, List.mem_range.2 (by omega), ?_⟩
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
    · by_cases hx : x = 2 * μ + 2 * t
      · apply List.mem_append_left
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
      · apply List.mem_append_right
        refine List.mem_flatMap.2 ⟨(x - 2 * μ - 2 * t - 1) / 2, List.mem_range.2 (by omega), ?_⟩
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
  have hlen : (lcwA μ).length = 6 * μ + 2 := by
    simp only [lcwA, List.length_append, List.length_cons, List.length_nil, List.length_map,
      List.length_range, hZlen]
    omega
  have hcov : ∀ x, x < 6 * μ + 2 → x ∈ lcwA μ := by
    intro x hx
    have hZ : (2 ≤ x ∧ x ≤ 2 * μ - 1) ∨ (2 * μ + 2 ≤ x ∧ x ≤ 4 * μ - 2) →
        x ∈ lcwZ μ 1 (μ - 2) := by
      intro h
      apply hZmem
      omega
    have hR : 4 * μ ≤ x → x ≤ 6 * μ - 2 →
        x ∈ (List.range (2 * μ - 1)).map (fun i => 6 * μ - 2 - i) := by
      intro h1 h2
      exact List.mem_map.2 ⟨6 * μ - 2 - x, List.mem_range.2 (by omega), by omega⟩
    have hT : x = 4 * μ - 1 ∨ x = 6 * μ - 1 ∨ x = 6 * μ ∨ x = 2 * μ + 1 ∨ x = 1 ∨ x = 0 ∨
        x = 2 * μ → x ∈ [4 * μ - 1, 6 * μ - 1, 6 * μ, 2 * μ + 1, 1, 0, 2 * μ] := by
      intro h
      simp only [List.mem_cons, List.not_mem_nil, or_false]
      exact h
    unfold lcwA
    rcases (show x = 6 * μ + 1 ∨ ((2 ≤ x ∧ x ≤ 2 * μ - 1) ∨ (2 * μ + 2 ≤ x ∧ x ≤ 4 * μ - 2)) ∨
        (4 * μ ≤ x ∧ x ≤ 6 * μ - 2) ∨ (x = 4 * μ - 1 ∨ x = 6 * μ - 1 ∨ x = 6 * μ ∨
          x = 2 * μ + 1 ∨ x = 1 ∨ x = 0 ∨ x = 2 * μ) by omega) with h | h | h | h
    · exact List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (by simp [h])))
    · exact List.mem_append_left _ (List.mem_append_left _ (List.mem_append_right _ (hZ h)))
    · exact List.mem_append_left _ (List.mem_append_right _ (hR h.1 h.2))
    · exact List.mem_append_right _ (hT h)
  have hsub : List.range (6 * μ + 2) ⊆ lcwA μ := fun x hx => hcov x (List.mem_range.1 hx)
  exact ((List.subperm_of_subset List.nodup_range hsub).perm_of_length_le
    (by rw [List.length_range, hlen])).symm

theorem lcwA_edges : ∀ μ : ℕ, 3 ≤ μ → edgeLengths (lcwA μ) = Multiset.replicate (4 * μ - 2) 1 + Multiset.replicate (2 * μ) (2 * μ) + Multiset.replicate 3 (4 * μ - 1) :=
by
  intro μ hμ
  have econs : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (a :: b :: l) =
      Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l) := fun a b l => rfl
  have esing : ∀ a : ℕ, edgeLengths [a] = 0 := fun a => rfl
  have econs' : ∀ (a b d : ℕ) (l : List ℕ), (a = b + d ∨ b = a + d) →
      edgeLengths (a :: b :: l) = {d} + edgeLengths (b :: l) := by
    intro a b d l h
    have hd : Int.natAbs ((b : ℤ) - (a : ℤ)) = d := by omega
    rw [econs, hd, Multiset.singleton_add]
  have ehead : ∀ (a b d : ℕ) (L : List ℕ), L.head? = some b → (a = b + d ∨ b = a + d) →
      edgeLengths (a :: L) = {d} + edgeLengths L := by
    intro a b d L h hd
    cases L with
    | nil => simp at h
    | cons c L =>
      simp only [List.head?_cons, Option.some.injEq] at h
      subst h
      exact econs' a c d L hd
  have rs : ∀ (m a : ℕ), Multiset.replicate (m + 1) a = Multiset.replicate m a + {a} := by
    intro m a
    rw [Multiset.replicate_succ, ← Multiset.singleton_add, add_comm]
  
  have Zsucc : ∀ t n, lcwZ μ t (n + 1) = lcwZ μ t n ++ [2 * μ + 2 * t + 2 * n + 1,
      2 * μ + 2 * t + 2 * n + 2, 2 * t + 2 * n + 2, 2 * t + 2 * n + 3] := by
    intro t n
    simp [lcwZ, List.range_succ, List.flatMap_append]
  have ZE : ∀ (t n : ℕ) (X : List ℕ), edgeLengths (lcwZ μ t n ++ X) =
      Multiset.replicate (2 * n + 1) (2 * μ) + Multiset.replicate (2 * n + 1) 1 +
        edgeLengths ((2 * t + 2 * n + 1) :: X) := by
    intro t n
    induction n with
    | zero =>
      intro X
      simp only [lcwZ, List.range_zero, List.flatMap_nil, List.append_nil, List.cons_append,
        List.nil_append]
      rw [econs' (2 * μ + 2 * t) (2 * t) (2 * μ) _ (by omega),
        econs' (2 * t) (2 * t + 1) 1 _ (by omega)]
      simp only [Nat.mul_zero, Nat.add_zero, Nat.zero_add, Multiset.replicate_one]
      abel
    | succ n ih =>
      intro X
      rw [Zsucc, List.append_assoc, ih]
      simp only [List.cons_append, List.nil_append]
      rw [econs' (2 * t + 2 * n + 1) (2 * μ + 2 * t + 2 * n + 1) (2 * μ) _ (by omega),
        econs' (2 * μ + 2 * t + 2 * n + 1) (2 * μ + 2 * t + 2 * n + 2) 1 _ (by omega),
        econs' (2 * μ + 2 * t + 2 * n + 2) (2 * t + 2 * n + 2) (2 * μ) _ (by omega),
        econs' (2 * t + 2 * n + 2) (2 * t + 2 * n + 3) 1 _ (by omega)]
      rw [show 2 * t + 2 * (n + 1) + 1 = 2 * t + 2 * n + 3 by ring]
      rw [show 2 * (n + 1) + 1 = 2 * n + 1 + 1 + 1 by ring, rs (2 * n + 1 + 1), rs (2 * n + 1),
        rs (2 * n + 1 + 1), rs (2 * n + 1)]
      abel
  
  have RE : ∀ (s N : ℕ) (X : List ℕ), N ≤ s →
      edgeLengths ((List.range (N + 1)).map (fun i => s - i) ++ X) =
        Multiset.replicate N 1 + edgeLengths ((s - N) :: X) := by
    intro s N
    induction N with
    | zero => intro X _; simp
    | succ N ih =>
      intro X h
      rw [List.range_succ, List.map_append, List.map_cons, List.map_nil, List.append_assoc,
        List.singleton_append, ih _ (by omega),
        econs' (s - N) (s - (N + 1)) 1 _ (by omega), rs]
      abel
  
  unfold lcwA
  rw [show 2 * μ - 1 = (2 * μ - 2) + 1 by omega]
  simp only [List.append_assoc, List.singleton_append, List.cons_append, List.nil_append]
  have h1 : (lcwZ μ 1 (μ - 2) ++ ((List.range (2 * μ - 2 + 1)).map (fun i => 6 * μ - 2 - i) ++
      [4 * μ - 1, 6 * μ - 1, 6 * μ, 2 * μ + 1, 1, 0, 2 * μ])).head? = some (2 * μ + 2) := by
    simp [lcwZ]
  rw [ehead (6 * μ + 1) (2 * μ + 2) (4 * μ - 1) _ h1 (by omega), ZE]
  have h2 : ((List.range (2 * μ - 2 + 1)).map (fun i => 6 * μ - 2 - i) ++
      [4 * μ - 1, 6 * μ - 1, 6 * μ, 2 * μ + 1, 1, 0, 2 * μ]).head? = some (6 * μ - 2) := by
    rw [List.range_succ_eq_map]
    simp
  rw [ehead _ (6 * μ - 2) (4 * μ - 1) _ h2 (by omega), RE _ _ _ (by omega)]
  rw [econs' (6 * μ - 2 - (2 * μ - 2)) (4 * μ - 1) 1 _ (by omega),
    econs' (4 * μ - 1) (6 * μ - 1) (2 * μ) _ (by omega),
    econs' (6 * μ - 1) (6 * μ) 1 _ (by omega),
    econs' (6 * μ) (2 * μ + 1) (4 * μ - 1) _ (by omega),
    econs' (2 * μ + 1) 1 (2 * μ) _ (by omega),
    econs' 1 0 1 _ (by omega),
    econs' 0 (2 * μ) (2 * μ) _ (by omega), esing]
  have c1 : Multiset.replicate (4 * μ - 2) 1 = Multiset.replicate (2 * (μ - 2) + 1) 1 +
      Multiset.replicate (2 * μ - 2) 1 + Multiset.replicate 3 1 := by
    rw [← Multiset.replicate_add, ← Multiset.replicate_add]
    congr 1
    omega
  have c2 : Multiset.replicate (2 * μ) (2 * μ) =
      Multiset.replicate (2 * (μ - 2) + 1) (2 * μ) + Multiset.replicate 3 (2 * μ) := by
    rw [← Multiset.replicate_add]
    congr 1
    omega
  have r3 : ∀ x : ℕ, Multiset.replicate 3 x = {x} + {x} + {x} := by
    intro x
    rw [show (3 : ℕ) = 1 + 1 + 1 from rfl, Multiset.replicate_add, Multiset.replicate_add,
      Multiset.replicate_one]
  rw [c1, c2]
  simp only [r3]
  abel

theorem lcwA_windows : ∀ μ : ℕ, 3 ≤ μ → (∀ j : ℕ, j < μ → Adj (lcwA μ) (2 * j) (2 * j + 1)) ∧ IsEnd (lcwA μ) (6 * μ + 1) ∧ (∀ j : ℕ, 1 ≤ j → j + 1 ≤ 2 * μ → Adj (lcwA μ) (6 * μ + 2 - 2 * j) (6 * μ + 1 - 2 * j)) :=
by
  intro μ hμ
  have infix_flatMap : ∀ (l : List ℕ) (f : ℕ → List ℕ) (a : ℕ), a ∈ l → f a <:+: l.flatMap f := by
    intro l f a ha
    induction l with
    | nil => simp at ha
    | cons b l ih =>
      rw [List.flatMap_cons]
      rcases List.mem_cons.1 ha with h | h
      · subst h; exact (List.prefix_append _ _).isInfix
      · exact (ih h).trans (List.suffix_append _ _).isInfix
  have infix_mapRange : ∀ (f : ℕ → ℕ) (N a : ℕ), a + 2 ≤ N →
      [f a, f (a + 1)] <:+: (List.range N).map f := by
    intro f N a h
    obtain ⟨d, rfl⟩ : ∃ d, N = a + 2 + d := ⟨N - (a + 2), by omega⟩
    clear h
    induction d with
    | zero =>
      refine ⟨(List.range a).map f, [], ?_⟩
      simp [List.range_succ]
    | succ d ih =>
      rw [show a + 2 + (d + 1) = (a + 2 + d) + 1 by omega, List.range_succ, List.map_append]
      exact ih.trans (List.prefix_append _ _).isInfix
  have adjF : ∀ (p : List ℕ) (u w : ℕ), [u, w] <:+: p → Adj p u w := by
    rintro p u w ⟨s, r, h⟩
    exact ⟨s, r, Or.inl (by rw [← h]; simp)⟩
  have adjR : ∀ (p : List ℕ) (u w : ℕ), [w, u] <:+: p → Adj p u w := by
    rintro p u w ⟨s, r, h⟩
    exact ⟨s, r, Or.inr (by rw [← h]; simp)⟩
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have hTA : [4 * μ - 1, 6 * μ - 1, 6 * μ, 2 * μ + 1, 1, 0, 2 * μ] <:+: lcwA μ := by
    unfold lcwA; exact (List.suffix_append _ _).isInfix
  have hRun : (List.range (2 * μ - 1)).map (fun i => 6 * μ - 2 - i) <:+: lcwA μ := by
    unfold lcwA; exact List.infix_append _ _ _
  have hZ : lcwZ μ 1 (μ - 2) <:+: lcwA μ := by
    unfold lcwA; exact (List.infix_append _ _ _).trans (List.prefix_append _ _).isInfix
  have hhead : [2 * μ + 2 * 1, 2 * 1, 2 * 1 + 1] <:+: lcwA μ := by
    refine List.IsInfix.trans ?_ hZ
    unfold lcwZ; exact (List.prefix_append _ _).isInfix
  have hblk : ∀ i, i < μ - 2 → [2 * μ + 2 * 1 + 2 * i + 1, 2 * μ + 2 * 1 + 2 * i + 2,
      2 * 1 + 2 * i + 2, 2 * 1 + 2 * i + 3] <:+: lcwA μ := by
    intro i hi
    refine List.IsInfix.trans ?_ hZ
    unfold lcwZ
    exact (infix_flatMap (List.range (μ - 2)) (fun i => [2 * μ + 2 * 1 + 2 * i + 1,
      2 * μ + 2 * 1 + 2 * i + 2, 2 * 1 + 2 * i + 2, 2 * 1 + 2 * i + 3]) i
      (List.mem_range.2 hi)).trans (List.suffix_append _ _).isInfix
  refine ⟨?_, ?_, ?_⟩
  · intro j hj
    rcases (show j = 0 ∨ j = 1 ∨ 2 ≤ j by omega) with rfl | rfl | h2
    · have h : [1, 0] <:+: lcwA μ :=
        List.IsInfix.trans ⟨[4 * μ - 1, 6 * μ - 1, 6 * μ, 2 * μ + 1], [2 * μ], rfl⟩ hTA
      exact adjc _ _ _ _ _ (adjR _ 0 1 h) (by omega) (by omega)
    · have h : [2 * 1, 2 * 1 + 1] <:+: lcwA μ :=
        List.IsInfix.trans ⟨[2 * μ + 2 * 1], [], rfl⟩ hhead
      exact adjc _ _ _ _ _ (adjF _ _ _ h) (by omega) (by omega)
    · have h : [2 * 1 + 2 * (j - 2) + 2, 2 * 1 + 2 * (j - 2) + 3] <:+: lcwA μ :=
        List.IsInfix.trans ⟨[2 * μ + 2 * 1 + 2 * (j - 2) + 1, 2 * μ + 2 * 1 + 2 * (j - 2) + 2], [],
          rfl⟩ (hblk (j - 2) (by omega))
      exact adjc _ _ _ _ _ (adjF _ _ _ h) (by omega) (by omega)
  · left
    unfold lcwA
    simp
  · intro j hj1 hj2
    rcases (show j = 1 ∨ (2 ≤ j ∧ j ≤ μ) ∨ j = μ + 1 ∨ (μ + 2 ≤ j ∧ j + 1 ≤ 2 * μ) by omega) with
      rfl | ⟨h1, h2⟩ | rfl | ⟨h1, h2⟩
    · have h : [6 * μ - 1, 6 * μ] <:+: lcwA μ :=
        List.IsInfix.trans ⟨[4 * μ - 1], [2 * μ + 1, 1, 0, 2 * μ], rfl⟩ hTA
      exact adjc _ _ _ _ _ (adjR _ (6 * μ) (6 * μ - 1) h) (by omega) (by omega)
    · have h := (infix_mapRange (fun i => 6 * μ - 2 - i) (2 * μ - 1) (2 * j - 4) (by omega)).trans hRun
      exact adjc _ _ _ _ _ (adjF _ _ _ h) (by omega) (by omega)
    · have h : Adj (lcwA μ) (6 * μ - 2 - (2 * μ - 2)) (4 * μ - 1) := by
        refine ⟨[6 * μ + 1] ++ lcwZ μ 1 (μ - 2) ++
          (List.range (2 * μ - 2)).map (fun i => 6 * μ - 2 - i),
          [6 * μ - 1, 6 * μ, 2 * μ + 1, 1, 0, 2 * μ], Or.inl ?_⟩
        unfold lcwA
        rw [show 2 * μ - 1 = (2 * μ - 2) + 1 by omega, List.range_succ, List.map_append]
        simp [List.append_assoc]
      exact adjc _ _ _ _ _ h (by omega) (by omega)
    · have h : [2 * μ + 2 * 1 + 2 * (2 * μ - 1 - j) + 1, 2 * μ + 2 * 1 + 2 * (2 * μ - 1 - j) + 2]
          <:+: lcwA μ :=
        List.IsInfix.trans ⟨[], [2 * 1 + 2 * (2 * μ - 1 - j) + 2, 2 * 1 + 2 * (2 * μ - 1 - j) + 3],
          rfl⟩ (hblk (2 * μ - 1 - j) (by omega))
      exact adjc _ _ _ _ _ (adjR _ _ _ h) (by omega) (by omega)

theorem lcwB_perm : ∀ μ t : ℕ, 2 ≤ t → 2 * t + 1 ≤ μ → (lcwB μ t).Perm (List.range (6 * μ + 2)) :=
by
  intro μ t ht hμ
  have hZlen : ∀ n : ℕ, (lcwZ μ t n).length = 4 * n + 3 := by
    intro n
    induction n with
    | zero => simp [lcwZ]
    | succ n ih =>
      simp only [lcwZ, List.length_append, List.range_succ, List.flatMap_append,
        List.flatMap_cons, List.flatMap_nil, List.append_nil, List.length_cons,
        List.length_nil] at ih ⊢
      omega
  have hUslen : ∀ n : ℕ, (lcwUs μ t n).length = 6 * n := by
    intro n
    induction n with
    | zero => simp [lcwUs]
    | succ n ih =>
      simp only [lcwUs, List.range_succ, List.reverse_append, List.reverse_cons,
        List.reverse_nil, List.nil_append, List.flatMap_append, List.flatMap_cons,
        List.flatMap_nil, List.append_nil, List.length_append, lcwUnit, List.length_cons,
        List.length_nil] at ih ⊢
      omega
  have hZmem : ∀ n x : ℕ, (2 * t ≤ x ∧ x ≤ 2 * t + 2 * n + 1) ∨
      (2 * μ + 2 * t ≤ x ∧ x ≤ 2 * μ + 2 * t + 2 * n) → x ∈ lcwZ μ t n := by
    intro n x h
    unfold lcwZ
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · by_cases hx : x ≤ 2 * t + 1
      · apply List.mem_append_left
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
      · apply List.mem_append_right
        refine List.mem_flatMap.2 ⟨(x - 2 * t - 2) / 2, List.mem_range.2 (by omega), ?_⟩
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
    · by_cases hx : x = 2 * μ + 2 * t
      · apply List.mem_append_left
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
      · apply List.mem_append_right
        refine List.mem_flatMap.2 ⟨(x - 2 * μ - 2 * t - 1) / 2, List.mem_range.2 (by omega), ?_⟩
        simp only [List.mem_cons, List.not_mem_nil, or_false]
        omega
  have hUsmem : ∀ n x j : ℕ, j < n → x ∈ lcwUnit μ t (j + 1) → x ∈ lcwUs μ t n := by
    intro n x j hj hx
    unfold lcwUs
    exact List.mem_flatMap.2 ⟨j, List.mem_reverse.2 (List.mem_range.2 hj), hx⟩
  have hlen : (lcwB μ t).length = 6 * μ + 2 := by
    simp only [lcwB, List.length_append, List.length_cons, List.length_nil, List.length_map,
      List.length_range, hZlen, hUslen]
    omega
  have hcov : ∀ x, x < 6 * μ + 2 → x ∈ lcwB μ t := by
    intro x hx
    have hB1 : x = 6 * μ + 1 → x ∈ [6 * μ + 1] := by
      intro h
      simp [h]
    have hZ : (2 * t ≤ x ∧ x ≤ 2 * μ - 1) ∨ (2 * μ + 2 * t ≤ x ∧ x ≤ 4 * μ - 2) →
        x ∈ lcwZ μ t (μ - t - 1) := by
      intro h
      apply hZmem
      omega
    have hR : 4 * μ + 2 * t - 1 ≤ x ∧ x ≤ 6 * μ - 2 * t →
        x ∈ (List.range (2 * μ + 2 - 4 * t)).map (fun i => 6 * μ - 2 * t - i) := by
      intro h
      exact List.mem_map.2 ⟨6 * μ - 2 * t - x, List.mem_range.2 (by omega), by omega⟩
    have hB4 : x = 2 * μ + 2 * t - 1 ∨ x = 2 * μ + 2 * t - 2 ∨ x = 4 * μ + 2 * t - 2 ∨
        x = 4 * μ + 2 * t - 3 ∨ x = 2 * μ + 2 * t - 3 →
        x ∈ [2 * μ + 2 * t - 1, 2 * μ + 2 * t - 2, 4 * μ + 2 * t - 2, 4 * μ + 2 * t - 3,
          2 * μ + 2 * t - 3] := by
      intro h
      simp only [List.mem_cons, List.not_mem_nil, or_false]
      exact h
    have hUs : (2 * μ + 1 ≤ x ∧ x ≤ 2 * μ + 2 * t - 4) ∨ (4 * μ + 1 ≤ x ∧ x ≤ 4 * μ + 2 * t - 4) ∨
        (6 * μ + 3 - 2 * t ≤ x ∧ x ≤ 6 * μ - 2) → x ∈ lcwUs μ t (t - 2) := by
      intro h
      rcases h with h | h | h
      · refine hUsmem (t - 2) x ((x - 2 * μ - 1) / 2) (by omega) ?_
        simp only [lcwUnit, List.mem_cons, List.not_mem_nil, or_false]
        omega
      · refine hUsmem (t - 2) x ((x - 4 * μ - 1) / 2) (by omega) ?_
        simp only [lcwUnit, List.mem_cons, List.not_mem_nil, or_false]
        omega
      · refine hUsmem (t - 2) x ((x - (6 * μ + 3 - 2 * t)) / 2) (by omega) ?_
        simp only [lcwUnit, List.mem_cons, List.not_mem_nil, or_false]
        omega
    have hB6 : x = 6 * μ + 2 - 2 * t ∨ x = 6 * μ + 1 - 2 * t ∨ x = 2 * μ →
        x ∈ [6 * μ + 2 - 2 * t, 6 * μ + 1 - 2 * t, 2 * μ] := by
      intro h
      simp only [List.mem_cons, List.not_mem_nil, or_false]
      exact h
    have hB7 : x < 2 * t → x ∈ List.range (2 * t) := fun h => List.mem_range.2 h
    have hB8 : x = 4 * μ ∨ x = 4 * μ - 1 ∨ x = 6 * μ - 1 ∨ x = 6 * μ →
        x ∈ [4 * μ, 4 * μ - 1, 6 * μ - 1, 6 * μ] := by
      intro h
      simp only [List.mem_cons, List.not_mem_nil, or_false]
      exact h
    simp only [lcwB, List.mem_append]
    rcases (show x = 6 * μ + 1 ∨
        ((2 * t ≤ x ∧ x ≤ 2 * μ - 1) ∨ (2 * μ + 2 * t ≤ x ∧ x ≤ 4 * μ - 2)) ∨
        (4 * μ + 2 * t - 1 ≤ x ∧ x ≤ 6 * μ - 2 * t) ∨
        (x = 2 * μ + 2 * t - 1 ∨ x = 2 * μ + 2 * t - 2 ∨ x = 4 * μ + 2 * t - 2 ∨
          x = 4 * μ + 2 * t - 3 ∨ x = 2 * μ + 2 * t - 3) ∨
        ((2 * μ + 1 ≤ x ∧ x ≤ 2 * μ + 2 * t - 4) ∨ (4 * μ + 1 ≤ x ∧ x ≤ 4 * μ + 2 * t - 4) ∨
          (6 * μ + 3 - 2 * t ≤ x ∧ x ≤ 6 * μ - 2)) ∨
        (x = 6 * μ + 2 - 2 * t ∨ x = 6 * μ + 1 - 2 * t ∨ x = 2 * μ) ∨
        x < 2 * t ∨
        (x = 4 * μ ∨ x = 4 * μ - 1 ∨ x = 6 * μ - 1 ∨ x = 6 * μ) by omega)
      with h | h | h | h | h | h | h | h
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (hB1 h)))))))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (hZ h)))))))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (hR h))))))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr (hB4 h)))))
    · exact Or.inl (Or.inl (Or.inl (Or.inr (hUs h))))
    · exact Or.inl (Or.inl (Or.inr (hB6 h)))
    · exact Or.inl (Or.inr (hB7 h))
    · exact Or.inr (hB8 h)
  have hsub : List.range (6 * μ + 2) ⊆ lcwB μ t := fun x hx => hcov x (List.mem_range.1 hx)
  exact ((List.subperm_of_subset List.nodup_range hsub).perm_of_length_le
    (by rw [List.length_range, hlen])).symm

theorem lcwB_edges : ∀ μ t : ℕ, 2 ≤ t → 2 * t + 1 ≤ μ → edgeLengths (lcwB μ t) = Multiset.replicate (4 * μ - 2 * t) 1 + Multiset.replicate (2 * μ) (2 * μ) + Multiset.replicate (2 * t + 1) (4 * μ + 1 - 2 * t) :=
by
  intro μ t ht hμ
  have econs : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (a :: b :: l) =
      Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l) := fun a b l => rfl
  have esing : ∀ a : ℕ, edgeLengths [a] = 0 := fun a => rfl
  have econs' : ∀ (a b d : ℕ) (l : List ℕ), (a = b + d ∨ b = a + d) →
      edgeLengths (a :: b :: l) = {d} + edgeLengths (b :: l) := by
    intro a b d l h
    have hd : Int.natAbs ((b : ℤ) - (a : ℤ)) = d := by omega
    rw [econs, hd, Multiset.singleton_add]
  have ehead2 : ∀ (a b d : ℕ) (L : List ℕ), (a = b + d ∨ b = a + d) → L.head? = some b →
      edgeLengths (a :: L) = {d} + edgeLengths L := by
    intro a b d L hd h
    cases L with
    | nil => simp at h
    | cons c L =>
      simp only [List.head?_cons, Option.some.injEq] at h
      subst h
      exact econs' a c d L hd
  have rs : ∀ (m a : ℕ), Multiset.replicate (m + 1) a = Multiset.replicate m a + {a} := by
    intro m a
    rw [Multiset.replicate_succ, ← Multiset.singleton_add, add_comm]
  
  have Zsucc : ∀ t n, lcwZ μ t (n + 1) = lcwZ μ t n ++ [2 * μ + 2 * t + 2 * n + 1,
      2 * μ + 2 * t + 2 * n + 2, 2 * t + 2 * n + 2, 2 * t + 2 * n + 3] := by
    intro t n
    simp [lcwZ, List.range_succ, List.flatMap_append]
  have Zhead : ∀ (t n : ℕ) (X : List ℕ), (lcwZ μ t n ++ X).head? = some (2 * μ + 2 * t) := by
    intro t n X
    simp [lcwZ]
  have ZE : ∀ (t n : ℕ) (X : List ℕ), edgeLengths (lcwZ μ t n ++ X) =
      Multiset.replicate (2 * n + 1) (2 * μ) + Multiset.replicate (2 * n + 1) 1 +
        edgeLengths ((2 * t + 2 * n + 1) :: X) := by
    intro t n
    induction n with
    | zero =>
      intro X
      simp only [lcwZ, List.range_zero, List.flatMap_nil, List.append_nil, List.cons_append,
        List.nil_append]
      rw [econs' (2 * μ + 2 * t) (2 * t) (2 * μ) _ (by omega),
        econs' (2 * t) (2 * t + 1) 1 _ (by omega)]
      simp only [Nat.mul_zero, Nat.add_zero, Nat.zero_add, Multiset.replicate_one]
      abel
    | succ n ih =>
      intro X
      rw [Zsucc, List.append_assoc, ih]
      simp only [List.cons_append, List.nil_append]
      rw [econs' (2 * t + 2 * n + 1) (2 * μ + 2 * t + 2 * n + 1) (2 * μ) _ (by omega),
        econs' (2 * μ + 2 * t + 2 * n + 1) (2 * μ + 2 * t + 2 * n + 2) 1 _ (by omega),
        econs' (2 * μ + 2 * t + 2 * n + 2) (2 * t + 2 * n + 2) (2 * μ) _ (by omega),
        econs' (2 * t + 2 * n + 2) (2 * t + 2 * n + 3) 1 _ (by omega)]
      rw [show 2 * t + 2 * (n + 1) + 1 = 2 * t + 2 * n + 3 by ring]
      rw [show 2 * (n + 1) + 1 = 2 * n + 1 + 1 + 1 by ring, rs (2 * n + 1 + 1), rs (2 * n + 1),
        rs (2 * n + 1 + 1), rs (2 * n + 1)]
      abel
  
  have Rhead : ∀ (s N : ℕ) (X : List ℕ),
      ((List.range (N + 1)).map (fun i => s - i) ++ X).head? = some s := by
    intro s N X
    rw [List.range_succ_eq_map]
    simp
  have RE : ∀ (s N : ℕ) (X : List ℕ), N ≤ s →
      edgeLengths ((List.range (N + 1)).map (fun i => s - i) ++ X) =
        Multiset.replicate N 1 + edgeLengths ((s - N) :: X) := by
    intro s N
    induction N with
    | zero => intro X _; simp
    | succ N ih =>
      intro X h
      rw [List.range_succ, List.map_append, List.map_cons, List.map_nil, List.append_assoc,
        List.singleton_append, ih _ (by omega),
        econs' (s - N) (s - (N + 1)) 1 _ (by omega), rs]
      abel
  
  have Ahead : ∀ (M : ℕ) (X : List ℕ), (List.range (M + 1) ++ X).head? = some 0 := by
    intro M X
    rw [List.range_succ_eq_map]
    simp
  have AE : ∀ (M : ℕ) (X : List ℕ),
      edgeLengths (List.range (M + 1) ++ X) = Multiset.replicate M 1 + edgeLengths (M :: X) := by
    intro M
    induction M with
    | zero => intro X; simp
    | succ M ih =>
      intro X
      rw [List.range_succ, List.append_assoc, List.singleton_append, ih,
        econs' M (M + 1) 1 _ (by omega), rs]
      abel
  
  have Usucc : ∀ n, lcwUs μ t (n + 1) = lcwUnit μ t (n + 1) ++ lcwUs μ t n := by
    intro n
    simp [lcwUs, List.range_succ]
  have Uhead : ∀ (n : ℕ) (X : List ℕ),
      (lcwUs μ t n ++ (6 * μ + 2 - 2 * t) :: X).head? = some (6 * μ + 2 - 2 * t + 2 * n) := by
    intro n X
    cases n with
    | zero => simp [lcwUs]
    | succ m =>
      rw [Usucc, List.append_assoc]
      simp [lcwUnit]
  have UE : ∀ (n : ℕ) (X : List ℕ),
      edgeLengths (lcwUs μ t n ++ (6 * μ + 2 - 2 * t) :: X) =
        Multiset.replicate (2 * n) 1 + Multiset.replicate (2 * n) (2 * μ) +
          Multiset.replicate (2 * n) (4 * μ + 1 - 2 * t) +
          edgeLengths ((6 * μ + 2 - 2 * t) :: X) := by
    intro n
    induction n with
    | zero => intro X; simp [lcwUs]
    | succ n ih =>
      intro X
      rw [Usucc, List.append_assoc]
      simp only [lcwUnit, List.cons_append, List.nil_append]
      rw [econs' (6 * μ + 2 - 2 * t + 2 * (n + 1)) (6 * μ + 1 - 2 * t + 2 * (n + 1)) 1 _
          (by omega),
        econs' (6 * μ + 1 - 2 * t + 2 * (n + 1)) (2 * μ + 2 * (n + 1)) (4 * μ + 1 - 2 * t) _
          (by omega),
        econs' (2 * μ + 2 * (n + 1)) (4 * μ + 2 * (n + 1)) (2 * μ) _ (by omega),
        econs' (4 * μ + 2 * (n + 1)) (4 * μ + 2 * (n + 1) - 1) 1 _ (by omega),
        econs' (4 * μ + 2 * (n + 1) - 1) (2 * μ + 2 * (n + 1) - 1) (2 * μ) _ (by omega),
        ehead2 (2 * μ + 2 * (n + 1) - 1) (6 * μ + 2 - 2 * t + 2 * n) (4 * μ + 1 - 2 * t) _
          (by omega) (Uhead n X), ih]
      rw [Multiset.ext]
      intro x
      simp only [Multiset.count_add, Multiset.count_replicate, Multiset.count_singleton]
      split_ifs <;> omega
  
  unfold lcwB
  obtain ⟨N, hN⟩ : ∃ N, 2 * μ + 2 - 4 * t = N + 1 := ⟨2 * μ + 1 - 4 * t, by omega⟩
  rw [hN, show List.range (2 * t) = List.range ((2 * t - 1) + 1) by congr 1; omega]
  simp only [List.append_assoc, List.singleton_append, List.cons_append, List.nil_append]
  rw [ehead2 (6 * μ + 1) (2 * μ + 2 * t) (4 * μ + 1 - 2 * t) _ (by omega) (Zhead _ _ _), ZE,
    ehead2 (2 * t + 2 * (μ - t - 1) + 1) (6 * μ - 2 * t) (4 * μ + 1 - 2 * t) _ (by omega)
      (Rhead _ _ _),
    RE _ _ _ (by omega),
    econs' (6 * μ - 2 * t - N) (2 * μ + 2 * t - 1) (2 * μ) _ (by omega),
    econs' (2 * μ + 2 * t - 1) (2 * μ + 2 * t - 2) 1 _ (by omega),
    econs' (2 * μ + 2 * t - 2) (4 * μ + 2 * t - 2) (2 * μ) _ (by omega),
    econs' (4 * μ + 2 * t - 2) (4 * μ + 2 * t - 3) 1 _ (by omega),
    econs' (4 * μ + 2 * t - 3) (2 * μ + 2 * t - 3) (2 * μ) _ (by omega),
    ehead2 (2 * μ + 2 * t - 3) (6 * μ + 2 - 2 * t + 2 * (t - 2)) (4 * μ + 1 - 2 * t) _
      (by omega) (Uhead _ _),
    UE,
    econs' (6 * μ + 2 - 2 * t) (6 * μ + 1 - 2 * t) 1 _ (by omega),
    econs' (6 * μ + 1 - 2 * t) (2 * μ) (4 * μ + 1 - 2 * t) _ (by omega),
    ehead2 (2 * μ) 0 (2 * μ) _ (by omega) (Ahead _ _), AE,
    econs' (2 * t - 1) (4 * μ) (4 * μ + 1 - 2 * t) _ (by omega),
    econs' (4 * μ) (4 * μ - 1) 1 _ (by omega),
    econs' (4 * μ - 1) (6 * μ - 1) (2 * μ) _ (by omega),
    econs' (6 * μ - 1) (6 * μ) 1 _ (by omega), esing]
  rw [Multiset.ext]
  intro x
  simp only [Multiset.count_add, Multiset.count_replicate, Multiset.count_singleton,
    Multiset.count_zero]
  split_ifs <;> omega

theorem lcwB_windows : ∀ μ t : ℕ, 2 ≤ t → 2 * t + 1 ≤ μ → (∀ j : ℕ, j < μ → Adj (lcwB μ t) (2 * j) (2 * j + 1)) ∧ IsEnd (lcwB μ t) (6 * μ + 1) ∧ (∀ j : ℕ, 1 ≤ j → j + t ≤ 2 * μ → Adj (lcwB μ t) (6 * μ + 2 - 2 * j) (6 * μ + 1 - 2 * j)) :=
by
  intro μ t ht hμ
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have s1 : ∀ (p : List ℕ) (u w : ℕ), ([u, w] <:+: p ∨ [w, u] <:+: p) → Adj p u w := by
    rintro p u w (⟨s, r, h⟩ | ⟨s, r, h⟩)
    · exact ⟨s, r, Or.inl (by rw [← h]; simp)⟩
    · exact ⟨s, r, Or.inr (by rw [← h]; simp)⟩
  have s2 : ∀ (l : List ℕ) (f : ℕ → List ℕ) (a : ℕ), a ∈ l → f a <:+: l.flatMap f := by
    intro l f a ha
    induction l with
    | nil => simp at ha
    | cons b l ih =>
      rw [List.flatMap_cons]
      rcases List.mem_cons.mp ha with rfl | h
      · exact (List.prefix_append _ _).isInfix
      · exact (ih h).trans (List.suffix_append _ _).isInfix
  have s3 : ∀ (f : ℕ → ℕ) (N a : ℕ), a + 2 ≤ N → [f a, f (a + 1)] <:+: (List.range N).map f := by
    intro f N a h
    obtain ⟨r, rfl⟩ : ∃ r, N = a + (2 + r) := ⟨N - a - 2, by omega⟩
    have h2 : List.range 2 = [0, 1] := rfl
    rw [List.range_add, List.range_add, h2]
    refine ⟨(List.range a).map f, (List.range r).map (fun x => f (a + (2 + x))), ?_⟩
    simp [Function.comp_def]
  have pre : ∀ l₁ l₂ l₃ : List ℕ, l₁ <:+: l₂ → l₁ <:+: l₂ ++ l₃ :=
    fun _ _ l₃ h => h.trans (List.prefix_append _ l₃).isInfix
  have hB8 : [4 * μ, 4 * μ - 1, 6 * μ - 1, 6 * μ] <:+: lcwB μ t := by
    unfold lcwB; exact (List.suffix_append _ _).isInfix
  have hB7 : List.range (2 * t) <:+: lcwB μ t := by
    unfold lcwB; exact List.infix_append _ _ _
  have hB6 : [6 * μ + 2 - 2 * t, 6 * μ + 1 - 2 * t, 2 * μ] <:+: lcwB μ t := by
    unfold lcwB; exact pre _ _ _ (List.infix_append _ _ _)
  have hUs : lcwUs μ t (t - 2) <:+: lcwB μ t := by
    unfold lcwB; exact pre _ _ _ (pre _ _ _ (List.infix_append _ _ _))
  have hB4 : [2 * μ + 2 * t - 1, 2 * μ + 2 * t - 2, 4 * μ + 2 * t - 2, 4 * μ + 2 * t - 3,
      2 * μ + 2 * t - 3] <:+: lcwB μ t := by
    unfold lcwB; exact pre _ _ _ (pre _ _ _ (pre _ _ _ (List.infix_append _ _ _)))
  have hRun : (List.range (2 * μ + 2 - 4 * t)).map (fun i => 6 * μ - 2 * t - i) <:+: lcwB μ t := by
    unfold lcwB; exact pre _ _ _ (pre _ _ _ (pre _ _ _ (pre _ _ _ (List.infix_append _ _ _))))
  have hZ : lcwZ μ t (μ - t - 1) <:+: lcwB μ t := by
    unfold lcwB
    exact pre _ _ _ (pre _ _ _ (pre _ _ _ (pre _ _ _ (pre _ _ _ (List.infix_append _ _ _)))))
  have hZh : [2 * μ + 2 * t, 2 * t, 2 * t + 1] <:+: lcwB μ t := by
    refine List.IsInfix.trans ?_ hZ
    unfold lcwZ; exact (List.prefix_append _ _).isInfix
  have hF : (List.range (μ - t - 1)).flatMap (fun i => [2 * μ + 2 * t + 2 * i + 1,
      2 * μ + 2 * t + 2 * i + 2, 2 * t + 2 * i + 2, 2 * t + 2 * i + 3]) <:+: lcwB μ t := by
    refine List.IsInfix.trans ?_ hZ
    unfold lcwZ; exact (List.suffix_append _ _).isInfix
  have hg : ∀ i : ℕ, i < μ - t - 1 → [2 * μ + 2 * t + 2 * i + 1,
      2 * μ + 2 * t + 2 * i + 2, 2 * t + 2 * i + 2, 2 * t + 2 * i + 3] <:+: lcwB μ t := by
    intro i hi
    exact (s2 (List.range (μ - t - 1)) (fun i => [2 * μ + 2 * t + 2 * i + 1,
      2 * μ + 2 * t + 2 * i + 2, 2 * t + 2 * i + 2, 2 * t + 2 * i + 3]) i
      (List.mem_range.mpr hi)).trans hF
  have hU : ∀ i : ℕ, i < t - 2 → lcwUnit μ t (i + 1) <:+: lcwB μ t := by
    intro i hi
    refine List.IsInfix.trans ?_ hUs
    exact s2 ((List.range (t - 2)).reverse) (fun j => lcwUnit μ t (j + 1)) i
      (by simp; omega)
  refine ⟨?_, ?_, ?_⟩
  · intro j hj
    rcases (show j < t ∨ j = t ∨ t + 1 ≤ j by omega) with h | h | h
    · have h1 := s3 id (2 * t) (2 * j) (by omega)
      rw [List.map_id] at h1
      exact s1 _ (2 * j) (2 * j + 1) (Or.inl (h1.trans hB7))
    · have h1 : [2 * t, 2 * t + 1] <:+: lcwB μ t :=
        (show [2 * t, 2 * t + 1] <:+: [2 * μ + 2 * t, 2 * t, 2 * t + 1] from
          ⟨[2 * μ + 2 * t], [], rfl⟩).trans hZh
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
    · obtain ⟨i, rfl⟩ : ∃ i, j = t + 1 + i := ⟨j - t - 1, by omega⟩
      have h1 : [2 * t + 2 * i + 2, 2 * t + 2 * i + 3] <:+: lcwB μ t :=
        (show [2 * t + 2 * i + 2, 2 * t + 2 * i + 3] <:+: [2 * μ + 2 * t + 2 * i + 1,
          2 * μ + 2 * t + 2 * i + 2, 2 * t + 2 * i + 2, 2 * t + 2 * i + 3] from
          ⟨[2 * μ + 2 * t + 2 * i + 1, 2 * μ + 2 * t + 2 * i + 2], [], rfl⟩).trans
          (hg i (by omega))
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
  · left
    simp [lcwB]
  · intro j hj1 hj2
    rcases (show j = 1 ∨ (2 ≤ j ∧ j + 1 ≤ t) ∨ j = t ∨ (t + 1 ≤ j ∧ j + t ≤ μ + 1) ∨
        j + t = μ + 2 ∨ (μ + 3 ≤ j + t ∧ j ≤ μ) ∨ j = μ + 1 ∨ μ + 2 ≤ j by omega)
      with h | h | h | h | h | h | h | h
    · 
      have h1 : [6 * μ - 1, 6 * μ] <:+: lcwB μ t :=
        (show [6 * μ - 1, 6 * μ] <:+: [4 * μ, 4 * μ - 1, 6 * μ - 1, 6 * μ] from
          ⟨[4 * μ, 4 * μ - 1], [], rfl⟩).trans hB8
      exact adjc _ _ _ _ _ (s1 _ (6 * μ) (6 * μ - 1) (Or.inr h1)) (by omega) (by omega)
    · 
      have h1 : [6 * μ + 2 - 2 * t + 2 * (t - j - 1 + 1), 6 * μ + 1 - 2 * t + 2 * (t - j - 1 + 1)]
          <:+: lcwB μ t :=
        (show [6 * μ + 2 - 2 * t + 2 * (t - j - 1 + 1), 6 * μ + 1 - 2 * t + 2 * (t - j - 1 + 1)]
          <:+: lcwUnit μ t (t - j - 1 + 1) from ⟨[], _, rfl⟩).trans (hU _ (by omega))
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
    · 
      have h1 : [6 * μ + 2 - 2 * t, 6 * μ + 1 - 2 * t] <:+: lcwB μ t :=
        (show [6 * μ + 2 - 2 * t, 6 * μ + 1 - 2 * t] <:+:
          [6 * μ + 2 - 2 * t, 6 * μ + 1 - 2 * t, 2 * μ] from ⟨[], [2 * μ], rfl⟩).trans hB6
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
    · 
      have h0 : [6 * μ - 2 * t - (2 * j - 2 * t - 2), 6 * μ - 2 * t - (2 * j - 2 * t - 2 + 1)] <:+:
          (List.range (2 * μ + 2 - 4 * t)).map (fun i => 6 * μ - 2 * t - i) :=
        s3 (fun i => 6 * μ - 2 * t - i) _ _ (by omega)
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl (h0.trans hRun))) (by omega) (by omega)
    · 
      have h1 : [4 * μ + 2 * t - 2, 4 * μ + 2 * t - 3] <:+: lcwB μ t :=
        (show [4 * μ + 2 * t - 2, 4 * μ + 2 * t - 3] <:+: [2 * μ + 2 * t - 1, 2 * μ + 2 * t - 2,
          4 * μ + 2 * t - 2, 4 * μ + 2 * t - 3, 2 * μ + 2 * t - 3] from
          ⟨[2 * μ + 2 * t - 1, 2 * μ + 2 * t - 2], [2 * μ + 2 * t - 3], rfl⟩).trans hB4
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
    · 
      have h1 : [4 * μ + 2 * (μ - j + 1), 4 * μ + 2 * (μ - j + 1) - 1] <:+: lcwB μ t :=
        (show [4 * μ + 2 * (μ - j + 1), 4 * μ + 2 * (μ - j + 1) - 1] <:+:
          lcwUnit μ t (μ - j + 1) from ⟨[_, _, _], [_], rfl⟩).trans (hU _ (by omega))
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
    · 
      have h1 : [4 * μ, 4 * μ - 1] <:+: lcwB μ t :=
        (show [4 * μ, 4 * μ - 1] <:+: [4 * μ, 4 * μ - 1, 6 * μ - 1, 6 * μ] from
          ⟨[], [6 * μ - 1, 6 * μ], rfl⟩).trans hB8
      exact adjc _ _ _ _ _ (s1 _ _ _ (Or.inl h1)) (by omega) (by omega)
    · 
      have h1 : [2 * μ + 2 * t + 2 * (2 * μ - t - j) + 1, 2 * μ + 2 * t + 2 * (2 * μ - t - j) + 2]
          <:+: lcwB μ t :=
        (show [2 * μ + 2 * t + 2 * (2 * μ - t - j) + 1, 2 * μ + 2 * t + 2 * (2 * μ - t - j) + 2]
          <:+: [2 * μ + 2 * t + 2 * (2 * μ - t - j) + 1, 2 * μ + 2 * t + 2 * (2 * μ - t - j) + 2,
            2 * t + 2 * (2 * μ - t - j) + 2, 2 * t + 2 * (2 * μ - t - j) + 3] from
          ⟨[], [_, _], rfl⟩).trans (hg _ (by omega))
      exact adjc _ _ _ _ _ (s1 _ (2 * μ + 2 * t + 2 * (2 * μ - t - j) + 2)
        (2 * μ + 2 * t + 2 * (2 * μ - t - j) + 1) (Or.inr h1)) (by omega) (by omega)

theorem lowCW : ∀ (y k t : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 1 ≤ t → 2 * t + k = (y - k) + 1 → 2 * t + 3 ≤ k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (y - k) + (2 * t + 1) + 1) (prescribedLengths y k (y - 1) (y - k) (2 * t + 1)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (y - k) + (2 * t + 1) + 1) p :=
by
  intro y k t hk hyk hy hk2 ht h2 h3
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  obtain ⟨μ, hμ⟩ : ∃ μ, y - k = 2 * μ := ⟨(y - k) / 2, by omega⟩
  have hyμ : y = 4 * μ + 1 - 2 * t := by omega
  have hμt : 2 * t + 1 ≤ μ := by omega
  have hv : (y - 1) + (y - k) + (2 * t + 1) + 1 = 6 * μ + 2 := by omega
  have e1 : y - 1 = 4 * μ - 2 * t := by omega
  have hL : prescribedLengths y k (y - 1) (y - k) (2 * t + 1) =
      Multiset.replicate (4 * μ - 2 * t) 1 + Multiset.replicate (2 * μ) (2 * μ) +
        Multiset.replicate (2 * t + 1) (4 * μ + 1 - 2 * t) := by
    unfold prescribedLengths
    rw [e1, hμ, hyμ]
  
  have assemble : ∀ p : List ℕ, (∀ j : ℕ, j < μ → Adj p (2 * j) (2 * j + 1)) →
      IsEnd p (6 * μ + 1) →
      (∀ j : ℕ, 1 ≤ j → j + t ≤ 2 * μ → Adj p (6 * μ + 2 - 2 * j) (6 * μ + 1 - 2 * j)) →
      BotPairInv (y - k) p ∧ TopEndInv y (6 * μ + 2) p := by
    intro p hbot hend htop
    refine ⟨⟨Nat.even_iff.mpr (by omega), fun j hj => hbot j (by omega)⟩,
      endc _ _ _ hend (by omega),
      fun j hj1 hj2 => adjc _ _ _ _ _ (htop j hj1 (by omega)) rfl (by omega),
      fun he => absurd (Nat.even_iff.mp he) (by omega)⟩
  rw [hv, hL]
  rcases Nat.lt_or_ge t 2 with htl | htg
  · obtain rfl : t = 1 := by omega
    obtain ⟨hbot, hend, htop⟩ := lcwA_windows μ (by omega)
    have hE := lcwA_edges μ (by omega)
    rw [show 4 * μ - 2 = 4 * μ - 2 * 1 by omega, show (3 : ℕ) = 2 * 1 + 1 by norm_num,
      show 4 * μ - 1 = 4 * μ + 1 - 2 * 1 by omega] at hE
    exact ⟨lcwA μ, ⟨lcwA_perm μ (by omega), hE⟩, assemble _ hbot hend htop⟩
  · obtain ⟨hbot, hend, htop⟩ := lcwB_windows μ t htg hμt
    exact ⟨lcwB μ t, ⟨lcwB_perm μ t htg hμt, lcwB_edges μ t htg hμt⟩, assemble _ hbot hend htop⟩

theorem lowCV : ∀ (y k t : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → (y - k) + 3 ≤ 2 * t + k → 2 * t + 3 ≤ k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (y - k) + (2 * t + 1) + 1) (prescribedLengths y k (y - 1) (y - k) (2 * t + 1)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (y - k) + (2 * t + 1) + 1) p :=
by
  intro y k t hk hyk hy hk2 h1 h2
  obtain ⟨κ, hκ⟩ : ∃ κ, k = 2 * κ + 1 := ⟨k / 2, by omega⟩
  obtain ⟨μ, hμ⟩ : ∃ μ, y = 2 * μ + 2 * κ + 1 := ⟨(y - k) / 2, by omega⟩
  obtain ⟨n, hn⟩ : ∃ n, μ = t + n := ⟨μ - t, by omega⟩
  obtain ⟨a, ha⟩ : ∃ a, t + κ = μ + a + 1 := ⟨t + κ - μ - 1, by omega⟩
  obtain ⟨b, hb⟩ : ∃ b, t = a + b + 2 := ⟨t - a - 2, by omega⟩
  obtain ⟨N, hN⟩ : ∃ N, 2 * κ + 3 = 2 * t + N := ⟨2 * κ + 3 - 2 * t, by omega⟩
  have hn1 : 1 ≤ n := by omega
  
  
  
  have econs : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (a :: b :: l) =
      Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l) := fun a b l => rfl
  have esing : ∀ a : ℕ, edgeLengths [a] = 0 := fun a => rfl
  have econs' : ∀ (a b d : ℕ) (l : List ℕ), (a = b + d ∨ b = a + d) →
      edgeLengths (a :: b :: l) = {d} + edgeLengths (b :: l) := by
    intro a b d l h
    have hd : Int.natAbs ((b : ℤ) - (a : ℤ)) = d := by omega
    rw [econs, hd, Multiset.singleton_add]
  have G : ∀ (A : List ℕ) (b : ℕ) (T : List ℕ),
      edgeLengths (A ++ b :: T) = edgeLengths (A ++ [b]) + edgeLengths (b :: T) := by
    intro A
    induction A with
    | nil => intro b T; simp [esing]
    | cons a A ih =>
      intro b T
      cases A with
      | nil =>
        simp only [List.nil_append, List.cons_append]
        rw [econs, econs, esing, Multiset.cons_add, zero_add]
      | cons c A' =>
        simp only [List.cons_append] at ih ⊢
        rw [econs, econs, ih, Multiset.cons_add]
  have rs : ∀ (m a : ℕ), Multiset.replicate (m + 1) a = Multiset.replicate m a + {a} := by
    intro m a
    rw [Multiset.replicate_succ, ← Multiset.singleton_add, add_comm]
  have rsplit : ∀ n a : ℕ, a + 1 < n → ∃ A B : List ℕ, List.range n = A ++ a :: (a + 1) :: B := by
    intro n a h
    obtain ⟨d, rfl⟩ : ∃ d, n = a + 2 + d := ⟨n - a - 2, by omega⟩
    refine ⟨List.range a, (List.range d).map (fun i => a + 2 + i), ?_⟩
    rw [List.range_add, List.range_succ, List.range_succ]
    simp
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjsymm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have adjL : ∀ {p l : List ℕ} {u w : ℕ}, Adj l u w → Adj (p ++ l) u w := by
    intro p l u w h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨p ++ l₁, l₂, Or.inl (by rw [h, List.append_assoc])⟩
    · exact ⟨p ++ l₁, l₂, Or.inr (by rw [h, List.append_assoc])⟩
  have adjR : ∀ {l q : List ℕ} {u w : ℕ}, Adj l u w → Adj (l ++ q) u w := by
    intro l q u w h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨l₁, l₂ ++ q, Or.inl (by rw [h]; simp)⟩
    · exact ⟨l₁, l₂ ++ q, Or.inr (by rw [h]; simp)⟩
