  have hv : (y - 1) + (1 + 2 * s) + ((y - k) + y - 1 - 4 * s) + 1 =
      y + 1 + 1 + 2 * s + 2 * s₂ + 2 * s₃ + 1 := by omega
  have hL : prescribedLengths y k (y - 1) (1 + 2 * s) ((y - k) + y - 1 - 4 * s) =
