theorem famIIm : ∀ (y k t : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 2 * t + 1 ≤ k → ∃ p : List ℕ, IsLinearRealization ((y - 1) + 1 + ((y - k) - 1 + 2 * t) + 1) (prescribedLengths y k (y - 1) 1 ((y - k) - 1 + 2 * t)) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + 1 + ((y - k) - 1 + 2 * t) + 1) p :=
by
  intro y k t hk hyk hy hk2 hH
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjsymm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  obtain ⟨r, hr⟩ : ∃ r, 2 * r + 2 = y - k := ⟨(y - k) / 2 - 1, by omega⟩
  
  obtain ⟨Q, hQ, hQa, hQb, hQ0, hQj⟩ := path_II (y + 1) (k + 1) (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, hA1, hK1, hE1⟩ := top_pairs y (y + 1) t _ Q (by omega) (by omega)
    (by omega) hQ (by
      intro i hi
      exact adjc _ _ _ _ _ (hQa (2 * i + 1) (by omega)) (by omega) (by omega))
  
  obtain ⟨p₂, hp₂, hA2, hK2, hE2⟩ := bot_pairs y (y + 1 + 2 * t) r _ p₁ (by omega)
    (by omega) (by omega) hp₁ (by
      intro i hi
      have h := hK1 (y - 2 - 2 * i) (hQb _ (by omega) (by omega)) (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h rfl (by omega))
  have hEnd : IsEnd p₂ (y - 1) := by
    have h := hE2 _ (hE1 _ hQj)
    exact endc _ _ _ h (by omega)
  
  obtain ⟨p₃, hp₃, hE30, hK3, -⟩ :=
    bot_attach y (y + 1 + 2 * t + 2 * r) _ p₂ (by omega) (by omega) hp₂ hEnd
  
  obtain ⟨hR, hRA, hRE⟩ := reflect_realization (y + 1 + 2 * t + 2 * r + 1) _ p₃ hp₃
  have hL : Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - (k + 1)) +
      Multiset.replicate (2 * t) y + Multiset.replicate (2 * r) y + Multiset.replicate 1 y =
      prescribedLengths y k (y - 1) 1 ((y - k) - 1 + 2 * t) := by
    have hc' : Multiset.replicate ((y - k) - 1 + 2 * t) y = Multiset.replicate (2 * t) y +
        Multiset.replicate (2 * r) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - (k + 1) = y - k by omega]
    unfold prescribedLengths
    rw [hc']
    abel
  rw [show (y - 1) + 1 + ((y - k) - 1 + 2 * t) + 1 = y + 1 + 2 * t + 2 * r + 1 by omega, ← hL]
  refine ⟨_, hR, ⟨Nat.even_iff.mpr (by omega), ?_⟩, ⟨?_, ?_, ?_⟩⟩
  · intro j hj
    have hw : Adj p₁ (y - 1 + 2 * t - 2 * j) (y - 1 + 2 * t - 2 * j + 1) := by
      by_cases hjt : j < t
      · have h := hA1 (t - 1 - j) (by omega)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
      · have h := hK1 (y - 1 + 2 * t - 2 * j) (hQb _ (by omega) (by omega))
          (by intro i hi; omega)
        exact h
    have h2 := hK2 _ hw (by intro i hi; omega)
    have h3 := hK3 _ h2
    have h5 := hRA _ _ (by omega) (by omega) h3
    exact adjsymm _ _ _ (adjc _ _ _ _ _ h5 (by omega) (by omega))
  · have h := hRE 0 (by omega) hE30
    exact endc _ _ _ h (by omega)
  · intro j hj1 hj2
    have hw : Adj p₂ (2 * j - 2) (2 * j - 2 + 1) := by
