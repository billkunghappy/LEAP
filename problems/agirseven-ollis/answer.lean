theorem bOE_c0 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → b % 2 = 1 → c = 0 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  intro y k b c hk hyk hy hk2 hb hb2 hc
  subst hc
  
  have hadj : ∀ (P : List ℕ) (i : ℕ) (h : i + 1 < P.length), Adj P P[i] P[i + 1] := by
    intro P i h
    refine ⟨P.take i, P.drop (i + 2), Or.inl ?_⟩
    have e1 : P.drop i = P[i] :: P[i + 1] :: P.drop (i + 2) := by
      rw [List.drop_eq_getElem_cons (by omega), List.drop_eq_getElem_cons h]
    rw [← e1, List.take_append_drop]
  have hswap : ∀ (P : List ℕ) (u w : ℕ), Adj P u w → Adj P w u := by
    rintro P u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  
  have seed : ∀ d : ℕ, ∃ P : List ℕ,
      IsLinearRealization (k + 3 + d + 4)
        (Multiset.replicate (k + 3 + d) 1 + Multiset.replicate 3 (d + 3)) P ∧
      (∀ x : ℕ, x + 1 ≤ k → Adj P x (x + 1)) ∧
      (∀ x : ℕ, k + 3 ≤ x → x + 1 ≤ k + 3 + d → Adj P x (x + 1)) ∧
      Adj P (k + 1) (k + 2) ∧ IsEnd P 0 := by
    intro d
    obtain ⟨f, hf⟩ : ∃ f : ℕ → ℕ, ∀ i, f i =
        if i < k + 1 then i else if i < k + d + 2 then k + d + 3 - (i - (k + 1))
        else if i = k + d + 2 then k + d + 6 else if i = k + d + 3 then k + d + 5
        else if i = k + d + 4 then k + d + 4 else if i = k + d + 5 then k + 1 else k + 2 :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨g, hg⟩ : ∃ g : ℕ → ℕ, ∀ i, g i =
        if i = k ∨ i = k + d + 1 ∨ i = k + d + 4 then d + 3 else 1 := ⟨_, fun _ => rfl⟩
    
    have hv1 : ∀ i, i < k + 1 → f i = i := by
      intro i h1; rw [hf]; split_ifs <;> omega
    have hv2 : ∀ i, k + 1 ≤ i → i < k + d + 2 → f i = k + d + 3 - (i - (k + 1)) := by
      intro i h1 h2; rw [hf]; split_ifs <;> omega
    have hv3 : f (k + d + 5) = k + 1 := by rw [hf]; split_ifs <;> omega
    have hv4 : f (k + d + 6) = k + 2 := by rw [hf]; split_ifs <;> omega
    have hfb : ∀ i, i < k + d + 7 → f i < k + d + 7 := by
      intro i h1; rw [hf]; split_ifs <;> omega
    have hfinj : ∀ i j, i < j → j < k + d + 7 → f i ≠ f j := by
      intro i j h1 h2; rw [hf, hf]; split_ifs <;> omega
    have hfg : ∀ i, i < k + d + 6 → Int.natAbs ((f (i + 1) : ℤ) - (f i : ℤ)) = g i := by
      intro i h1
      rw [hf, hf, hg, Int.natAbs_eq_iff]
      split_ifs <;> omega
    obtain ⟨P, hPdef⟩ : ∃ P : List ℕ, P = List.range (k + 1) ++
        (List.range (d + 1)).map (fun i => k + d + 3 - i) ++
        [k + d + 6, k + d + 5, k + d + 4, k + 1, k + 2] := ⟨_, rfl⟩
    have hlen : P.length = k + d + 7 := by
      rw [hPdef]; simp; omega
    have hP : ∀ (i : ℕ) (h : i < P.length), P[i] = f i := by
      intro i h
      have h' : i < k + d + 7 := by omega
      rw [hf]
      subst hPdef
      simp only [List.getElem_append, List.getElem_range, List.getElem_map, List.length_range,
        List.length_map, List.length_append, List.getElem_cons, List.length_cons, List.length_nil]
      split_ifs <;> omega
    refine ⟨P, ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · 
      show P.Perm (List.range (k + 3 + d + 4))
      have hnd : P.Nodup := by
        rw [List.Nodup, List.pairwise_iff_getElem]
        intro i j hi hj hij
        rw [hP i hi, hP j hj]
        exact hfinj i j hij (by omega)
      have hsub : P ⊆ List.range (k + 3 + d + 4) := by
        intro z hz
        rw [List.mem_iff_getElem] at hz
        obtain ⟨i, hi, rfl⟩ := hz
        rw [List.mem_range, hP i hi]
        have := hfb i (by omega)
        omega
      exact (List.subperm_of_subset hnd hsub).perm_of_length_le (by simp; omega)
    · 
      have htg : ∀ (i : ℕ) (h : i < (List.replicate k 1 ++ (d + 3) ::
          (List.replicate d 1 ++ [d + 3, 1, 1, d + 3, 1])).length),
          (List.replicate k 1 ++ (d + 3) :: (List.replicate d 1 ++ [d + 3, 1, 1, d + 3, 1]))[i]
            = g i := by
        intro i h
        simp only [List.length_append, List.length_replicate, List.length_cons,
          List.length_nil] at h
        rw [hg]
        simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
          List.length_replicate, List.length_append, List.length_cons, List.length_nil]
        split_ifs <;> omega
      have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (P.map (fun a : ℕ => (a : ℤ))) (P.tail.map (fun a : ℕ => (a : ℤ))) =
          List.replicate k 1 ++ (d + 3) :: (List.replicate d 1 ++ [d + 3, 1, 1, d + 3, 1]) := by
        apply List.ext_getElem
        · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
            List.length_append, List.length_replicate, List.length_cons, List.length_nil]
          omega
