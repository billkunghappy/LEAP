    intro x hx1 hx2
    by_cases h : x + 2 ≤ s
    · exact hlo x h
    · exact hhi x (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, -, hS₁, hE₁⟩ := bot_pairs (y - k) (s + d) t _ _ (by omega) (by omega)
    (by omega) hR (fun i hi =>
      adj_cast _ _ _ _ _ rfl (by omega) (SR (y - k - 2 - 2 * i) (by omega) (by omega)))
  
  obtain ⟨p₂, hp₂, -, hS₂, hE₂⟩ := bot_attach (y - k) (s + d + 2 * t) _ p₁ (by omega)
    (by omega) hp₁ (by rw [show y - k - 1 = s + 2 * t by omega]; exact hE₁ _ hEs)
  
  obtain ⟨p₃, hp₃, hN₃, hK₃, hE₃⟩ := top_pairs y (s + d + 2 * t + 1) 3 _ p₂
    (by omega) (by omega) (by omega) hp₂ (fun i hi => by
