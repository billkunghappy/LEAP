      (∀ x : ℕ, x + 2 ≤ s → Adj ((List.range d).map (fun i => s + i) ++ List.range s) x (x + 1)) ∧
      (∀ x : ℕ, s ≤ x → x + 2 ≤ s + d →
        Adj ((List.range d).map (fun i => s + i) ++ List.range s) x (x + 1)) ∧
      IsEnd ((List.range d).map (fun i => s + i) ++ List.range s) s ∧
      IsEnd ((List.range d).map (fun i => s + i) ++ List.range s) (s - 1) := by
    intro s d hs hd
    refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · show List.Perm _ _
      have h1 : List.range (s + d) = List.range s ++
          List.map (fun x => s + x) (List.range d) := List.range_add
      rw [h1]
      exact List.perm_append_comm
    · have hlen : ((List.range d).map (fun i => s + i) ++ List.range s).length = d + s := by
        simp
      have hQ : ∀ (i : ℕ) (h : i < ((List.range d).map (fun i => s + i) ++ List.range s).length),
          ((List.range d).map (fun i => s + i) ++ List.range s)[i] =
            if i < d then s + i else i - d := by
        intro i h
        simp only [List.getElem_append, List.getElem_map, List.getElem_range, List.length_map,
          List.length_range]
        split_ifs <;> first | rfl | omega
      have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (((List.range d).map (fun i => s + i) ++ List.range s).map (fun a : ℕ => (a : ℤ)))
          (((List.range d).map (fun i => s + i) ++ List.range s).tail.map (fun a : ℕ => (a : ℤ))) =
          List.replicate (d - 1) 1 ++ (s + d - 1) :: List.replicate (s - 1) 1 := by
        apply List.ext_getElem
        · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
            List.length_append, List.length_replicate, List.length_cons]
          omega
        · intro i h1 h2
          simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
          rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail, hQ, hQ]
          simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
            List.length_replicate]
          rw [Int.natAbs_eq_iff]
          split_ifs <;> omega
      have he : edgeLengths ((List.range d).map (fun i => s + i) ++ List.range s) =
          ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (((List.range d).map (fun i => s + i) ++ List.range s).map (fun a : ℕ => (a : ℤ)))
          (((List.range d).map (fun i => s + i) ++ List.range s).tail.map
            (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
        unfold edgeLengths
        simp only [List.map_eq_flatMap]
        rfl
      rw [he, hl, ← Multiset.coe_add, ← Multiset.cons_coe, Multiset.coe_replicate,
        Multiset.coe_replicate, show s + d - 2 = (d - 1) + (s - 1) by omega,
        Multiset.replicate_add, Multiset.replicate_one, ← Multiset.singleton_add]
      abel
    · intro x hx
      obtain ⟨r, rfl⟩ : ∃ r, s = x + 2 + r := ⟨s - x - 2, by omega⟩
      refine ⟨(List.range d).map (fun i => x + 2 + r + i) ++ List.range x,
        List.map (fun i => x + 2 + i) (List.range r), Or.inl ?_⟩
      have hR : List.range (x + 2 + r) = List.range (x + 2) ++
          List.map (fun i => x + 2 + i) (List.range r) := List.range_add
      have hS : List.range (x + 2) = List.range x ++ [x, x + 1] := by
        simp [List.range_succ]
      rw [hR, hS]
      simp [List.append_assoc]
    · intro x hx1 hx2
      obtain ⟨e, rfl⟩ : ∃ e, x = s + e := ⟨x - s, by omega⟩
      obtain ⟨r, rfl⟩ : ∃ r, d = e + 2 + r := ⟨d - e - 2, by omega⟩
      refine ⟨List.map (fun i => s + i) (List.range e),
        List.map (fun i => s + i) (List.map (fun i => e + 2 + i) (List.range r)) ++ List.range s,
        Or.inl ?_⟩
      have hR : List.range (e + 2 + r) = List.range (e + 2) ++
          List.map (fun i => e + 2 + i) (List.range r) := List.range_add
      have hS : List.range (e + 2) = List.range e ++ [e, e + 1] := by
        simp [List.range_succ]
      rw [hR, hS]
      simp [List.append_assoc, add_assoc]
    · left
      obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
      rw [List.range_succ_eq_map]
      simp
    · right
      obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
      rw [List.range_succ, ← List.append_assoc, List.getLast?_concat]
      simp
  
  obtain ⟨t, rfl⟩ : ∃ t, b = 2 * t + 2 := ⟨b / 2 - 1, by omega⟩
  obtain ⟨s, hs⟩ : ∃ s, s = y - k - (2 * t + 2) + 1 := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d, y + 1 = s + d := ⟨y + 1 - s, by omega⟩
  obtain ⟨hR, hlo, hhi, hEs, hEs1⟩ := rot s d (by omega) (by omega)
  have SR : ∀ x : ℕ, x + 1 ≤ y → x ≠ s - 1 →
