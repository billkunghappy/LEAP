          omega
        · rw [hfA i (by omega) (by omega), hfB (i + 1) (by omega), Int.natAbs_eq_iff]
          omega
        · rcases Nat.lt_or_gt_of_ne hb with hc | hc
          · rw [hfA i (by omega) (by omega), hfA (i + 1) (by omega) (by omega), Int.natAbs_eq_iff]
            omega
          · rw [hfB i hc, hfB (i + 1) (by omega), Int.natAbs_eq_iff]
            omega
    have he : edgeLengths ((List.range (y + 1 + 1)).map f) =
        ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        (((List.range (y + 1 + 1)).map f).map (fun a : ℕ => (a : ℤ)))
        (((List.range (y + 1 + 1)).map f).tail.map (fun a : ℕ => (a : ℤ))) : List ℕ) :
          Multiset ℕ) := by
      unfold edgeLengths
      simp only [List.map_eq_flatMap]
      rfl
    refine ⟨(List.range (y + 1 + 1)).map f, ⟨hperm, ?_⟩, ?_, ?_⟩
    · rw [he, hlist]
      rw [show y - 1 = (m - 1) + k by omega, Multiset.replicate_add]
      simp only [← Multiset.cons_coe, ← Multiset.coe_add, Multiset.coe_replicate,
