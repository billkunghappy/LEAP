        exact adjc _ _ _ _ _ h rfl (by omega))
    have hEnd : IsEnd p₂ (y - k - 1) := by
      have h := hE2 _ (hE1 _ hQ2)
      rwa [show 2 + 2 * s = y - k - 1 by omega] at h
    obtain ⟨p₃, hp₃, hE30, hK3, -⟩ :=
      bot_attach (y - k) (y - k + 2 + 2 * u + 2 * s) _ p₂ (by omega) (by omega) hp₂ hEnd
    have hv : y - k + 2 + 2 * u + 2 * s + 1 = y - k + (y - k + r) + 0 + 1 := by omega
    have hL : Multiset.replicate (y - k) 1 + Multiset.replicate 1 (y - k) +
        Multiset.replicate (2 * u) (y - k) + Multiset.replicate (2 * s) (y - k) +
        Multiset.replicate 1 (y - k) = prescribedLengths y k (y - k) (y - k + r) 0 := by
      have hb' : Multiset.replicate (y - k + r) (y - k) =
          Multiset.replicate 1 (y - k) + Multiset.replicate (2 * u) (y - k) +
          Multiset.replicate (2 * s) (y - k) + Multiset.replicate 1 (y - k) := by
        rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
        congr 1
        omega
      unfold prescribedLengths
      rw [hb', Multiset.replicate_zero]
      abel
    rw [hv, hL] at hp₃
    have hBE : BotEndInv (y - k) p₃ := by
      refine ⟨hE30, ?_, fun he => absurd he hnotEven⟩
      intro j hj1 hj2
      by_cases hA : j - 1 < s
      · have h := hK3 _ (hC2 (j - 1) hA)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
      · have h1 := hK1 0 (hQa 0 (by omega)) (by intro i' hi'; omega)
        have h2 := hK2 0 h1 (by intro i hi; omega)
        have h3 := hK3 _ h2
        exact adjc _ _ _ _ _ h3 (by omega) (by omega)
    exact ⟨y - k, by omega, p₃, hp₃, Or.inl hBE, Or.inr hBE⟩
  
  obtain ⟨α, P1, P2, P3⟩ : ∃ α, 2 * α + 2 ≤ c ∧ c ≤ k + 1 + 4 * α ∧ 4 * α + r + 2 ≤ y - k :=
    ⟨(c + 1 - k) / 4, by omega, by omega, by omega⟩
  obtain ⟨j, hj⟩ : ∃ j, j = k + 4 * α + 2 - c := ⟨_, rfl⟩
  obtain ⟨β, hβ⟩ : ∃ b, 2 * b = r + 1 + 2 * α := ⟨(r + 1) / 2 + α, by omega⟩
  obtain ⟨γ, hγ⟩ : ∃ g, 2 * g = y - k - 1 - 2 * α := ⟨(y - k - 1) / 2 - α, by omega⟩
  obtain ⟨δ, hδ⟩ : ∃ d, 2 * d = c - 2 - 2 * α := ⟨(c - 2 - 2 * α) / 2, by omega⟩
  obtain ⟨Q, hQ, hQa, hQb, -, hQj⟩ := path_III (y + 1) j (by omega) (by omega)
  rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - 1 = y by omega] at hQ
  have hSQ : ∀ x, x ≠ j - 1 → x + 2 ≤ y + 1 → Adj Q x (x + 1) := by
    intro x hx1 hx2
    by_cases hxj : x + 2 ≤ j
    · exact hQa x hxj
    · exact hQb x (by omega) hx2
  obtain ⟨p₁, hp₁, -, hK1, hE1⟩ := top_pairs y (y + 1) α _ Q (by omega) (by omega) (by omega) hQ
    (by
      intro i hi
      exact hSQ _ (by omega) (by omega))
  obtain ⟨p₂, hp₂, -, hK2, hE2⟩ := top_pairs (y - k) (y + 1 + 2 * α) β _ p₁ (by omega)
    (by omega) (by omega) hp₁
    (by
      intro i hi
      exact hK1 _ (hSQ _ (by omega) (by omega)) (by intro i' hi'; omega))
  obtain ⟨p₃, hp₃, hC3, hK3, hE3⟩ := bot_pairs (y - k) (y + 1 + 2 * α + 2 * β) γ _ p₂
    (by omega) (by omega) (by omega) hp₂
    (by
      intro i hi
      have h1 := hK1 _ (hSQ (y - k - 2 - 2 * i) (by omega) (by omega)) (by intro i' hi'; omega)
      have h2 := hK2 _ h1 (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h2 rfl (by omega))
  obtain ⟨p₄, hp₄, hC4, hK4, hE4⟩ := bot_pairs y (y + 1 + 2 * α + 2 * β + 2 * γ) δ _ p₃
    (by omega) (by omega) (by omega) hp₃
    (by
      intro i hi
      have h1 := hK1 _ (hSQ (k - 1 + 2 * α - 2 * i) (by omega) (by omega))
        (by intro i' hi'; omega)
      have h2 := hK2 _ h1 (by intro i' hi'; omega)
      have h3 := hK3 _ h2 (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h3 (by omega) (by omega))
  have hEnd : IsEnd p₄ (y - 1) := by
    have h := hE4 _ (hE3 _ (hE2 _ (hE1 _ hQj)))
    rwa [show j + 2 * γ + 2 * δ = y - 1 by omega] at h
  obtain ⟨p₅, hp₅, hE50, hK5, -⟩ :=
    bot_attach y (y + 1 + 2 * α + 2 * β + 2 * γ + 2 * δ) _ p₄ (by omega) (by omega) hp₄ hEnd
  have hv : y + 1 + 2 * α + 2 * β + 2 * γ + 2 * δ + 1 = y - 1 + (y - k + r) + c + 1 := by omega
  have hL : Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y + Multiset.replicate (2 * α) y +
      Multiset.replicate (2 * β) (y - k) + Multiset.replicate (2 * γ) (y - k) +
      Multiset.replicate (2 * δ) y + Multiset.replicate 1 y =
      prescribedLengths y k (y - 1) (y - k + r) c := by
    have hb' : Multiset.replicate (y - k + r) (y - k) =
        Multiset.replicate (2 * β) (y - k) + Multiset.replicate (2 * γ) (y - k) := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    have hc' : Multiset.replicate c y = Multiset.replicate 1 y + Multiset.replicate (2 * α) y +
        Multiset.replicate (2 * δ) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    unfold prescribedLengths
    rw [hb', hc']
    abel
  rw [hv, hL] at hp₅
  have hBE : BotEndInv (y - k) p₅ := by
    refine ⟨hE50, ?_, fun he => absurd he hnotEven⟩
    intro j' hj1 hj2
    have hz : Adj p₄ (2 * j' - 2) (2 * j' - 2 + 1) := by
      by_cases hA : j' - 1 < δ
      · exact adjc _ _ _ _ _ (hC4 (j' - 1) hA) (by omega) (by omega)
      · by_cases hB : j' - 1 < δ + γ
        · have h3 := hC3 (j' - 1 - δ) (by omega)
          have h4 := hK4 _ h3 (by intro i' hi'; omega)
          exact adjc _ _ _ _ _ h4 (by omega) (by omega)
        · obtain ⟨x, hx⟩ : ∃ x, x = 2 * j' - 2 - 2 * δ - 2 * γ := ⟨_, rfl⟩
          have h1 := hK1 x (hSQ x (by omega) (by omega)) (by intro i' hi'; omega)
          have h2 := hK2 x h1 (by intro i' hi'; omega)
          have h3 := hK3 x h2 (by intro i' hi'; omega)
          have h4 := hK4 _ h3 (by intro i' hi'; omega)
          exact adjc _ _ _ _ _ h4 (by omega) (by omega)
    exact adjc _ _ _ _ _ (hK5 _ hz) (by omega) (by omega)
  exact ⟨y - 1, by omega, p₅, hp₅, Or.inl hBE, Or.inr hBE⟩

theorem base_C : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y - k ≤ b → b < 2 * (y - k) → c < y →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧
      (IsEnd p (a₀ + b + c) ∨ BotEndInv (y - k) p) :=
by
  intro y k b c hk hyk hb1 hb2 hc
  obtain ⟨r, rfl⟩ : ∃ r, b = y - k + r := ⟨b - (y - k), by omega⟩
  have hr : r < y - k := by omega
  rcases Nat.mod_two_eq_zero_or_one (y - k) with hm | hm
  · by_cases hce : k % 2 = 1 ∧ r % 2 = 1 ∧ c % 2 = 0
    · exact baseC_CE y k r c hk hyk hr hc hm hce.1 hce.2.1 hce.2.2
    · exact baseC_ME y k r c hk hyk hr hc hm hce
  · rcases Nat.mod_two_eq_zero_or_one k with hk2 | hk2 <;>
    rcases Nat.mod_two_eq_zero_or_one r with hr2 | hr2 <;>
    rcases Nat.mod_two_eq_zero_or_one c with hc2 | hc2
    · exact baseC_O1 y k r c hk hyk hr hc hm hk2 hr2 hc2
    · exact baseC_O2 y k r c hk hyk hr hc hm hk2 hr2 hc2
    · exact baseC_O3 y k r c hk hyk hr hc hm hk2 hr2 hc2
    · exact baseC_OO y k r c hk hyk hr hc hm hr2 hc2
    · exact baseC_O4 y k r c hk hyk hr hc hm hk2 hr2 hc2
    · exact baseC_O5 y k r c hk hyk hr hc hm hk2 hr2 hc2
    · exact baseC_O6 y k r c hk hyk hr hc hm hk2 hr2 hc2
    · exact baseC_OO y k r c hk hyk hr hc hm hr2 hc2

theorem baseD_Sym : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 0 → ((y - k) % 2 = 0 ∨ b + c ≤ y - k ∨ b = 0) →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hb2 hc2 hdisj
  obtain ⟨hQ, hQslot, hQ0, -⟩ := path_range y (by omega)
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ := top_pairs y y (c / 2) (Multiset.replicate (y - 1) 1)
    (List.range y) (by omega) le_rfl (by omega) hQ (by
      intro i hi
      exact hQslot (y - y + 2 * i) (by omega))
  obtain ⟨p₂, hp₂, -, -, hE2⟩ := top_pairs (y - k) (y + 2 * (c / 2)) (b / 2)
    (Multiset.replicate (y - 1) 1 + Multiset.replicate (2 * (c / 2)) y) p₁
    (by omega) (by omega) (by omega) hp₁ (by
      intro i hi
      by_cases hx : y + 2 * (c / 2) - (y - k) + 2 * i + 2 ≤ y
      · apply hK1 _ (hQslot _ hx)
        intro i' hi'
        omega
      · rcases hdisj with hm | hs | h0
        · obtain ⟨j, hj1, hj2⟩ : ∃ j, j < c / 2 ∧
              y + 2 * (c / 2) - (y - k) + 2 * i = y + 2 * j :=
            ⟨(y + 2 * (c / 2) - (y - k) + 2 * i - y) / 2, by omega, by omega⟩
          rw [hj2]
          exact hN1 j hj1
        · omega
        · omega)
  refine ⟨y - 1, by omega, p₂, ?_, Or.inl (hE2 0 (hE1 0 hQ0))⟩
  have e1 : y + 2 * (c / 2) + 2 * (b / 2) = y - 1 + b + c + 1 := by omega
  have e2 : Multiset.replicate (y - 1) 1 + Multiset.replicate (2 * (c / 2)) y +
      Multiset.replicate (2 * (b / 2)) (y - k) = prescribedLengths y k (y - 1) b c := by
    rw [show 2 * (c / 2) = c by omega, show 2 * (b / 2) = b by omega]
    unfold prescribedLengths
    abel
  rw [e1, e2] at hp₂
  exact hp₂

theorem baseD_Smy : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 0 → k % 2 = 1 → (y % 2 = 0 ∨ b + c ≤ y) →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hb2 hc2 hko hyc
  obtain ⟨t₁, rfl⟩ : ∃ t, b = 2 * t := ⟨b / 2, by omega⟩
  obtain ⟨t₂, rfl⟩ : ∃ t, c = 2 * t := ⟨c / 2, by omega⟩
  obtain ⟨hQ, hQslot, hQ0, -⟩ := path_range y (by omega)
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ := top_pairs (y - k) y t₁ (Multiset.replicate (y - 1) 1)
    (List.range y) (by omega) (by omega) (by omega) hQ (by
      intro i hi
      have e : y - (y - k) + 2 * i = k + 2 * i := by omega
      rw [e]
      exact hQslot _ (by omega))
  obtain ⟨p₂, hp₂, -, -, hE2⟩ := top_pairs y (y + 2 * t₁) t₂ _ p₁ (by omega) (by omega)
    (by omega) hp₁ (by
      intro i hi
      have e : y + 2 * t₁ - y + 2 * i = 2 * t₁ + 2 * i := by omega
      rw [e]
      by_cases hx : 2 * t₁ + 2 * i + 2 ≤ y
      · apply hK1 _ (hQslot _ hx)
        intro i' _
        omega
      · rcases hyc with hye | hbc
        · obtain ⟨i', hi'1, hi'2⟩ : ∃ i', i' < t₁ ∧ y + 2 * i' = 2 * t₁ + 2 * i :=
            ⟨(2 * t₁ + 2 * i - y) / 2, by omega, by omega⟩
          have h := hN1 i' hi'1
          rw [hi'2] at h
          exact h
        · omega)
  refine ⟨y - 1, by omega, p₂, ?_, Or.inl (hE2 0 (hE1 0 hQ0))⟩
  have ev : y - 1 + 2 * t₁ + 2 * t₂ + 1 = y + 2 * t₁ + 2 * t₂ := by omega
  rw [ev]
  unfold prescribedLengths
  exact hp₂

theorem baseD_FB : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    y % 2 = 1 → k % 2 = 0 → b % 2 = 0 → 2 ≤ b → b ≤ y - 2 * k + 1 → c % 2 = 0 →
    y - 2 * k + 1 ≤ b + c →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hy2 hk2 hb2 hb2' hbu hc2 hbc
  obtain ⟨σ, hσ⟩ : ∃ σ, 2 * σ = y - 2 * k + 1 - b := ⟨(y - 2 * k + 1 - b) / 2, by omega⟩
  obtain ⟨τ, hτ⟩ : ∃ τ, 2 * τ + 2 * σ = c := ⟨(c - 2 * σ) / 2, by omega⟩
  obtain ⟨β, hβ⟩ : ∃ β, 2 * β + 1 + 1 = b := ⟨(b - 2) / 2, by omega⟩
  
  obtain ⟨Q, hQ, hQs1, hQs2, -, hQk⟩ := path_II y k hk (by omega)
  
  obtain ⟨p₁, hp₁, -, hK1, hE1⟩ := top_pairs y y τ _ Q (by omega) le_rfl (by omega) hQ (by
    intro i hi
    by_cases h : y - y + 2 * i + 2 ≤ k
    · exact hQs1 _ h
    · exact hQs2 _ (by omega) (by omega))
  have h1 : ∀ x : ℕ, x % 2 = 1 → k ≤ x → x + 2 ≤ y → Adj p₁ x (x + 1) := by
    intro x hx hkx hxy
    exact hK1 x (hQs2 x hkx hxy) (by intro i _; omega)
  
  obtain ⟨p₂, hp₂, -, hK2, hE2⟩ := bot_pairs y (y + 2 * τ) σ _ p₁ (by omega) (by omega)
    (by omega) hp₁ (by
      intro i hi
      have h := h1 (y - 2 - 2 * i) (by omega) (by omega) (by omega)
      rw [show y - 2 - 2 * i + 1 = y - 1 - 2 * i by omega] at h
      exact h)
  
  obtain ⟨p₃, hp₃, -, -, hE3⟩ := bot_pairs (y - k) (y + 2 * τ + 2 * σ) β _ p₂ (by omega)
    (by omega) (by omega) hp₂ (by
      intro i hi
      have hq := hK2 (k + b - 3 - 2 * i) (h1 _ (by omega) (by omega) (by omega))
        (by intro i' _; omega)
      rw [show y - k - 2 - 2 * i = k + b - 3 - 2 * i + 2 * σ by omega,
        show y - k - 1 - 2 * i = k + b - 3 - 2 * i + 2 * σ + 1 by omega]
      exact hq)
  
  have hend : IsEnd p₃ (y - k - 1) := by
    rw [show y - k - 1 = k + 2 * σ + 2 * β by omega]
    exact hE3 _ (hE2 _ (hE1 _ hQk))
  obtain ⟨p₄, hp₄, h0, -, -⟩ := bot_attach (y - k) (y + 2 * τ + 2 * σ + 2 * β) _ p₃
    (by omega) (by omega) hp₃ hend
  
  refine ⟨y - 2, by omega, p₄, ?_, Or.inl h0⟩
  have e1 : y + 2 * τ + 2 * σ + 2 * β + 1 = y - 2 + b + c + 1 := by omega
  have e2 : Multiset.replicate (y - 2) 1 + Multiset.replicate 1 (y - k) +
      Multiset.replicate (2 * τ) y + Multiset.replicate (2 * σ) y +
      Multiset.replicate (2 * β) (y - k) + Multiset.replicate 1 (y - k) =
      prescribedLengths y k (y - 2) b c := by
    rw [← hτ, ← hβ]
    unfold prescribedLengths
    simp only [Multiset.replicate_add]
    abel
  rw [e1, e2] at hp₄
  exact hp₄

theorem baseD_FA : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    k % 2 = 0 → b % 2 = 0 → 2 ≤ b → c % 2 = 0 → y - 2 * k ≤ b + 1 →
    ((y - k) % 2 = 1 ∨ b ≤ y - 2 * k + 1) →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hke hbe hb2 hce hyb hdisj
  obtain ⟨t, rfl⟩ : ∃ t, b = 2 * t + 2 := ⟨(b - 2) / 2, by omega⟩
  
  obtain ⟨Q, hQ, hQ1, hQ2, -, hQj⟩ :=
    path_II (2 * (y - k) - 2 * t - 1) (y - k - 2 * t - 1) (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, hN, hK, hE₁⟩ :=
    bot_pairs (y - k) (2 * (y - k) - 2 * t - 1) t _ Q (by omega) (by omega) (by omega) hQ (by
      intro i hi
      have h := hQ2 (y - k - 2 - 2 * i) (by omega) (by omega)
      rw [show y - k - 2 - 2 * i + 1 = y - k - 1 - 2 * i by omega] at h
      exact h)
  have hend : IsEnd p₁ (y - k - 1) := by
    have h := hE₁ _ hQj
    rw [show y - k - 2 * t - 1 + 2 * t = y - k - 1 by omega] at h
    exact h
  
  obtain ⟨p₂, hp₂, hp₂0, hS, -⟩ :=
    bot_attach (y - k) (2 * (y - k) - 2 * t - 1 + 2 * t) _ p₁ (by omega) (by omega) hp₁ hend
  
  have hslot : ∀ i : ℕ, i < c / 2 →
      Adj p₂ (2 * (y - k) - 2 * t - 1 + 2 * t + 1 - y + 2 * i)
        (2 * (y - k) - 2 * t - 1 + 2 * t + 1 - y + 2 * i + 1) := by
    intro i hi
    have hz : ∀ z : ℕ, z + 1 = 2 * (y - k) - 2 * t - 1 + 2 * t + 1 - y + 2 * i →
        Adj p₁ z (z + 1) →
        Adj p₂ (2 * (y - k) - 2 * t - 1 + 2 * t + 1 - y + 2 * i)
          (2 * (y - k) - 2 * t - 1 + 2 * t + 1 - y + 2 * i + 1) := by
      intro z hz1 hA
      have h := hS z hA
      rw [show z + 2 = z + 1 + 1 by omega, hz1] at h
      exact h
    by_cases h1 : y - k ≤ y - 2 * k + 2 * i
    · 
      have hA := hK _ (hQ2 (y - 2 * k + 2 * i - 2 * t - 1) (by omega) (by omega))
        (fun i' _ => by omega)
      exact hz _ (by omega) hA
    by_cases h2 : 2 * t + 1 ≤ y - 2 * k + 2 * i
    · 
      have hA := hK _ (hQ1 (y - 2 * k + 2 * i - 2 * t - 1) (by omega))
        (fun i' _ => by omega)
      exact hz _ (by omega) hA
    · 
      rcases hdisj with hm | hm
      · have hA := hN ((y - 2 * k + 2 * i - 1) / 2) (by omega)
        have e : 2 * ((y - 2 * k + 2 * i - 1) / 2) = y - 2 * k + 2 * i - 1 := by omega
        rw [e] at hA
        exact hz _ (by omega) hA
      · exfalso; omega
  
  obtain ⟨p, hp, -, -, hE⟩ :=
    top_pairs y (2 * (y - k) - 2 * t - 1 + 2 * t + 1) (c / 2) _ p₂ (by omega) (by omega)
      (by omega) hp₂ hslot
  refine ⟨2 * (y - k) - (2 * t + 2) - 1, by omega, p, ?_, Or.inl (hE 0 hp₂0)⟩
  have e1 : 2 * (y - k) - 2 * t - 1 + 2 * t + 1 + 2 * (c / 2) =
      2 * (y - k) - (2 * t + 2) - 1 + (2 * t + 2) + c + 1 := by omega
  have e2 : Multiset.replicate (2 * (y - k) - 2 * t - 1 - 2) 1 +
      Multiset.replicate 1 (2 * (y - k) - 2 * t - 1 - (y - k - 2 * t - 1)) +
      Multiset.replicate (2 * t) (y - k) + Multiset.replicate 1 (y - k) +
      Multiset.replicate (2 * (c / 2)) y =
      prescribedLengths y k (2 * (y - k) - (2 * t + 2) - 1) (2 * t + 2) c := by
    rw [show 2 * (y - k) - 2 * t - 1 - 2 = 2 * (y - k) - (2 * t + 2) - 1 by omega,
      show 2 * (y - k) - 2 * t - 1 - (y - k - 2 * t - 1) = y - k by omega,
      show 2 * (c / 2) = c by omega]
    unfold prescribedLengths
    rw [show 2 * t + 2 = 1 + 2 * t + 1 by omega, Multiset.replicate_add,
      Multiset.replicate_add]
    abel
  rw [e1, e2] at hp
  exact hp

theorem baseD_EE : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hb2 hc2
  rcases Nat.mod_two_eq_zero_or_one (y - k) with hm | hm
  · exact baseD_Sym y k b c hk hyk hb hc hb2 hc2 (Or.inl hm)
  · rcases Nat.mod_two_eq_zero_or_one y with hy | hy
    · exact baseD_Smy y k b c hk hyk hb hc hb2 hc2 (by omega) (Or.inl hy)
    · have hk2 : k % 2 = 0 := by omega
      by_cases h1 : b + c ≤ y - k ∨ b = 0
      · exact baseD_Sym y k b c hk hyk hb hc hb2 hc2 (Or.inr h1)
      · have hb2' : 2 ≤ b := by omega
        have hbc : y - k + 1 ≤ b + c := by omega
        by_cases h2 : b ≤ y - 2 * k + 1
        · exact baseD_FB y k b c hk hyk hb hc hy hk2 hb2 hb2' h2 hc2 (by omega)
        · exact baseD_FA y k b c hk hyk hb hc hk2 hb2 hb2' hc2 (by omega) (Or.inl hm)

theorem baseD_Y1 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 1 → ((y - k) % 2 = 0 ∨ b + c ≤ y - k + 1 ∨ b = 0) →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hb2 hc2 hdisj
  
  obtain ⟨Q, hQ, -, hQs, hQ0, -⟩ := path_II (y + 1) 1 le_rfl (by omega)
  have e1 : y + 1 - 2 = y - 1 := by omega
  have e2 : y + 1 - 1 = y := by omega
  rw [e1, e2] at hQ
  
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ :=
    top_pairs y (y + 1) ((c - 1) / 2) _ Q (by omega) (by omega) (by omega) hQ
      (fun i hi => hQs _ (by omega) (by omega))
  
  obtain ⟨p₂, hp₂, -, -, hE2⟩ :=
    top_pairs (y - k) (y + 1 + 2 * ((c - 1) / 2)) (b / 2) _ p₁ (by omega) (by omega)
      (by omega) hp₁ (by
        intro i hi
        by_cases hx : y + 1 + 2 * ((c - 1) / 2) - (y - k) + 2 * i ≤ y - 1
        · apply hK1 _ (hQs _ (by omega) (by omega))
          intro i' hi'
          omega
        · have hm : (y - k) % 2 = 0 := by omega
          obtain ⟨j, hj⟩ : ∃ j, y + 1 + 2 * ((c - 1) / 2) - (y - k) + 2 * i = y + 1 + 2 * j :=
            ⟨(y + 1 + 2 * ((c - 1) / 2) - (y - k) + 2 * i - (y + 1)) / 2, by omega⟩
          rw [hj]
          exact hN1 j (by omega))
  
  have hv : y + 1 + 2 * ((c - 1) / 2) + 2 * (b / 2) = y - 1 + b + c + 1 := by omega
  have hL : Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y +
      Multiset.replicate (2 * ((c - 1) / 2)) y + Multiset.replicate (2 * (b / 2)) (y - k) =
      prescribedLengths y k (y - 1) b c := by
    have h1 : 2 * ((c - 1) / 2) = c - 1 := by omega
    have h2 : 2 * (b / 2) = b := by omega
    have h3 : Multiset.replicate c y = Multiset.replicate 1 y + Multiset.replicate (c - 1) y := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    rw [h1, h2]
    unfold prescribedLengths
    rw [h3]
    abel
  rw [hv, hL] at hp₂
  exact ⟨y - 1, by omega, p₂, hp₂, Or.inl (hE2 0 (hE1 0 hQ0))⟩

theorem baseD_EO_ye : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 1 → k % 2 = 1 → y % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hb2 hc2 hk2 hy2
  obtain ⟨β, hβ⟩ : ∃ β, 2 * β = b := ⟨b / 2, by omega⟩
  obtain ⟨γ, hγ⟩ : ∃ γ, 2 * γ + 1 = c := ⟨c / 2, by omega⟩
  obtain ⟨w, hw⟩ : ∃ w, y = 2 * w := ⟨y / 2, by omega⟩
  
  obtain ⟨Q, hQ, -, hQs, hQ0, -⟩ := path_II (y + 1) 1 le_rfl (by omega)
  
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ := top_pairs (y - k) (y + 1) β _ Q (by omega) (by omega)
    (by omega) hQ (by
      intro i hi
      exact hQs _ (by omega) (by omega))
  
  have h2 : ∀ i : ℕ, i < γ →
      Adj p₁ (y + 1 + 2 * β - y + 2 * i) (y + 1 + 2 * β - y + 2 * i + 1) := by
    intro i hi
    by_cases hx : y + 1 + 2 * β - y + 2 * i + 2 ≤ y + 1
    · exact hK1 _ (hQs _ (by omega) hx) (by intro i' _; omega)
    · have h := hN1 (β + i - w) (by omega)
      rw [show y + 1 + 2 * (β + i - w) = y + 1 + 2 * β - y + 2 * i by omega] at h
      exact h
  
  obtain ⟨p₂, hp₂, -, -, hE2⟩ := top_pairs y (y + 1 + 2 * β) γ _ p₁ (by omega) (by omega)
    (by omega) hp₁ h2
  
  refine ⟨y - 1, by omega, p₂, ?_, Or.inl (hE2 0 (hE1 0 hQ0))⟩
  have e1 : y + 1 + 2 * β + 2 * γ = y - 1 + b + c + 1 := by omega
  have e2 : Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - 1) +
      Multiset.replicate (2 * β) (y - k) + Multiset.replicate (2 * γ) y =
      prescribedLengths y k (y - 1) b c := by
    rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - 1 = y by omega, ← hβ, ← hγ]
    unfold prescribedLengths
    simp only [Multiset.replicate_add]
    abel
  rw [e1, e2] at hp₂
  exact hp₂

theorem baseD_EO_FH : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 1 → y % 2 = 1 → k % 2 = 0 → 2 ≤ b → b ≤ k →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  intro y k b c hk hyk hb hc hb2 hc2 hy2 hk2 hb0 hbk
  obtain ⟨β, hβ⟩ : ∃ β, 2 * β = b := ⟨b / 2, by omega⟩
  obtain ⟨γ, hγ⟩ : ∃ γ, 2 * γ + 1 = c := ⟨c / 2, by omega⟩
  
  obtain ⟨hQ, hQs, -, hQe⟩ := path_range (y - b) (by omega)
  
  obtain ⟨p₁, hp₁, hC1, hK1, hE1⟩ := bot_pairs (y - k) (y - b) β _ (List.range (y - b))
    (by omega) (by omega) (by omega) hQ (by
      intro i hi
      have h := hQs (y - k - 2 - 2 * i) (by omega)
      rw [show y - k - 2 - 2 * i + 1 = y - k - 1 - 2 * i by omega] at h
      exact h)
  
  have hend : IsEnd p₁ (y - 1) := by
    have h := hE1 _ hQe
    rw [show y - b - 1 + 2 * β = y - 1 by omega] at h
    exact h
  
  obtain ⟨p₂, hp₂, h0, hK2, -⟩ := bot_attach y (y - b + 2 * β) _ p₁ (by omega) (by omega)
    hp₁ hend
  
  have s6 : ∀ i : ℕ, 2 * i + 2 ≤ y → Adj p₁ (2 * i) (2 * i + 1) := by
    intro i hi
    by_cases hiβ : i < β
    · exact hC1 i hiβ
    · have h := hK1 (2 * i - 2 * β) (hQs _ (by omega)) (by intro i' _; omega)
      rw [show 2 * i - 2 * β + 2 * β = 2 * i by omega] at h
      exact h
  
  obtain ⟨p₃, hp₃, -, -, hE3⟩ := top_pairs y (y - b + 2 * β + 1) γ _ p₂ (by omega) (by omega)
    (by omega) hp₂ (by
      intro i hi
      have h := hK2 _ (s6 i (by omega))
      rw [show y - b + 2 * β + 1 - y + 2 * i = 2 * i + 1 by omega]
      exact h)
  
  refine ⟨y - b - 1, by omega, p₃, ?_, Or.inl (hE3 0 h0)⟩
  have e1 : y - b + 2 * β + 1 + 2 * γ = y - b - 1 + b + c + 1 := by omega
  have e2 : Multiset.replicate (y - b - 1) 1 + Multiset.replicate (2 * β) (y - k) +
      Multiset.replicate 1 y + Multiset.replicate (2 * γ) y =
      prescribedLengths y k (y - b - 1) b c := by
    rw [← hγ]
    unfold prescribedLengths
    rw [hβ]
    simp only [Multiset.replicate_add]
    abel
  rw [e1, e2] at hp₃
  exact hp₃

theorem baseD_EO_FE : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → c < y →
    b % 2 = 0 → c % 2 = 1 → y % 2 = 1 → k % 2 = 0 → y - k + 2 ≤ b + c → c ≤ y - k →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (IsEnd p 0 ∨ IsEnd p (a₀ + b + c)) :=
by
  
  
  
  have top_attach : ∀ (ℓ v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ ℓ → ℓ ≤ v →
      IsLinearRealization v L p → IsEnd p (v - ℓ) →
      ∃ p' : List ℕ, IsLinearRealization (v + 1) (L + Multiset.replicate 1 ℓ) p' ∧ IsEnd p' v ∧
        (∀ x : ℕ, Adj p x (x + 1) → Adj p' x (x + 1)) ∧
        (∀ x : ℕ, IsEnd p x → x ≠ v - ℓ → IsEnd p' x) := by
    have s1 : ∀ (x a : ℕ) (t : List ℕ), edgeLengths (x :: a :: t) =
        Int.natAbs ((a : ℤ) - (x : ℤ)) ::ₘ edgeLengths (a :: t) := by
      intro x a t; rfl
    have s0 : ∀ x : ℕ, edgeLengths [x] = 0 := fun x => rfl
    have s3 : ∀ (l : List ℕ) (a b : ℕ), edgeLengths (l ++ [a, b]) =
        edgeLengths (l ++ [a]) + {Int.natAbs ((b : ℤ) - (a : ℤ))} := by
      intro l a b
      induction l with
      | nil =>
        rw [List.nil_append, List.nil_append, s1, s0, s0, zero_add]
        rfl
      | cons x l ih =>
        cases l with
        | nil =>
          have e1 : [x] ++ [a, b] = x :: a :: [b] := rfl
          have e2 : [x] ++ [a] = x :: a :: [] := rfl
          have ih' : edgeLengths (a :: [b]) =
              edgeLengths [a] + {Int.natAbs ((b : ℤ) - (a : ℤ))} := ih
          rw [e1, e2, s1, ih', s1, Multiset.cons_add]
        | cons y l' =>
          have e1 : (x :: y :: l') ++ [a, b] = x :: y :: (l' ++ [a, b]) := rfl
          have e2 : (x :: y :: l') ++ [a] = x :: y :: (l' ++ [a]) := rfl
          have ih' : edgeLengths (y :: (l' ++ [a, b])) =
              edgeLengths (y :: (l' ++ [a])) + {Int.natAbs ((b : ℤ) - (a : ℤ))} := ih
          rw [e1, e2, s1 x y (l' ++ [a, b]), ih', s1 x y (l' ++ [a]), Multiset.cons_add]
    intro ℓ v L p hℓ hv hpL hend
    obtain ⟨hq, hM⟩ := hpL
    have hadj : ∀ (pre suf : List ℕ) (x : ℕ), Adj p x (x + 1) →
        Adj (pre ++ p ++ suf) x (x + 1) := by
      rintro pre suf x ⟨l₁, l₂, h | h⟩
      · exact ⟨pre ++ l₁, l₂ ++ suf, Or.inl (by rw [h]; simp)⟩
      · exact ⟨pre ++ l₁, l₂ ++ suf, Or.inr (by rw [h]; simp)⟩
    have hab1 : Int.natAbs (((v - ℓ : ℕ) : ℤ) - (v : ℤ)) = ℓ := by
      have e : ((v - ℓ : ℕ) : ℤ) - (v : ℤ) = -(ℓ : ℤ) := by omega
      rw [e]; simp
    have hab2 : Int.natAbs ((v : ℤ) - ((v - ℓ : ℕ) : ℤ)) = ℓ := by
      have e : (v : ℤ) - ((v - ℓ : ℕ) : ℤ) = (ℓ : ℤ) := by omega
      rw [e]; simp
    rcases hend with h | h
    · obtain ⟨t, rfl⟩ := List.head?_eq_some_iff.mp h
      refine ⟨v :: (v - ℓ) :: t, ⟨?_, ?_⟩, Or.inl rfl, ?_, ?_⟩
      · show List.Perm _ _
        rw [List.range_succ]
        exact (hq.cons v).trans (List.perm_append_singleton v _).symm
      · rw [s1, hM, hab1, Multiset.replicate_one, add_comm, Multiset.singleton_add]
      · intro x hx
        simpa using hadj [v] [] x hx
      · intro x hx hne
        rcases hx with hx | hx
        · simp at hx
          omega
        · right
          rw [List.getLast?_cons_cons]
          exact hx
    · obtain ⟨t, rfl⟩ := List.getLast?_eq_some_iff.mp h
      refine ⟨t ++ [v - ℓ, v], ⟨?_, ?_⟩, Or.inr (by simp), ?_, ?_⟩
      · show List.Perm _ _
        rw [List.range_succ]
        have e : t ++ [v - ℓ, v] = (t ++ [v - ℓ]) ++ [v] := by simp
        rw [e]
        exact hq.append_right [v]
      · rw [s3, hM, hab2, Multiset.replicate_one]
      · intro x hx
        simpa using hadj [] [v] x hx
      · intro x hx hne
        rcases hx with hx | hx
        · left
          cases t with
          | nil =>
            simp at hx
            omega
          | cons a t => simpa using hx
        · simp at hx
          omega
  
  
  
  have path_III : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ,
      IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - 1)) Q ∧
      (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧
      (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧
      IsEnd Q (j - 1) ∧ IsEnd Q j := by
    intro n j hj hn
    obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
    have hm : 1 ≤ m := by omega
    refine ⟨(List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse,
      ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · 
      show List.Perm _ _
      rw [List.range_add]
      exact (List.reverse_perm _).append (List.reverse_perm _)
    · 
      have hlen : ((List.range j).reverse ++
          (List.map (fun y => j + y) (List.range m)).reverse).length = j + m := by simp
      have hQ : ∀ (i : ℕ) (h : i < ((List.range j).reverse ++
          (List.map (fun y => j + y) (List.range m)).reverse).length),
          ((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse)[i] =
            if i < j then j - 1 - i else j + (m - 1 - (i - j)) := by
        intro i h
        by_cases hi : i < j
        · rw [List.getElem_append_left (by simpa using hi)]
          simp [hi, List.getElem_reverse]
        · rw [List.getElem_append_right (by simpa using hi)]
          simp [hi, List.getElem_reverse]
      have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).map
            (fun a : ℕ => (a : ℤ)))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).tail.map
            (fun a : ℕ => (a : ℤ))) =
          List.replicate (j - 1) 1 ++ (j + m - 1) :: List.replicate (m - 1) 1 := by
        apply List.ext_getElem
        · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
            List.length_append, List.length_replicate, List.length_cons]
          omega
        · intro i h1 h2
          simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
          rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail,
            hQ, hQ]
          simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
            List.length_replicate]
          rw [Int.natAbs_eq_iff]
          split_ifs <;> omega
      have he : edgeLengths ((List.range j).reverse ++
          (List.map (fun y => j + y) (List.range m)).reverse) =
          ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).map
            (fun a : ℕ => (a : ℤ)))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).tail.map
            (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
        unfold edgeLengths
        simp only [List.map_eq_flatMap]
        rfl
      rw [he, hl, show j + m - 2 = (j - 1) + (m - 1) by omega,
        Multiset.replicate_add, ← Multiset.coe_add, ← Multiset.cons_coe, Multiset.coe_replicate,
        Multiset.coe_replicate, Multiset.replicate_one, ← Multiset.singleton_add]
      abel
    · 
      intro x hx
      obtain ⟨r, rfl⟩ : ∃ r, j = x + 1 + 1 + r := ⟨j - x - 2, by omega⟩
      refine ⟨(List.map (fun y => x + 1 + 1 + y) (List.range r)).reverse,
        (List.range x).reverse ++
          (List.map (fun y => x + 1 + 1 + r + y) (List.range m)).reverse, Or.inr ?_⟩
      rw [List.range_add, List.range_succ, List.range_succ]
      simp [List.append_assoc, List.reverse_append]
    · 
      intro x hx1 hx2
      obtain ⟨d, rfl⟩ : ∃ d, x = j + d := ⟨x - j, by omega⟩
      obtain ⟨r, rfl⟩ : ∃ r, m = d + 1 + 1 + r := ⟨m - d - 2, by omega⟩
      refine ⟨(List.range j).reverse ++
          (List.map (fun y => j + y) (List.map (fun y => d + 1 + 1 + y) (List.range r))).reverse,
        (List.map (fun y => j + y) (List.range d)).reverse, Or.inr ?_⟩
      rw [@List.range_add (d + 1 + 1) r, List.range_succ, List.range_succ]
      simp [List.append_assoc, List.reverse_append, add_assoc]
    · 
      left
      obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      rw [List.range_succ]
      simp
    · 
      right
      have hm0 : m ≠ 0 := by omega
      simp [List.getLast?_append, List.head?_map, List.head?_range, hm0]
  
  
  
  have S1 : ∀ (y k s : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → s % 2 = 1 →
      s + 2 ≤ y - k →
      ∃ p : List ℕ, IsLinearRealization (y + s + 1)
          (Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y +
            Multiset.replicate s (y - k)) p ∧
        IsEnd p (y + s) ∧
        (∀ x : ℕ, x % 2 = 0 → x + 2 ≤ y + s → Adj p x (x + 1)) := by
    intro y k s hk hyk hy hk0 hs hsm
    obtain ⟨Q, hQ, hQlo, hQhi, hQe1, -⟩ := path_III (y + 1) (k + 1 + s) (by omega) (by omega)
    obtain ⟨p₁, hp₁, hN₁, hK₁, hE₁⟩ := top_pairs (y - k) (y + 1) ((s - 1) / 2) _ Q
      (by omega) (by omega) (by omega) hQ (fun i hi => hQlo _ (by omega))
    obtain ⟨p, hp, hpe, hpK, -⟩ := top_attach (y - k) (y + 1 + 2 * ((s - 1) / 2)) _ p₁
      (by omega) (by omega) hp₁ (by
        rw [show y + 1 + 2 * ((s - 1) / 2) - (y - k) = k + 1 + s - 1 by omega]
        exact hE₁ _ hQe1)
    have hv : y + 1 + 2 * ((s - 1) / 2) + 1 = y + s + 1 := by omega
    rw [hv] at hp
    rw [show y + 1 + 2 * ((s - 1) / 2) = y + s by omega] at hpe
    refine ⟨p, ?_, hpe, ?_⟩
    · have hM : Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y +
          Multiset.replicate s (y - k) =
          Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - 1) +
            Multiset.replicate (2 * ((s - 1) / 2)) (y - k) + Multiset.replicate 1 (y - k) := by
        rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - 1 = y by omega, add_assoc _ _
          (Multiset.replicate 1 (y - k)), ← Multiset.replicate_add,
          show 2 * ((s - 1) / 2) + 1 = s by omega]
      rw [hM]
      exact hp
    · intro x hx0 hx2
      apply hpK
      by_cases hxy : x + 1 ≤ y
      · apply hK₁ x
        · by_cases hlo : x + 2 ≤ k + 1 + s
          · exact hQlo x hlo
          · exact hQhi x (by omega) (by omega)
        · intro i hi
          omega
      · have h := hN₁ ((x - y - 1) / 2) (by omega)
        rw [show y + 1 + 2 * ((x - y - 1) / 2) = x by omega] at h
        exact h
  
  
  
  intro y k b c hk hyk hb hc hb2 hc2 hy1 hk0 hbc hcm
