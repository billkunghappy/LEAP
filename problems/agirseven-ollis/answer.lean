      unfold prescribedLengths
      abel
    rw [hM]
    exact hp
  · rw [show y - 1 + 2 * b' + 1 + 1 = y + 1 + 2 * b' by omega]
    unfold TopPairInv
    refine ⟨Nat.even_iff.mpr hy, fun j hj => ?_⟩
    have key : Adj p (y + 2 * b' - 1 - 2 * j) (y + 2 * b' - 1 - 2 * j + 1) := by
      by_cases h1 : y + 1 ≤ y + 2 * b' - 1 - 2 * j
      · have h := hN (b' - 1 - j) (by omega)
        rw [show y + 1 + 2 * (b' - 1 - j) = y + 2 * b' - 1 - 2 * j by omega] at h
        exact h
      · exact hK _ (hS _ (by omega) (by omega)) (fun i hi => by omega)
    obtain ⟨l₁, l₂, h⟩ := key
    refine ⟨l₁, l₂, ?_⟩
    rw [show y + 1 + 2 * b' - 1 - 2 * j = y + 2 * b' - 1 - 2 * j + 1 by omega,
      show y + 1 + 2 * b' - 2 - 2 * j = y + 2 * b' - 1 - 2 * j by omega]
    exact h.symm

theorem bBe_G2 : ∀ (y k : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → k % 2 = 1 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + 1 + 1 + 1 ∧ ∃ q : List ℕ,
      IsLinearRealization (a₀ + 1 + 1 + 1) (prescribedLengths y k a₀ 1 1) q ∧
      TopPairInv y (a₀ + 1 + 1 + 1) q ∧ IsEnd q 0 :=
by
  intro y k hk hyk hy hk2
  obtain ⟨m, rfl⟩ : ∃ m, y = m + k := ⟨y - k, by omega⟩
  have hm : k + 2 ≤ m := by omega
  have hv : m + k - 1 + 1 + 1 + 1 = 1 + m + (k + 1) := by omega
  refine ⟨m + k - 1, by omega, by omega,
    List.map (fun i => 1 + m + i) (List.range (k + 1)) ++
      (List.map (fun i => 1 + i) (List.range m) ++ [0]), ?_⟩
  rw [hv]
  have key : ∀ z : ℕ, ((1 + m ≤ z ∧ z + 1 ≤ m + k + 1) ∨ (1 ≤ z ∧ z + 1 ≤ m)) →
      ∃ l₁ l₂ : List ℕ, List.map (fun i => 1 + m + i) (List.range (k + 1)) ++
        (List.map (fun i => 1 + i) (List.range m) ++ [0]) = l₁ ++ z :: (z + 1) :: l₂ := by
    rintro z (⟨h1, h2⟩ | ⟨h1, h2⟩)
    · obtain ⟨e, rfl⟩ : ∃ e, z = 1 + m + e := ⟨z - (1 + m), by omega⟩
      obtain ⟨r, hr⟩ : ∃ r, k + 1 = e + 1 + 1 + r := ⟨k + 1 - e - 2, by omega⟩
      refine ⟨List.map (fun i => 1 + m + i) (List.range e),
        List.map (fun i => 1 + m + i) (List.map (fun i => e + 1 + 1 + i) (List.range r)) ++
          (List.map (fun i => 1 + i) (List.range m) ++ [0]), ?_⟩
      have hR : List.range (k + 1) = List.range (e + 1 + 1) ++
          List.map (fun x => e + 1 + 1 + x) (List.range r) := by
        rw [hr]; exact List.range_add
      rw [hR, List.range_succ, List.range_succ]
      simp [List.append_assoc, add_assoc]
    · obtain ⟨e, rfl⟩ : ∃ e, z = 1 + e := ⟨z - 1, by omega⟩
      obtain ⟨r, rfl⟩ : ∃ r, m = e + 1 + 1 + r := ⟨m - e - 2, by omega⟩
      refine ⟨List.map (fun i => 1 + (e + 1 + 1 + r) + i) (List.range (k + 1)) ++
          List.map (fun i => 1 + i) (List.range e),
        List.map (fun i => 1 + i) (List.map (fun i => e + 1 + 1 + i) (List.range r)) ++ [0], ?_⟩
      have hR : List.range (e + 1 + 1 + r) = List.range (e + 1 + 1) ++
          List.map (fun x => e + 1 + 1 + x) (List.range r) := List.range_add
      have hS : List.range (e + 1 + 1) = List.range e ++ [e, e + 1] := by
        simp [List.range_succ]
