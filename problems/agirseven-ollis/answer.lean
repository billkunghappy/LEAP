  · rw [hV]
    refine ⟨hp₃.1, ?_⟩
    rw [hp₃.2]
    unfold prescribedLengths
    rw [show y - k - (2 * t + 1) + 1 = 2 + 2 * u by omega,
      Multiset.replicate_add (2 * t) 1 (y - k), Multiset.replicate_add 2 (2 * u) y]
