  have adj_cast : ∀ (p : List ℕ) (u w u' w' : ℕ), u = u' → w = w' → Adj p u w → Adj p u' w' := by
    rintro p u w u' w' rfl rfl h
    exact h
  
  have rot : ∀ s d : ℕ, 1 ≤ s → 1 ≤ d →
      IsLinearRealization (s + d)
        (Multiset.replicate (s + d - 2) 1 + Multiset.replicate 1 (s + d - 1))
