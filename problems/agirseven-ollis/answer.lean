    intro m hm
    unfold prescribedLengths
    rw [← hm]
    have hmk : m + k = y := by omega
    have hkm : k + 1 ≤ m := by omega
    clear hm hyk hs hy hk2
    obtain ⟨f, hfdef⟩ : ∃ f : ℕ → ℕ, ∀ i, f i =
