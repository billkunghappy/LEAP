theorem bEE_Q3 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → y - k + 1 ≤ c → 2 ≤ b → b + c + 3 ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  have adj_cast : ∀ (p : List ℕ) (u w u' w' : ℕ), u = u' → w = w' → Adj p u w → Adj p u' w' := by
    rintro p u w u' w' rfl rfl h
    exact h
  
  have seed : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ,
      IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - 1)) Q ∧
      (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧ (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧
      IsEnd Q (j - 1) ∧ IsEnd Q j := by
    intro n j hj hn
    obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
    have hm : 1 ≤ m := by omega
    refine ⟨List.map (fun y => j + y) (List.range m) ++ List.range j,
      ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · 
      show List.Perm _ _
      rw [List.range_add]
      exact List.perm_append_comm
    · 
      have hlen : (List.map (fun y => j + y) (List.range m) ++ List.range j).length
          = m + j := by simp
      have hQ : ∀ (i : ℕ) (h : i < (List.map (fun y => j + y) (List.range m) ++
          List.range j).length),
          (List.map (fun y => j + y) (List.range m) ++ List.range j)[i] =
            if i < m then j + i else i - m := by
        intro i h
        by_cases hi : i < m
        · rw [List.getElem_append_left (by simpa using hi)]
          simp [hi]
        · rw [List.getElem_append_right (by simpa using hi)]
          simp [hi]
      have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          ((List.map (fun y => j + y) (List.range m) ++ List.range j).map
            (fun a : ℕ => (a : ℤ)))
          ((List.map (fun y => j + y) (List.range m) ++ List.range j).tail.map
            (fun a : ℕ => (a : ℤ))) =
          List.replicate (m - 1) 1 ++ (j + m - 1) :: List.replicate (j - 1) 1 := by
        apply List.ext_getElem
        · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
            List.length_append, List.length_replicate, List.length_cons]
          omega
        · intro i h1 h2
          simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
          rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail,
