    abel
  refine ⟨y - 1, by omega, p2, ?_⟩
  rw [hv, hL]
  exact ⟨hp2, Or.inr hp2B, Or.inl hp2T, Or.inr hp2T⟩

theorem base_A_par : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → ¬ (y % 2 = 1 ∧ k % 2 = 0) →
