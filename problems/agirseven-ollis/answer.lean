      | cons c l₁ ih =>
        cases l₁ with
        | nil =>
          simp only [List.nil_append, List.cons_append]
          rw [T1, T1, E1, Multiset.cons_add, zero_add]
        | cons d l₁ =>
          simp only [List.cons_append] at ih ⊢
          rw [T1, T1, ih, Multiset.cons_add]
    obtain ⟨S, hSdef⟩ : ∃ S : ℕ → ℕ, ∀ K, S K =
        ((List.range K).map (fun x => sf2N μ κ x + sf2Q μ κ x)).sum := ⟨_, fun K => rfl⟩
    have hS : ∀ K, S (K + 1) = S K + (sf2N μ κ K + sf2Q μ κ K) := by
      intro K
      rw [hSdef, hSdef, List.range_succ, List.map_append, List.sum_append]
      simp
    have P : ∀ K, K ≤ κ → ∀ L' : List ℕ,
        edgeLengths ((List.range K).flatMap (sf2Round μ κ) ++ 2 * K :: L') =
          Multiset.replicate (4 * K + 2 * S K) 1 + Multiset.replicate (2 * K + 2 * S K) (2 * μ) +
            Multiset.replicate (4 * K + 2 * S K) (2 * μ + 2 * κ) + edgeLengths (2 * K :: L') := by
      intro K
      induction K with
      | zero =>
        intro _ L'
        simp [hSdef]
      | succ K ih =>
        intro hK L'
        obtain ⟨t, ht⟩ : ∃ t, sf2Round μ κ K = 2 * K :: t := ⟨_, rfl⟩
        have c1 : 4 * (K + 1) + 2 * S (K + 1) =
            (4 * K + 2 * S K) + (4 + 2 * (sf2N μ κ K + sf2Q μ κ K)) := by
          rw [hS]; ring
        have c2 : 2 * (K + 1) + 2 * S (K + 1) =
            (2 * K + 2 * S K) + (2 + 2 * (sf2N μ κ K + sf2Q μ κ K)) := by
          rw [hS]; ring
        rw [c1, c2, Multiset.replicate_add (4 * K + 2 * S K) (4 + 2 * (sf2N μ κ K + sf2Q μ κ K)) 1,
          Multiset.replicate_add (2 * K + 2 * S K) (2 + 2 * (sf2N μ κ K + sf2Q μ κ K)) (2 * μ),
          Multiset.replicate_add (4 * K + 2 * S K) (4 + 2 * (sf2N μ κ K + sf2Q μ κ K)) (2 * μ + 2 * κ)]
        rw [List.range_succ, List.flatMap_append, List.flatMap_singleton, List.append_assoc, ht,
          List.cons_append, ih (by omega), ← List.cons_append, ← ht, T2 (sf2Round μ κ K),
          show 2 * (K + 1) = 2 * K + 2 by ring, hR K (by omega)]
        abel
    obtain ⟨tl, htl⟩ : ∃ tl, sf2Tail μ κ = 2 * κ :: tl := ⟨_, rfl⟩
    have hSS : sf2S μ κ = S κ := by rw [hSdef]; rfl
    unfold seedF2List
    rw [htl, P κ le_rfl tl, ← htl, hSS]
    have g1 : Int.natAbs (((2 * (μ + κ) : ℕ) : ℤ) - ((2 * κ : ℕ) : ℤ)) = 2 * μ := by omega
    have g2 : Int.natAbs (((2 * (2 * μ + κ) : ℕ) : ℤ) - ((2 * (μ + κ) : ℕ) : ℤ)) = 2 * μ := by omega
    have g3 : Int.natAbs (((2 * (3 * μ + 2 * κ) : ℕ) : ℤ) - ((2 * (2 * μ + κ) : ℕ) : ℤ)) =
        2 * μ + 2 * κ := by omega
    have g4 : Int.natAbs (((2 * (3 * μ + 2 * κ) - 1 : ℕ) : ℤ) - ((2 * (3 * μ + 2 * κ) : ℕ) : ℤ)) = 1 := by
      omega
    have g5 : Int.natAbs (((2 * (2 * μ + κ) - 1 : ℕ) : ℤ) - ((2 * (3 * μ + 2 * κ) - 1 : ℕ) : ℤ)) =
        2 * μ + 2 * κ := by omega
    have g6 : Int.natAbs (((2 * μ - 1 : ℕ) : ℤ) - ((2 * (2 * μ + κ) - 1 : ℕ) : ℤ)) = 2 * μ + 2 * κ := by
      omega
    have hT : edgeLengths (sf2Tail μ κ) = Multiset.replicate 1 (2 * μ) + Multiset.replicate 1 (2 * μ) +
        Multiset.replicate 1 (2 * μ + 2 * κ) + Multiset.replicate 1 1 +
        Multiset.replicate 1 (2 * μ + 2 * κ) + Multiset.replicate 1 (2 * μ + 2 * κ) := by
      unfold sf2Tail
      rw [T1, T1, T1, T1, T1, T1, E1, g1, g2, g3, g4, g5, g6]
      simp only [Tc]
      abel
    rw [hT, show 2 * κ + 2 * S κ + 2 = 2 * κ + 2 * S κ + 1 + 1 by ring,
      show 4 * κ + 2 * S κ + 3 = 4 * κ + 2 * S κ + 1 + 1 + 1 by ring]
    generalize 4 * κ + 2 * S κ = n1
    generalize 2 * κ + 2 * S κ = n2
    simp only [Multiset.replicate_add]
    abel
  intro y k hk hyk hy hk2
  obtain ⟨κ, rfl⟩ : ∃ κ, k = 2 * κ := ⟨k / 2, by omega⟩
  obtain ⟨μ, rfl⟩ : ∃ μ, y = 2 * μ + 2 * κ := ⟨(y - 2 * κ) / 2, by omega⟩
  have hκ : 1 ≤ κ := by omega
  have hμ : κ + 1 ≤ μ := by omega
  have hm : 2 * μ + 2 * κ - 2 * κ = 2 * μ := by omega
  have hv : 2 * (2 * μ + 2 * κ) + 2 * μ + 1 = 6 * μ + 4 * κ + 1 := by ring
  unfold prescribedLengths
  rw [hm, hv]
  
  have swap : ∀ (l : List ℕ) (u w : ℕ), Adj l u w → Adj l w u := by
    intro l u w h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adjc : ∀ (l : List ℕ) (a b a' b' : ℕ), Adj l a b → a = a' → b = b' → Adj l a' b' := by
    intro l a b a' b' h h1 h2
    subst h1 h2
    exact h
  have infixAdj : ∀ (l' l : List ℕ) (u w : ℕ), l' <:+: l → Adj l' u w → Adj l u w := by
    intro l' l u w hinf hadj
    obtain ⟨s, t, rfl⟩ := hinf
    obtain ⟨l₁, l₂, h | h⟩ := hadj
    · subst h
      exact ⟨s ++ l₁, l₂ ++ t, Or.inl (by simp)⟩
    · subst h
      exact ⟨s ++ l₁, l₂ ++ t, Or.inr (by simp)⟩
  have hRx : ∀ x, x < κ → ∀ z ∈ sf2Round μ κ x, z ∈ seedF2List μ κ := by
    intro x hx z hz
    exact (sF2_round_infix μ κ x hx).subset (List.mem_append_left _ hz)
  have hAdjR : ∀ x, x < κ → ∀ u w : ℕ, Adj (sf2Round μ κ x ++ [2 * x + 2]) u w →
      Adj (seedF2List μ κ) u w := by
    intro x hx u w h
    exact infixAdj _ _ u w (sF2_round_infix μ κ x hx) h
  
  have hlen : (seedF2List μ κ).length = 6 * μ + 4 * κ + 1 := by
    rw [sF2_length, sF2_sum μ κ hκ hμ]
    omega
  
  have hcov : ∀ w, w < 6 * μ + 4 * κ + 1 → w ∈ seedF2List μ κ := by
    refine sF2_partition μ κ (seedF2List μ κ) hκ hμ ?_ ?_ ?_ ?_ ?_
    · intro x hx z hz
      exact hRx x hx z ((sF2_round_mem μ κ x).1 z hz)
    · intro x hx z hz
      exact hRx x hx z ((sF2_round_mem μ κ x).2.1 z hz)
    · intro z hz
      exact List.mem_append_right _ hz
    · intro r hr1 hr2 z hz
      obtain ⟨x, hx, ⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩⟩ := sF2_rcover μ κ r hκ hr1 hr2
      · exact hRx x hx z ((sF2_round_mem μ κ x).2.2.2.1 i hi z hz)
      · exact hRx x hx z ((sF2_round_mem μ κ x).2.2.2.2 i hi z hz)
    · intro j hj
      obtain ⟨x, hx, h1, h2, h3⟩ := sF2_turn_cover μ κ j hκ hμ hj
      have m := (sF2_round_mem μ κ x).2.2.1
      exact ⟨hRx x hx _ (m _ h1), hRx x hx _ (m _ h2), hRx x hx _ (m _ h3)⟩
  
  have hperm : IsVertexPerm (6 * μ + 4 * κ + 1) (seedF2List μ κ) := by
    unfold IsVertexPerm
    exact ((List.subperm_of_subset List.nodup_range
      (fun w hw => hcov w (List.mem_range.mp hw))).perm_of_length_le (by simp [hlen])).symm
  
  have hedges : edgeLengths (seedF2List μ κ) = Multiset.replicate (2 * μ + 2 * κ - 1) 1 +
      Multiset.replicate (2 * μ) (2 * μ) + Multiset.replicate (2 * μ + 2 * κ + 1) (2 * μ + 2 * κ) := by
    rw [sF2_edges_assembly μ κ (by omega)
      (fun x hx => sF2_round_edges μ κ x hx (sF2_turn_gaps μ κ x hκ hμ hx)),
      sF2_sum μ κ hκ hμ]
    rw [show 4 * κ + 2 * (μ - 1 - κ) + 1 = 2 * μ + 2 * κ - 1 by omega,
      show 2 * κ + 2 * (μ - 1 - κ) + 2 = 2 * μ by omega,
      show 4 * κ + 2 * (μ - 1 - κ) + 3 = 2 * μ + 2 * κ + 1 by omega]
  
  have hbot : BotEndInv (2 * μ) (seedF2List μ κ) := by
    refine ⟨?_, ?_, ?_⟩
    · left
      obtain ⟨κ', hκ'⟩ : ∃ κ', κ = κ' + 1 := ⟨κ - 1, by omega⟩
      simp [seedF2List, hκ', List.range_succ_eq_map, sf2Round, sf2Open]
    · intro j hj1 hj2
      rw [show 2 * j - 1 = 2 * (j - 1) + 1 by omega, show 2 * j = 2 * (j - 1) + 2 by omega]
      by_cases hr : j - 1 < κ
      · exact hAdjR (j - 1) hr _ _ (sF2_round_adj μ κ (j - 1)).2.2.1
      · obtain ⟨x, hx, ⟨i, hi, hr'⟩ | ⟨i, hi, hr'⟩⟩ :=
          sF2_rcover μ κ (j - 1) hκ (by omega) (by omega)
        · rw [hr']
          exact hAdjR x hx _ _ ((sF2_round_adj μ κ x).2.2.2.1 i hi).1
        · rw [hr']
          exact hAdjR x hx _ _ ((sF2_round_adj μ κ x).2.2.2.2 i hi).1
    · intro _
      right
      simp [seedF2List, sf2Tail]
  
  have htop : TopPairInv (2 * μ + 2 * κ) (6 * μ + 4 * κ + 1) (seedF2List μ κ) := by
    refine ⟨⟨μ + κ, by ring⟩, ?_⟩
    intro j hj
    obtain ⟨i, hi⟩ : ∃ i, i = 3 * μ + 2 * κ - 1 - j := ⟨_, rfl⟩
    rw [show 6 * μ + 4 * κ + 1 - 1 - 2 * j = 2 * i + 2 by omega,
      show 6 * μ + 4 * κ + 1 - 2 - 2 * j = 2 * i + 1 by omega]
    apply swap
    by_cases h1 : i ≤ 2 * μ + 2 * κ - 1
    · obtain ⟨x, rfl⟩ : ∃ x, i = x + 2 * μ + κ := ⟨i - 2 * μ - κ, by omega⟩
      have hx : x < κ := by omega
      exact adjc _ _ _ _ _ (hAdjR x hx _ _ (sF2_round_adj μ κ x).1) (by ring) (by ring)
    · obtain ⟨r, rfl⟩ : ∃ r, i = r + 2 * μ + 2 * κ := ⟨i - 2 * μ - 2 * κ, by omega⟩
      by_cases h2 : r = μ - 1
      · refine ⟨(List.range κ).flatMap (sf2Round μ κ) ++ [2 * κ, 2 * (μ + κ), 2 * (2 * μ + κ)],
          [2 * (2 * μ + κ) - 1, 2 * μ - 1], Or.inr ?_⟩
        rw [show 2 * (r + 2 * μ + 2 * κ) + 1 = 2 * (3 * μ + 2 * κ) - 1 by omega,
          show 2 * (r + 2 * μ + 2 * κ) + 2 = 2 * (3 * μ + 2 * κ) by omega]
        simp [seedF2List, sf2Tail]
      · by_cases h3 : r < κ
        · exact hAdjR r h3 _ _ (sF2_round_adj μ κ r).2.1
        · obtain ⟨x, hx, ⟨i', hi', rfl⟩ | ⟨i', hi', rfl⟩⟩ :=
            sF2_rcover μ κ r hκ (by omega) (by omega)
          · exact hAdjR x hx _ _ ((sF2_round_adj μ κ x).2.2.2.1 i' hi').2
          · exact hAdjR x hx _ _ ((sF2_round_adj μ κ x).2.2.2.2 i' hi').2
  exact ⟨seedF2List μ κ, ⟨hperm, hedges⟩, hbot, htop⟩

theorem plus2_bot : ∀ (ℓ v : ℕ) (L : Multiset ℕ) (p : List ℕ), 4 ≤ ℓ → ℓ % 2 = 0 → ℓ ≤ v → IsLinearRealization v L p → BotEndInv ℓ p → ∃ p' : List ℕ, IsLinearRealization (v + 2) (L + Multiset.replicate 2 ℓ) p' ∧ BotEndInv ℓ p' ∧ (∀ x : ℕ, ℓ ≤ x → Adj p x (x + 1) → Adj p' (x + 2) (x + 3)) :=
by
  intro ℓ v L p h4 hℓ2 hv hp hBE
  
  have hU : ∀ (c d : ℕ) (r : List ℕ), edgeLengths (c :: d :: r) =
      (Int.natAbs ((d : ℤ) - (c : ℤ))) ::ₘ edgeLengths (d :: r) := fun _ _ _ => rfl
  have hE1 : ∀ a : ℕ, edgeLengths [a] = 0 := fun _ => rfl
  
  have el_split : ∀ (l₁ l₂ : List ℕ) (a b : ℕ), edgeLengths (l₁ ++ a :: b :: l₂) =
      edgeLengths (l₁ ++ [a]) + (Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l₂)) := by
    intro l₁ l₂ a b
    induction l₁ with
    | nil =>
      simp only [List.nil_append]
      rw [hU, hE1, zero_add]
    | cons c l ih =>
      cases l with
      | nil =>
        simp only [List.nil_append, List.cons_append] at ih ⊢
        rw [hU c a, hU c a, ih, Multiset.cons_add]
      | cons d l' =>
        simp only [List.cons_append] at ih ⊢
        rw [hU c d, hU c d, ih, Multiset.cons_add]
  
  have el_reverse : ∀ q : List ℕ, edgeLengths q.reverse = edgeLengths q := by
    intro q
    induction q with
    | nil => rfl
    | cons a r ih =>
      cases r with
      | nil => rfl
      | cons b r' =>
        have e1 : (a :: b :: r').reverse = r'.reverse ++ b :: a :: [] := by simp
        have e2 : r'.reverse ++ [b] = (b :: r').reverse := by simp
        have n : Int.natAbs ((a : ℤ) - (b : ℤ)) = Int.natAbs ((b : ℤ) - (a : ℤ)) := by omega
        rw [e1, el_split, e2, ih, hU a b, hE1, Multiset.add_cons, add_zero, n]
  
  have el_map : ∀ q : List ℕ, edgeLengths (q.map (fun x : ℕ => x + 2)) = edgeLengths q := by
    intro q
    induction q with
    | nil => rfl
    | cons a r ih =>
      cases r with
      | nil => rfl
      | cons b r' =>
        simp only [List.map_cons] at ih ⊢
        rw [hU, hU, ih]
        congr 1
        omega
  
  have hO : ∀ (l₁ l₂ m₁ m₂ : List ℕ) (a b u w : ℕ),
      m₁ ++ u :: w :: m₂ = l₁ ++ a :: b :: l₂ →
      (∃ n₁ n₂ : List ℕ, l₁ ++ [a] = n₁ ++ u :: w :: n₂) ∨
      (∃ n₁ n₂ : List ℕ, b :: l₂ = n₁ ++ u :: w :: n₂) ∨ (u = a ∧ w = b) := by
    intro l₁ l₂ m₁ m₂ a b u w h
    rw [List.append_eq_append_iff] at h
    rcases h with ⟨as, rfl, h2⟩ | ⟨bs, rfl, h2⟩
    · rcases as with _ | ⟨a₁, _ | ⟨a₂, as'⟩⟩
      · simp only [List.nil_append, List.cons.injEq] at h2
        exact Or.inr (Or.inr ⟨h2.1, h2.2.1⟩)
      · simp only [List.cons_append, List.nil_append, List.cons.injEq] at h2
        obtain ⟨rfl, rfl, rfl⟩ := h2
        exact Or.inl ⟨m₁, [], by simp⟩
      · simp only [List.cons_append, List.cons.injEq] at h2
        obtain ⟨rfl, rfl, rfl⟩ := h2
        exact Or.inl ⟨m₁, as' ++ [a], by simp⟩
    · rcases bs with _ | ⟨b₁, _ | ⟨b₂, bs'⟩⟩
      · simp only [List.nil_append, List.cons.injEq] at h2
        exact Or.inr (Or.inr ⟨h2.1.symm, h2.2.1.symm⟩)
      · simp only [List.cons_append, List.nil_append, List.cons.injEq] at h2
        obtain ⟨rfl, rfl, rfl⟩ := h2
        exact Or.inr (Or.inl ⟨[], m₂, by simp⟩)
      · simp only [List.cons_append, List.cons.injEq] at h2
        obtain ⟨rfl, rfl, rfl⟩ := h2
        exact Or.inr (Or.inl ⟨b :: bs', m₂, by simp⟩)
  have adj_split : ∀ (l₁ l₂ : List ℕ) (a b u w : ℕ), Adj (l₁ ++ a :: b :: l₂) u w →
      Adj (l₁ ++ [a]) u w ∨ Adj (b :: l₂) u w ∨ (u = a ∧ w = b) ∨ (u = b ∧ w = a) := by
    intro l₁ l₂ a b u w hA
    obtain ⟨m₁, m₂, hm | hm⟩ := hA
    · rcases hO l₁ l₂ m₁ m₂ a b u w hm.symm with ⟨n₁, n₂, h⟩ | ⟨n₁, n₂, h⟩ | h
      · exact Or.inl ⟨n₁, n₂, Or.inl h⟩
      · exact Or.inr (Or.inl ⟨n₁, n₂, Or.inl h⟩)
      · exact Or.inr (Or.inr (Or.inl h))
    · rcases hO l₁ l₂ m₁ m₂ a b w u hm.symm with ⟨n₁, n₂, h⟩ | ⟨n₁, n₂, h⟩ | h
      · exact Or.inl ⟨n₁, n₂, Or.inr h⟩
      · exact Or.inr (Or.inl ⟨n₁, n₂, Or.inr h⟩)
      · exact Or.inr (Or.inr (Or.inr ⟨h.2, h.1⟩))
  
  have adj_app : ∀ (P X R : List ℕ) (u w : ℕ), Adj X u w → Adj (P ++ X ++ R) u w := by
    intro P X R u w hA
    obtain ⟨l₁, l₂, rfl | rfl⟩ := hA
    · exact ⟨P ++ l₁, l₂ ++ R, Or.inl (by simp)⟩
    · exact ⟨P ++ l₁, l₂ ++ R, Or.inr (by simp)⟩
  have adj_rev : ∀ (X : List ℕ) (u w : ℕ), Adj X u w → Adj X.reverse u w := by
    intro X u w hA
    obtain ⟨l₁, l₂, rfl | rfl⟩ := hA
    · exact ⟨l₂.reverse, l₁.reverse, Or.inr (by simp)⟩
    · exact ⟨l₂.reverse, l₁.reverse, Or.inl (by simp)⟩
  have adj_map : ∀ (X : List ℕ) (u w : ℕ), Adj X u w →
      Adj (X.map (fun x : ℕ => x + 2)) (u + 2) (w + 2) := by
    intro X u w hA
    obtain ⟨l₁, l₂, rfl | rfl⟩ := hA
    · exact ⟨l₁.map (fun x : ℕ => x + 2), l₂.map (fun x : ℕ => x + 2), Or.inl (by simp)⟩
    · exact ⟨l₁.map (fun x : ℕ => x + 2), l₂.map (fun x : ℕ => x + 2), Or.inr (by simp)⟩
  
  have hrep : Multiset.replicate 2 ℓ = ℓ ::ₘ ℓ ::ₘ 0 := rfl
  have hlast : ∀ (X : List ℕ) (a : ℕ), (X ++ [a]).getLast? = some a := by
    intro X a
    simp
  
  have hconsI : ∀ A B : List ℕ, ∃ p' : List ℕ,
      p'.Perm (0 :: 1 :: ((2 :: A) ++ (ℓ - 1) :: ℓ :: (B ++ [ℓ + 1]))) ∧
      edgeLengths p' = edgeLengths ((2 :: A) ++ (ℓ - 1) :: ℓ :: (B ++ [ℓ + 1])) +
        Multiset.replicate 2 ℓ ∧
      p'.head? = some 0 ∧ p'.getLast? = some (ℓ - 1) ∧ Adj p' 1 2 ∧
      ∀ u w : ℕ, Adj ((2 :: A) ++ (ℓ - 1) :: ℓ :: (B ++ [ℓ + 1])) u w →
        ¬(u = ℓ - 1 ∧ w = ℓ) → ¬(u = ℓ ∧ w = ℓ - 1) → Adj p' u w := by
    intro A B
    refine ⟨0 :: ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: (A ++ [ℓ - 1])), ?_, ?_, rfl, ?_, ?_, ?_⟩
    · have e1 : 0 :: ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: (A ++ [ℓ - 1])) =
          0 :: ((ℓ :: (B ++ [ℓ + 1])) ++ 1 :: (2 :: (A ++ [ℓ - 1]))) := by simp
      have e2 : (2 :: A) ++ (ℓ - 1) :: ℓ :: (B ++ [ℓ + 1]) =
          (2 :: (A ++ [ℓ - 1])) ++ (ℓ :: (B ++ [ℓ + 1])) := by simp
      rw [e1, e2]
      exact List.Perm.cons 0 (List.perm_middle.trans (List.Perm.cons 1 List.perm_append_comm))
    · rw [hU 0 ℓ, show ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: (A ++ [ℓ - 1])) =
          (ℓ :: B) ++ (ℓ + 1) :: 1 :: (2 :: (A ++ [ℓ - 1])) from rfl, el_split, hU 1 2,
        el_split (2 :: A) (B ++ [ℓ + 1]) (ℓ - 1) ℓ]
      have n1 : Int.natAbs ((ℓ : ℤ) - ((0 : ℕ) : ℤ)) = ℓ := by omega
      have n2 : Int.natAbs (((1 : ℕ) : ℤ) - ((ℓ + 1 : ℕ) : ℤ)) = ℓ := by omega
      have n3 : Int.natAbs (((2 : ℕ) : ℤ) - ((1 : ℕ) : ℤ)) = 1 := by omega
      have n4 : Int.natAbs ((ℓ : ℤ) - ((ℓ - 1 : ℕ) : ℤ)) = 1 := by omega
      rw [n1, n2, n3, n4, hrep]
      simp only [List.cons_append]
      simp only [← Multiset.singleton_add]
      abel
    · rw [show 0 :: ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: (A ++ [ℓ - 1])) =
          (0 :: ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: A)) ++ [ℓ - 1] by simp]
      exact hlast _ _
    · exact ⟨0 :: ℓ :: (B ++ [ℓ + 1]), A ++ [ℓ - 1], Or.inl (by simp)⟩
    · intro u w h hn1 hn2
      rcases adj_split (2 :: A) (B ++ [ℓ + 1]) (ℓ - 1) ℓ u w h with hX | hY | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · have e : 0 :: ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: (A ++ [ℓ - 1])) =
            (0 :: ℓ :: (B ++ [ℓ + 1, 1])) ++ ((2 :: A) ++ [ℓ - 1]) ++ [] := by simp
        rw [e]
        exact adj_app _ _ _ u w hX
      · have e : 0 :: ℓ :: (B ++ (ℓ + 1) :: 1 :: 2 :: (A ++ [ℓ - 1])) =
            [0] ++ (ℓ :: (B ++ [ℓ + 1])) ++ (1 :: 2 :: (A ++ [ℓ - 1])) := by simp
        rw [e]
        exact adj_app _ _ _ u w hY
      · exact absurd ⟨rfl, rfl⟩ hn1
      · exact absurd ⟨rfl, rfl⟩ hn2
  
  have hconsII : ∀ A B : List ℕ, ∃ p' : List ℕ,
      p'.Perm (0 :: 1 :: ((2 :: A) ++ ℓ :: (ℓ - 1) :: (B ++ [ℓ + 1]))) ∧
      edgeLengths p' = edgeLengths ((2 :: A) ++ ℓ :: (ℓ - 1) :: (B ++ [ℓ + 1])) +
        Multiset.replicate 2 ℓ ∧
      p'.head? = some 0 ∧ p'.getLast? = some (ℓ - 1) ∧ Adj p' 1 2 ∧
      ∀ u w : ℕ, Adj ((2 :: A) ++ ℓ :: (ℓ - 1) :: (B ++ [ℓ + 1])) u w →
        ¬(u = ℓ - 1 ∧ w = ℓ) → ¬(u = ℓ ∧ w = ℓ - 1) → Adj p' u w := by
    intro A B
    refine ⟨0 :: ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: (B.reverse ++ [ℓ - 1])),
      ?_, ?_, rfl, ?_, ?_, ?_⟩
    · have e1 : 0 :: ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: (B.reverse ++ [ℓ - 1])) =
          0 :: (((2 :: A) ++ [ℓ]).reverse ++ 1 :: ((ℓ - 1) :: (B ++ [ℓ + 1])).reverse) := by
        simp
      have e2 : (2 :: A) ++ ℓ :: (ℓ - 1) :: (B ++ [ℓ + 1]) =
          ((2 :: A) ++ [ℓ]) ++ ((ℓ - 1) :: (B ++ [ℓ + 1])) := by simp
      rw [e1, e2]
      exact List.Perm.cons 0 (List.perm_middle.trans (List.Perm.cons 1
        ((List.reverse_perm _).append (List.reverse_perm _))))
    · rw [hU 0 ℓ, show ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: (B.reverse ++ [ℓ - 1])) =
          (ℓ :: A.reverse) ++ 2 :: 1 :: ((ℓ + 1) :: (B.reverse ++ [ℓ - 1])) from rfl,
        el_split, hU 1 (ℓ + 1),
        show (ℓ :: A.reverse) ++ [2] = ((2 :: A) ++ [ℓ]).reverse by simp,
        show (ℓ + 1) :: (B.reverse ++ [ℓ - 1]) = ((ℓ - 1) :: (B ++ [ℓ + 1])).reverse by simp,
        el_reverse, el_reverse, el_split (2 :: A) (B ++ [ℓ + 1]) ℓ (ℓ - 1)]
      have n1 : Int.natAbs ((ℓ : ℤ) - ((0 : ℕ) : ℤ)) = ℓ := by omega
      have n2 : Int.natAbs (((1 : ℕ) : ℤ) - ((2 : ℕ) : ℤ)) = 1 := by omega
      have n3 : Int.natAbs (((ℓ + 1 : ℕ) : ℤ) - ((1 : ℕ) : ℤ)) = ℓ := by omega
      have n4 : Int.natAbs (((ℓ - 1 : ℕ) : ℤ) - (ℓ : ℤ)) = 1 := by omega
      rw [n1, n2, n3, n4, hrep]
      simp only [← Multiset.singleton_add]
      abel
    · rw [show 0 :: ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: (B.reverse ++ [ℓ - 1])) =
          (0 :: ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: B.reverse)) ++ [ℓ - 1] by simp]
      exact hlast _ _
    · exact ⟨0 :: ℓ :: A.reverse, (ℓ + 1) :: (B.reverse ++ [ℓ - 1]), Or.inr (by simp)⟩
    · intro u w h hn1 hn2
      rcases adj_split (2 :: A) (B ++ [ℓ + 1]) ℓ (ℓ - 1) u w h with hX | hY | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · have e : 0 :: ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: (B.reverse ++ [ℓ - 1])) =
            [0] ++ ((2 :: A) ++ [ℓ]).reverse ++ (1 :: ((ℓ - 1) :: (B ++ [ℓ + 1])).reverse) := by
          simp
        rw [e]
        exact adj_app _ _ _ u w (adj_rev _ u w hX)
      · have e : 0 :: ℓ :: (A.reverse ++ 2 :: 1 :: (ℓ + 1) :: (B.reverse ++ [ℓ - 1])) =
            (0 :: ((2 :: A) ++ [ℓ]).reverse ++ [1]) ++ ((ℓ - 1) :: (B ++ [ℓ + 1])).reverse ++ [] := by
          simp
        rw [e]
        exact adj_app _ _ _ u w (adj_rev _ u w hY)
      · exact absurd ⟨rfl, rfl⟩ hn2
      · exact absurd ⟨rfl, rfl⟩ hn1
  have hcons : ∀ Q : List ℕ, (∃ A B : List ℕ, Q = (2 :: A) ++ (ℓ - 1) :: ℓ :: (B ++ [ℓ + 1]) ∨
      Q = (2 :: A) ++ ℓ :: (ℓ - 1) :: (B ++ [ℓ + 1])) → ∃ p' : List ℕ,
      p'.Perm (0 :: 1 :: Q) ∧ edgeLengths p' = edgeLengths Q + Multiset.replicate 2 ℓ ∧
      p'.head? = some 0 ∧ p'.getLast? = some (ℓ - 1) ∧ Adj p' 1 2 ∧
      ∀ u w : ℕ, Adj Q u w → ¬(u = ℓ - 1 ∧ w = ℓ) → ¬(u = ℓ ∧ w = ℓ - 1) → Adj p' u w := by
    rintro Q ⟨A, B, rfl | rfl⟩
    · exact hconsI A B
    · exact hconsII A B
  
  have peel : ∀ (l₁ l₂ : List ℕ) (α β : ℕ), (l₁ ++ α :: β :: l₂).head? = some 0 →
      (l₁ ++ α :: β :: l₂).getLast? = some (ℓ - 1) → α ≠ 0 → β ≠ ℓ - 1 →
      ∃ l₁' l₂' : List ℕ, l₁ = 0 :: l₁' ∧ l₂ = l₂' ++ [ℓ - 1] := by
    intro l₁ l₂ α β hh hl hα hβ
    have h1 : ∃ l₁' : List ℕ, l₁ = 0 :: l₁' := by
      cases l₁ with
      | nil => simp at hh; exact absurd hh hα
      | cons c l => simp at hh; exact ⟨l, by rw [hh]⟩
    have h2 : ∃ l₂' : List ℕ, l₂ = l₂' ++ [ℓ - 1] := by
      rcases List.eq_nil_or_concat l₂ with rfl | ⟨L', b, rfl⟩
      · rw [show l₁ ++ α :: β :: [] = (l₁ ++ [α]) ++ [β] by simp, hlast] at hl
        exact absurd (Option.some.inj hl) hβ
      · rw [show l₁ ++ α :: β :: L'.concat b = (l₁ ++ α :: β :: L') ++ [b] by simp, hlast] at hl
        exact ⟨L', by rw [← Option.some.inj hl]; simp⟩
    obtain ⟨l₁', h1⟩ := h1
    obtain ⟨l₂', h2⟩ := h2
    exact ⟨l₁', l₂', h1, h2⟩
  have hR : List.range (v + 2) = 0 :: 1 :: (List.range v).map (fun x : ℕ => x + 2) := by
    rw [List.range_succ_eq_map, List.range_succ_eq_map]
    simp [List.map_map, Function.comp_def]
  
  have core : ∀ q : List ℕ, q.Perm (List.range v) → edgeLengths q = L → q.head? = some 0 →
      q.getLast? = some (ℓ - 1) → (∀ j : ℕ, 1 ≤ j → 2 * j + 1 ≤ ℓ → Adj q (2 * j - 1) (2 * j)) →
      ∃ p' : List ℕ, IsLinearRealization (v + 2) (L + Multiset.replicate 2 ℓ) p' ∧
        BotEndInv ℓ p' ∧ (∀ x : ℕ, ℓ ≤ x → Adj q x (x + 1) → Adj p' (x + 2) (x + 3)) := by
    intro q hperm hel hh hl hpairs
    have hcut : Adj q (ℓ - 3) (ℓ - 2) := by
      have h := hpairs (ℓ / 2 - 1) (by omega) (by omega)
      rw [show 2 * (ℓ / 2 - 1) - 1 = ℓ - 3 by omega, show 2 * (ℓ / 2 - 1) = ℓ - 2 by omega] at h
      exact h
    have e1 : ℓ - 3 + 2 = ℓ - 1 := by omega
    have e2 : ℓ - 2 + 2 = ℓ := by omega
    have e3 : ℓ - 1 + 2 = ℓ + 1 := by omega
    have hshape : ∃ A B : List ℕ,
        q.map (fun x : ℕ => x + 2) = (2 :: A) ++ (ℓ - 1) :: ℓ :: (B ++ [ℓ + 1]) ∨
        q.map (fun x : ℕ => x + 2) = (2 :: A) ++ ℓ :: (ℓ - 1) :: (B ++ [ℓ + 1]) := by
      obtain ⟨l₁, l₂, h | h⟩ := hcut
      · obtain ⟨l₁', l₂', rfl, rfl⟩ := peel l₁ l₂ (ℓ - 3) (ℓ - 2) (h ▸ hh) (h ▸ hl)
          (by omega) (by omega)
        refine ⟨l₁'.map (fun x : ℕ => x + 2), l₂'.map (fun x : ℕ => x + 2), Or.inl ?_⟩
        rw [h]
        simp [e1, e2, e3]
      · obtain ⟨l₁', l₂', rfl, rfl⟩ := peel l₁ l₂ (ℓ - 2) (ℓ - 3) (h ▸ hh) (h ▸ hl)
          (by omega) (by omega)
        refine ⟨l₁'.map (fun x : ℕ => x + 2), l₂'.map (fun x : ℕ => x + 2), Or.inr ?_⟩
        rw [h]
        simp [e1, e2, e3]
    obtain ⟨p', hP, hE, hH, hL, h12, hT⟩ := hcons _ hshape
    refine ⟨p', ⟨?_, ?_⟩, ⟨Or.inl hH, ?_, fun _ => Or.inr hL⟩, ?_⟩
    · show p'.Perm (List.range (v + 2))
      rw [hR]
      exact hP.trans (List.Perm.cons 0 (List.Perm.cons 1 (List.Perm.map _ hperm)))
    · rw [hE, el_map, hel]
    · intro j hj1 hj2
      rcases Nat.lt_or_ge j 2 with hj | hj
      · have hj' : j = 1 := by omega
        subst hj'
        exact h12
      · have h := adj_map _ _ _ (hpairs (j - 1) (by omega) (by omega))
        rw [show 2 * (j - 1) - 1 + 2 = 2 * j - 1 by omega,
          show 2 * (j - 1) + 2 = 2 * j by omega] at h
        exact hT _ _ h (by omega) (by omega)
    · intro x hx hA
      have h := adj_map _ _ _ hA
      rw [show x + 1 + 2 = x + 3 by omega] at h
      exact hT _ _ h (by omega) (by omega)
  
  obtain ⟨h0, hpairs, hev⟩ := hBE
  have hend := hev (Nat.even_iff.mpr hℓ2)
  unfold IsEnd at h0 hend
  rcases h0 with h0 | h0 <;> rcases hend with he | he
  · have := Option.some.inj (h0.symm.trans he)
    omega
  · exact core p hp.1 hp.2 h0 he hpairs
  · obtain ⟨p', h1, h2, h3⟩ := core p.reverse ((List.reverse_perm p).trans hp.1)
      (by rw [el_reverse]; exact hp.2) (by rw [List.head?_reverse]; exact h0)
      (by rw [List.getLast?_reverse]; exact he)
      (fun j hj1 hj2 => adj_rev _ _ _ (hpairs j hj1 hj2))
    exact ⟨p', h1, h2, fun x hx hA => h3 x hx (adj_rev _ _ _ hA)⟩
  · have := Option.some.inj (h0.symm.trans he)
    omega

theorem baseAP_E_eo : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → k % 2 = 0 → b % 2 = 0 → c % 2 = 1 → y - k ≤ b → b < 2 * (y - k) → y ≤ c → c < 2 * y → ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧ (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧ (BotEndInv (y - k) p ∨ TopEndInv y (a₀ + b + c + 1) p) :=
by
  intro y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
  have adjSymm : ∀ (q : List ℕ) (u w : ℕ), Adj q u w → Adj q w u := by
    intro q u w h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  
  have stepB : ∀ (b c : ℕ) (p : List ℕ), y - k ≤ b →
      IsLinearRealization (y - 1 + b + c + 1) (prescribedLengths y k (y - 1) b c) p →
      BotEndInv (y - k) p → TopPairInv y (y - 1 + b + c + 1) p →
      ∃ p' : List ℕ, IsLinearRealization (y - 1 + (b + 2) + c + 1)
        (prescribedLengths y k (y - 1) (b + 2) c) p' ∧ BotEndInv (y - k) p' ∧
        TopPairInv y (y - 1 + (b + 2) + c + 1) p' := by
    intro b c p hb hp hBE hTP
    obtain ⟨p', hp', hBE', hsh⟩ :=
      plus2_bot (y - k) (y - 1 + b + c + 1) _ p (by omega) (by omega) (by omega) hp hBE
    have ev : y - 1 + b + c + 1 + 2 = y - 1 + (b + 2) + c + 1 := by omega
    have eL : prescribedLengths y k (y - 1) b c + Multiset.replicate 2 (y - k) =
        prescribedLengths y k (y - 1) (b + 2) c := by
      unfold prescribedLengths
      rw [Multiset.replicate_add]
      abel
    rw [ev, eL] at hp'
    refine ⟨p', hp', hBE', hTP.1, ?_⟩
    intro j hj
    have h1 := hTP.2 j hj
    have h2 : Adj p (y - 1 + b + c + 1 - 2 - 2 * j) (y - 1 + b + c + 1 - 2 - 2 * j + 1) := by
      rw [show y - 1 + b + c + 1 - 2 - 2 * j + 1 = y - 1 + b + c + 1 - 1 - 2 * j by omega]
      exact adjSymm _ _ _ h1
    have h3 := hsh _ (by omega) h2
    rw [show y - 1 + b + c + 1 - 2 - 2 * j + 2 = y - 1 + (b + 2) + c + 1 - 2 - 2 * j by omega,
      show y - 1 + b + c + 1 - 2 - 2 * j + 3 = y - 1 + (b + 2) + c + 1 - 1 - 2 * j by omega] at h3
    exact adjSymm _ _ _ h3
  
  have stepC : ∀ (b c : ℕ) (p : List ℕ), y - k ≤ b →
      IsLinearRealization (y - 1 + b + c + 1) (prescribedLengths y k (y - 1) b c) p →
      BotEndInv (y - k) p → TopPairInv y (y - 1 + b + c + 1) p →
      ∃ p' : List ℕ, IsLinearRealization (y - 1 + b + (c + 2) + 1)
        (prescribedLengths y k (y - 1) b (c + 2)) p' ∧ BotEndInv (y - k) p' ∧
        TopPairInv y (y - 1 + b + (c + 2) + 1) p' := by
    intro b c p hb hp hBE hTP
    have hpair : ∀ i : ℕ, i < 1 →
        Adj p (y - 1 + b + c + 1 - y + 2 * i) (y - 1 + b + c + 1 - y + 2 * i + 1) := by
      intro i hi
      have hi0 : i = 0 := by omega
      subst hi0
      have h := hTP.2 (y / 2 - 1) (by omega)
      rw [show y - 1 + b + c + 1 - 1 - 2 * (y / 2 - 1) = y - 1 + b + c + 1 - y + 2 * 0 + 1 by omega,
        show y - 1 + b + c + 1 - 2 - 2 * (y / 2 - 1) = y - 1 + b + c + 1 - y + 2 * 0 by omega] at h
      exact adjSymm _ _ _ h
    obtain ⟨p', hp', hnew, hkeep, hend⟩ :=
      top_pairs y (y - 1 + b + c + 1) 1 _ p (by omega) (by omega) (by omega) hp hpair
    have ev : y - 1 + b + c + 1 + 2 * 1 = y - 1 + b + (c + 2) + 1 := by omega
    have eL : prescribedLengths y k (y - 1) b c + Multiset.replicate (2 * 1) y =
        prescribedLengths y k (y - 1) b (c + 2) := by
      unfold prescribedLengths
      rw [Nat.mul_one, Multiset.replicate_add]
      abel
    rw [ev, eL] at hp'
    obtain ⟨h0, hpairs, hev⟩ := hBE
    refine ⟨p', hp', ⟨hend 0 h0, ?_, fun he => hend _ (hev he)⟩, hTP.1, ?_⟩
    · intro j hj1 hj2
      have h := hpairs j hj1 hj2
      obtain ⟨x, hx1, hx2⟩ : ∃ x, 2 * j - 1 = x ∧ 2 * j = x + 1 := ⟨2 * j - 1, rfl, by omega⟩
      rw [hx1, hx2] at h ⊢
      exact hkeep _ h (fun i hi => by omega)
    · intro j hj
      rcases Nat.eq_zero_or_pos j with hj0 | hj0
      · subst hj0
        have h := hnew 0 (by omega)
        rw [show y - 1 + b + c + 1 + 2 * 0 = y - 1 + b + (c + 2) + 1 - 2 - 2 * 0 by omega,
          show y - 1 + b + (c + 2) + 1 - 2 - 2 * 0 + 1 = y - 1 + b + (c + 2) + 1 - 1 - 2 * 0 by omega]
          at h
        exact adjSymm _ _ _ h
      · have h := hTP.2 (j - 1) (by omega)
        rw [show y - 1 + b + c + 1 - 1 - 2 * (j - 1) = y - 1 + b + c + 1 - 2 * j + 1 by omega,
          show y - 1 + b + c + 1 - 2 - 2 * (j - 1) = y - 1 + b + c + 1 - 2 * j by omega] at h
        have h' := hkeep _ (adjSymm _ _ _ h) (fun i hi => by omega)
        rw [show y - 1 + b + c + 1 - 2 * j = y - 1 + b + (c + 2) + 1 - 2 - 2 * j by omega,
          show y - 1 + b + (c + 2) + 1 - 2 - 2 * j + 1 = y - 1 + b + (c + 2) + 1 - 1 - 2 * j by omega]
          at h'
        exact adjSymm _ _ _ h'
  
  have P : ∀ i : ℕ, ∃ p : List ℕ,
      IsLinearRealization (y - 1 + (y - k + 2 * i) + (y + 1) + 1)
        (prescribedLengths y k (y - 1) (y - k + 2 * i) (y + 1)) p ∧ BotEndInv (y - k) p ∧
      TopPairInv y (y - 1 + (y - k + 2 * i) + (y + 1) + 1) p := by
    intro i
    induction i with
    | zero =>
      obtain ⟨p, hp, hBE, hTP⟩ := seedE_F2 y k hk hyk hy hk2
      have e : 2 * y + (y - k) + 1 = y - 1 + (y - k) + (y + 1) + 1 := by omega
      rw [e] at hp hTP
      simp only [Nat.mul_zero, Nat.add_zero]
      exact ⟨p, hp, hBE, hTP⟩
    | succ i ih =>
      obtain ⟨p, hp, hBE, hTP⟩ := ih
      obtain ⟨p', hp', hBE', hTP'⟩ := stepB (y - k + 2 * i) (y + 1) p (by omega) hp hBE hTP
      rw [show y - k + 2 * i + 2 = y - k + 2 * (i + 1) by omega] at hp' hTP'
      exact ⟨p', hp', hBE', hTP'⟩
  obtain ⟨i, rfl⟩ : ∃ i, b = y - k + 2 * i := ⟨(b - (y - k)) / 2, by omega⟩
  obtain ⟨j, rfl⟩ : ∃ j, c = y + 1 + 2 * j := ⟨(c - (y + 1)) / 2, by omega⟩
  
  have Q : ∀ j : ℕ, ∃ p : List ℕ,
      IsLinearRealization (y - 1 + (y - k + 2 * i) + (y + 1 + 2 * j) + 1)
        (prescribedLengths y k (y - 1) (y - k + 2 * i) (y + 1 + 2 * j)) p ∧ BotEndInv (y - k) p ∧
      TopPairInv y (y - 1 + (y - k + 2 * i) + (y + 1 + 2 * j) + 1) p := by
    intro j
    induction j with
    | zero =>
      simp only [Nat.mul_zero, Nat.add_zero]
      exact P i
    | succ j ih =>
      obtain ⟨p, hp, hBE, hTP⟩ := ih
      obtain ⟨p', hp', hBE', hTP'⟩ :=
        stepC (y - k + 2 * i) (y + 1 + 2 * j) p (by omega) hp hBE hTP
      rw [show y + 1 + 2 * j + 2 = y + 1 + 2 * (j + 1) by omega] at hp' hTP'
      exact ⟨p', hp', hBE', hTP'⟩
  obtain ⟨p, hp, hBE, hTP⟩ := Q j
  exact ⟨y - 1, by omega, p, hp, Or.inl hBE, Or.inr hTP, Or.inl hBE⟩

theorem ham_path_of_edges : ∀ (v s : ℕ) (E : List (ℕ × ℕ)), s < v → (∀ e ∈ E, e.1 < e.2 ∧ e.2 < v) → E.length + 1 = v → (∀ x a b c : ℕ, ((x, a) ∈ E ∨ (a, x) ∈ E) → ((x, b) ∈ E ∨ (b, x) ∈ E) → ((x, c) ∈ E ∨ (c, x) ∈ E) → a = b ∨ a = c ∨ b = c) → (∀ a b : ℕ, ((s, a) ∈ E ∨ (a, s) ∈ E) → ((s, b) ∈ E ∨ (b, s) ∈ E) → a = b) → (∀ x : ℕ, x < v → Relation.ReflTransGen (fun a b : ℕ => (a, b) ∈ E ∨ (b, a) ∈ E) s x) → ∃ p : List ℕ, IsLinearRealization v ((E.map (fun e : ℕ × ℕ => e.2 - e.1) : List ℕ) : Multiset ℕ) p ∧ (∀ e ∈ E, Adj p e.1 e.2) ∧ (∀ x : ℕ, x < v → (∀ a b : ℕ, ((x, a) ∈ E ∨ (a, x) ∈ E) → ((x, b) ∈ E ∨ (b, x) ∈ E) → a = b) → IsEnd p x) :=
by
  intro v s E hs hE hlen hdeg hleaf hconn
  classical
  
  have nd3 : ∀ (L l : List ℕ) (a x : ℕ), (L ++ a :: x :: a :: l).Nodup → False := by
    intro L l a x h
    have h2 := (List.nodup_cons.mp ((List.nodup_append.mp h).2.1)).1
    exact h2 (by simp)
  
  have bound : ∀ q : List ℕ, q.Nodup → (∀ x ∈ q, x < v) → q.length ≤ v := by
    intro q hnd hlt
    have hsub : q ⊆ List.range v := fun x hx => List.mem_range.mpr (hlt x hx)
    have := (List.Nodup.subperm hnd hsub).length_le
    simpa using this
  have extd : ∀ (q : List ℕ) (x w : ℕ), q.getLast? = some s → q.Nodup → (∀ y ∈ q, y < v) →
      (∀ (l₁ l₂ : List ℕ) (a b : ℕ), q = l₁ ++ a :: b :: l₂ → ((a, b) ∈ E ∨ (b, a) ∈ E)) →
      q.head? = some x → ((x, w) ∈ E ∨ (w, x) ∈ E) → w ∉ q →
      (w :: q).getLast? = some s ∧ (w :: q).Nodup ∧ (∀ y ∈ w :: q, y < v) ∧
      (∀ (l₁ l₂ : List ℕ) (a b : ℕ), w :: q = l₁ ++ a :: b :: l₂ → ((a, b) ∈ E ∨ (b, a) ∈ E)) := by
    intro q x w hl hnd hlt hc hx hxw hw
    cases q with
    | nil => simp at hl
    | cons b r =>
      simp only [List.head?_cons, Option.some.injEq] at hx
      subst hx
      refine ⟨?_, List.nodup_cons.mpr ⟨hw, hnd⟩, ?_, ?_⟩
      · rw [List.getLast?_cons_cons]; exact hl
      · intro y hy
        rcases List.mem_cons.mp hy with rfl | hy
        · rcases hxw with h | h
          · exact (hE _ h).2
          · have := hE _ h
            simp only at this
            omega
        · exact hlt y hy
      · intro l₁ l₂ a c h
        cases l₁ with
        | nil =>
          simp only [List.nil_append, List.cons.injEq] at h
          obtain ⟨rfl, rfl, rfl⟩ := h
          exact hxw.symm
        | cons d l₁' =>
          simp only [List.cons_append, List.cons.injEq] at h
          obtain ⟨rfl, h⟩ := h
          exact hc l₁' l₂ a c h
  have C : ∀ (d : ℕ) (q : List ℕ), q.getLast? = some s → q.Nodup → (∀ y ∈ q, y < v) →
      (∀ (l₁ l₂ : List ℕ) (a b : ℕ), q = l₁ ++ a :: b :: l₂ → ((a, b) ∈ E ∨ (b, a) ∈ E)) →
      v ≤ q.length + d →
      ∃ q' : List ℕ, q'.getLast? = some s ∧ q'.Nodup ∧ (∀ x ∈ q', x < v) ∧
        (∀ (l₁ l₂ : List ℕ) (a b : ℕ), q' = l₁ ++ a :: b :: l₂ → ((a, b) ∈ E ∨ (b, a) ∈ E)) ∧
        (∀ x w : ℕ, q'.head? = some x → ((x, w) ∈ E ∨ (w, x) ∈ E) → w ∈ q') := by
    intro d
    induction d with
    | zero =>
      intro q hl hnd hlt hc hv
      refine ⟨q, hl, hnd, hlt, hc, ?_⟩
      intro x w hx hxw
      by_contra hw
      obtain ⟨-, hnd', hlt', -⟩ := extd q x w hl hnd hlt hc hx hxw hw
      have := bound _ hnd' hlt'
      simp only [List.length_cons] at this
      omega
    | succ d ih =>
      intro q hl hnd hlt hc hv
      by_cases hH : ∀ x w : ℕ, q.head? = some x → ((x, w) ∈ E ∨ (w, x) ∈ E) → w ∈ q
      · exact ⟨q, hl, hnd, hlt, hc, hH⟩
      · push_neg at hH
        obtain ⟨x, w, hx, hxw, hw⟩ := hH
        obtain ⟨h1, h2, h3, h4⟩ := extd q x w hl hnd hlt hc hx hxw hw
        exact ih (w :: q) h1 h2 h3 h4 (by simp only [List.length_cons]; omega)
  obtain ⟨q, hl, hnd, hlt, hc, hh⟩ := C v [s] rfl (List.nodup_singleton s)
    (by intro y hy; simp only [List.mem_singleton] at hy; omega)
    (by
      intro l₁ l₂ a b h
      have := congrArg List.length h
      simp at this <;> omega)
    (by simp)
  
  have closed : ∀ x ∈ q, ∀ w, ((x, w) ∈ E ∨ (w, x) ∈ E) → w ∈ q := by
    intro x hx w hxw
    by_contra hw
    obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem hx
    rcases List.eq_nil_or_concat' l₁ with rfl | ⟨L, a, rfl⟩
    · exact hw (hh x w (by simp) hxw)
    · have hax : (x, a) ∈ E ∨ (a, x) ∈ E := (hc L l₂ a x (by simp)).symm
      have haq : a ∈ (L ++ [a]) ++ x :: l₂ := by simp
      cases l₂ with
      | nil =>
        have hxs : x = s := by
          simp at hl
          omega
        subst hxs
        have := hleaf a w hax hxw
        subst this
        exact hw haq
      | cons b l₂' =>
        have hxb : (x, b) ∈ E ∨ (b, x) ∈ E := hc (L ++ [a]) l₂' x b (by simp)
        have hbq : b ∈ (L ++ [a]) ++ x :: b :: l₂' := by simp
        rcases hdeg x a w b hax hxw hxb with h | h | h
        · subst h; exact hw haq
        · subst h
          exact nd3 L l₂' a x (by simpa using hnd)
        · subst h; exact hw hbq
  have cover : ∀ x : ℕ, Relation.ReflTransGen (fun a b : ℕ => (a, b) ∈ E ∨ (b, a) ∈ E) s x → x ∈ q := by
    intro x hx
    induction hx with
    | refl =>
      obtain ⟨ys, hys⟩ := List.getLast?_eq_some_iff.mp hl
      rw [hys]; simp
    | tail _ hab ih => exact closed _ ih _ hab
  have hcov : ∀ x, x < v → x ∈ q := fun x hx => cover x (hconn x hx)
  have hperm : q.Perm (List.range v) := (List.perm_ext_iff_of_nodup hnd List.nodup_range).mpr
    (fun a => ⟨fun h => List.mem_range.mpr (hlt a h), fun h => hcov a (List.mem_range.mp h)⟩)
  have hql : q.length = E.length + 1 := by rw [hperm.length_eq, List.length_range]; omega
  
  have ends : ∀ x, x ∈ q → (∀ a b : ℕ, ((x, a) ∈ E ∨ (a, x) ∈ E) → ((x, b) ∈ E ∨ (b, x) ∈ E) → a = b) →
      IsEnd q x := by
    intro x hx hl1
    obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem hx
    rcases List.eq_nil_or_concat' l₁ with rfl | ⟨L, a, rfl⟩
    · left; simp
    · cases l₂ with
      | nil => right; simp
      | cons b l₂' =>
        exfalso
        have hax := (hc L (b :: l₂') a x (by simp)).symm
        have hxb := hc (L ++ [a]) l₂' x b (by simp)
        have := hl1 a b hax hxb
        subst this
        exact nd3 L l₂' a x (by simpa using hnd)
  
  have D1 : ∀ (r : List ℕ) (a b : ℕ), (a, b) ∈ r.zip r.tail → ∃ l₁ l₂, r = l₁ ++ a :: b :: l₂ := by
    intro r
    induction r with
    | nil => intro a b h; simp at h
    | cons c r ih =>
      intro a b h
      cases r with
      | nil => simp at h
      | cons d r' =>
        simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons, Prod.mk.injEq] at h
        rcases h with ⟨rfl, rfl⟩ | h
        · exact ⟨[], r', rfl⟩
        · obtain ⟨l₁, l₂, h'⟩ := ih a b h
          exact ⟨c :: l₁, l₂, by rw [h']; rfl⟩
  have D3 : ∀ r : List ℕ, r.Nodup →
      ((r.zip r.tail).map (fun e : ℕ × ℕ => (min e.1 e.2, max e.1 e.2))).Nodup := by
    intro r
    induction r with
    | nil => intro _; simp
    | cons c r ih =>
      intro hnd'
      cases r with
      | nil => simp
      | cons d r' =>
        have hnd2 := List.nodup_cons.mp hnd'
        simp only [List.tail_cons, List.zip_cons_cons, List.map_cons]
        refine List.nodup_cons.mpr ⟨?_, ih hnd2.2⟩
        intro hmem
        obtain ⟨⟨e1, e2⟩, he, heq⟩ := List.mem_map.mp hmem
        have h1 : e1 ∈ d :: r' := (List.of_mem_zip he).1
        have h2 : e2 ∈ d :: r' := List.mem_cons_of_mem _ (List.of_mem_zip he).2
        simp only [Prod.mk.injEq] at heq
        obtain ⟨heq1, heq2⟩ := heq
        have hc' : c = e1 ∨ c = e2 := by omega
        rcases hc' with rfl | rfl
        · exact hnd2.1 h1
        · exact hnd2.1 h2
  have D6 : ∀ r : List ℕ, edgeLengths r =
      ((((r.zip r.tail).map (fun e : ℕ × ℕ => (min e.1 e.2, max e.1 e.2))).map
        (fun e : ℕ × ℕ => e.2 - e.1) : List ℕ) : Multiset ℕ) := by
    intro r
    induction r with
    | nil => simp [edgeLengths]
    | cons c r ih =>
      cases r with
      | nil => simp [edgeLengths]
      | cons d r' =>
        have e1 : edgeLengths (c :: d :: r') =
            Int.natAbs ((d : ℤ) - (c : ℤ)) ::ₘ edgeLengths (d :: r') := by
          simp [edgeLengths]
        have e2 : Int.natAbs ((d : ℤ) - (c : ℤ)) = max c d - min c d := by omega
        rw [e1, ih, e2]
        simp only [List.tail_cons, List.zip_cons_cons, List.map_cons, Multiset.cons_coe]
  set P := (q.zip q.tail).map (fun e : ℕ × ℕ => (min e.1 e.2, max e.1 e.2)) with hP
  have D2 : P ⊆ E := by
    intro e he
    obtain ⟨⟨a, b⟩, hab, rfl⟩ := List.mem_map.mp he
    obtain ⟨l₁, l₂, hq⟩ := D1 q a b hab
    rcases hc l₁ l₂ a b hq with h | h
    · have := (hE _ h).1
      simp only at this
      have e : (min a b, max a b) = (a, b) := by
        simp only [Prod.mk.injEq]; constructor <;> omega
      simp only
      rw [e]; exact h
    · have := (hE _ h).1
      simp only at this
      have e : (min a b, max a b) = (b, a) := by
        simp only [Prod.mk.injEq]; constructor <;> omega
      simp only
      rw [e]; exact h
  have D4 : P.length = E.length := by
    rw [hP, List.length_map, List.length_zip, List.length_tail]
    omega
  have D5 : P.Perm E := (List.Nodup.subperm (D3 q hnd) D2).perm_of_length_le (le_of_eq D4.symm)
  have hL : edgeLengths q = ((E.map (fun e : ℕ × ℕ => e.2 - e.1) : List ℕ) : Multiset ℕ) := by
    rw [D6 q]
    exact Multiset.coe_eq_coe.mpr (D5.map _)
  have hA : ∀ e ∈ E, Adj q e.1 e.2 := by
    intro e he
    have heP : e ∈ P := D5.symm.subset he
    obtain ⟨⟨a, b⟩, hab, rfl⟩ := List.mem_map.mp heP
    obtain ⟨l₁, l₂, hq⟩ := D1 q a b hab
    simp only
    rcases le_total a b with h | h
    · rw [min_eq_left h, max_eq_right h]; exact ⟨l₁, l₂, Or.inl hq⟩
    · rw [min_eq_right h, max_eq_left h]; exact ⟨l₁, l₂, Or.inr hq⟩
  exact ⟨q, ⟨hperm, hL⟩, hA, fun x hx hx1 => ends x (hcov x hx) hx1⟩

theorem F3b_edges_connected : ∀ (μ κ : ℕ), 1 ≤ κ → 2 * κ + 1 ≤ μ → ∀ E : List (ℕ × ℕ), E = (List.range (2 * μ + κ)).map (fun r => (2 * r + 1, 2 * r + 2 * μ + 2 * κ + 1)) ++ [(0, 2 * μ), (2 * μ, 4 * μ), (4 * μ, 6 * μ)] ++ (List.range κ).map (fun i => (2 * i + 2, 2 * i + 2 * μ + 2 * κ + 2)) ++ (List.range κ).map (fun i => (2 * i + 2 * κ + 2, 2 * i + 2 * μ + 2 * κ + 2)) ++ (List.range (μ - 2 * κ - 1)).map (fun i => (2 * i + 4 * κ + 2, 2 * i + 2 * μ + 4 * κ + 2)) ++ (List.range (μ - 2 * κ - 1)).map (fun i => (2 * i + 2 * μ + 4 * κ + 2, 2 * i + 4 * μ + 4 * κ + 2)) ++ (List.range κ).map (fun i => (2 * i + 2 * μ + 2, 2 * i + 4 * μ + 2)) ++ (List.range κ).map (fun i => (2 * i + 4 * μ + 2, 2 * i + 6 * μ + 2)) ++ (List.range κ).map (fun i => (2 * i + 4 * μ + 2 * κ + 2, 2 * i + 6 * μ + 2 * κ + 2)) ++ (List.range μ).map (fun i => (2 * i, 2 * i + 1)) ++ (List.range (μ + κ - 1)).map (fun i => (2 * i + 4 * μ + 2 * κ + 2, 2 * i + 4 * μ + 2 * κ + 3)) ++ (List.range κ).map (fun i => (2 * i + 2 * μ + 1, 2 * i + 2 * μ + 2)) → ∀ x : ℕ, x < 6 * μ + 4 * κ + 1 → Relation.ReflTransGen (fun a b : ℕ => (a, b) ∈ E ∨ (b, a) ∈ E) (6 * μ + 4 * κ) x :=
by
  intro μ κ hκ hμ E hE
  have main : ∀ R : ℕ → ℕ → Prop, (∀ a b : ℕ, R a b → R b a) →
      (∀ r : ℕ, r < 2 * μ + κ → R (2 * r + 1) (2 * r + 2 * μ + 2 * κ + 1)) →
      R 0 (2 * μ) → R (2 * μ) (4 * μ) → R (4 * μ) (6 * μ) →
      (∀ i : ℕ, i < κ → R (2 * i + 2) (2 * i + 2 * μ + 2 * κ + 2)) →
      (∀ i : ℕ, i < κ → R (2 * i + 2 * κ + 2) (2 * i + 2 * μ + 2 * κ + 2)) →
      (∀ i : ℕ, i < μ - 2 * κ - 1 → R (2 * i + 4 * κ + 2) (2 * i + 2 * μ + 4 * κ + 2)) →
      (∀ i : ℕ, i < μ - 2 * κ - 1 → R (2 * i + 2 * μ + 4 * κ + 2) (2 * i + 4 * μ + 4 * κ + 2)) →
      (∀ i : ℕ, i < κ → R (2 * i + 2 * μ + 2) (2 * i + 4 * μ + 2)) →
      (∀ i : ℕ, i < κ → R (2 * i + 4 * μ + 2) (2 * i + 6 * μ + 2)) →
      (∀ i : ℕ, i < κ → R (2 * i + 4 * μ + 2 * κ + 2) (2 * i + 6 * μ + 2 * κ + 2)) →
      (∀ i : ℕ, i < μ → R (2 * i) (2 * i + 1)) →
      (∀ i : ℕ, i < μ + κ - 1 → R (2 * i + 4 * μ + 2 * κ + 2) (2 * i + 4 * μ + 2 * κ + 3)) →
      (∀ i : ℕ, i < κ → R (2 * i + 2 * μ + 1) (2 * i + 2 * μ + 2)) →
      ∀ x : ℕ, x < 6 * μ + 4 * κ + 1 → Relation.ReflTransGen R (6 * μ + 4 * κ) x := by
    intro R hR hFB hL1 hL2 hL3 hFC1 hFC2 hFS1 hFS2 hFS3 hFS4 hFP hFV1 hFV2 hFD
    have rc : ∀ u w u' w' : ℕ, R u w → u = u' → w = w' → R u' w' := by
      rintro u w _ _ h rfl rfl; exact h
    have rs : ∀ u w u' w' : ℕ, R u w → w = u' → u = w' → R u' w' := by
      rintro u w _ _ h rfl rfl; exact hR _ _ h
    have cv : ∀ a b c d : ℕ, Relation.ReflTransGen R a b → a = c → b = d →
        Relation.ReflTransGen R c d := by
      rintro a b _ _ h rfl rfl; exact h
    have sy : ∀ a b : ℕ, Relation.ReflTransGen R a b → Relation.ReflTransGen R b a :=
      fun a b h => Relation.ReflTransGen.symmetric (fun x y hxy => hR x y hxy) h
    have hh : ∀ a b c : ℕ, R a b → Relation.ReflTransGen R b c → Relation.ReflTransGen R a c :=
      fun a b c h1 h2 => Relation.ReflTransGen.head h1 h2
    have sg : ∀ a b : ℕ, R a b → Relation.ReflTransGen R a b :=
      fun a b h => Relation.ReflTransGen.single h
    
    have line : ∀ q j : ℕ, 1 ≤ j → j ≤ κ → κ * q + j ≤ μ + κ → κ * q + j ≠ μ →
        Relation.ReflTransGen R (2 * (κ * q + j)) (2 * j) := by
      intro q
      induction q using Nat.strong_induction_on with
      | _ q ih =>
        intro j hj1 hj2 hb1 hb2
        rcases (show q = 0 ∨ q = 1 ∨ 2 ≤ q by omega) with rfl | rfl | hq
        · exact cv (2 * j) (2 * j) _ _ Relation.ReflTransGen.refl (by simp) rfl
        · rw [Nat.mul_one]
          refine hh _ (2 * j + 2 * μ + 2 * κ) _
            (rc _ _ _ _ (hFC2 (j - 1) (by omega)) (by omega) (by omega)) ?_
          exact sg _ _ (rs _ _ _ _ (hFC1 (j - 1) (by omega)) (by omega) (by omega))
        · obtain ⟨q₁, rfl⟩ : ∃ q₁, q = q₁ + 2 := ⟨q - 2, by omega⟩
          have e2 : κ * (q₁ + 2) = κ * q₁ + 2 * κ := by ring
          rw [e2] at hb1 hb2 ⊢
          have hih := ih q₁ (by omega) j hj1 hj2 (by omega) (by omega)
          have h1 : Relation.ReflTransGen R (2 * (κ * q₁ + 2 * κ + j))
              (2 * (κ * q₁ + 2 * κ + j) + 4 * μ) := by
            rcases lt_or_gt_of_ne hb2 with hlt | hgt
            · refine hh _ (2 * (κ * q₁ + 2 * κ + j) + 2 * μ) _
                (rc _ _ _ _ (hFS1 (κ * q₁ + j - 1) (by omega)) (by omega) (by omega)) ?_
              exact sg _ _ (rc _ _ _ _ (hFS2 (κ * q₁ + j - 1) (by omega)) (by omega) (by omega))
            · refine hh _ (2 * (κ * q₁ + 2 * κ + j) + 2 * μ) _
                (rc _ _ _ _ (hFS3 (κ * q₁ + 2 * κ + j - μ - 1) (by omega)) (by omega)
                  (by omega)) ?_
              exact sg _ _ (rc _ _ _ _ (hFS4 (κ * q₁ + 2 * κ + j - μ - 1) (by omega)) (by omega)
                (by omega))
          refine h1.trans ?_
          refine hh _ (2 * (κ * q₁ + 2 * κ + j) + 4 * μ + 1) _
            (rc _ _ _ _ (hFV2 (κ * q₁ + κ + j - 1) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (2 * (κ * q₁ + κ + j + μ) + 1) _
            (rs _ _ _ _ (hFB (κ * q₁ + κ + j + μ) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (2 * (κ * q₁ + j) + 1) _
            (rs _ _ _ _ (hFB (κ * q₁ + j) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (2 * (κ * q₁ + j)) _
            (rs _ _ _ _ (hFV1 (κ * q₁ + j) (by omega)) (by omega) (by omega)) ?_
          exact hih
    
    have zH : ∀ n : ℕ, μ + 1 + n ≤ μ + κ →
        Relation.ReflTransGen R (2 * (μ + 1 + n)) (2 * μ + 2) := by
      intro n
      induction n with
      | zero => intro _; exact cv _ _ _ _ Relation.ReflTransGen.refl rfl (by ring)
      | succ n ih =>
        intro hn
        have ih' := ih (by omega)
        
        have hP : Relation.ReflTransGen R (2 * (μ + 1 + (n + 1))) (2 * (μ + n + 1 - κ)) := by
          refine hh _ (2 * μ + 2 * n + 3) _
            (rs _ _ _ _ (hFD (n + 1) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (4 * μ + 2 * n + 2 * κ + 3) _
            (rc _ _ _ _ (hFB (μ + n + 1) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (4 * μ + 2 * n + 2 * κ + 2) _
            (rs _ _ _ _ (hFV2 n (by omega)) (by omega) (by omega)) ?_
          refine hh _ (6 * μ + 2 * n + 2 * κ + 2) _
            (rc _ _ _ _ (hFP n (by omega)) (by omega) (by omega)) ?_
          refine hh _ (6 * μ + 2 * n + 2 * κ + 3) _
            (rc _ _ _ _ (hFV2 (μ + n) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (4 * μ + 2 * n + 3) _
            (rs _ _ _ _ (hFB (2 * μ + n + 1) (by omega)) (by omega) (by omega)) ?_
          refine hh _ (2 * (μ + n + 1 - κ) + 1) _
            (rs _ _ _ _ (hFB (μ + n + 1 - κ) (by omega)) (by omega) (by omega)) ?_
          exact sg _ _ (rs _ _ _ _ (hFV1 (μ + n + 1 - κ) (by omega)) (by omega) (by omega))
        
        have hz1 := Nat.div_add_mod (μ + n) κ
        have hz2 := Nat.mod_lt (μ + n) (show κ > 0 by omega)
        obtain ⟨d, hd1⟩ : ∃ d, (μ + n) / κ = d := ⟨_, rfl⟩
        obtain ⟨r, hr1⟩ : ∃ r, (μ + n) % κ = r := ⟨_, rfl⟩
        rw [hd1, hr1] at hz1
        rw [hr1] at hz2
        rcases Nat.eq_zero_or_pos d with rfl | hdpos
        · rw [Nat.mul_zero, Nat.zero_add] at hz1
          omega
        · obtain ⟨d₁, rfl⟩ : ∃ d₁, d = d₁ + 1 := ⟨d - 1, by omega⟩
          have e3 : κ * (d₁ + 1) = κ * d₁ + κ := by ring
          rw [e3] at hz1
          have l1 := line (d₁ + 1) (r + 1) (by omega) (by omega) (by rw [e3]; omega)
            (by rw [e3]; omega)
          have l2 := line d₁ (r + 1) (by omega) (by omega) (by omega) (by omega)
          rw [e3] at l1
          refine hP.trans ?_
          refine (cv _ _ _ _ l2 (by omega) rfl).trans ?_
          refine (sy _ _ l1).trans ?_
          exact cv _ _ _ _ ih' (by omega) rfl
    have hbot : ∀ β : ℕ, 1 ≤ β → β ≤ μ + κ → β ≠ μ →
        Relation.ReflTransGen R (2 * β) (2 * μ + 2) := by
      intro β hβ1 hβ2 hβ3
      have hz1 := Nat.div_add_mod (β - 1) κ
      have hz2 := Nat.mod_lt (β - 1) (show κ > 0 by omega)
      have hm1 := Nat.div_add_mod μ κ
      have hm2 := Nat.mod_lt μ (show κ > 0 by omega)
      obtain ⟨d, hd1⟩ : ∃ d, (β - 1) / κ = d := ⟨_, rfl⟩
      obtain ⟨r, hr1⟩ : ∃ r, (β - 1) % κ = r := ⟨_, rfl⟩
      obtain ⟨q0, hq1⟩ : ∃ q0, μ / κ = q0 := ⟨_, rfl⟩
      obtain ⟨s0, hs1⟩ : ∃ s0, μ % κ = s0 := ⟨_, rfl⟩
      rw [hd1, hr1] at hz1
      rw [hr1] at hz2
      rw [hq1, hs1] at hm1
      rw [hs1] at hm2
      have l1 := line d (r + 1) (by omega) (by omega) (by omega) (by omega)
      refine (cv _ _ _ _ l1 (by omega) rfl).trans ?_
      by_cases hrs : s0 < r + 1
      · have l2 := line q0 (r + 1) (by omega) (by omega) (by omega) (by omega)
        refine (sy _ _ l2).trans ?_
        exact cv _ _ _ _ (zH (κ * q0 + (r + 1) - μ - 1) (by omega)) (by omega) rfl
