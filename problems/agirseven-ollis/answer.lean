theorem baseB_okO_EE : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2
  
  have flip : ∀ (v : ℕ) (L : Multiset ℕ) (q : List ℕ), y ≤ v → IsLinearRealization v L q →
      BotEndInv y q →
      IsLinearRealization v L (q.map (fun x => v - 1 - x)) ∧
        TopEndInv y v (q.map (fun x => v - 1 - x)) := by
    intro v L q hv hq hbot
    obtain ⟨hR, hA, hE⟩ := reflect_realization v L q hq
    obtain ⟨h0, hpair, -⟩ := hbot
    refine ⟨hR, ?_⟩
    unfold TopEndInv
    refine ⟨?_, ?_, ?_⟩
    · have h := hE 0 (by omega) h0
      rw [Nat.sub_zero] at h
      exact h
    · intro j hj1 hj2
      have h := hA (2 * j - 1) (2 * j) (by omega) (by omega) (hpair j hj1 hj2)
      rw [show v - 1 - (2 * j - 1) = v - 2 * j by omega] at h
      exact h
    · intro he
      rw [Nat.even_iff] at he
      omega
  
  suffices H : ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ q : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) q ∧ BotEndInv y q by
    obtain ⟨a₀, ha, hv, q, hq, hbot⟩ := H
    have hf := flip _ _ q hv hq hbot
    exact ⟨a₀, ha, hv, _, hf.1, hf.2⟩
  by_cases h1 : b = 0 ∨ y - k ≤ c
  · exact okEE_F1 y k b c hk hyk hy hk2 hb hc hb2 hc2 h1
  by_cases h2 : c = 0
  · exact okEE_F2 y k b c hk hyk hy hk2 hb hc hb2 hc2 h2
  by_cases h3 : c ≤ k + 1
  · by_cases h4 : c ≤ b + 2
    · exact okEE_Q8 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h3 h4
    · exact okEE_P5 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega) h3
  by_cases h5 : b + c ≤ y + 1
  · exact okEE_P4 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h5
  by_cases h6 : b + 2 * c + 1 ≤ y + (y - k)
  · exact okEE_G1 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega) (by omega) h6
  · exact okEE_G2 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega) (by omega) (by omega)

theorem eoSeed_perm : ∀ (y k r : ℕ), 1 ≤ k → 2 * k < y → 2 * r + 3 ≤ k → (eoSeed y k r).Perm (List.range (y + 4 * r + 4)) :=
by
  intro y k r hk hyk hr
  have hblk : ∀ m n : ℕ, ((List.range n).flatMap (fun i => eoBlk y m i)).length = 6 * n := by
    intro m n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [List.range_succ, List.flatMap_append, List.length_append, ih]
      simp [eoBlk]
      ring
  have hlen : (eoSeed y k r).length = y + 4 * r + 4 := by
    unfold eoSeed
    simp only [List.length_append, List.length_map, List.length_range, hblk, List.length_cons,
      List.length_nil]
    omega
  have hA : ∀ x, y + 2 * r + 3 ≤ x → x < y + 4 * r + 4 →
      x ∈ (List.range (2 * r + 1)).map (fun i => y + 4 * r + 3 - i) := by
    intro x h1 h2
    exact List.mem_map.mpr ⟨y + 4 * r + 3 - x, List.mem_range.mpr (by omega), by omega⟩
  have hB : ∀ x, 2 * r + 3 ≤ x → x ≤ y - k + 2 →
      x ∈ (List.range (y - k - 2 * r)).map (fun i => 2 * r + 3 + i) := by
    intro x h1 h2
    exact List.mem_map.mpr ⟨x - (2 * r + 3), List.mem_range.mpr (by omega), by omega⟩
  have hC : ∀ x, (∃ i, i < r ∧ (x = y - k + 3 + 2 * i ∨ x = 3 + 2 * i ∨ x = y + 3 + 2 * i ∨
      x = y + 4 + 2 * i ∨ x = 4 + 2 * i ∨ x = y - k + 4 + 2 * i)) →
      x ∈ (List.range r).flatMap (fun i => eoBlk y (y - k) i) := by
    rintro x ⟨i, hi, h⟩
    rw [List.mem_flatMap]
    refine ⟨i, List.mem_range.mpr hi, ?_⟩
    unfold eoBlk
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    omega
  have hD : ∀ x, y - k + 2 * r + 3 ≤ x → x ≤ y →
      x ∈ (List.range (k - 2 * r - 2)).map (fun i => y - k + 2 * r + 3 + i) := by
    intro x h1 h2
    exact List.mem_map.mpr ⟨x - (y - k + 2 * r + 3), List.mem_range.mpr (by omega), by omega⟩
  have hE : ∀ x, (x = 0 ∨ x = 1 ∨ x = 2 ∨ x = y + 2 ∨ x = y + 1) →
      x ∈ ([0, 1, 2, y + 2, y + 1] : List ℕ) := by
    intro x h
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    omega
  have hcov : ∀ x, x < y + 4 * r + 4 → x ∈ eoSeed y k r := by
    intro x hx
    unfold eoSeed
    simp only [List.mem_append]
    by_cases c1 : x ≤ 2
    · exact Or.inr (hE x (by omega))
    by_cases c2 : x ≤ 2 * r + 2
    · exact Or.inl (Or.inl (Or.inr (hC x ⟨(x - 3) / 2, by omega, by omega⟩)))
    by_cases c3 : x ≤ y - k + 2
    · exact Or.inl (Or.inl (Or.inl (Or.inr (hB x (by omega) c3))))
    by_cases c4 : x ≤ y - k + 2 * r + 2
    · exact Or.inl (Or.inl (Or.inr (hC x ⟨(x - (y - k) - 3) / 2, by omega, by omega⟩)))
    by_cases c5 : x ≤ y
    · exact Or.inl (Or.inr (hD x (by omega) c5))
    by_cases c6 : x ≤ y + 2
    · exact Or.inr (hE x (by omega))
    by_cases c7 : x ≤ y + 2 * r + 2
    · exact Or.inl (Or.inl (Or.inr (hC x ⟨(x - y - 3) / 2, by omega, by omega⟩)))
    · exact Or.inl (Or.inl (Or.inl (Or.inl (hA x (by omega) hx))))
  have hsub : (List.range (y + 4 * r + 4)).Subperm (eoSeed y k r) :=
    List.nodup_range.subperm (fun x hx => hcov x (List.mem_range.mp hx))
  exact (hsub.perm_of_length_le (by rw [hlen, List.length_range])).symm

theorem eoSeed_edges : ∀ (y k r : ℕ), 1 ≤ k → 2 * k < y → 2 * r + 3 ≤ k → edgeLengths (eoSeed y k r) = prescribedLengths y k y (2 * r) (2 * r + 3) :=
by
  have hU : ∀ (c d : ℕ) (t : List ℕ), edgeLengths (c :: d :: t) =
      Int.natAbs ((d : ℤ) - (c : ℤ)) ::ₘ edgeLengths (d :: t) := fun c d t => rfl
  have hC : ∀ (c h : ℕ) (L : List ℕ), L.head? = some h →
      edgeLengths (c :: L) = Int.natAbs ((h : ℤ) - (c : ℤ)) ::ₘ edgeLengths L := by
    intro c h L hL
    cases L with
    | nil => simp at hL
    | cons d t =>
      simp only [List.head?_cons, Option.some.injEq] at hL
      subst hL
      rfl
  have up : ∀ (a n h : ℕ) (L : List ℕ), L.head? = some h →
      edgeLengths ((List.range (n + 1)).map (fun i => a + i) ++ L) =
        Multiset.replicate n 1 + Multiset.replicate 1 (Int.natAbs ((h : ℤ) - ((a + n : ℕ) : ℤ))) +
          edgeLengths L := by
    intro a n
    induction n with
    | zero =>
      intro h L hL
      rw [show List.range (0 + 1) = [0] from rfl]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [hC _ h L hL]
      simp
    | succ n ih =>
      intro h L hL
      rw [List.range_succ, List.map_append, List.append_assoc]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [ih (a + (n + 1)) _ (by simp), hC _ h L hL]
      have e1 : Int.natAbs (((a + (n + 1) : ℕ) : ℤ) - ((a + n : ℕ) : ℤ)) = 1 := by omega
      rw [e1, Multiset.replicate_one, Multiset.replicate_one, Multiset.replicate_succ]
      simp only [← Multiset.singleton_add]
      abel
  have down : ∀ (a n h : ℕ) (L : List ℕ), n ≤ a → L.head? = some h →
      edgeLengths ((List.range (n + 1)).map (fun i => a - i) ++ L) =
        Multiset.replicate n 1 + Multiset.replicate 1 (Int.natAbs ((h : ℤ) - ((a - n : ℕ) : ℤ))) +
          edgeLengths L := by
    intro a n
    induction n with
    | zero =>
      intro h L _ hL
      rw [show List.range (0 + 1) = [0] from rfl]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [hC _ h L hL]
      simp
    | succ n ih =>
      intro h L hn hL
      rw [List.range_succ, List.map_append, List.append_assoc]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [ih (a - (n + 1)) _ (by omega) (by simp), hC _ h L hL]
      have e1 : Int.natAbs (((a - (n + 1) : ℕ) : ℤ) - ((a - n : ℕ) : ℤ)) = 1 := by omega
      rw [e1, Multiset.replicate_one, Multiset.replicate_one, Multiset.replicate_succ]
      simp only [← Multiset.singleton_add]
      abel
  have blk : ∀ (y m r : ℕ) (L : List ℕ), L.head? = some (m + 3 + 2 * r) →
      edgeLengths ((List.range r).flatMap (fun i => eoBlk y m i) ++ L) =
        Multiset.replicate (2 * r) 1 + Multiset.replicate (2 * r) m +
          Multiset.replicate (2 * r) y + edgeLengths L := by
    intro y m r
    induction r with
    | zero => intro L _; simp
    | succ r ih =>
      intro L hL
      rw [List.range_succ, List.flatMap_append, List.flatMap_singleton, List.append_assoc]
      rw [ih _ (by simp [eoBlk])]
      obtain ⟨t, rfl⟩ : ∃ t, L = (m + 3 + 2 * (r + 1)) :: t := by
        cases L with
        | nil => simp at hL
        | cons d t =>
          simp only [List.head?_cons, Option.some.injEq] at hL
          exact ⟨t, by rw [hL]⟩
      simp only [eoBlk, List.cons_append, List.nil_append]
      rw [hU, hU, hU, hU, hU, hU]
      have e1 : Int.natAbs (((3 + 2 * r : ℕ) : ℤ) - ((m + 3 + 2 * r : ℕ) : ℤ)) = m := by omega
      have e2 : Int.natAbs (((y + 3 + 2 * r : ℕ) : ℤ) - ((3 + 2 * r : ℕ) : ℤ)) = y := by omega
      have e3 : Int.natAbs (((y + 4 + 2 * r : ℕ) : ℤ) - ((y + 3 + 2 * r : ℕ) : ℤ)) = 1 := by omega
      have e4 : Int.natAbs (((4 + 2 * r : ℕ) : ℤ) - ((y + 4 + 2 * r : ℕ) : ℤ)) = y := by omega
      have e5 : Int.natAbs (((m + 4 + 2 * r : ℕ) : ℤ) - ((4 + 2 * r : ℕ) : ℤ)) = m := by omega
      have e6 : Int.natAbs (((m + 3 + 2 * (r + 1) : ℕ) : ℤ) - ((m + 4 + 2 * r : ℕ) : ℤ)) = 1 := by
        omega
      rw [e1, e2, e3, e4, e5, e6]
      rw [show 2 * (r + 1) = 2 * r + 1 + 1 by ring]
      simp only [Multiset.replicate_succ, ← Multiset.singleton_add]
      abel
  intro y k r hk hyk hr
  have hm : 2 * r + 4 ≤ y - k := by omega
  unfold eoSeed
  simp only [List.append_assoc]
  rw [show y - k - 2 * r = (y - k - 2 * r - 1) + 1 by omega,
    show k - 2 * r - 2 = (k - 2 * r - 3) + 1 by omega]
  have hZ : edgeLengths [0, 1, 2, y + 2, y + 1] = 1 ::ₘ 1 ::ₘ y ::ₘ 1 ::ₘ 0 := by
    rw [hU, hU, hU, hU]
    have h0 : edgeLengths [y + 1] = 0 := rfl
    have e1 : Int.natAbs (((1 : ℕ) : ℤ) - ((0 : ℕ) : ℤ)) = 1 := by omega
    have e2 : Int.natAbs (((2 : ℕ) : ℤ) - ((1 : ℕ) : ℤ)) = 1 := by omega
    have e3 : Int.natAbs (((y + 2 : ℕ) : ℤ) - ((2 : ℕ) : ℤ)) = y := by omega
    have e4 : Int.natAbs (((y + 1 : ℕ) : ℤ) - ((y + 2 : ℕ) : ℤ)) = 1 := by omega
    rw [h0, e1, e2, e3, e4]
  have hBZ := up (y - k + 2 * r + 3) (k - 2 * r - 3) 0 [0, 1, 2, y + 2, y + 1] rfl
  have eBZ : Int.natAbs (((0 : ℕ) : ℤ) - ((y - k + 2 * r + 3 + (k - 2 * r - 3) : ℕ) : ℤ)) = y := by
    omega
  rw [eBZ] at hBZ
  have hBlk := blk y (y - k) r
    ((List.range (k - 2 * r - 3 + 1)).map (fun i => y - k + 2 * r + 3 + i) ++ [0, 1, 2, y + 2, y + 1])
    (by
      rw [List.range_succ_eq_map]
      simp only [List.map_cons, List.cons_append, List.head?_cons, Option.some.injEq]
      omega)
  have hA := up (2 * r + 3) (y - k - 2 * r - 1) (y - k + 3)
    ((List.range r).flatMap (fun i => eoBlk y (y - k) i) ++
      ((List.range (k - 2 * r - 3 + 1)).map (fun i => y - k + 2 * r + 3 + i) ++ [0, 1, 2, y + 2, y + 1]))
    (by
      cases r with
      | zero =>
        rw [List.range_succ_eq_map]
        simp only [List.range_zero, List.flatMap_nil, List.nil_append, List.map_cons,
          List.cons_append, List.head?_cons, Option.some.injEq]
        all_goals omega
      | succ r' =>
        rw [List.range_succ_eq_map]
        simp only [List.flatMap_cons, eoBlk, List.cons_append, List.head?_cons, Option.some.injEq]
        all_goals omega)
  have eA : Int.natAbs (((y - k + 3 : ℕ) : ℤ) - ((2 * r + 3 + (y - k - 2 * r - 1) : ℕ) : ℤ)) = 1 := by
    omega
  rw [eA] at hA
  have hT := down (y + 4 * r + 3) (2 * r) (2 * r + 3)
    ((List.range (y - k - 2 * r - 1 + 1)).map (fun i => 2 * r + 3 + i) ++
      ((List.range r).flatMap (fun i => eoBlk y (y - k) i) ++
        ((List.range (k - 2 * r - 3 + 1)).map (fun i => y - k + 2 * r + 3 + i) ++
          [0, 1, 2, y + 2, y + 1])))
    (by omega)
    (by
      rw [List.range_succ_eq_map]
      simp only [List.map_cons, List.cons_append, List.head?_cons, Option.some.injEq]
      all_goals omega)
  have eT : Int.natAbs (((2 * r + 3 : ℕ) : ℤ) - ((y + 4 * r + 3 - 2 * r : ℕ) : ℤ)) = y := by
    omega
  rw [eT] at hT
  rw [hT, hA, hBlk, hBZ, hZ]
  unfold prescribedLengths
  have ey : Multiset.replicate y 1 = Multiset.replicate (2 * r) 1 +
      Multiset.replicate (y - k - 2 * r - 1) 1 + Multiset.replicate 1 1 +
      Multiset.replicate (2 * r) 1 + Multiset.replicate (k - 2 * r - 3) 1 +
      Multiset.replicate 1 1 + Multiset.replicate 1 1 + Multiset.replicate 1 1 := by
    simp only [← Multiset.replicate_add]
    congr 1
    omega
  have e3 : Multiset.replicate (2 * r + 3) y = Multiset.replicate (2 * r) y +
      Multiset.replicate 1 y + Multiset.replicate 1 y + Multiset.replicate 1 y := by
    simp only [← Multiset.replicate_add]
  rw [ey, e3]
  simp only [Multiset.replicate_one, ← Multiset.singleton_add]
  abel

theorem eoSeed_slots : ∀ (y k r : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → 2 * r + 3 ≤ k → IsEnd (eoSeed y k r) (y + 4 * r + 3) ∧ (∀ x : ℕ, x % 2 = 0 → 4 * r + 4 ≤ x → x ≤ y + 4 * r + 1 → Adj (eoSeed y k r) x (x + 1)) ∧ (∀ x : ℕ, y - k + 2 * r + 3 ≤ x → x + 1 ≤ y → Adj (eoSeed y k r) x (x + 1)) :=
by
  intro y k r hk hyk hy hk2 hr
  have F1 : ∀ (p : List ℕ) (j u w : ℕ), p[j]? = some u → p[j+1]? = some w → Adj p u w := by
    intro p j u w h1 h2
    rw [List.getElem?_eq_some_iff] at h1 h2
    obtain ⟨hj1, rfl⟩ := h1
    obtain ⟨hj2, rfl⟩ := h2
    have h := List.take_append_drop j p
    rw [List.drop_eq_getElem_cons hj1, List.drop_eq_getElem_cons hj2] at h
    exact ⟨p.take j, p.drop (j + 1 + 1), Or.inl h.symm⟩
  have FR : ∀ (s R : List ℕ) (u w : ℕ), Adj s u w → Adj (s ++ R) u w := by
    rintro s R u w ⟨l₁, l₂, h⟩
    refine ⟨l₁, l₂ ++ R, ?_⟩
    rcases h with rfl | rfl
    · left; simp
    · right; simp
  have FL : ∀ (L s : List ℕ) (u w : ℕ), Adj s u w → Adj (L ++ s) u w := by
    rintro L s u w ⟨l₁, l₂, h⟩
    refine ⟨L ++ l₁, l₂, ?_⟩
    rcases h with rfl | rfl
    · left; simp
    · right; simp
  have INF : ∀ (s t : List ℕ) (u w : ℕ), Adj s u w → s <:+: t → Adj t u w := by
    rintro s t u w h ⟨L, R, rfl⟩
    exact FR _ _ _ _ (FL _ _ _ _ h)
  have SYM : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have RM : ∀ (f : ℕ → ℕ) (n i u w : ℕ), i + 1 < n → f i = u → f (i + 1) = w →
      Adj ((List.range n).map f) u w := by
    intro f n i u w hi hu hw
    apply F1 _ i
    · simp [List.getElem?_range (show i < n by omega), hu]
    · simp [List.getElem?_range hi, hw]
  have J : ∀ (X Y : List ℕ) (a b : ℕ), X.getLast? = some a → Y.head? = some b →
      Adj (X ++ Y) a b := by
    intro X Y a b hX hY
    rw [List.getLast?_eq_some_iff] at hX
    rw [List.head?_eq_some_iff] at hY
    obtain ⟨X', rfl⟩ := hX
    obtain ⟨Y', rfl⟩ := hY
    exact ⟨X', Y', Or.inl (by simp)⟩
  
  have sA : ∀ x, y + 2 * r + 3 ≤ x → x ≤ y + 4 * r + 2 → Adj (eoSeed y k r) x (x + 1) := by
    intro x h1 h2
    unfold eoSeed
    apply FR; apply FR; apply FR; apply FR
    apply SYM
    exact RM _ _ (y + 4 * r + 2 - x) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  
  have sB : ∀ x, 2 * r + 3 ≤ x → x + 1 ≤ y - k + 2 → Adj (eoSeed y k r) x (x + 1) := by
    intro x h1 h2
    unfold eoSeed
    apply FR; apply FR; apply FR; apply FL
    exact RM _ _ (x - (2 * r + 3)) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  
  have sD : ∀ x, y - k + 2 * r + 3 ≤ x → x + 1 ≤ y → Adj (eoSeed y k r) x (x + 1) := by
    intro x h1 h2
    unfold eoSeed
    apply FR; apply FL
    exact RM _ _ (x - (y - k + 2 * r + 3)) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  
  have sC : ∀ i, i < r → Adj (eoSeed y k r) (y + 3 + 2 * i) (y + 4 + 2 * i) := by
    intro i hi
    unfold eoSeed
    apply FR; apply FR; apply FL
    apply INF (eoBlk y (y - k) i)
    · exact ⟨[y - k + 3 + 2 * i, 3 + 2 * i], [4 + 2 * i, y - k + 4 + 2 * i], Or.inl rfl⟩
    · exact List.infix_of_mem_flatten (List.mem_map.2 ⟨i, List.mem_range.2 hi, rfl⟩)
  
  have sJ : ∀ j, j ≤ r → Adj (eoSeed y k r) (y - k + 2 + 2 * j) (y - k + 3 + 2 * j) := by
    intro j hj
    have hR : List.range r = List.range j ++ (List.range (r - j)).map (fun i => j + i) := by
      rw [← List.range_add]; congr 1; omega
    unfold eoSeed
    rw [hR, List.flatMap_append]
    rw [show ∀ (A B P Q D E : List ℕ), A ++ B ++ (P ++ Q) ++ D ++ E = (A ++ B ++ P) ++ (Q ++ D ++ E)
      from fun _ _ _ _ _ _ => by simp only [List.append_assoc]]
    apply J
    · rcases j with _ | j
      · obtain ⟨n, hn⟩ : ∃ n, y - k - 2 * r = n + 1 := ⟨y - k - 2 * r - 1, by omega⟩
        rw [hn, @List.range_succ n]
        simp <;> omega
      · rw [@List.range_succ j, List.flatMap_append]
        simp [eoBlk] <;> omega
    · obtain ⟨s, hs⟩ : ∃ s, r - j = s := ⟨_, rfl⟩
      rw [hs]
      rcases s with _ | s
      · obtain ⟨d, hd⟩ : ∃ d, k - 2 * r - 2 = d + 1 := ⟨k - 2 * r - 3, by omega⟩
        rw [hd, @List.range_succ_eq_map d]
        simp <;> omega
      · rw [@List.range_succ_eq_map s]
        simp [eoBlk] <;> omega
  
  have sE : Adj (eoSeed y k r) (y + 1) (y + 2) := by
    unfold eoSeed
    apply FL
    exact ⟨[0, 1, 2], [], Or.inr rfl⟩
  refine ⟨?_, ?_, sD⟩
  · left
    simp [eoSeed, List.head?_range]
  · intro x hx2 hx1 hx3
    by_cases ha : y + 2 * r + 3 ≤ x
    · exact sA x ha (by omega)
    by_cases hb : y + 3 ≤ x
    · obtain ⟨i, rfl⟩ : ∃ i, x = y + 3 + 2 * i := ⟨(x - y - 3) / 2, by omega⟩
      have h := sC i (by omega)
      rw [show y + 4 + 2 * i = y + 3 + 2 * i + 1 by omega] at h
      exact h
    by_cases hc : x = y + 1
    · subst hc; exact sE
    by_cases hd : y - k + 2 * r + 3 ≤ x
    · exact sD x hd (by omega)
    by_cases he : y - k + 2 ≤ x
    · obtain ⟨j, rfl⟩ : ∃ j, x = y - k + 2 + 2 * j := ⟨(x - (y - k) - 2) / 2, by omega⟩
      have h := sJ j (by omega)
      rw [show y - k + 3 + 2 * j = y - k + 2 + 2 * j + 1 by omega] at h
      exact h
    exact sB x (by omega) (by omega)

theorem path_III : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ, IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - 1)) Q ∧ (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧ (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧ IsEnd Q (j - 1) ∧ IsEnd Q j :=
by
  intro n j hj hn
  obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
  have hm : 1 ≤ m := by omega
  refine ⟨(List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse,
    ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · 
    show List.Perm _ _
    rw [List.range_add]
    exact (List.reverse_perm _).append (List.reverse_perm _)
  · 
    have hlen : ((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).length
        = j + m := by simp
    have hQ : ∀ (i : ℕ) (h : i < ((List.range j).reverse ++
        (List.map (fun y => j + y) (List.range m)).reverse).length),
        ((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse)[i] =
          if i < j then j - 1 - i else j + m - 1 - (i - j) := by
      intro i h
      rw [hlen] at h
      by_cases hi : i < j
      · rw [List.getElem_append_left (by simpa using hi)]
        simp [hi]
      · rw [List.getElem_append_right (by simpa using hi)]
        simp [hi]
        omega
    have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).map
          (fun a : ℕ => (a : ℤ)))
        (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).tail.map
          (fun a : ℕ => (a : ℤ))) =
        List.replicate (j - 1) 1 ++ (j + m - 1) :: List.replicate (m - 1) 1 := by
      apply List.ext_getElem
      · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
          List.length_append, List.length_replicate, List.length_cons]
        omega
      · intro i h1 h2
        simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
        rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail,
          hQ, hQ]
        simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
          List.length_replicate]
        rw [Int.natAbs_eq_iff]
        split_ifs <;> omega
    have he : edgeLengths ((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse) =
        ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).map
          (fun a : ℕ => (a : ℤ)))
        (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).tail.map
          (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
      unfold edgeLengths
      simp only [List.map_eq_flatMap]
      rfl
    rw [he, hl, show j + m - 2 = (j - 1) + (m - 1) by omega,
      Multiset.replicate_add, ← Multiset.coe_add, ← Multiset.cons_coe, Multiset.coe_replicate,
      Multiset.coe_replicate, Multiset.replicate_one, ← Multiset.singleton_add]
    abel
  · 
    intro x hx
    obtain ⟨r, rfl⟩ : ∃ r, j = x + 1 + 1 + r := ⟨j - x - 2, by omega⟩
    refine ⟨(List.map (fun y => x + 1 + 1 + y) (List.range r)).reverse,
      (List.range x).reverse ++ (List.map (fun y => x + 1 + 1 + r + y) (List.range m)).reverse,
      Or.inr ?_⟩
    rw [List.range_add, List.range_succ, List.range_succ]
    simp [List.append_assoc, List.reverse_append]
  · 
    intro x hx1 hx2
    obtain ⟨d, rfl⟩ : ∃ d, x = j + d := ⟨x - j, by omega⟩
    obtain ⟨r, rfl⟩ : ∃ r, m = d + 1 + 1 + r := ⟨m - d - 2, by omega⟩
    refine ⟨(List.range j).reverse ++
        (List.map (fun y => j + y) (List.map (fun y => d + 1 + 1 + y) (List.range r))).reverse,
      (List.map (fun y => j + y) (List.range d)).reverse, Or.inr ?_⟩
    rw [List.range_add, List.range_succ, List.range_succ]
    simp [List.append_assoc, add_assoc, List.reverse_append]
  · 
    left
    have hj0 : j ≠ 0 := by omega
    simp [List.head?_append, List.head?_reverse, List.getLast?_range, hj0]
  · 
    right
    have hm0 : m ≠ 0 := by omega
    simp [List.getLast?_append, List.getLast?_reverse, List.head?_map, List.head?_range, hm0]

theorem top_attach : ∀ (ℓ v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ ℓ → ℓ ≤ v → IsLinearRealization v L p → IsEnd p (v - ℓ) → ∃ p' : List ℕ, IsLinearRealization (v + 1) (L + Multiset.replicate 1 ℓ) p' ∧ IsEnd p' v ∧ (∀ x : ℕ, Adj p x (x + 1) → Adj p' x (x + 1)) ∧ (∀ x : ℕ, IsEnd p x → x ≠ v - ℓ → IsEnd p' x) :=
by
  have s1 : ∀ (x a : ℕ) (t : List ℕ), edgeLengths (x :: a :: t) =
      Int.natAbs ((a : ℤ) - (x : ℤ)) ::ₘ edgeLengths (a :: t) := by
    intro x a t; rfl
  have s0 : ∀ x : ℕ, edgeLengths [x] = 0 := fun x => rfl
  have s3 : ∀ (l : List ℕ) (a b : ℕ), edgeLengths (l ++ [a, b]) =
      edgeLengths (l ++ [a]) + {Int.natAbs ((b : ℤ) - (a : ℤ))} := by
    intro l a b
    induction l with
    | nil =>
      rw [List.nil_append, List.nil_append, s1, s0, s0, zero_add]
      rfl
    | cons x l ih =>
      cases l with
      | nil =>
        have e1 : [x] ++ [a, b] = x :: a :: [b] := rfl
        have e2 : [x] ++ [a] = x :: a :: [] := rfl
        have ih' : edgeLengths (a :: [b]) = edgeLengths [a] + {Int.natAbs ((b : ℤ) - (a : ℤ))} := ih
        rw [e1, e2, s1, ih', s1, Multiset.cons_add]
      | cons y l' =>
        have e1 : (x :: y :: l') ++ [a, b] = x :: y :: (l' ++ [a, b]) := rfl
        have e2 : (x :: y :: l') ++ [a] = x :: y :: (l' ++ [a]) := rfl
        have ih' : edgeLengths (y :: (l' ++ [a, b])) =
            edgeLengths (y :: (l' ++ [a])) + {Int.natAbs ((b : ℤ) - (a : ℤ))} := ih
        rw [e1, e2, s1 x y (l' ++ [a, b]), ih', s1 x y (l' ++ [a]), Multiset.cons_add]
  intro ℓ v L p _ hℓv hpL hend
  obtain ⟨hq, hM⟩ := hpL
  have hperm0 : (v :: p).Perm (List.range (v + 1)) := by
    rw [List.range_succ]
    exact (hq.cons v).trans (List.perm_append_singleton v (List.range v)).symm
  have hadj : ∀ (pre suf : List ℕ) (x : ℕ), Adj p x (x + 1) →
      Adj (pre ++ p ++ suf) x (x + 1) := by
    rintro pre suf x ⟨l₁, l₂, h | h⟩
    · refine ⟨pre ++ l₁, l₂ ++ suf, Or.inl ?_⟩
      rw [h]; simp
    · refine ⟨pre ++ l₁, l₂ ++ suf, Or.inr ?_⟩
      rw [h]; simp
  have hA1 : Int.natAbs (((v - ℓ : ℕ) : ℤ) - (v : ℤ)) = ℓ := by omega
  have hA2 : Int.natAbs ((v : ℤ) - ((v - ℓ : ℕ) : ℤ)) = ℓ := by omega
  unfold IsEnd at hend
  rcases hend with h | h
  · obtain ⟨t, rfl⟩ := List.head?_eq_some_iff.mp h
    refine ⟨v :: (v - ℓ) :: t, ⟨hperm0, ?_⟩, Or.inl rfl, ?_, ?_⟩
    · have hM1 : L + Multiset.replicate 1 ℓ = ℓ ::ₘ L := by
        rw [Multiset.replicate_one, add_comm, Multiset.singleton_add]
      rw [s1, hA1, hM, hM1]
    · intro x hx
      simpa using hadj [v] [] x hx
    · intro x hx hne
      rcases hx with hx | hx
      · simp at hx
        omega
      · right
        rw [List.getLast?_cons_cons]
        exact hx
  · obtain ⟨t, rfl⟩ := List.getLast?_eq_some_iff.mp h
    refine ⟨t ++ [v - ℓ] ++ [v],
      ⟨(List.perm_append_singleton v _).trans hperm0, ?_⟩, Or.inr (by simp), ?_, ?_⟩
    · have e : t ++ [v - ℓ] ++ [v] = t ++ [v - ℓ, v] := by simp
      rw [e, s3, hM, hA2, Multiset.replicate_one]
    · intro x hx
      simpa using hadj [] [v] x hx
    · intro x hx hne
      rcases hx with hx | hx
      · left
        obtain ⟨s, hs⟩ := List.head?_eq_some_iff.mp hx
        rw [hs]; simp
      · simp at hx
        omega

theorem top_hook : ∀ (ℓ v : ℕ) (L : Multiset ℕ) (p : List ℕ), 2 ≤ ℓ → ℓ ≤ v + 1 → IsLinearRealization v L p → IsEnd p (v + 1 - ℓ) → ∃ p' : List ℕ, IsLinearRealization (v + 2) (L + Multiset.replicate 1 ℓ + Multiset.replicate 1 1) p' ∧ IsEnd p' v ∧ Adj p' v (v + 1) ∧ (∀ x : ℕ, Adj p x (x + 1) → Adj p' x (x + 1)) ∧ (∀ x : ℕ, IsEnd p x → x ≠ v + 1 - ℓ → IsEnd p' x) :=
by
  intro ℓ v L p hℓ hℓv hp hend
  have hU : ∀ (c d : ℕ) (r : List ℕ), edgeLengths (c :: d :: r) =
      (Int.natAbs ((d : ℤ) - (c : ℤ))) ::ₘ edgeLengths (d :: r) := fun _ _ _ => rfl
  have hS : ∀ (e : ℕ) (rest l : List ℕ), edgeLengths (l ++ e :: rest) =
      edgeLengths (l ++ [e]) + edgeLengths (e :: rest) := by
    intro e rest l
    induction l with
    | nil =>
      show edgeLengths (e :: rest) = edgeLengths [e] + edgeLengths (e :: rest)
      rw [show edgeLengths [e] = 0 from rfl, zero_add]
    | cons c l₀ ih =>
      cases l₀ with
      | nil =>
        show edgeLengths (c :: e :: rest) = edgeLengths [c, e] + edgeLengths (e :: rest)
        rw [hU, hU, show edgeLengths [e] = 0 from rfl, Multiset.cons_add, zero_add]
      | cons d l₁ =>
        show edgeLengths (c :: d :: (l₁ ++ e :: rest)) =
          edgeLengths (c :: d :: (l₁ ++ [e])) + edgeLengths (e :: rest)
        rw [hU, hU, Multiset.cons_add]
        exact congrArg _ ih
  have ha : Int.natAbs (((v + 1 : ℕ) : ℤ) - ((v + 1 - ℓ : ℕ) : ℤ)) = ℓ := by omega
  have ha' : Int.natAbs (((v + 1 - ℓ : ℕ) : ℤ) - ((v + 1 : ℕ) : ℤ)) = ℓ := by omega
  have hb : Int.natAbs (((v : ℕ) : ℤ) - ((v + 1 : ℕ) : ℤ)) = 1 := by omega
  have hb' : Int.natAbs (((v + 1 : ℕ) : ℤ) - ((v : ℕ) : ℤ)) = 1 := by omega
  rcases hend with hH | hL
  · 
    obtain ⟨r, hr⟩ := List.head?_eq_some_iff.mp hH
    refine ⟨v :: (v + 1) :: p, ⟨?_, ?_⟩, Or.inl rfl, ⟨[], p, Or.inl rfl⟩, ?_, ?_⟩
    · show (v :: (v + 1) :: p).Perm (List.range (v + 2))
      have h1 : ([v, v + 1] ++ p).Perm (p ++ [v, v + 1]) := List.perm_append_comm
      have h2 : (p ++ [v, v + 1]).Perm (List.range v ++ [v, v + 1]) := hp.1.append_right _
      have h3 : List.range v ++ [v, v + 1] = List.range (v + 2) := by simp [List.range_succ]
      rw [← h3]
      exact h1.trans h2
    · rw [hr, hU, hU, ← hr, hp.2, ha', hb', Multiset.replicate_one, Multiset.replicate_one,
        show L + {ℓ} + {1} = {1} + ({ℓ} + L) by abel, Multiset.singleton_add,
        Multiset.singleton_add]
    · rintro x ⟨m₁, m₂, h | h⟩
      · exact ⟨v :: (v + 1) :: m₁, m₂, Or.inl (by rw [h]; rfl)⟩
      · exact ⟨v :: (v + 1) :: m₁, m₂, Or.inr (by rw [h]; rfl)⟩
    · rintro x (hx | hx) hne
      · rw [hH] at hx
        exact absurd (Option.some.inj hx).symm hne
      · right
        rw [List.getLast?_cons_cons, hr, List.getLast?_cons_cons, ← hr]
        exact hx
  · 
    obtain ⟨l, hl⟩ := List.getLast?_eq_some_iff.mp hL
    refine ⟨p ++ [v + 1, v], ⟨?_, ?_⟩, Or.inr (by simp), ⟨p, [], Or.inr rfl⟩, ?_, ?_⟩
    · show (p ++ [v + 1, v]).Perm (List.range (v + 2))
      have h1 : (p ++ [v + 1, v]).Perm (List.range v ++ [v + 1, v]) := hp.1.append_right _
      have h2 : (List.range v ++ [v + 1, v]).Perm (List.range v ++ [v, v + 1]) :=
        List.Perm.append_left _ (List.Perm.swap _ _ _)
      have h3 : List.range v ++ [v, v + 1] = List.range (v + 2) := by simp [List.range_succ]
      rw [← h3]
      exact h1.trans h2
    · rw [hl, List.append_assoc,
        show [v + 1 - ℓ] ++ [v + 1, v] = (v + 1 - ℓ) :: [v + 1, v] from rfl,
        hS, ← hl, hp.2, hU, hU, show edgeLengths [v] = 0 from rfl, ha, hb, add_assoc]
      rfl
    · rintro x ⟨m₁, m₂, h | h⟩
      · exact ⟨m₁, m₂ ++ [v + 1, v], Or.inl (by rw [h]; simp)⟩
      · exact ⟨m₁, m₂ ++ [v + 1, v], Or.inr (by rw [h]; simp)⟩
    · rintro x (hx | hx) hne
      · left
        rw [List.head?_append, hx]
        rfl
      · rw [hL] at hx
        exact absurd (Option.some.inj hx).symm hne

theorem eoP1 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 0 → c % 2 = 1 → k + 2 ≤ c → b + c ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hkc hbc
  
  obtain ⟨Q, hQ, hQlo, hQhi, hQe1, hQe2⟩ := path_III (y + 1) (b + c) (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, hN₁, hK₁, hE₁⟩ := top_pairs (y - k) (y + 1) (b / 2) _ Q
    (by omega) (by omega) (by omega) hQ (fun i hi => hQlo _ (by omega))
  
  obtain ⟨p₂, hp₂, hN₂, hK₂, hE₂⟩ := top_pairs y (y + 1 + 2 * (b / 2)) ((c - 3) / 2) _ p₁
    (by omega) (by omega) (by omega) hp₁
    (fun i hi => hK₁ _ (hQlo _ (by omega)) (fun i' hi' => by omega))
  
  obtain ⟨p₃, hp₃, -, hA₃, hK₃, hE₃⟩ := top_hook y (y + 1 + 2 * (b / 2) + 2 * ((c - 3) / 2)) _ p₂
    (by omega) (by omega) hp₂ (by
      rw [show y + 1 + 2 * (b / 2) + 2 * ((c - 3) / 2) + 1 - y = b + c - 1 by omega]
      exact hE₂ _ (hE₁ _ hQe1))
  
  obtain ⟨p₄, hp₄, hE₄, hK₄, -⟩ := top_attach y (y + 1 + 2 * (b / 2) + 2 * ((c - 3) / 2) + 2) _ p₃
    (by omega) (by omega) hp₃ (by
      rw [show y + 1 + 2 * (b / 2) + 2 * ((c - 3) / 2) + 2 - y = b + c by omega]
      exact hE₃ _ (hE₂ _ (hE₁ _ hQe2)) (by omega))
  
  refine ⟨y, le_refl y, by omega, p₄, ?_, ?_⟩
  · rw [show y + b + c + 1 = y + 1 + 2 * (b / 2) + 2 * ((c - 3) / 2) + 2 + 1 by omega]
    have hM : prescribedLengths y k y b c =
        Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - 1) +
          Multiset.replicate (2 * (b / 2)) (y - k) + Multiset.replicate (2 * ((c - 3) / 2)) y +
          Multiset.replicate 1 y + Multiset.replicate 1 1 + Multiset.replicate 1 y := by
      unfold prescribedLengths
      have ea : Multiset.replicate y 1 =
          Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 1 := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      have eb : Multiset.replicate b (y - k) = Multiset.replicate (2 * (b / 2)) (y - k) := by
        congr 1
        omega
      have ec : Multiset.replicate c y = Multiset.replicate 1 y +
          Multiset.replicate (2 * ((c - 3) / 2)) y + Multiset.replicate 1 y +
          Multiset.replicate 1 y := by
        rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
        congr 1
        omega
      rw [show y + 1 - 1 = y by omega, ea, eb, ec]
      abel
    rw [hM]
    exact hp₄
  · refine ⟨?_, ?_, ?_⟩
    · rw [show y + b + c + 1 - 1 = y + 1 + 2 * (b / 2) + 2 * ((c - 3) / 2) + 2 by omega]
      exact hE₄
    · intro jj hj1 hj2
      obtain ⟨x, hx⟩ : ∃ x, x = y + b + c - 2 * jj := ⟨_, rfl⟩
      have key : Adj p₄ x (x + 1) := by
        apply hK₄
        by_cases hr1 : x + 1 ≤ y
        · apply hK₃
          apply hK₂ x
          · apply hK₁ x
            · exact hQhi x (by omega) (by omega)
            · intro i hi
              omega
          · intro i hi
            omega
        · by_cases hr2 : x + 1 ≤ y + b
          · apply hK₃
            have h := hN₁ ((x - y - 1) / 2) (by omega)
            rw [show y + 1 + 2 * ((x - y - 1) / 2) = x by omega] at h
            apply hK₂ x h
            intro i hi
            omega
          · by_cases hr3 : x + 4 ≤ y + b + c
            · apply hK₃
