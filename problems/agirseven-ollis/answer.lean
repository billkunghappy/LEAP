    rw [show a₀ + b + c + 1 - 1 - (2 * j - 1) = a₀ + b + c + 1 - 2 * j by omega] at h
    exact h
  · intro he
    exfalso
    rw [Nat.even_iff] at he
    omega

theorem base_B : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → b < y - k → y ≤ c → c < 2 * y →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧
      (IsEnd p 0 ∨ TopEndInv y (a₀ + b + c + 1) p) :=
by
  intro y k b c hk hyk hb hc1 hc2
  rcases Nat.mod_two_eq_zero_or_one y with hy | hy
  · exact base_B_even y k b c hk hyk hy hb hc1 hc2
  · have hR : ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + (c - y) + 1 ∧ ∃ p : List ℕ,
        IsLinearRealization (a₀ + b + (c - y) + 1) (prescribedLengths y k a₀ b (c - y)) p ∧
        TopEndInv y (a₀ + b + (c - y) + 1) p := by
      rcases Nat.mod_two_eq_zero_or_one k with hk2 | hk2
      · exact baseB_oddR_keven y k b (c - y) hk hyk hy hk2 hb (by omega)
      · exact baseB_oddR_kodd y k b (c - y) hk hyk hy hk2 hb (by omega)
    obtain ⟨a₀, ha₀, hv, p, hp, hTE⟩ := hR
    obtain ⟨p', hp', hTE', -, -⟩ :=
      grow_top_end_iter y (a₀ + b + (c - y) + 1) 1 _ p (by omega) hv hp hTE
    have ev : a₀ + b + (c - y) + 1 + 1 * y = a₀ + b + c + 1 := by omega
    have eL : prescribedLengths y k a₀ b (c - y) + Multiset.replicate (1 * y) y =
        prescribedLengths y k a₀ b c := by
      unfold prescribedLengths
      obtain ⟨d, rfl⟩ : ∃ d, c = y + d := ⟨c - y, by omega⟩
      rw [Nat.add_sub_cancel_left, one_mul, add_comm y d, Multiset.replicate_add]
      abel
    rw [ev, eL] at hp'
    rw [ev] at hTE'
    exact ⟨a₀, ha₀, p', hp', Or.inl hTE', Or.inr hTE'⟩

theorem dstar_lift : ∀ (y k a₀ r c : ℕ) (p : List ℕ), 1 ≤ k → 2 * k < y → y - k ≤ a₀ + r + c →
    IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p →
    (BotEndInv (y - k) p ∨ (BotPairInv (y - k) p ∧ IsEnd p (a₀ + r + c))) →
    ∃ p' : List ℕ,
      IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p' ∧
      (BotEndInv (y - k) p' ∨ BotPairInv (y - k) p') ∧
      (IsEnd p' (a₀ + (y - k + r) + c) ∨ BotEndInv (y - k) p') :=
by
  intro y k a₀ r c p hk hyk hv hp hinv
  have h2 : 2 ≤ y - k := by omega
  have hv' : y - k ≤ a₀ + r + c + 1 := by omega
  have e1 : a₀ + r + c + 1 + 1 * (y - k) = a₀ + (y - k + r) + c + 1 := by omega
  have e2 : prescribedLengths y k a₀ r c + Multiset.replicate (1 * (y - k)) (y - k) =
      prescribedLengths y k a₀ (y - k + r) c := by
    unfold prescribedLengths
    rw [one_mul, Multiset.replicate_add]
    abel
  rcases hinv with hBE | ⟨hBP, hEnd⟩
  · obtain ⟨p', hp', hBE', -, -⟩ :=
      grow_bot_end_iter (y - k) (a₀ + r + c + 1) 1 (prescribedLengths y k a₀ r c) p h2 hv' hp hBE
    rw [e1, e2] at hp'
    exact ⟨p', hp', Or.inl hBE', Or.inr hBE'⟩
  · obtain ⟨p', hp', hBP', -, hE'⟩ :=
      grow_bot_pair_iter (y - k) (a₀ + r + c + 1) 1 (prescribedLengths y k a₀ r c) p h2 hv' hp hBP
    have h := hE' (a₀ + r + c) hv hEnd
    rw [show a₀ + r + c + 1 * (y - k) = a₀ + (y - k + r) + c by omega] at h
    rw [e1, e2] at hp'
    exact ⟨p', hp', Or.inr hBP', Or.inl h⟩

theorem baseC_ME_a : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → r < y - k → c < y →
    (y - k) % 2 = 0 → r % 2 = 0 → c % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y - k ≤ a₀ + r + c ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p ∧
      IsEnd p 0 ∧ TopPairInv (y - k) (a₀ + r + c + 1) p :=
by
  intro y k r c hk hyk hr hc hm hr2 hc2
  obtain ⟨c', rfl⟩ : ∃ c', c = 2 * c' := ⟨c / 2, by omega⟩
  obtain ⟨r', rfl⟩ : ∃ r', r = 2 * r' := ⟨r / 2, by omega⟩
  
  obtain ⟨hR, hS, h0, -⟩ := path_range y (by omega)
  
  obtain ⟨P, hP, hN1, hK1, hE1⟩ := top_pairs y y c' _ (List.range y) (by omega) le_rfl
    (by omega) hR (fun i hi => by
      rw [show y - y + 2 * i = 2 * i by omega]
      exact hS _ (by omega))
  have hA : ∀ x : ℕ, 2 * c' ≤ x → x + 2 ≤ y → Adj P x (x + 1) := fun x h1 h2 =>
    hK1 x (hS x h2) (fun i hi => by omega)
  
  obtain ⟨p, hp, hN2, hK2, hE2⟩ := top_pairs (y - k) (y + 2 * c') r' _ P (by omega) (by omega)
    (by omega) hP (fun i hi => by
      by_cases hx : y + 2 * c' - (y - k) + 2 * i + 2 ≤ y
      · exact hA _ (by omega) hx
      · have h := hN1 ((2 * c' + 2 * i - (y - k)) / 2) (by omega)
        rw [show y + 2 * ((2 * c' + 2 * i - (y - k)) / 2) = y + 2 * c' - (y - k) + 2 * i by
          omega] at h
        exact h)
  refine ⟨y - 1, by omega, by omega, p, ?_, hE2 0 (hE1 0 h0), ?_⟩
  · rw [show y - 1 + 2 * r' + 2 * c' + 1 = y + 2 * c' + 2 * r' by omega]
    have hM : prescribedLengths y k (y - 1) (2 * r') (2 * c') =
        Multiset.replicate (y - 1) 1 + Multiset.replicate (2 * c') y +
          Multiset.replicate (2 * r') (y - k) := by
      unfold prescribedLengths
      exact add_right_comm _ _ _
    rw [hM]
    exact hp
  · rw [show y - 1 + 2 * r' + 2 * c' + 1 = y + 2 * c' + 2 * r' by omega]
    unfold TopPairInv
    refine ⟨Nat.even_iff.mpr hm, fun j hj => ?_⟩
    have key : Adj p (y + 2 * c' + 2 * r' - 2 - 2 * j) (y + 2 * c' + 2 * r' - 2 - 2 * j + 1) := by
      by_cases h1 : y + 2 * c' ≤ y + 2 * c' + 2 * r' - 2 - 2 * j
      · have h := hN2 (r' - 1 - j) (by omega)
        rw [show y + 2 * c' + 2 * (r' - 1 - j) = y + 2 * c' + 2 * r' - 2 - 2 * j by omega] at h
        exact h
      · apply hK2 _ ?_ (fun i hi => by omega)
        by_cases h2 : y ≤ y + 2 * c' + 2 * r' - 2 - 2 * j
        · have h := hN1 (c' + r' - 1 - j) (by omega)
          rw [show y + 2 * (c' + r' - 1 - j) = y + 2 * c' + 2 * r' - 2 - 2 * j by omega] at h
          exact h
        · exact hA _ (by omega) (by omega)
    obtain ⟨l₁, l₂, h⟩ := key
    refine ⟨l₁, l₂, ?_⟩
    rw [show y + 2 * c' + 2 * r' - 1 - 2 * j = y + 2 * c' + 2 * r' - 2 - 2 * j + 1 by omega]
    exact h.symm

theorem baseC_ME_b : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → r < y - k → c < y →
    (y - k) % 2 = 0 → r % 2 = 0 → c % 2 = 1 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y - k ≤ a₀ + r + c ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p ∧
      IsEnd p 0 ∧ TopPairInv (y - k) (a₀ + r + c + 1) p :=
by
  intro y k r c hk hyk hr hc hm hr2 hc2
  obtain ⟨ρ, hρ⟩ : ∃ ρ, 2 * ρ = r := ⟨r / 2, by omega⟩
  obtain ⟨γ, hγ⟩ : ∃ γ, 2 * γ + 1 = c := ⟨c / 2, by omega⟩
  obtain ⟨μ, hμ⟩ : ∃ μ, y - k = 2 * μ := ⟨(y - k) / 2, by omega⟩
  
  obtain ⟨Q, hQ, -, hQs, hQ0, -⟩ := path_II (y + 1) 1 le_rfl (by omega)
  
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ := top_pairs y (y + 1) γ _ Q (by omega) (by omega)
    (by omega) hQ (by
      intro i hi
      exact hQs _ (by omega) (by omega))
  
  have h2 : ∀ i : ℕ, i < ρ →
      Adj p₁ (y + 1 + 2 * γ - (y - k) + 2 * i) (y + 1 + 2 * γ - (y - k) + 2 * i + 1) := by
    intro i hi
    by_cases hx : y + 1 + 2 * γ - (y - k) + 2 * i + 2 ≤ y + 1
    · exact hK1 _ (hQs _ (by omega) hx) (by intro i' _; omega)
    · have h := hN1 (γ + i - μ) (by omega)
      rw [show y + 1 + 2 * (γ + i - μ) = y + 1 + 2 * γ - (y - k) + 2 * i by omega] at h
      exact h
  
  obtain ⟨p₂, hp₂, hN2, hK2, hE2⟩ := top_pairs (y - k) (y + 1 + 2 * γ) ρ _ p₁ (by omega)
    (by omega) (by omega) hp₁ h2
  have e1 : y + 1 + 2 * γ + 2 * ρ = y - 1 + r + c + 1 := by omega
  have hsymm : ∀ u w : ℕ, Adj p₂ u w → Adj p₂ w u := by
    rintro u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  
  refine ⟨y - 1, by omega, by omega, p₂, ?_, hE2 0 (hE1 0 hQ0), ?_⟩
  · have e2 : Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - 1) +
        Multiset.replicate (2 * γ) y + Multiset.replicate (2 * ρ) (y - k) =
        prescribedLengths y k (y - 1) r c := by
      rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - 1 = y by omega, ← hρ, ← hγ]
      unfold prescribedLengths
      simp only [Multiset.replicate_add]
      abel
    rw [e1, e2] at hp₂
    exact hp₂
  
  · refine ⟨⟨μ, by omega⟩, ?_⟩
    intro j hj
    rw [← e1]
    rw [show y + 1 + 2 * γ + 2 * ρ - 1 - 2 * j = (y + 2 * γ + 2 * ρ - 1 - 2 * j) + 1 by omega,
      show y + 1 + 2 * γ + 2 * ρ - 2 - 2 * j = y + 2 * γ + 2 * ρ - 1 - 2 * j by omega]
    apply hsymm
    by_cases hA : j < ρ
    · have h := hN2 (ρ - 1 - j) (by omega)
      rw [show y + 1 + 2 * γ + 2 * (ρ - 1 - j) = y + 2 * γ + 2 * ρ - 1 - 2 * j by omega] at h
      exact h
    · by_cases hB : j < γ + ρ
      · have h := hN1 (γ + ρ - 1 - j) (by omega)
        rw [show y + 1 + 2 * (γ + ρ - 1 - j) = y + 2 * γ + 2 * ρ - 1 - 2 * j by omega] at h
        exact hK2 _ h (by intro i _; omega)
      · exact hK2 _ (hK1 _ (hQs _ (by omega) (by omega)) (by intro i _; omega))
          (by intro i _; omega)

theorem baseC_ME_c : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → r < y - k → c < y →
    (y - k) % 2 = 0 → r % 2 = 1 → c % 2 = 1 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y - k ≤ a₀ + r + c ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p ∧
      BotEndInv (y - k) p :=
by
  intro y k r c hk hyk hr hc hm hr2 hc2
  
  have path_III : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ,
      IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - 1)) Q ∧
      (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧
      (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧
      IsEnd Q (j - 1) ∧ IsEnd Q j := by
    intro n j hj hn
    obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
    have hm : 1 ≤ m := by omega
    refine ⟨(List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse,
      ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · 
      show List.Perm _ _
      rw [List.range_add]
      exact (List.reverse_perm _).append (List.reverse_perm _)
    · 
      have hlen : ((List.range j).reverse ++
          (List.map (fun y => j + y) (List.range m)).reverse).length = j + m := by simp
      have hQ : ∀ (i : ℕ) (h : i < ((List.range j).reverse ++
          (List.map (fun y => j + y) (List.range m)).reverse).length),
          ((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse)[i] =
            if i < j then j - 1 - i else j + m - 1 - (i - j) := by
        intro i h
        by_cases hi : i < j
        · rw [List.getElem_append_left (by simpa using hi)]
          simp [hi] <;> omega
        · rw [List.getElem_append_right (by simpa using hi)]
          simp [hi] <;> omega
      have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).map
            (fun a : ℕ => (a : ℤ)))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).tail.map
            (fun a : ℕ => (a : ℤ))) =
          List.replicate (j - 1) 1 ++ (j + m - 1) :: List.replicate (m - 1) 1 := by
        apply List.ext_getElem
        · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
            List.length_append, List.length_replicate, List.length_cons]
          omega
        · intro i h1 h2
          simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
          rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail,
            hQ, hQ]
          simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
            List.length_replicate]
          rw [Int.natAbs_eq_iff]
          split_ifs <;> omega
      have he : edgeLengths ((List.range j).reverse ++
          (List.map (fun y => j + y) (List.range m)).reverse) =
          ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).map
            (fun a : ℕ => (a : ℤ)))
          (((List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse).tail.map
            (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
        unfold edgeLengths
        simp only [List.map_eq_flatMap]
        rfl
      rw [he, hl, show j + m - 2 = (j - 1) + (m - 1) by omega,
        Multiset.replicate_add, ← Multiset.coe_add, ← Multiset.cons_coe, Multiset.coe_replicate,
        Multiset.coe_replicate, Multiset.replicate_one, ← Multiset.singleton_add]
      abel
    · 
      intro x hx
      obtain ⟨r, rfl⟩ : ∃ r, j = x + 1 + 1 + r := ⟨j - x - 2, by omega⟩
      refine ⟨(List.map (fun y => x + 1 + 1 + y) (List.range r)).reverse,
        (List.range x).reverse ++ (List.map (fun y => x + 1 + 1 + r + y) (List.range m)).reverse,
        Or.inr ?_⟩
      rw [List.range_add, List.range_succ, List.range_succ]
      simp [List.append_assoc, List.reverse_append]
    · 
      intro x hx1 hx2
      obtain ⟨d, rfl⟩ : ∃ d, x = j + d := ⟨x - j, by omega⟩
      obtain ⟨r, rfl⟩ : ∃ r, m = d + 1 + 1 + r := ⟨m - d - 2, by omega⟩
      refine ⟨(List.range j).reverse ++
          (List.map (fun y => j + y) (List.map (fun y => d + 1 + 1 + y) (List.range r))).reverse,
        (List.map (fun y => j + y) (List.range d)).reverse, Or.inr ?_⟩
      rw [List.range_add, List.range_succ, List.range_succ]
      simp [List.append_assoc, List.reverse_append, add_assoc]
    · 
      left
      obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
      simp [List.range_succ]
    · 
      right
      have hm0 : m ≠ 0 := by omega
      simp [List.getLast?_append, List.getLast?_reverse, List.head?_map, List.head?_range, hm0]
  have hm2 : 2 ≤ y - k := by omega
  have ht1 : 2 * ((r - 1) / 2) = r - 1 := by omega
  have ht3 : 2 * ((c - 1) / 2) = c - 1 := by omega
  
  obtain ⟨Q, hQ, hQa, hQb, hQj1, hQj⟩ := path_III (y + 1) (y - k - r) (by omega) (by omega)
  rw [show y + 1 - 2 = y - 1 by omega, show y + 1 - 1 = y by omega] at hQ
  
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ := bot_pairs (y - k) (y + 1) ((r - 1) / 2) _ Q hm2
    (by omega) (by omega) hQ (by
      intro i hi
      have h := hQb (y - k - 2 - 2 * i) (by omega) (by omega)
      rwa [show y - k - 2 - 2 * i + 1 = y - k - 1 - 2 * i by omega] at h)
  have hEnd1 : IsEnd p₁ (y - k - 1) := by
    have h := hE1 _ hQj
    rwa [show y - k - r + 2 * ((r - 1) / 2) = y - k - 1 by omega] at h
  have hEnd1' : IsEnd p₁ (y - k - 2) := by
    have h := hE1 _ hQj1
    rwa [show y - k - r - 1 + 2 * ((r - 1) / 2) = y - k - 2 by omega] at h
  
  obtain ⟨p₂, hp₂, hE20, hK2, hE2⟩ :=
    bot_attach (y - k) (y + 1 + 2 * ((r - 1) / 2)) _ p₁ (by omega) (by omega) hp₁ hEnd1
  have hEnd2 : IsEnd p₂ (y - k - 1) := by
    have h := hE2 _ hEnd1' (by omega)
    rwa [show y - k - 2 + 1 = y - k - 1 by omega] at h
  
  obtain ⟨p₃, hp₃, -, hK3, hE3⟩ := top_pairs y (y + 1 + 2 * ((r - 1) / 2) + 1) ((c - 1) / 2) _ p₂
    (by omega) (by omega) (by omega) hp₂ (by
      intro i hi
      have hQx : Adj Q (1 + 2 * i) (1 + 2 * i + 1) := by
        by_cases hx : 1 + 2 * i + 2 ≤ y - k - r
        · exact hQa _ hx
        · exact hQb _ (by omega) (by omega)
      have h1 := hK1 _ hQx (by intro i' hi'; omega)
      have h2 := hK2 _ h1
      have e1 : y + 1 + 2 * ((r - 1) / 2) + 1 - y + 2 * i =
          1 + 2 * i + 2 * ((r - 1) / 2) + 1 := by omega
      have e2 : 1 + 2 * i + 2 * ((r - 1) / 2) + 1 + 1 = 1 + 2 * i + 2 * ((r - 1) / 2) + 2 := by
        omega
      rw [e1, e2]
      exact h2)
  
  have hBE : BotEndInv (y - k) p₃ := by
    refine ⟨hE3 0 hE20, ?_, fun _ => hE3 _ hEnd2⟩
    intro j' hj1 hj2
    have hp2slot : Adj p₂ (2 * j' - 1) (2 * j' - 1 + 1) := by
      by_cases hA : 2 * j' - 1 + 2 ≤ r
      · have h := hK2 _ (hN1 (j' - 1) (by omega))
        have e1 : 2 * (j' - 1) + 1 = 2 * j' - 1 := by omega
        have e2 : 2 * (j' - 1) + 2 = 2 * j' - 1 + 1 := by omega
        rw [e1, e2] at h
        exact h
      · have hQx := hQa (2 * j' - 1 - r) (by omega)
        have h1 := hK1 _ hQx (by intro i' hi'; omega)
        have h2 := hK2 _ h1
        have e1 : 2 * j' - 1 - r + 2 * ((r - 1) / 2) + 1 = 2 * j' - 1 := by omega
        have e2 : 2 * j' - 1 - r + 2 * ((r - 1) / 2) + 2 = 2 * j' - 1 + 1 := by omega
        rw [e1, e2] at h2
        exact h2
    have h3 := hK3 _ hp2slot (by intro i hi; omega)
    rwa [show 2 * j' - 1 + 1 = 2 * j' by omega] at h3
  
  have hv : y + 1 + 2 * ((r - 1) / 2) + 1 + 2 * ((c - 1) / 2) = y - 1 + r + c + 1 := by omega
  have hL : Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y +
      Multiset.replicate (2 * ((r - 1) / 2)) (y - k) + Multiset.replicate 1 (y - k) +
      Multiset.replicate (2 * ((c - 1) / 2)) y = prescribedLengths y k (y - 1) r c := by
    have hb' : Multiset.replicate r (y - k) =
        Multiset.replicate (r - 1) (y - k) + Multiset.replicate 1 (y - k) := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    have hc' : Multiset.replicate c y = Multiset.replicate 1 y + Multiset.replicate (c - 1) y := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    rw [ht1, ht3]
    unfold prescribedLengths
    rw [hb', hc']
    abel
  rw [hv, hL] at hp₃
  exact ⟨y - 1, by omega, by omega, p₃, hp₃, hBE⟩

theorem baseC_ME_d : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → r < y - k → c < y →
    (y - k) % 2 = 0 → k % 2 = 0 → r % 2 = 1 → c % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y - k ≤ a₀ + r + c ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p ∧
      IsEnd p 0 ∧ TopPairInv (y - k) (a₀ + r + c + 1) p :=
by
  intro y k r c hk hyk hr hc hm hk2 hr2 hc2
  obtain ⟨K, rfl⟩ : ∃ K, k = 2 * K := ⟨k / 2, by omega⟩
  obtain ⟨C, rfl⟩ : ∃ C, c = 2 * C := ⟨c / 2, by omega⟩
  obtain ⟨R, rfl⟩ : ∃ R, r = 2 * R + 1 := ⟨r / 2, by omega⟩
  obtain ⟨M, rfl⟩ : ∃ M, y = 2 * K + 2 * M := ⟨(y - 2 * K) / 2, by omega⟩
  have hym : 2 * K + 2 * M - 2 * K = 2 * M := by omega
  have adj_congr : ∀ (p : List ℕ) (a b a' b' : ℕ), a = a' → b = b' → Adj p a b → Adj p a' b' := by
    rintro p a b a' b' rfl rfl h
    exact h
  
  obtain ⟨Q0, hQ0, hS0a, hS0b, hE0, -⟩ :=
    path_II (2 * K + 2 * M) (2 * K) (by omega) (by omega)
  
  obtain ⟨Q1, hQ1, hN1, hK1, hE1⟩ :=
    top_pairs (2 * K + 2 * M) (2 * K + 2 * M) C _ Q0 (by omega) le_rfl (by omega) hQ0 (by
      intro i hi
      by_cases h : 2 * i + 2 ≤ 2 * K
      · exact adj_congr _ _ _ _ _ (by omega) (by omega) (hS0a (2 * i) h)
      · exact adj_congr _ _ _ _ _ (by omega) (by omega) (hS0b (2 * i) (by omega) (by omega)))
  
  obtain ⟨Q2, hQ2, hN2, hK2, hE2⟩ :=
    top_pairs (2 * M) (2 * K + 2 * M + 2 * C) R _ Q1 (by omega) (by omega) (by omega) hQ1 (by
      intro i hi
      by_cases h : 2 * K + 2 * C + 2 * i + 2 ≤ 2 * K + 2 * M
      · have h1 := hK1 (2 * K + 2 * C + 2 * i) (hS0b (2 * K + 2 * C + 2 * i) (by omega) h)
          (fun i' hi' => by omega)
        exact adj_congr _ _ _ _ _ (by omega) (by omega) h1
      · exact adj_congr _ _ _ _ _ (by omega) (by omega) (hN1 (C + i - M) (by omega)))
  refine ⟨2 * K + 2 * M - 2, by omega, by omega, Q2, ?_, hE2 0 (hE1 0 hE0), ?_⟩
  · have e1 : 2 * K + 2 * M + 2 * C + 2 * R = 2 * K + 2 * M - 2 + (2 * R + 1) + 2 * C + 1 := by
      omega
    have e2 : Multiset.replicate (2 * K + 2 * M - 2) 1 +
        Multiset.replicate 1 (2 * K + 2 * M - 2 * K) +
        Multiset.replicate (2 * C) (2 * K + 2 * M) + Multiset.replicate (2 * R) (2 * M) =
        prescribedLengths (2 * K + 2 * M) (2 * K) (2 * K + 2 * M - 2) (2 * R + 1) (2 * C) := by
      unfold prescribedLengths
      rw [hym, Multiset.replicate_add]
      abel
    rw [e1, e2] at hQ2
    exact hQ2
  · refine ⟨⟨M, by omega⟩, fun j hj => ?_⟩
    have symm : ∀ u w, Adj Q2 u w → Adj Q2 w u := by
      rintro u w ⟨l₁, l₂, h | h⟩
      · exact ⟨l₁, l₂, Or.inr h⟩
      · exact ⟨l₁, l₂, Or.inl h⟩
    have key : ∀ x, x = 2 * K + 2 * M + 2 * C + 2 * R - 2 - 2 * j → Adj Q2 x (x + 1) := by
      intro x hx
      by_cases h1 : 2 * K + 2 * M + 2 * C ≤ x
      · exact adj_congr _ _ _ _ _ (by omega) (by omega) (hN2 (R - 1 - j) (by omega))
      by_cases h2 : 2 * K + 2 * M ≤ x
      · have h3 := adj_congr _ _ _ x (x + 1) (by omega) (by omega) (hN1 (C + R - 1 - j) (by omega))
        exact hK2 x h3 (fun i hi => by omega)
      · exact hK2 x (hK1 x (hS0b x (by omega) (by omega)) (fun i hi => by omega))
          (fun i hi => by omega)
    exact adj_congr _ _ _ _ _ (by omega) (by omega) (symm _ _ (key _ rfl))

theorem baseC_ME : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → r < y - k → c < y →
    (y - k) % 2 = 0 → ¬ (k % 2 = 1 ∧ r % 2 = 1 ∧ c % 2 = 0) →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p ∧
      (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧
      (IsEnd p (a₀ + (y - k + r) + c) ∨ BotEndInv (y - k) p) :=
by
  intro y k r c hk hyk hr hc hm hce
  
  have fromTop : ∀ (a₀ : ℕ), a₀ ≤ y → y - k ≤ a₀ + r + c → ∀ p : List ℕ,
      IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p →
      IsEnd p 0 → TopPairInv (y - k) (a₀ + r + c + 1) p →
      ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
        IsLinearRealization (a₀ + (y - k + r) + c + 1)
          (prescribedLengths y k a₀ (y - k + r) c) p ∧
        (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧
        (IsEnd p (a₀ + (y - k + r) + c) ∨ BotEndInv (y - k) p) := by
    intro a₀ ha₀ hv p hp h0 hTP
    obtain ⟨hq, hAdj, hEnd⟩ := reflect_realization (a₀ + r + c + 1) _ p hp
    have hBP : BotPairInv (y - k) (p.map (fun x => a₀ + r + c + 1 - 1 - x)) := by
      refine ⟨hTP.1, fun j hj => ?_⟩
      have h := hAdj _ _ (by omega) (by omega) (hTP.2 j hj)
      rw [show a₀ + r + c + 1 - 1 - (a₀ + r + c + 1 - 1 - 2 * j) = 2 * j by omega,
        show a₀ + r + c + 1 - 1 - (a₀ + r + c + 1 - 2 - 2 * j) = 2 * j + 1 by omega] at h
      exact h
    have hE : IsEnd (p.map (fun x => a₀ + r + c + 1 - 1 - x)) (a₀ + r + c) := by
      have h := hEnd 0 (by omega) h0
      rw [show a₀ + r + c + 1 - 1 - 0 = a₀ + r + c by omega] at h
      exact h
    obtain ⟨p', hp', h1, h2⟩ := dstar_lift y k a₀ r c _ hk hyk hv hq (Or.inr ⟨hBP, hE⟩)
    exact ⟨a₀, ha₀, p', hp', h1, h2⟩
  rcases Nat.mod_two_eq_zero_or_one r with hr2 | hr2 <;>
    rcases Nat.mod_two_eq_zero_or_one c with hc2 | hc2
  · obtain ⟨a₀, ha₀, hv, p, hp, h0, hTP⟩ := baseC_ME_a y k r c hk hyk hr hc hm hr2 hc2
    exact fromTop a₀ ha₀ hv p hp h0 hTP
  · obtain ⟨a₀, ha₀, hv, p, hp, h0, hTP⟩ := baseC_ME_b y k r c hk hyk hr hc hm hr2 hc2
    exact fromTop a₀ ha₀ hv p hp h0 hTP
  · have hk2 : k % 2 = 0 := by
      rcases Nat.mod_two_eq_zero_or_one k with h | h
      · exact h
      · exact absurd ⟨h, hr2, hc2⟩ hce
    obtain ⟨a₀, ha₀, hv, p, hp, h0, hTP⟩ := baseC_ME_d y k r c hk hyk hr hc hm hk2 hr2 hc2
    exact fromTop a₀ ha₀ hv p hp h0 hTP
  · obtain ⟨a₀, ha₀, hv, p, hp, hBE⟩ := baseC_ME_c y k r c hk hyk hr hc hm hr2 hc2
    obtain ⟨p', hp', h1, h2⟩ := dstar_lift y k a₀ r c p hk hyk hv hp (Or.inl hBE)
    exact ⟨a₀, ha₀, p', hp', h1, h2⟩

theorem baseC_CE : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → r < y - k → c < y →
    (y - k) % 2 = 0 → k % 2 = 1 → r % 2 = 1 → c % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p ∧
      (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧
      (IsEnd p (a₀ + (y - k + r) + c) ∨ BotEndInv (y - k) p) :=
by
  intro y k r c hk hyk hr hc hm hk2 hr2 hc2
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjs : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have hm2 : 2 ≤ y - k := by omega
  have hEv : Even (y - k) := Nat.even_iff.mpr hm
  
  
  have econs : ∀ (a b : ℕ) (X : List ℕ), edgeLengths (a :: b :: X) =
      Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: X) := by
    intro a b X
    rfl
  have esnoc : ∀ (l : List ℕ) (a b : ℕ), edgeLengths (l ++ [a, b]) =
      edgeLengths (l ++ [a]) + {Int.natAbs ((b : ℤ) - (a : ℤ))} := by
    intro l
    induction l with
    | nil =>
      intro a b
      simp [edgeLengths]
    | cons c l ih =>
      intro a b
      obtain ⟨d, X, hdX⟩ : ∃ d X, l ++ [a] = d :: X := by
        cases l with
        | nil => exact ⟨a, [], rfl⟩
        | cons d X => exact ⟨d, X ++ [a], rfl⟩
      have h2 : l ++ [a, b] = d :: (X ++ [b]) := by
        rw [show l ++ [a, b] = (l ++ [a]) ++ [b] by simp, hdX]
        rfl
      have ih' := ih a b
      rw [h2, hdX] at ih'
      rw [List.cons_append, List.cons_append, h2, hdX, econs, econs, ih', Multiset.cons_add]
  
  
  have top_attach : ∀ (ℓ v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ ℓ → ℓ ≤ v →
      IsLinearRealization v L p → IsEnd p (v - ℓ) →
      ∃ p' : List ℕ, IsLinearRealization (v + 1) (L + Multiset.replicate 1 ℓ) p' ∧ IsEnd p' v ∧
        (∀ x : ℕ, Adj p x (x + 1) → Adj p' x (x + 1)) ∧
        (∀ x : ℕ, IsEnd p x → x ≠ v - ℓ → IsEnd p' x) := by
    intro ℓ v L p hℓ hv hp hend
    obtain ⟨hperm, hedge⟩ := hp
    have hab : Int.natAbs ((v : ℤ) - ((v - ℓ : ℕ) : ℤ)) = ℓ := by omega
    have hab' : Int.natAbs (((v - ℓ : ℕ) : ℤ) - (v : ℤ)) = ℓ := by omega
    rcases hend with hh | hl
    · obtain ⟨q, rfl⟩ : ∃ q, p = (v - ℓ) :: q := by
        cases p with
        | nil => simp at hh
        | cons a q =>
          simp only [List.head?_cons, Option.some.injEq] at hh
          exact ⟨q, by rw [hh]⟩
      refine ⟨v :: (v - ℓ) :: q, ⟨?_, ?_⟩, Or.inl rfl, ?_, ?_⟩
      · unfold IsVertexPerm at hperm ⊢
        rw [List.range_succ]
        exact (List.perm_append_singleton _ _).symm.trans (hperm.append_right [v])
      · rw [econs, hedge, hab', Multiset.replicate_one, Multiset.add_comm, Multiset.singleton_add]
      · rintro x ⟨l₁, l₂, h⟩
        refine ⟨v :: l₁, l₂, ?_⟩
        rcases h with h | h
        · left; rw [h]; rfl
        · right; rw [h]; rfl
      · intro x hx hne
        rcases hx with hx | hx
        · simp only [List.head?_cons, Option.some.injEq] at hx
          omega
        · right
          rw [List.getLast?_cons_cons]
          exact hx
    · obtain ⟨q, rfl⟩ : ∃ q, p = q ++ [v - ℓ] := List.getLast?_eq_some_iff.mp hl
      have happ : q ++ [v - ℓ, v] = (q ++ [v - ℓ]) ++ [v] := by simp
      refine ⟨q ++ [v - ℓ, v], ⟨?_, ?_⟩, Or.inr (by simp), ?_, ?_⟩
      · unfold IsVertexPerm at hperm ⊢
        rw [List.range_succ, happ]
        exact hperm.append_right [v]
      · rw [esnoc, hedge, hab, Multiset.replicate_one]
      · rintro x ⟨l₁, l₂, h⟩
        refine ⟨l₁, l₂ ++ [v], ?_⟩
        rw [happ]
        rcases h with h | h
        · left; rw [h]; simp
        · right; rw [h]; simp
      · intro x hx hne
        rcases hx with hx | hx
        · left
          cases q with
          | nil =>
            simp only [List.nil_append, List.head?_cons, Option.some.injEq] at hx
            omega
          | cons a q' =>
            simpa using hx
        · simp at hx
          omega
  
  
  have reflect : ∀ (v : ℕ) (L : Multiset ℕ) (p : List ℕ), IsLinearRealization v L p →
      IsLinearRealization v L (p.map (fun x => v - 1 - x)) ∧
      (∀ u w : ℕ, u < v → w < v → Adj p u w →
        Adj (p.map (fun x => v - 1 - x)) (v - 1 - u) (v - 1 - w)) ∧
      (∀ x : ℕ, x < v → IsEnd p x → IsEnd (p.map (fun x => v - 1 - x)) (v - 1 - x)) := by
    intro v L p hp
    obtain ⟨hperm, hedge⟩ := hp
    have hmem : ∀ x ∈ p, x < v := fun x hx => List.mem_range.mp (hperm.mem_iff.mp hx)
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
    · unfold IsVertexPerm
      refine (hperm.map _).trans ?_
      have hnd : ((List.range v).map (fun x => v - 1 - x)).Nodup := by
        refine List.Nodup.map_on ?_ List.nodup_range
        intro x hx y hy hxy
        rw [List.mem_range] at hx hy
        omega
      have hsub : ((List.range v).map (fun x => v - 1 - x)).Subperm (List.range v) := by
        refine List.Nodup.subperm hnd ?_
        intro z hz
        rw [List.mem_map] at hz
        obtain ⟨x, hx, rfl⟩ := hz
        rw [List.mem_range] at hx ⊢
        omega
      exact hsub.perm_of_length_le (by simp)
    · rw [← hedge]
      have key : ∀ l : List ℕ, (∀ x ∈ l, x < v) →
          edgeLengths (l.map (fun x => v - 1 - x)) = edgeLengths l := by
        intro l
        induction l with
        | nil => intro _; rfl
        | cons a t ih =>
          intro hl
          cases t with
          | nil => rfl
          | cons b t' =>
            have ha : a < v := hl a (by simp)
            have hb : b < v := hl b (by simp)
            have ih' := ih (fun x hx => hl x (List.mem_cons_of_mem _ hx))
            simp only [List.map_cons] at ih' ⊢
            rw [econs, econs, ih']
            congr 1
            have h1 : ((v - 1 - b : ℕ) : ℤ) - ((v - 1 - a : ℕ) : ℤ) = -((b : ℤ) - (a : ℤ)) := by
              omega
            rw [h1, Int.natAbs_neg]
      exact key p hmem
    · intro u w _ _ h
      obtain ⟨l₁, l₂, h⟩ := h
      refine ⟨l₁.map (fun x => v - 1 - x), l₂.map (fun x => v - 1 - x), ?_⟩
      rcases h with h | h
      · left; subst h; simp
      · right; subst h; simp
    · intro x _ h
      unfold IsEnd at h ⊢
      rw [List.head?_map, List.getLast?_map]
      rcases h with h | h
      · left; rw [h]; rfl
      · right; rw [h]; rfl
  
  
  have rfin : ∀ (v : ℕ) (L : Multiset ℕ) (P : List ℕ), IsLinearRealization v L P → IsEnd P 0 →
      y - k ≤ v →
      (∀ j : ℕ, 2 * j + 2 ≤ y - k → Adj P (v - 2 - 2 * j) (v - 2 - 2 * j + 1)) →
      ∃ Q : List ℕ, IsLinearRealization v L Q ∧ BotPairInv (y - k) Q ∧ IsEnd Q (v - 1) := by
    intro v L P hP h0 hmv hS
    obtain ⟨hR, hA, hE⟩ := reflect v L P hP
    refine ⟨_, hR, ⟨hEv, ?_⟩, ?_⟩
    · intro j hj
      have h := hA _ _ (by omega) (by omega) (hS j hj)
      exact adjs _ _ _ (adjc _ _ _ _ _ h (by omega) (by omega))
    · have h := hE 0 (by omega) h0
      rwa [Nat.sub_zero] at h
  
  
  have pairs : ∀ (v t : ℕ) (L : Multiset ℕ) (P : List ℕ), y - k ≤ v → 1 ≤ v → 2 * t ≤ y - k →
      IsLinearRealization v L P → BotPairInv (y - k) P → IsEnd P (v - 1) →
      ∃ P' : List ℕ, IsLinearRealization (v + 2 * t) (L + Multiset.replicate (2 * t) (y - k)) P' ∧
        BotPairInv (y - k) P' ∧ IsEnd P' (v + 2 * t - 1) := by
    intro v t L P hv hv1 ht hP hB hE
    obtain ⟨P', hP', hC, hK, hEE⟩ := bot_pairs (y - k) v t L P hm2 hv ht hP (by
      intro i hi
      exact adjc _ _ _ _ _ (hB.2 ((y - k) / 2 - 1 - i) (by omega)) (by omega) (by omega))
    refine ⟨P', hP', ⟨hEv, ?_⟩, ?_⟩
    · intro j hj
      by_cases hjt : j < t
      · exact hC j hjt
      · have h := hK (2 * (j - t)) (hB.2 (j - t) (by omega)) (by intro i hi; omega)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
    · have h := hEE _ hE
      rwa [show v - 1 + 2 * t = v + 2 * t - 1 by omega] at h
  
  
  have lift : ∀ (r₀ : ℕ) (Q : List ℕ), r₀ ≤ y - k + r → (y - k + r - r₀) % 2 = 0 →
      y - k + 1 ≤ y - 2 + r₀ + c + 1 →
      IsLinearRealization (y - 2 + r₀ + c + 1) (prescribedLengths y k (y - 2) r₀ c) Q →
      BotPairInv (y - k) Q → IsEnd Q (y - 2 + r₀ + c) →
      ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
        IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p ∧
        (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧
        (IsEnd p (a₀ + (y - k + r) + c) ∨ BotEndInv (y - k) p) := by
    intro r₀ Q h1 h2 h3 hQ hB hE
    have hE' : IsEnd Q (y - 2 + r₀ + c + 1 - 1) := by
      rwa [show y - 2 + r₀ + c + 1 - 1 = y - 2 + r₀ + c by omega]
    by_cases hd : y - k + r - r₀ ≤ y - k
    · obtain ⟨P, hP, hBP, hEP⟩ :=
        pairs _ ((y - k + r - r₀) / 2) _ Q (by omega) (by omega) (by omega) hQ hB hE'
      have e1 : y - 2 + r₀ + c + 1 + 2 * ((y - k + r - r₀) / 2) = y - 2 + (y - k + r) + c + 1 := by
        omega
      have e2 : prescribedLengths y k (y - 2) r₀ c +
          Multiset.replicate (2 * ((y - k + r - r₀) / 2)) (y - k) =
          prescribedLengths y k (y - 2) (y - k + r) c := by
        have hb : Multiset.replicate (y - k + r) (y - k) = Multiset.replicate r₀ (y - k) +
            Multiset.replicate (2 * ((y - k + r - r₀) / 2)) (y - k) := by
          rw [← Multiset.replicate_add]
          congr 1
          omega
        unfold prescribedLengths
        rw [hb]
        abel
      rw [e1, e2] at hP
      rw [e1] at hEP
      refine ⟨y - 2, by omega, P, hP, Or.inr hBP, Or.inl ?_⟩
      rwa [show y - 2 + (y - k + r) + c + 1 - 1 = y - 2 + (y - k + r) + c by omega] at hEP
    · obtain ⟨Q₁, hQ₁, hB₁, -, hE₁⟩ :=
        grow_bot_pair_iter (y - k) (y - 2 + r₀ + c + 1) 1 _ Q hm2 (by omega) hQ hB
      have hE₁' : IsEnd Q₁ (y - 2 + r₀ + c + 1 + 1 * (y - k) - 1) := by
        have h := hE₁ _ (by omega) hE
        rwa [show y - 2 + r₀ + c + 1 * (y - k) = y - 2 + r₀ + c + 1 + 1 * (y - k) - 1 by omega] at h
      obtain ⟨P, hP, hBP, hEP⟩ :=
        pairs _ ((r - r₀) / 2) _ Q₁ (by omega) (by omega) (by omega) hQ₁ hB₁ hE₁'
      have e1 : y - 2 + r₀ + c + 1 + 1 * (y - k) + 2 * ((r - r₀) / 2) =
          y - 2 + (y - k + r) + c + 1 := by
        omega
      have e2 : prescribedLengths y k (y - 2) r₀ c + Multiset.replicate (1 * (y - k)) (y - k) +
          Multiset.replicate (2 * ((r - r₀) / 2)) (y - k) =
          prescribedLengths y k (y - 2) (y - k + r) c := by
        have hb : Multiset.replicate (y - k + r) (y - k) = Multiset.replicate r₀ (y - k) +
            Multiset.replicate (1 * (y - k)) (y - k) +
            Multiset.replicate (2 * ((r - r₀) / 2)) (y - k) := by
          rw [← Multiset.replicate_add, ← Multiset.replicate_add]
          congr 1
          omega
        unfold prescribedLengths
        rw [hb]
        abel
      rw [e1, e2] at hP
      rw [e1] at hEP
      refine ⟨y - 2, by omega, P, hP, Or.inr hBP, Or.inl ?_⟩
      rwa [show y - 2 + (y - k + r) + c + 1 - 1 = y - 2 + (y - k + r) + c by omega] at hEP
  
  
  have famA : c + 2 ≤ y - k → ∃ Q : List ℕ,
      IsLinearRealization (y - 2 + (k + 2) + c + 1) (prescribedLengths y k (y - 2) (k + 2) c) Q ∧
      BotPairInv (y - k) Q ∧ IsEnd Q (y - 2 + (k + 2) + c) := by
    intro hcA
    obtain ⟨t₁, ht₁⟩ : ∃ t, 2 * t = k + 1 := ⟨(k + 1) / 2, by omega⟩
    obtain ⟨t₂, ht₂⟩ : ∃ t, 2 * t = c := ⟨c / 2, by omega⟩
    obtain ⟨Q₀, hQ₀, -, hQb, hQe0, -⟩ := path_II y k hk (by omega)
    obtain ⟨P₁, hP₁, hN1, hK1, hE1⟩ :=
      top_pairs (y - k) y t₁ _ Q₀ hm2 (by omega) (by omega) hQ₀ (by
        intro i hi
        exact adjc _ _ _ _ _ (hQb (k + 2 * i) (by omega) (by omega)) (by omega) (by omega))
    obtain ⟨P₂, hP₂, hN2, hK2, hE2⟩ :=
      top_pairs y (y + 2 * t₁) t₂ _ P₁ (by omega) (by omega) (by omega) hP₁ (by
        intro i hi
