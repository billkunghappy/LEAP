  have J : ∀ (X Y : List ℕ) (a b : ℕ), X.getLast? = some a → Y.head? = some b →
      Adj (X ++ Y) a b := by
    intro X Y a b hX hY
    rw [List.getLast?_eq_some_iff] at hX
    rw [List.head?_eq_some_iff] at hY
    obtain ⟨X', rfl⟩ := hX
    obtain ⟨Y', rfl⟩ := hY
    exact ⟨X', Y', Or.inl (by simp)⟩
  have hE : IsEnd (okxCore y k r) 0 := by
    left
    simp [okxCore, List.head?_range]
  
  have sA : ∀ z, z ≤ 2 * r → Adj (okxCore y k r) z (z + 1) := by
    intro z hz
    unfold okxCore
    apply FR; apply FR; apply FR
    exact F1 _ z _ _ (List.getElem?_range (by omega)) (List.getElem?_range (by omega))
  
  have sC : ∀ z, 4 * r + 2 ≤ z → z + 2 ≤ 2 * r + 2 + k → Adj (okxCore y k r) z (z + 1) := by
    intro z h1 h2
    unfold okxCore
    apply FR; apply FL
    exact RM _ _ (z - (4 * r + 2)) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  
  have sD : ∀ z, 4 * r + k + 2 ≤ z → z ≤ 2 * r + y → Adj (okxCore y k r) z (z + 1) := by
    intro z h1 h2
    unfold okxCore
    apply FL
    apply SYM
    exact RM _ _ (2 * r + y - z) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  
  have sM : ∀ i, i < r →
      Adj (okxCore y k r) (2 * r + 2 + 2 * i + k) (2 * r + 2 + 2 * i + k + 1) := by
    intro i hi
    unfold okxCore
    apply FR; apply FR; apply FL
    apply INF (okxU y k (2 * r + 2 + 2 * i))
    · exact ⟨[2 * r + 2 + 2 * i, 2 * r + 2 + 2 * i + y],
        [2 * r + 2 + 2 * i + y + 1, 2 * r + 2 + 2 * i + 1], Or.inl rfl⟩
    · exact List.infix_of_mem_flatten (List.mem_map.2 ⟨i, List.mem_range.2 hi, rfl⟩)
  
  have sJ : ∀ j, j ≤ r → Adj (okxCore y k r) (2 * r + 1 + 2 * j) (2 * r + 2 + 2 * j) := by
    intro j hj
    have hR : List.range r = List.range j ++ (List.range (r - j)).map (fun i => j + i) := by
      rw [← List.range_add]; congr 1; omega
    unfold okxCore
    rw [hR, List.flatMap_append]
    rw [show ∀ (A P Q C D : List ℕ), A ++ (P ++ Q) ++ C ++ D = (A ++ P) ++ (Q ++ C ++ D)
      from fun _ _ _ _ _ => by simp only [List.append_assoc]]
    apply J
    · rcases j with _ | j
      · rw [show 2 * r + 2 = (2 * r + 1) + 1 from rfl, List.range_succ]
        simp
      · rw [@List.range_succ j, List.flatMap_append]
        simp [okxU] <;> omega
    · obtain ⟨s, hs⟩ : ∃ s, r - j = s := ⟨_, rfl⟩
      rw [hs]
      rcases s with _ | s
      · obtain ⟨d, hd⟩ : ∃ d, k - 2 * r = d + 1 := ⟨k - 2 * r - 1, by omega⟩
        rw [hd, @List.range_succ_eq_map d]
        simp <;> omega
      · rw [@List.range_succ_eq_map s]
        simp [okxU]
  have hodd : ∀ z : ℕ, z % 2 = 1 → z + 2 ≤ y → Adj (okxCore y k r) z (z + 1) := by
    intro z hz1 hz2
    by_cases c1 : z ≤ 2 * r
    · exact sA z c1
    by_cases c2 : z ≤ 4 * r + 1
    · obtain ⟨j, rfl⟩ : ∃ j, z = 2 * r + 1 + 2 * j := ⟨(z - 2 * r - 1) / 2, by omega⟩
      have h := sJ j (by omega)
      rw [show 2 * r + 2 + 2 * j = 2 * r + 1 + 2 * j + 1 by omega] at h
      exact h
    by_cases c3 : z ≤ 2 * r + k
    · exact sC z (by omega) (by omega)
    by_cases c4 : z ≤ 4 * r + k + 1
    · obtain ⟨i, rfl⟩ : ∃ i, z = 2 * r + 2 + 2 * i + k := ⟨(z - 2 * r - 2 - k) / 2, by omega⟩
      exact sM i (by omega)
    · exact sD z (by omega) (by omega)
  
  
  
  have hD : IsLinearRealization (y + 4 * r + 2) (prescribedLengths y k y (2 * r + 1) (2 * r))
      (okxCore y k r) := ⟨hperm, hedges⟩
  have hslot : ∀ i : ℕ, i < u →
      Adj (okxCore y k r) (y + 4 * r + 2 - y + 2 * i) (y + 4 * r + 2 - y + 2 * i + 1) := by
    intro i hi
    have h := sC (4 * r + 2 + 2 * i) (by omega) (by omega)
    rw [show y + 4 * r + 2 - y = 4 * r + 2 by omega]
    exact h
  obtain ⟨q, hq, -, hkeep, hend⟩ := top_pairs y (y + 4 * r + 2) u _ (okxCore y k r) (by omega)
    (by omega) (by omega) hD hslot
  refine ⟨y, le_refl y, by omega, q, ?_, ?_⟩
  · have e1 : y + (2 * r + 1) + (2 * r + 2 * u) + 1 = y + 4 * r + 2 + 2 * u := by omega
    have e2 : prescribedLengths y k y (2 * r + 1) (2 * r + 2 * u) =
        prescribedLengths y k y (2 * r + 1) (2 * r) + Multiset.replicate (2 * u) y := by
      unfold prescribedLengths
      rw [Multiset.replicate_add (2 * r) (2 * u) y]
      abel
    rw [e1, e2]
    exact hq
  · refine ⟨hend 0 hE, ?_, ?_⟩
    · intro j hj1 hj2
      have h := hodd (2 * j - 1) (by omega) (by omega)
      have h' := hkeep (2 * j - 1) h (fun i _ => by omega)
      rw [show 2 * j - 1 + 1 = 2 * j by omega] at h'
      exact h'
    · intro he
      rw [Nat.even_iff] at he
      omega

theorem okK_perm : ∀ (y k s : ℕ), 1 ≤ k → 1 ≤ s → 2 * s ≤ k + 1 → k + 2 * s + 2 ≤ y →
    (okKSeed y k s).Perm (List.range (y + 2 * s + 3)) :=
by
  intro y k s hk hs hsk hy
  have hU_len : ∀ n : ℕ, ((List.range n).flatMap (okKUnit y k)).length = 6 * n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [List.range_succ, List.flatMap_append, List.length_append, ih]
      simp [okKUnit]
      ring
  have hlen : (okKSeed y k s).length = y + 2 * s + 3 := by
    unfold okKSeed
    simp only [List.length_append, List.length_map, List.length_range, hU_len, List.length_cons,
      List.length_nil]
    omega
  have hA : ∀ x, k + 2 * s + 2 ≤ x → x ≤ y →
      x ∈ (List.range (y - k - 2 * s - 1)).map (fun i => y - i) := by
    intro x h1 h2
    exact List.mem_map.mpr ⟨y - x, List.mem_range.mpr (by omega), by omega⟩
  have hB : ∀ x, 2 * s - 1 ≤ x → x ≤ k + 1 →
      x ∈ (List.range (k + 3 - 2 * s)).map (fun i => 2 * s - 1 + i) := by
    intro x h1 h2
    exact List.mem_map.mpr ⟨x - (2 * s - 1), List.mem_range.mpr (by omega), by omega⟩
  have hG : ∀ x, (x = y + 2 * s + 2 ∨ x = y + 2 * s + 1 ∨ x = k + 2 * s + 1 ∨ x = k + 2 * s ∨
      x = y + 2 * s ∨ x = y + 2 * s - 1) →
      x ∈ ([y + 2 * s + 2, y + 2 * s + 1, k + 2 * s + 1, k + 2 * s, y + 2 * s, y + 2 * s - 1] :
        List ℕ) := by
    intro x h
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    exact h
  have hU : ∀ x, (∃ j, j < s - 1 ∧ (x = y + 1 + 2 * j ∨ x = 1 + 2 * j ∨ x = 2 + 2 * j ∨
      x = y + 2 + 2 * j ∨ x = k + 2 + 2 * j ∨ x = k + 3 + 2 * j)) →
      x ∈ (List.range (s - 1)).flatMap (okKUnit y k) := by
    rintro x ⟨j, hj, h⟩
    rw [List.mem_flatMap]
    refine ⟨j, List.mem_range.mpr hj, ?_⟩
    unfold okKUnit
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    exact h
  have hcov : ∀ x, x < y + 2 * s + 3 → x ∈ okKSeed y k s := by
    intro x hx
    unfold okKSeed
    by_cases c0 : x = 0
    · rw [c0]; exact List.mem_cons_self
    apply List.mem_cons_of_mem
    simp only [List.mem_append]
    by_cases c1 : x + 2 ≤ 2 * s
    · obtain ⟨m, hm | hm⟩ := Nat.even_or_odd' (x - 1)
      · have h := hU x ⟨m, by omega, Or.inr (Or.inl (by omega))⟩
        simp only [h, true_or, or_true]
      · have h := hU x ⟨m, by omega, Or.inr (Or.inr (Or.inl (by omega)))⟩
        simp only [h, true_or, or_true]
    by_cases c2 : x ≤ k + 1
    · have h := hB x (by omega) c2
      simp only [h, true_or, or_true]
    by_cases c3 : x + 1 ≤ k + 2 * s
    · obtain ⟨m, hm | hm⟩ := Nat.even_or_odd' (x - k - 2)
      · have h := hU x ⟨m, by omega, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (by omega)))))⟩
        simp only [h, true_or, or_true]
      · have h := hU x ⟨m, by omega, Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (by omega)))))⟩
        simp only [h, true_or, or_true]
    by_cases c4 : x ≤ k + 2 * s + 1
    · have h := hG x (by omega)
      simp only [h, true_or, or_true]
    by_cases c5 : x ≤ y
    · have h := hA x (by omega) c5
      simp only [h, true_or, or_true]
    by_cases c6 : x + 2 ≤ y + 2 * s
    · obtain ⟨m, hm | hm⟩ := Nat.even_or_odd' (x - y - 1)
      · have h := hU x ⟨m, by omega, Or.inl (by omega)⟩
        simp only [h, true_or, or_true]
      · have h := hU x ⟨m, by omega, Or.inr (Or.inr (Or.inr (Or.inl (by omega))))⟩
        simp only [h, true_or, or_true]
    · have h := hG x (by omega)
      simp only [h, true_or, or_true]
  have hsub : (List.range (y + 2 * s + 3)).Subperm (okKSeed y k s) :=
    List.nodup_range.subperm (fun x hx => hcov x (List.mem_range.mp hx))
  exact (hsub.perm_of_length_le (by rw [hlen, List.length_range])).symm

theorem okK_edges : ∀ (y k s : ℕ), 1 ≤ k → 1 ≤ s → 2 * s ≤ k + 1 → k + 2 * s + 2 ≤ y →
    edgeLengths (okKSeed y k s) = prescribedLengths y k (y - 2 * s + 1) (2 * s + 1) (2 * s) :=
by
  have hU : ∀ (c d : ℕ) (t : List ℕ), edgeLengths (c :: d :: t) =
      Int.natAbs ((d : ℤ) - (c : ℤ)) ::ₘ edgeLengths (d :: t) := fun c d t => rfl
  have hC : ∀ (c h : ℕ) (L : List ℕ), L.head? = some h →
      edgeLengths (c :: L) = Int.natAbs ((h : ℤ) - (c : ℤ)) ::ₘ edgeLengths L := by
    intro c h L hL
    cases L with
    | nil => simp at hL
    | cons d t =>
      simp only [List.head?_cons, Option.some.injEq] at hL
      subst hL
      rfl
  have up : ∀ (a n h : ℕ) (L : List ℕ), L.head? = some h →
      edgeLengths ((List.range (n + 1)).map (fun i => a + i) ++ L) =
        Multiset.replicate n 1 + Multiset.replicate 1 (Int.natAbs ((h : ℤ) - ((a + n : ℕ) : ℤ))) +
          edgeLengths L := by
    intro a n
    induction n with
    | zero =>
      intro h L hL
      rw [show List.range (0 + 1) = [0] from rfl]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [hC _ h L hL]
      simp
    | succ n ih =>
      intro h L hL
      rw [List.range_succ, List.map_append, List.append_assoc]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [ih (a + (n + 1)) _ (by simp), hC _ h L hL]
      have e1 : Int.natAbs (((a + (n + 1) : ℕ) : ℤ) - ((a + n : ℕ) : ℤ)) = 1 := by omega
      rw [e1, Multiset.replicate_one, Multiset.replicate_one, Multiset.replicate_succ]
      simp only [← Multiset.singleton_add]
      abel
  have down : ∀ (a n h : ℕ) (L : List ℕ), n ≤ a → L.head? = some h →
      edgeLengths ((List.range (n + 1)).map (fun i => a - i) ++ L) =
        Multiset.replicate n 1 + Multiset.replicate 1 (Int.natAbs ((h : ℤ) - ((a - n : ℕ) : ℤ))) +
          edgeLengths L := by
    intro a n
    induction n with
    | zero =>
      intro h L _ hL
      rw [show List.range (0 + 1) = [0] from rfl]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [hC _ h L hL]
      simp
    | succ n ih =>
      intro h L hn hL
      rw [List.range_succ, List.map_append, List.append_assoc]
      simp only [List.map_cons, List.map_nil, List.singleton_append]
      rw [ih (a - (n + 1)) _ (by omega) (by simp), hC _ h L hL]
      have e1 : Int.natAbs (((a - (n + 1) : ℕ) : ℤ) - ((a - n : ℕ) : ℤ)) = 1 := by omega
      rw [e1, Multiset.replicate_one, Multiset.replicate_one, Multiset.replicate_succ]
      simp only [← Multiset.singleton_add]
      abel
  intro y k s hk hs hsk hy
  have hky : k < y := by omega
  have Ucont : ∀ (n : ℕ) (L : List ℕ), L.head? = some (y + 1 + 2 * n) →
      edgeLengths ((List.range n).flatMap (okKUnit y k) ++ L) =
        Multiset.replicate (2 * n) 1 + Multiset.replicate (2 * n) (y - k) +
          Multiset.replicate (2 * n) y + edgeLengths L := by
    intro n
    induction n with
    | zero => intro L _; simp
    | succ n ih =>
      intro L hL
      rw [List.range_succ, List.flatMap_append, List.flatMap_singleton, List.append_assoc]
      rw [ih _ (by simp [okKUnit])]
      obtain ⟨t, rfl⟩ : ∃ t, L = (y + 1 + 2 * (n + 1)) :: t := by
        cases L with
        | nil => simp at hL
        | cons d t =>
          simp only [List.head?_cons, Option.some.injEq] at hL
          exact ⟨t, by rw [hL]⟩
      simp only [okKUnit, List.cons_append, List.nil_append]
      rw [hU, hU, hU, hU, hU, hU]
      have e1 : Int.natAbs (((1 + 2 * n : ℕ) : ℤ) - ((y + 1 + 2 * n : ℕ) : ℤ)) = y := by omega
      have e2 : Int.natAbs (((2 + 2 * n : ℕ) : ℤ) - ((1 + 2 * n : ℕ) : ℤ)) = 1 := by omega
      have e3 : Int.natAbs (((y + 2 + 2 * n : ℕ) : ℤ) - ((2 + 2 * n : ℕ) : ℤ)) = y := by omega
      have e4 : Int.natAbs (((k + 2 + 2 * n : ℕ) : ℤ) - ((y + 2 + 2 * n : ℕ) : ℤ)) = y - k := by
        omega
      have e5 : Int.natAbs (((k + 3 + 2 * n : ℕ) : ℤ) - ((k + 2 + 2 * n : ℕ) : ℤ)) = 1 := by omega
      have e6 : Int.natAbs (((y + 1 + 2 * (n + 1) : ℕ) : ℤ) - ((k + 3 + 2 * n : ℕ) : ℤ)) =
          y - k := by omega
      rw [e1, e2, e3, e4, e5, e6]
      rw [show 2 * (n + 1) = 2 * n + 1 + 1 by ring]
      simp only [Multiset.replicate_succ, ← Multiset.singleton_add]
      abel
  have hUnit : ∀ j : ℕ, edgeLengths (okKUnit y k j) = y ::ₘ 1 ::ₘ y ::ₘ (y - k) ::ₘ 1 ::ₘ 0 := by
    intro j
    simp only [okKUnit]
    rw [hU, hU, hU, hU, hU]
    have h0 : edgeLengths [k + 3 + 2 * j] = 0 := rfl
    have e1 : Int.natAbs (((1 + 2 * j : ℕ) : ℤ) - ((y + 1 + 2 * j : ℕ) : ℤ)) = y := by omega
    have e2 : Int.natAbs (((2 + 2 * j : ℕ) : ℤ) - ((1 + 2 * j : ℕ) : ℤ)) = 1 := by omega
    have e3 : Int.natAbs (((y + 2 + 2 * j : ℕ) : ℤ) - ((2 + 2 * j : ℕ) : ℤ)) = y := by omega
    have e4 : Int.natAbs (((k + 2 + 2 * j : ℕ) : ℤ) - ((y + 2 + 2 * j : ℕ) : ℤ)) = y - k := by
      omega
    have e5 : Int.natAbs (((k + 3 + 2 * j : ℕ) : ℤ) - ((k + 2 + 2 * j : ℕ) : ℤ)) = 1 := by omega
    rw [h0, e1, e2, e3, e4, e5]
  have W : ∀ n : ℕ, edgeLengths ((k + 1) :: (List.range n).flatMap (okKUnit y k)) =
      Multiset.replicate (2 * n) 1 + Multiset.replicate (2 * n) (y - k) +
        Multiset.replicate (2 * n) y := by
    intro n
    cases n with
    | zero =>
      simp only [List.range_zero, List.flatMap_nil, Nat.mul_zero, Multiset.replicate_zero,
        add_zero]
      rfl
    | succ n =>
      have hh : ((List.range (n + 1)).flatMap (okKUnit y k)).head? = some (y + 1) := by
        rw [List.range_succ_eq_map]
        simp [okKUnit]
      rw [hC _ _ _ hh]
      rw [List.range_succ, List.flatMap_append, List.flatMap_singleton]
      rw [Ucont n (okKUnit y k n) (by simp [okKUnit]), hUnit n]
      have e0 : Int.natAbs (((y + 1 : ℕ) : ℤ) - ((k + 1 : ℕ) : ℤ)) = y - k := by omega
      rw [e0, show 2 * (n + 1) = 2 * n + 1 + 1 by ring]
      simp only [Multiset.replicate_succ, ← Multiset.singleton_add]
      abel
  
  unfold okKSeed
  simp only [List.append_assoc]
  rw [show y - k - 2 * s - 1 = (y - k - 2 * s - 2) + 1 by omega,
    show k + 3 - 2 * s = (k + 1 - 2 * s) + 1 + 1 by omega]
  have hB : (List.range (k + 1 - 2 * s + 1 + 1)).map (fun i => 2 * s - 1 + i) =
      (List.range (k + 1 - 2 * s + 1)).map (fun i => 2 * s - 1 + i) ++ [k + 1] := by
    have e : 2 * s - 1 + (k + 1 - 2 * s + 1) = k + 1 := by omega
    rw [List.range_succ (n := k + 1 - 2 * s + 1)]
    simp only [List.map_append, List.map_cons, List.map_nil]
    rw [e]
  rw [hB, List.append_assoc, List.singleton_append]
  
  have hW := W (s - 1)
  have hBp := up (2 * s - 1) (k + 1 - 2 * s) (k + 1)
    ((k + 1) :: (List.range (s - 1)).flatMap (okKUnit y k)) rfl
  have eBp : Int.natAbs (((k + 1 : ℕ) : ℤ) - ((2 * s - 1 + (k + 1 - 2 * s) : ℕ) : ℤ)) = 1 := by
    omega
  rw [eBp] at hBp
  have hG : edgeLengths ([y + 2 * s + 2, y + 2 * s + 1, k + 2 * s + 1, k + 2 * s, y + 2 * s,
      y + 2 * s - 1] ++ ((List.range (k + 1 - 2 * s + 1)).map (fun i => 2 * s - 1 + i) ++
        ((k + 1) :: (List.range (s - 1)).flatMap (okKUnit y k)))) =
      1 ::ₘ (y - k) ::ₘ 1 ::ₘ (y - k) ::ₘ 1 ::ₘ y ::ₘ
        edgeLengths ((List.range (k + 1 - 2 * s + 1)).map (fun i => 2 * s - 1 + i) ++
          ((k + 1) :: (List.range (s - 1)).flatMap (okKUnit y k))) := by
    simp only [List.cons_append, List.nil_append]
    rw [hU, hU, hU, hU, hU]
    rw [hC (y + 2 * s - 1) (2 * s - 1) _ (by
      rw [List.range_succ_eq_map]
      simp)]
    have e1 : Int.natAbs (((y + 2 * s + 1 : ℕ) : ℤ) - ((y + 2 * s + 2 : ℕ) : ℤ)) = 1 := by omega
    have e2 : Int.natAbs (((k + 2 * s + 1 : ℕ) : ℤ) - ((y + 2 * s + 1 : ℕ) : ℤ)) = y - k := by
      omega
    have e3 : Int.natAbs (((k + 2 * s : ℕ) : ℤ) - ((k + 2 * s + 1 : ℕ) : ℤ)) = 1 := by omega
    have e4 : Int.natAbs (((y + 2 * s : ℕ) : ℤ) - ((k + 2 * s : ℕ) : ℤ)) = y - k := by omega
    have e5 : Int.natAbs (((y + 2 * s - 1 : ℕ) : ℤ) - ((y + 2 * s : ℕ) : ℤ)) = 1 := by omega
    have e6 : Int.natAbs (((2 * s - 1 : ℕ) : ℤ) - ((y + 2 * s - 1 : ℕ) : ℤ)) = y := by omega
    rw [e1, e2, e3, e4, e5, e6]
  have hT := down y (y - k - 2 * s - 2) (y + 2 * s + 2)
    ([y + 2 * s + 2, y + 2 * s + 1, k + 2 * s + 1, k + 2 * s, y + 2 * s,
      y + 2 * s - 1] ++ ((List.range (k + 1 - 2 * s + 1)).map (fun i => 2 * s - 1 + i) ++
        ((k + 1) :: (List.range (s - 1)).flatMap (okKUnit y k)))) (by omega) (by simp)
  have eT : Int.natAbs (((y + 2 * s + 2 : ℕ) : ℤ) - ((y - (y - k - 2 * s - 2) : ℕ) : ℤ)) = y - k := by
    omega
  rw [eT] at hT
  have h0 : ((List.range (y - k - 2 * s - 2 + 1)).map (fun i => y - i) ++
      ([y + 2 * s + 2, y + 2 * s + 1, k + 2 * s + 1, k + 2 * s, y + 2 * s,
      y + 2 * s - 1] ++ ((List.range (k + 1 - 2 * s + 1)).map (fun i => 2 * s - 1 + i) ++
        ((k + 1) :: (List.range (s - 1)).flatMap (okKUnit y k))))).head? = some y := by
    rw [List.range_succ_eq_map]
    simp
  rw [hC 0 y _ h0, hT, hG, hBp, hW]
  have ey0 : Int.natAbs (((y : ℕ) : ℤ) - ((0 : ℕ) : ℤ)) = y := by omega
  rw [ey0]
  unfold prescribedLengths
  have ey : Multiset.replicate (y - 2 * s + 1) 1 = Multiset.replicate (y - k - 2 * s - 2) 1 +
      Multiset.replicate (k + 1 - 2 * s) 1 + Multiset.replicate (2 * (s - 1)) 1 +
      Multiset.replicate 1 1 + Multiset.replicate 1 1 + Multiset.replicate 1 1 +
      Multiset.replicate 1 1 := by
    simp only [← Multiset.replicate_add]
    congr 1
    omega
  have em : Multiset.replicate (2 * s + 1) (y - k) = Multiset.replicate (2 * (s - 1)) (y - k) +
      Multiset.replicate 1 (y - k) + Multiset.replicate 1 (y - k) +
      Multiset.replicate 1 (y - k) := by
    simp only [← Multiset.replicate_add]
    congr 1
    omega
  have e3 : Multiset.replicate (2 * s) y = Multiset.replicate (2 * (s - 1)) y +
      Multiset.replicate 1 y + Multiset.replicate 1 y := by
    simp only [← Multiset.replicate_add]
    congr 1
    omega
  rw [ey, em, e3]
  simp only [Multiset.replicate_one, ← Multiset.singleton_add]
  abel

theorem okK_slots : ∀ (y k s : ℕ), 1 ≤ k → 1 ≤ s → 2 * s ≤ k + 1 → k + 2 * s + 2 ≤ y →
    IsEnd (okKSeed y k s) 0 ∧
    (∀ x : ℕ, k + 2 * s + 2 ≤ x → x + 1 ≤ y → Adj (okKSeed y k s) x (x + 1)) ∧
    Adj (okKSeed y k s) (k + 2 * s) (k + 2 * s + 1) ∧
    (∀ x : ℕ, 2 * s - 1 ≤ x → x ≤ k → Adj (okKSeed y k s) x (x + 1)) ∧
    (∀ j : ℕ, j + 2 ≤ s → Adj (okKSeed y k s) (1 + 2 * j) (2 + 2 * j) ∧
      Adj (okKSeed y k s) (k + 2 + 2 * j) (k + 3 + 2 * j)) :=
by
  intro y k s hk hs hsk hY
  have F1 : ∀ (p : List ℕ) (j u w : ℕ), p[j]? = some u → p[j+1]? = some w → Adj p u w := by
    intro p j u w h1 h2
    rw [List.getElem?_eq_some_iff] at h1 h2
    obtain ⟨hj1, rfl⟩ := h1
    obtain ⟨hj2, rfl⟩ := h2
    have h := List.take_append_drop j p
    rw [List.drop_eq_getElem_cons hj1, List.drop_eq_getElem_cons hj2] at h
    exact ⟨p.take j, p.drop (j + 1 + 1), Or.inl h.symm⟩
  have FR : ∀ (s R : List ℕ) (u w : ℕ), Adj s u w → Adj (s ++ R) u w := by
    rintro s R u w ⟨l₁, l₂, h⟩
    refine ⟨l₁, l₂ ++ R, ?_⟩
    rcases h with rfl | rfl
    · left; simp
    · right; simp
  have FL : ∀ (L s : List ℕ) (u w : ℕ), Adj s u w → Adj (L ++ s) u w := by
    rintro L s u w ⟨l₁, l₂, h⟩
    refine ⟨L ++ l₁, l₂, ?_⟩
    rcases h with rfl | rfl
    · left; simp
    · right; simp
  have FC : ∀ (a : ℕ) (s : List ℕ) (u w : ℕ), Adj s u w → Adj (a :: s) u w := by
    intro a s u w h
    exact FL [a] s u w h
  have INF : ∀ (s t : List ℕ) (u w : ℕ), Adj s u w → s <:+: t → Adj t u w := by
    rintro s t u w h ⟨L, R, rfl⟩
    exact FR _ _ _ _ (FL _ _ _ _ h)
  have SYM : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  have RM : ∀ (f : ℕ → ℕ) (n i u w : ℕ), i + 1 < n → f i = u → f (i + 1) = w →
      Adj ((List.range n).map f) u w := by
    intro f n i u w hi hu hw
    apply F1 _ i
    · simp [List.getElem?_range (show i < n by omega), hu]
    · simp [List.getElem?_range hi, hw]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · left
    rfl
  · intro x h1 h2
    unfold okKSeed
    apply FC; apply FR; apply FR; apply FR
    apply SYM
    exact RM _ _ (y - 1 - x) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  · unfold okKSeed
    apply FC; apply FR; apply FR; apply FL
    exact ⟨[y + 2 * s + 2, y + 2 * s + 1], [y + 2 * s, y + 2 * s - 1], Or.inr rfl⟩
  · intro x h1 h2
    unfold okKSeed
    apply FC; apply FR; apply FL
    exact RM _ _ (x - (2 * s - 1)) _ _ (by omega) (by first | omega | (simp only []; omega))
      (by first | omega | (simp only []; omega))
  · intro j hj
    have hj' : j < s - 1 := by omega
    have hinf : okKUnit y k j <:+: (List.range (s - 1)).flatMap (okKUnit y k) :=
      List.infix_of_mem_flatten (List.mem_map.2 ⟨j, List.mem_range.2 hj', rfl⟩)
    refine ⟨?_, ?_⟩
    · unfold okKSeed
      apply FC; apply FL
      apply INF (okKUnit y k j) _ _ _ _ hinf
      exact ⟨[y + 1 + 2 * j], [y + 2 + 2 * j, k + 2 + 2 * j, k + 3 + 2 * j], Or.inl rfl⟩
    · unfold okKSeed
      apply FC; apply FL
      apply INF (okKUnit y k j) _ _ _ _ hinf
      exact ⟨[y + 1 + 2 * j, 1 + 2 * j, 2 + 2 * j, y + 2 + 2 * j], [], Or.inl rfl⟩

theorem okOE_K : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 0 → 2 ≤ c → c ≤ k + 1 → c + 1 ≤ b → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ q : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) q ∧ BotEndInv y q :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hc0 hck hcb
  obtain ⟨s, rfl⟩ : ∃ s, c = 2 * s := ⟨c / 2, by omega⟩
  obtain ⟨t, rfl⟩ : ∃ t, b = 2 * s + 1 + 2 * t := ⟨(b - 2 * s - 1) / 2, by omega⟩
  have hs : 1 ≤ s := by omega
  have hsk : 2 * s ≤ k + 1 := by omega
  have hY : k + 2 * s + 2 + 2 * t ≤ y := by omega
  have hY' : k + 2 * s + 2 ≤ y := by omega
  have hp : IsLinearRealization (y + 2 * s + 3)
      (prescribedLengths y k (y - 2 * s + 1) (2 * s + 1) (2 * s)) (okKSeed y k s) :=
    ⟨okK_perm y k s hk hs hsk hY', okK_edges y k s hk hs hsk hY'⟩
  obtain ⟨hE, hT, hG, hB, hU⟩ := okK_slots y k s hk hs hsk hY'
  have hv : y + 2 * s + 3 - (y - k) = k + 2 * s + 3 := by omega
  have hslot : ∀ i : ℕ, i < t → Adj (okKSeed y k s) (y + 2 * s + 3 - (y - k) + 2 * i)
      (y + 2 * s + 3 - (y - k) + 2 * i + 1) := by
    intro i hi
    rw [hv]
    exact hT _ (by omega) (by omega)
  obtain ⟨q, hq, -, hkeep, hend⟩ := top_pairs (y - k) (y + 2 * s + 3) t _ (okKSeed y k s)
    (by omega) (by omega) (by omega) hp hslot
  have e1 : y + 2 * s + 3 + 2 * t = (y - 2 * s + 1) + (2 * s + 1 + 2 * t) + 2 * s + 1 := by
    omega
  have e2 : prescribedLengths y k (y - 2 * s + 1) (2 * s + 1) (2 * s) +
      Multiset.replicate (2 * t) (y - k) =
      prescribedLengths y k (y - 2 * s + 1) (2 * s + 1 + 2 * t) (2 * s) := by
    unfold prescribedLengths
    rw [Multiset.replicate_add (2 * s + 1) (2 * t) (y - k)]
    abel
  rw [e1, e2] at hq
  refine ⟨y - 2 * s + 1, by omega, by omega, q, hq, ?_⟩
  refine ⟨hend 0 hE, ?_, ?_⟩
  · intro j hj1 hj2
    have hx : Adj (okKSeed y k s) (2 * j - 1) (2 * j - 1 + 1) := by
      rcases (show 2 * j - 1 + 2 ≤ 2 * s - 1 ∨ (2 * s - 1 ≤ 2 * j - 1 ∧ 2 * j - 1 ≤ k) ∨
          (k + 2 ≤ 2 * j - 1 ∧ 2 * j - 1 ≤ k + 2 * s - 2) ∨ 2 * j - 1 = k + 2 * s ∨
          k + 2 * s + 2 ≤ 2 * j - 1 by omega) with h | h | h | h | h
      · have h1 := (hU (j - 1) (by omega)).1
        rw [show 1 + 2 * (j - 1) = 2 * j - 1 by omega,
          show 2 + 2 * (j - 1) = 2 * j - 1 + 1 by omega] at h1
        exact h1
      · exact hB _ h.1 h.2
      · obtain ⟨j', hj'⟩ : ∃ j', 2 * j - 1 = k + 2 + 2 * j' := ⟨(2 * j - 1 - k - 2) / 2, by omega⟩
        have h1 := (hU j' (by omega)).2
        rw [hj', show k + 2 + 2 * j' + 1 = k + 3 + 2 * j' by omega]
        exact h1
      · rw [h]
        exact hG
      · exact hT _ h (by omega)
    have h2 := hkeep _ hx (fun i _ => by omega)
    rw [show 2 * j - 1 + 1 = 2 * j by omega] at h2
    exact h2
  · intro he
    rw [Nat.even_iff] at he
    omega

theorem okOE_P1 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 0 → k + 1 ≤ c → b + c ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ q : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) q ∧ BotEndInv y q :=
by
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  
  have bot_ones : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ v →
      IsLinearRealization v L p → IsEnd p 0 →
      ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧ IsEnd p' 0 ∧
        (∀ x : ℕ, x < r → Adj p' x (x + 1)) ∧
        (∀ x : ℕ, Adj p x (x + 1) → Adj p' (x + r) (x + r + 1)) ∧
        (∀ x : ℕ, IsEnd p x → x ≠ 0 → IsEnd p' (x + r)) := by
    have eCC : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (a :: b :: l) =
        Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l) := by
      intro a b l
      simp [edgeLengths]
    have eS : ∀ a : ℕ, edgeLengths [a] = 0 := by
      intro a
      simp [edgeLengths]
    have eSnoc : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (l ++ [a, b]) =
        Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (l ++ [a]) := by
      intro a b l
      induction l with
      | nil => simp [eCC, eS]
      | cons c l ih =>
        cases l with
        | nil =>
          simp only [List.nil_append, List.cons_append, eCC, eS]
          exact Multiset.cons_swap _ _ _
        | cons d l =>
          simp only [List.cons_append] at ih ⊢
          rw [eCC, ih, eCC, Multiset.cons_swap]
    have eRev : ∀ l : List ℕ, edgeLengths l.reverse = edgeLengths l := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih =>
        cases l with
        | nil => simp
        | cons b l =>
          have h1 : (a :: b :: l).reverse = l.reverse ++ [b, a] := by simp
          have h2 : (b :: l).reverse = l.reverse ++ [b] := by simp
          rw [h1, eSnoc, ← h2, ih, eCC]
          congr 1
          rw [← Int.natAbs_neg]
          congr 1
          ring
    have eMap : ∀ l : List ℕ, edgeLengths (l.map (· + 1)) = edgeLengths l := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih =>
        cases l with
        | nil => simp [eS]
        | cons b l =>
          simp only [List.map_cons] at ih ⊢
          rw [eCC, ih, eCC]
          congr 1
          push_cast
          ring_nf
    have adjRev : ∀ (l : List ℕ) (u w : ℕ), Adj l u w → Adj l.reverse u w := by
      rintro l u w ⟨l₁, l₂, h | h⟩
      · exact ⟨l₂.reverse, l₁.reverse, Or.inr (by simp [h])⟩
      · exact ⟨l₂.reverse, l₁.reverse, Or.inl (by simp [h])⟩
    have adjShift : ∀ (l : List ℕ) (u w : ℕ), Adj l u w →
        Adj (0 :: l.map (· + 1)) (u + 1) (w + 1) := by
      rintro l u w ⟨l₁, l₂, h | h⟩
      · exact ⟨0 :: l₁.map (· + 1), l₂.map (· + 1), Or.inl (by simp [h])⟩
      · exact ⟨0 :: l₁.map (· + 1), l₂.map (· + 1), Or.inr (by simp [h])⟩
    have gLast : ∀ (l : List ℕ) (x : ℕ), l.getLast? = some x →
        (0 :: l.map (· + 1)).getLast? = some (x + 1) := by
      intro l x h
      cases l with
      | nil => simp at h
      | cons a l =>
        have e : (a + 1) :: List.map (fun x => x + 1) l = (a :: l).map (· + 1) := rfl
        rw [List.map_cons, List.getLast?_cons_cons, e, List.getLast?_map, h]
        rfl
    have H : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), IsLinearRealization v L p →
        p.head? = some 0 →
        ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧
          p'.head? = some 0 ∧ (∀ x : ℕ, x < r → Adj p' x (x + 1)) ∧
          (∀ u w : ℕ, Adj p u w → Adj p' (u + r) (w + r)) ∧
          (∀ x : ℕ, p.getLast? = some x → p'.getLast? = some (x + r)) := by
      intro r v L p hp hh
      induction r with
      | zero => exact ⟨p, by simpa using hp, hh, fun x hx => by omega,
          fun u w h => by simpa using h, fun x hx => by simpa using hx⟩
      | succ r ih =>
        obtain ⟨p', ⟨hperm, hlen⟩, hh', hO, hA, hL⟩ := ih
        obtain ⟨t, rfl⟩ : ∃ t, p' = 0 :: t := by
          cases p' with
          | nil => simp at hh'
          | cons a t => simp at hh'; exact ⟨t, by rw [hh']⟩
        refine ⟨0 :: (0 :: t).map (· + 1), ⟨?_, ?_⟩, rfl, ?_, ?_, ?_⟩
        · show (0 :: (0 :: t).map (· + 1)).Perm (List.range (v + r + 1))
          rw [List.range_succ_eq_map]
          exact (List.Perm.map (· + 1) hperm).cons 0
        · have e : (0 :: (0 :: t).map (· + 1)) = 0 :: 1 :: t.map (· + 1) := rfl
          have e' : (1 :: t.map (· + 1)) = (0 :: t).map (· + 1) := rfl
          rw [e, eCC, e', eMap, hlen, Multiset.replicate_succ, Multiset.add_cons]
          rfl
        · intro x hx
          rcases x with _ | x
          · exact ⟨[], (t.map (· + 1)), Or.inl (by simp)⟩
          · exact adjShift _ _ _ (hO x (by omega))
        · intro u w h
          exact adjShift _ _ _ (hA u w h)
        · intro x hx
          have h := gLast _ _ (hL x hx)
          rw [show x + (r + 1) = x + r + 1 by omega]
          exact h
    intro r v L p hv hp h0
    rcases h0 with h0 | h0
    · obtain ⟨p', hp', hh', hO, hA, hL⟩ := H r v L p hp h0
      refine ⟨p', hp', Or.inl hh', hO, fun x hx => ?_, fun x hx hx0 => ?_⟩
      · have h := hA _ _ hx
        rw [show x + 1 + r = x + r + 1 by omega] at h
        exact h
      rcases hx with hx | hx
      · rw [h0] at hx
        simp at hx
        omega
      · exact Or.inr (hL x hx)
    · have hpr : IsLinearRealization v L p.reverse :=
        ⟨List.Perm.trans (List.reverse_perm p) hp.1, by rw [eRev]; exact hp.2⟩
      have hh : p.reverse.head? = some 0 := by rw [List.head?_reverse]; exact h0
      obtain ⟨p', hp', hh', hO, hA, hL⟩ := H r v L p.reverse hpr hh
      refine ⟨p', hp', Or.inl hh', hO, fun x hx => ?_, fun x hx hx0 => ?_⟩
      · have h := hA _ _ (adjRev _ _ _ hx)
        rw [show x + 1 + r = x + r + 1 by omega] at h
        exact h
      rcases hx with hx | hx
      · exact Or.inr (hL x (by rw [List.getLast?_reverse]; exact hx))
      · rw [h0] at hx
        simp at hx
        omega
  
  have seed : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ,
      IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - 1)) Q ∧
      (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧ (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧
      IsEnd Q (j - 1) ∧ IsEnd Q j := by
    intro n j hj hn
    obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
    have hm : 1 ≤ m := by omega
    refine ⟨List.map (fun y => j + y) (List.range m) ++ List.range j,
      ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
    · show List.Perm _ _
      rw [List.range_add]
      exact List.perm_append_comm
    · have hlen : (List.map (fun y => j + y) (List.range m) ++ List.range j).length
