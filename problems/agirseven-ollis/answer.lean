  obtain ⟨q, hq, hqB⟩ := hB (y - k) s1 s2 (y - k + 2 + 2 * s0) _ p (by omega) (by omega)
    (by omega) (by omega) (by omega) (by omega) (by omega) hp hp0 hOC (by
      intro i hi
      exact hEC _ (by omega) (by omega) (by omega))
  refine ⟨y - k - 1, by omega, by omega, q, ?_, hqB⟩
  have e : y - k + 2 + 2 * s0 + 2 * s1 + 2 * s2 + 1 = y - k - 1 + b + c + 1 := by omega
  rw [e] at hq
  have hbv : b = 1 + 2 * s0 + 2 * s1 := by omega
  have hcv : c = 2 * s2 + 1 + 1 := by omega
  have eL : Multiset.replicate (y - k - 1) 1 + Multiset.replicate 1 (y - k) +
      Multiset.replicate (2 * s0) (y - k) + Multiset.replicate 1 y +
      Multiset.replicate (2 * s1) (y - k) + Multiset.replicate (2 * s2) y +
      Multiset.replicate 1 y = prescribedLengths y k (y - k - 1) b c := by
    unfold prescribedLengths
    rw [hbv, hcv]
    simp only [Multiset.replicate_add]
    abel
  rw [← eL]
  exact hq

theorem baseB_okO_OE : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 0 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2
  
  have flip : ∀ (v : ℕ) (L : Multiset ℕ) (q : List ℕ), y ≤ v → IsLinearRealization v L q →
      BotEndInv y q →
      IsLinearRealization v L (q.map (fun x => v - 1 - x)) ∧
        TopEndInv y v (q.map (fun x => v - 1 - x)) := by
    intro v L q hv hq hbot
    obtain ⟨hR, hA, hE⟩ := reflect_realization v L q hq
    obtain ⟨h0, hpair, -⟩ := hbot
    refine ⟨hR, ?_⟩
    unfold TopEndInv
    refine ⟨?_, ?_, ?_⟩
    · have h := hE 0 (by omega) h0
      rw [Nat.sub_zero] at h
      exact h
    · intro j hj1 hj2
      have h := hA (2 * j - 1) (2 * j) (by omega) (by omega) (hpair j hj1 hj2)
      rw [show v - 1 - (2 * j - 1) = v - 2 * j by omega] at h
      exact h
    · intro he
      rw [Nat.even_iff] at he
      omega
  
  suffices H : ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ q : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) q ∧ BotEndInv y q by
    obtain ⟨a₀, ha, hv, q, hq, hbot⟩ := H
    have hf := flip _ _ q hv hq hbot
    exact ⟨a₀, ha, hv, _, hf.1, hf.2⟩
  by_cases h1 : c = 0
  · exact okOE_F1 y k b c hk hyk hy hk2 hb hc hb2 hc2 h1
  by_cases h2 : c + 1 ≤ k ∧ b ≤ c + 1
  · exact okOE_X y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h2.1 h2.2
  by_cases h3 : c ≤ k + 1 ∧ c + 1 ≤ b
  · exact okOE_K y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h3.1 h3.2
  by_cases h4 : b + c ≤ y
  · exact okOE_P1 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h4
  by_cases h5 : y - k ≤ c
  · exact okOE_Z y k b c hk hyk hy hk2 hb hc hb2 hc2 h5
  by_cases h6 : y + k + 1 ≤ b + c
  · exact okOE_P6 y k b c hk hyk hy hk2 hb hc hb2 hc2 h6 (by omega)
  · exact okOE_E2 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega) (by omega)

theorem bko11_S2 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → c + 2 ≤ k → c + 2 ≤ b → k ≤ b + c + 1 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hI hcb hS2
  obtain ⟨u, rfl⟩ : ∃ u, c = 2 * u + 1 := ⟨c / 2, by omega⟩
  obtain ⟨w, r, rfl, hr, hw, hkk⟩ : ∃ w r : ℕ, b = 2 * u + 3 + 2 * w + 2 * r ∧
