    ⟨(b - k) / 2, (b - 2 * u - 3 - 2 * ((b - k) / 2)) / 2, by omega, by omega, by omega, by omega⟩
  have hv : y + k - 4 * u - 2 * r - 5 + (2 * u + 3 + 2 * w + 2 * r) + (2 * u + 1) + 1 =
      y + k + 2 * w := by omega
  refine ⟨y + k - 4 * u - 2 * r - 5, by omega, by omega, ?_⟩
  rw [hv]
  
  have hT : (bS2Tail y k u w r).head? = some (2 * k + 2 * w) := by
    unfold bS2Tail
    rw [show y + 1 - (2 * k + 2 * w) = (y - (2 * k + 2 * w)) + 1 by omega, List.range_succ_eq_map]
