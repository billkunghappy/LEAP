    fun i hi z hz => List.mem_flatMap.2 ⟨i, List.mem_range.2 hi, hz⟩
  
  
  
  have Usucc : ∀ s r, lcvUs μ κ s (r + 1) = ldvUnit μ κ (s + r) ++ lcvUs μ κ s r := by
    intro s r
