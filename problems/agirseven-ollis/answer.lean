    (by omega) hR (fun i hi => by
      rw [show y + 1 - (y - k) + 2 * i = k + 1 + 2 * i by omega]
      exact hS _ (by omega) (by omega))
  refine ⟨y - 1, by omega, by omega, p, ?_, ?_, hE 0 h0⟩
  · rw [show y - 1 + 2 * b' + 1 + 1 = y + 1 + 2 * b' by omega]
    have hM : prescribedLengths y k (y - 1) (2 * b') 1 =
        Multiset.replicate (y - 1) 1 + Multiset.replicate 1 y +
