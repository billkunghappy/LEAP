  obtain ⟨p₁, hp₁, -, hS₁, hE₁⟩ := bot_pairs y (y + 3) u _ _ (by omega) (by omega)
    (by omega) hQ (fun i hi =>
      adj_cast _ _ _ _ _ rfl (by omega) (hrun (y - 2 - 2 * i) (by omega) (by omega)))
  
  obtain ⟨p₂, hp₂, -, hS₂, hE₂⟩ := bot_pairs (y - k) (y + 3 + 2 * u) t _ p₁ (by omega)
    (by omega) (by omega) hp₁ (fun i hi => by
