    · intro x hx
      simpa using hadj [] [0] x hx
    · intro x hx hne
      rcases hx with hx | hx
      · exact Or.inl (hendT x hx)
      · simp at hx
        omega

theorem path_II : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ,
    IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - j)) Q ∧
    (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧
    (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧
    IsEnd Q 0 ∧ IsEnd Q j :=
by
  intro n j hj hn
  obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
  have hm : 1 ≤ m := by omega
  refine ⟨List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse,
    ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · 
    show List.Perm _ _
    rw [List.range_add]
    exact (List.Perm.append_left _ (List.reverse_perm _)).trans List.perm_append_comm
  · 
    have hlen : (List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse).length
        = m + j := by simp
    have hQ : ∀ (i : ℕ) (h : i < (List.map (fun y => j + y) (List.range m) ++
        (List.range j).reverse).length),
        (List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse)[i] =
          if i < m then j + i else j - 1 - (i - m) := by
      intro i h
      by_cases hi : i < m
      · rw [List.getElem_append_left (by simpa using hi)]
        simp [hi]
      · rw [List.getElem_append_right (by simpa using hi)]
        simp [hi]
    have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        ((List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse).map
          (fun a : ℕ => (a : ℤ)))
        ((List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse).tail.map
          (fun a : ℕ => (a : ℤ))) =
        List.replicate (m - 1) 1 ++ m :: List.replicate (j - 1) 1 := by
      apply List.ext_getElem
      · simp only [List.length_zipWith, List.length_map, List.length_tail, hlen,
          List.length_append, List.length_replicate, List.length_cons]
        omega
      · intro i h1 h2
        simp only [List.length_zipWith, List.length_map, List.length_tail, hlen] at h1
        rw [List.getElem_zipWith, List.getElem_map, List.getElem_map, List.getElem_tail,
          hQ, hQ]
        simp only [List.getElem_append, List.getElem_cons, List.getElem_replicate,
          List.length_replicate]
        rw [Int.natAbs_eq_iff]
        split_ifs <;> omega
    have he : edgeLengths (List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse) =
        ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        ((List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse).map
          (fun a : ℕ => (a : ℤ)))
        ((List.map (fun y => j + y) (List.range m) ++ (List.range j).reverse).tail.map
          (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
      unfold edgeLengths
      simp only [List.map_eq_flatMap]
      rfl
    rw [he, hl, show j + m - j = m by omega, show j + m - 2 = (m - 1) + (j - 1) by omega,
      Multiset.replicate_add, ← Multiset.coe_add, ← Multiset.cons_coe, Multiset.coe_replicate,
      Multiset.coe_replicate, Multiset.replicate_one, ← Multiset.singleton_add]
    abel
  · 
    intro x hx
    obtain ⟨r, rfl⟩ : ∃ r, j = x + 1 + 1 + r := ⟨j - x - 2, by omega⟩
    refine ⟨List.map (fun y => x + 1 + 1 + r + y) (List.range m) ++
      (List.map (fun y => x + 1 + 1 + y) (List.range r)).reverse, (List.range x).reverse,
      Or.inr ?_⟩
    rw [List.range_add, List.range_succ, List.range_succ]
    simp [List.append_assoc, List.reverse_append]
  · 
    intro x hx1 hx2
    obtain ⟨d, rfl⟩ : ∃ d, x = j + d := ⟨x - j, by omega⟩
    obtain ⟨r, rfl⟩ : ∃ r, m = d + 1 + 1 + r := ⟨m - d - 2, by omega⟩
    refine ⟨List.map (fun y => j + y) (List.range d),
      List.map (fun y => j + y) (List.map (fun y => d + 1 + 1 + y) (List.range r)) ++
        (List.range j).reverse, Or.inl ?_⟩
    rw [List.range_add, List.range_succ, List.range_succ]
    simp [List.append_assoc, add_assoc]
  · 
    right
    have hj0 : j ≠ 0 := by omega
    simp [List.getLast?_append, List.getLast?_reverse, List.head?_range, hj0]
  · 
    left
    have hm0 : m ≠ 0 := by omega
    simp [List.head?_append, List.head?_map, List.head?_range, hm0]

theorem path_range : ∀ n : ℕ, 1 ≤ n →
    IsLinearRealization n (Multiset.replicate (n - 1) 1) (List.range n) ∧
    (∀ x : ℕ, x + 2 ≤ n → Adj (List.range n) x (x + 1)) ∧
    IsEnd (List.range n) 0 ∧ IsEnd (List.range n) (n - 1) :=
by
  intro n hn
  refine ⟨⟨List.Perm.refl _, ?_⟩, ?_, ?_, ?_⟩
  · have hl : List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        ((List.range n).map (fun a : ℕ => (a : ℤ)))
        ((List.range n).tail.map (fun a : ℕ => (a : ℤ))) = List.replicate (n - 1) 1 := by
      apply List.ext_getElem
      · simp only [List.length_zipWith, List.length_map, List.length_tail, List.length_range,
          List.length_replicate]
        omega
      · intro i h1 h2
        simp only [List.length_zipWith, List.length_map, List.length_tail,
          List.length_range] at h1
        simp only [List.getElem_zipWith, List.getElem_map, List.getElem_tail,
          List.getElem_range, List.getElem_replicate]
        push_cast
        simp
    have he : edgeLengths (List.range n) = ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
        ((List.range n).map (fun a : ℕ => (a : ℤ)))
        ((List.range n).tail.map (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
      unfold edgeLengths
      simp only [List.map_eq_flatMap]
      rfl
    rw [he, hl, Multiset.coe_replicate]
  · intro x hx
    obtain ⟨r, rfl⟩ : ∃ r, n = x + 2 + r := ⟨n - x - 2, by omega⟩
    refine ⟨List.range x, List.map (fun i => x + 2 + i) (List.range r), Or.inl ?_⟩
    rw [List.range_add, List.range_succ, List.range_succ]
    simp [List.append_assoc]
  · exact Or.inl (by rw [List.head?_range, if_neg (by omega)])
  · exact Or.inr (by rw [List.getLast?_range, if_neg (by omega)])

