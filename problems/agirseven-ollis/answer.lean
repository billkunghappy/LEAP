    · refine ⟨pre ++ l₁.map (· + 1), l₂.map (· + 1) ++ suf, Or.inr ?_⟩
      rw [h]; simp
  have hendH : ∀ x : ℕ, p.getLast? = some x → (0 :: p.map (· + 1)).getLast? = some (x + 1) := by
    intro x h
