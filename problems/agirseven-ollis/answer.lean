theorem baseAP_E_oo : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → k % 2 = 0 → b % 2 = 1 → c % 2 = 1 → y - k ≤ b → b < 2 * (y - k) → y ≤ c → c < 2 * y → ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧ (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧ (BotEndInv (y - k) p ∨ TopEndInv y (a₀ + b + c + 1) p) :=
