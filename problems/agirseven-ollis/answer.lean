    · obtain ⟨s, hs⟩ : ∃ s, r - j = s := ⟨_, rfl⟩
      rw [hs]
      rcases s with _ | s
      · simp
        omega
      · rw [@List.range_succ_eq_map s]
        simp [okxU]
  have hodd : ∀ z : ℕ, z % 2 = 1 → z + 2 ≤ y → Adj (bvCore y k r) z (z + 1) := by
    intro z hz1 hz2
    by_cases c1 : z ≤ 2 * r
    · exact sA z c1
    by_cases c2 : z ≤ 4 * r + 1
    · obtain ⟨j, rfl⟩ : ∃ j, z = 2 * r + 1 + 2 * j := ⟨(z - 2 * r - 1) / 2, by omega⟩
      have h := sJ j (by omega)
      rw [show 2 * r + 2 + 2 * j = 2 * r + 1 + 2 * j + 1 by omega] at h
      exact h
    by_cases c3 : z ≤ k + 2 * r
    · exact sR z (by omega) (by omega)
    by_cases c4 : z ≤ k + 4 * r + 1
    · obtain ⟨i, rfl⟩ : ∃ i, z = 2 * r + 2 + 2 * i + k := ⟨(z - 2 * r - 2 - k) / 2, by omega⟩
      exact sM i (by omega)
    by_cases c5 : z ≤ y - k + 4 * r + 1
    · exact sD z (by omega) c5
    · exact sS z (by omega) (by omega)
  
  
  
  have hD : IsLinearRealization (y + 4 * r + 4) (prescribedLengths y k (y - 1) (2 * r + 3) (2 * r + 1))
      (bvCore y k r) := ⟨hperm, hedges⟩
  have hslot : ∀ i : ℕ, i < w →
      Adj (bvCore y k r) (y + 4 * r + 4 - y + 2 * i) (y + 4 * r + 4 - y + 2 * i + 1) := by
    intro i hi
