    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x _ h rfl
    exact h
  
  have lift : ∀ (ℓ yy v t : ℕ) (L : Multiset ℕ) (p : List ℕ), 2 ≤ ℓ → ℓ % 2 = 0 → 2 * t ≤ ℓ →
      ℓ + yy ≤ v → IsLinearRealization v L p →
      (∀ s : ℕ, 2 * s + 2 ≤ ℓ → Adj p (2 * s) (2 * s + 1)) → TopEndInv yy v p →
      ∃ p' : List ℕ, IsLinearRealization (v + 2 * t) (L + Multiset.replicate (2 * t) ℓ) p' ∧
        BotPairInv ℓ p' ∧ TopEndInv yy (v + 2 * t) p' := by
    intro ℓ yy v t L p hℓ hℓe ht hv hp hpair hT
    obtain ⟨hEnd, hTP, hEv⟩ := hT
    obtain ⟨p', hp', hN, hP, hE⟩ := bot_pairs ℓ v t L p hℓ (by omega) ht hp (by
      intro i hi
      exact adjc _ _ _ _ _ (hpair ((ℓ - 2 - 2 * i) / 2) (by omega)) (by omega) (by omega))
    refine ⟨p', hp', ⟨Nat.even_iff.mpr hℓe, ?_⟩, ?_, ?_, ?_⟩
    · intro s hs
      by_cases hst : s < t
      · exact hN s hst
      · have h := hP (2 * (s - t)) (hpair (s - t) (by omega)) (by intro i hi; omega)
        exact adjc _ _ _ _ _ h (by omega) (by omega)
    · exact endc _ _ _ (hE _ hEnd) (by omega)
    · intro j hj1 hj2
      have h0 : Adj p (v - 1 - 2 * j) (v - 1 - 2 * j + 1) :=
        adjc _ _ _ _ _ (swap _ _ _ (hTP j hj1 hj2)) (by omega) (by omega)
      have h := hP _ h0 (by intro i hi; omega)
      exact swap _ _ _ (adjc _ _ _ _ _ h (by omega) (by omega))
    · intro he
      exact endc _ _ _ (hE _ (hEv he)) (by omega)
  
  obtain ⟨η, hη⟩ : ∃ η, y = 2 * η := ⟨y / 2, by omega⟩
  obtain ⟨j, hj⟩ : ∃ j, c = y + 2 * j := ⟨(c - y) / 2, by omega⟩
  obtain ⟨μ, hμ⟩ : ∃ μ, y - k = 2 * μ := ⟨(y - k) / 2, by omega⟩
  obtain ⟨i, hi⟩ : ∃ i, b = (y - k) + 2 * i := ⟨(b - (y - k)) / 2, by omega⟩
  
  obtain ⟨hP0, hA0, hE0a, hE0b⟩ := path_range y (by omega)
  
  obtain ⟨P1, hP1, hB1, hB2, hB3⟩ := top_pairs y y η _ _ (by omega) le_rfl (by omega) hP0 (by
    intro i' hi'
    exact adjc _ _ _ _ _ (hA0 (2 * i') (by omega)) (by omega) (by omega))
  
  obtain ⟨P2, hP2, hC1, hC2, hC3⟩ := top_pairs y (y + 2 * η) j _ P1 (by omega) (by omega)
    (by omega) hP1 (by
    intro i' hi'
    exact adjc _ _ _ _ _ (hB1 i' (by omega)) (by omega) (by omega))
  
  obtain ⟨hQ, hQA, hQE⟩ := reflect_realization (y + 2 * η + 2 * j) _ P2 hP2
  have hQT : TopEndInv y (y + 2 * η + 2 * j) (P2.map (fun x => y + 2 * η + 2 * j - 1 - x)) := by
    refine ⟨?_, ?_, ?_⟩
    · exact endc _ _ _ (hQE 0 (by omega) (hC3 0 (hB3 0 hE0a))) (by omega)
    · intro j' hj1 hj2
      have h1 := hB2 (2 * j' - 1) (hA0 (2 * j' - 1) (by omega)) (by intro i' hi'; omega)
      have h2 := hC2 (2 * j' - 1) h1 (by intro i' hi'; omega)
      have h3 := hQA _ _ (by omega) (by omega) h2
      exact adjc _ _ _ _ _ h3 (by omega) (by omega)
    · intro _
      exact endc _ _ _ (hQE (y - 1) (by omega) (hC3 _ (hB3 _ hE0b))) (by omega)
  have hQB : ∀ s : ℕ, 2 * s + 2 ≤ y →
      Adj (P2.map (fun x => y + 2 * η + 2 * j - 1 - x)) (2 * s) (2 * s + 1) := by
    intro s hs
    by_cases hsj : s < j
    · have h1 := hC1 (j - 1 - s) (by omega)
      have h3 := hQA _ _ (by omega) (by omega) h1
      exact swap _ _ _ (adjc _ _ _ _ _ h3 (by omega) (by omega))
    · have h0 := hB1 (η + j - 1 - s) (by omega)
      have h1 := hC2 _ h0 (by intro i' hi'; omega)
      have h3 := hQA _ _ (by omega) (by omega) h1
      exact swap _ _ _ (adjc _ _ _ _ _ h3 (by omega) (by omega))
  
  obtain ⟨p1, hp1, hp1B, hp1T⟩ := lift (y - k) y (y + 2 * η + 2 * j) μ _ _ (by omega) (by omega)
    (by omega) (by omega) hQ (fun s hs => hQB s (by omega)) hQT
  obtain ⟨p2, hp2, hp2B, hp2T⟩ := lift (y - k) y (y + 2 * η + 2 * j + 2 * μ) i _ _ (by omega)
    (by omega) (by omega) (by omega) hp1 hp1B.2 hp1T
  
  have hv : y - 1 + b + c + 1 = y + 2 * η + 2 * j + 2 * μ + 2 * i := by omega
  have hL : prescribedLengths y k (y - 1) b c =
      Multiset.replicate (y - 1) 1 + Multiset.replicate (2 * η) y + Multiset.replicate (2 * j) y +
        Multiset.replicate (2 * μ) (y - k) + Multiset.replicate (2 * i) (y - k) := by
    unfold prescribedLengths
    rw [show b = 2 * μ + 2 * i by omega, show c = 2 * η + 2 * j by omega,
