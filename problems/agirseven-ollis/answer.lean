        zero_add] at hm ⊢
      exact hcons x z T m hm
    | succ n ih =>
      intro x z T m hd hz hm
      have e : x :: (ul4StB d L (n + 1) ++ z :: T) = x :: (L + d + 1 + 2 * n) :: (L + 1 + 2 * n) ::
          (L + 2 * n) :: (L + d + 2 * n) :: (ul4StB d L n ++ z :: T) := by
        simp [ul4StB]
