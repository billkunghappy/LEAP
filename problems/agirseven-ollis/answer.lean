      · have hj' : j = 1 := by omega
        subst hj'
        rw [show v + 2 - 2 * 1 = v by omega, show v + 2 - 1 - 2 * 1 = v - 1 by omega]
        exact hvt
      · have h := hpairs (j - 1) (by omega) (by omega)
        rw [show v - 2 * (j - 1) = v + 2 - 2 * j by omega,
          show v - 1 - 2 * (j - 1) = v + 2 - 1 - 2 * j by omega] at h
        exact hT _ _ h (by omega) (by omega)
    · intro _
      left
      rw [show v + 2 - ℓ = v - ℓ + 2 by omega]
      exact hH
    · intro x hx hA
      exact hT _ _ hA (by omega) (by omega)
  
  obtain ⟨h0, hpairs, hev⟩ := hTE
  have hend := hev (Nat.even_iff.mpr hℓ2)
  unfold IsEnd at h0 hend
  rcases h0 with h0 | h0 <;> rcases hend with he | he
  · have := Option.some.inj (h0.symm.trans he)
    omega
  · obtain ⟨p', h1, h2, h3⟩ := core p.reverse ((List.reverse_perm p).trans hp.1)
      (by rw [el_reverse]; exact hp.2) (by rw [List.head?_reverse]; exact he)
      (by rw [List.getLast?_reverse]; exact h0)
      (fun j hj1 hj2 => adj_rev _ _ _ (hpairs j hj1 hj2))
    exact ⟨p', h1, h2, fun x hx hA => h3 x hx (adj_rev _ _ _ hA)⟩
  · exact core p hp.1 hp.2 he h0 hpairs
  · have := Option.some.inj (h0.symm.trans he)
    omega

theorem baseAP_E_oe : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → k % 2 = 0 → b % 2 = 1 → c % 2 = 0 → y - k ≤ b → b < 2 * (y - k) → y ≤ c → c < 2 * y → ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧ (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧ (BotEndInv (y - k) p ∨ TopEndInv y (a₀ + b + c + 1) p) :=
by
  intro y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
  have swap : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    intro p u w h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w _ _ h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x _ h rfl
    exact h
  
  have hseed : ∃ p : List ℕ, IsLinearRealization (2 * y + (y - k) + 1)
      (prescribedLengths y k (y - 1) (y - k + 1) y) p ∧ BotPairInv (y - k) p ∧
      TopEndInv y (2 * y + (y - k) + 1) p := by
    by_cases h : 3 * k + 2 ≤ y
    · exact seedE_F3b y k hk h hy hk2
    · exact seedE_F3c y k hk hyk (by omega) hy hk2
  obtain ⟨p₀, hp₀, hB₀, hT₀⟩ := hseed
  obtain ⟨i, hi⟩ : ∃ i, b = (y - k + 1) + 2 * i := ⟨(b - (y - k + 1)) / 2, by omega⟩
  obtain ⟨j, hj⟩ : ∃ j, c = y + 2 * j := ⟨(c - y) / 2, by omega⟩
  
  obtain ⟨hEm, hpair⟩ := hB₀
  obtain ⟨hEnd, hTP, hEv⟩ := hT₀
  obtain ⟨p₁, hp₁, hN, hP, hE⟩ := bot_pairs (y - k) (2 * y + (y - k) + 1) i _ p₀ (by omega)
    (by omega) (by omega) hp₀ (by
      intro i' hi'
      exact adjc _ _ _ _ _ (hpair ((y - k - 2 - 2 * i') / 2) (by omega)) (by omega) (by omega))
  have hB₁ : BotPairInv (y - k) p₁ := by
    refine ⟨hEm, ?_⟩
    intro s hs
    by_cases hsi : s < i
    · exact hN s hsi
    · have h := hP (2 * (s - i)) (hpair (s - i) (by omega)) (by intro i' hi'; omega)
      exact adjc _ _ _ _ _ h (by omega) (by omega)
  have hT₁ : TopEndInv y (2 * y + (y - k) + 1 + 2 * i) p₁ := by
    refine ⟨?_, ?_, ?_⟩
    · exact endc _ _ _ (hE _ hEnd) (by omega)
    · intro j' hj1 hj2
      have h0 : Adj p₀ (2 * y + (y - k) + 1 - 1 - 2 * j') (2 * y + (y - k) + 1 - 1 - 2 * j' + 1) :=
        adjc _ _ _ _ _ (swap _ _ _ (hTP j' hj1 hj2)) (by omega) (by omega)
      have h := hP _ h0 (by intro i' hi'; omega)
      exact swap _ _ _ (adjc _ _ _ _ _ h (by omega) (by omega))
    · intro he
      exact endc _ _ _ (hE _ (hEv he)) (by omega)
  
  have liftc : ∀ (jj v : ℕ) (L : Multiset ℕ) (p : List ℕ), y - k + y ≤ v →
      IsLinearRealization v L p → BotPairInv (y - k) p → TopEndInv y v p →
      ∃ p' : List ℕ, IsLinearRealization (v + 2 * jj) (L + Multiset.replicate (2 * jj) y) p' ∧
        BotPairInv (y - k) p' ∧ TopEndInv y (v + 2 * jj) p' := by
    intro jj
    induction jj with
    | zero =>
      intro v L p _ hp hB hT
      exact ⟨p, by simpa using hp, hB, by simpa using hT⟩
    | succ n ih =>
      intro v L p hv hp hB hT
      obtain ⟨p', hp', hB', hT'⟩ := ih v L p hv hp hB hT
      obtain ⟨p'', hp'', hT'', hA''⟩ :=
        plus2_top y (v + 2 * n) _ p' (by omega) hy (by omega) hp' hT'
      have e : 2 * (n + 1) = 2 * n + 2 := by ring
      refine ⟨p'', ?_, ⟨hB'.1, ?_⟩, ?_⟩
      · rw [e, Multiset.replicate_add, ← add_assoc, ← add_assoc]
        exact hp''
      · intro s hs
        exact hA'' _ (by omega) (hB'.2 s hs)
      · rw [e, ← add_assoc]
        exact hT''
  obtain ⟨p₂, hp₂, hB₂, hT₂⟩ := liftc j (2 * y + (y - k) + 1 + 2 * i) _ p₁ (by omega) hp₁ hB₁ hT₁
  
  have hv : y - 1 + b + c + 1 = 2 * y + (y - k) + 1 + 2 * i + 2 * j := by omega
  have hL : prescribedLengths y k (y - 1) b c =
      prescribedLengths y k (y - 1) (y - k + 1) y + Multiset.replicate (2 * i) (y - k) +
        Multiset.replicate (2 * j) y := by
    unfold prescribedLengths
    rw [hi, hj]
    simp only [Multiset.replicate_add]
    abel
  refine ⟨y - 1, by omega, p₂, ?_⟩
  rw [hv, hL]
  exact ⟨hp₂, Or.inr hB₂, Or.inl hT₂, Or.inr hT₂⟩

theorem baseAP_E_ee : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → k % 2 = 0 → b % 2 = 0 → c % 2 = 0 → y - k ≤ b → b < 2 * (y - k) → y ≤ c → c < 2 * y → ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ (BotEndInv (y - k) p ∨ BotPairInv (y - k) p) ∧ (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧ (BotEndInv (y - k) p ∨ TopEndInv y (a₀ + b + c + 1) p) :=
by
  intro y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
  
  have swap : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
