  intro y k b c hk hyk hpar hb1 hb2 hc1 hc2
  rcases Nat.mod_two_eq_zero_or_one y with hy | hy <;>
    rcases Nat.mod_two_eq_zero_or_one k with hk2 | hk2
  · rcases Nat.mod_two_eq_zero_or_one b with hb | hb <;>
      rcases Nat.mod_two_eq_zero_or_one c with hc | hc
    · exact baseAP_E_ee y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
    · exact baseAP_E_eo y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
    · exact baseAP_E_oe y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
    · exact baseAP_E_oo y k b c hk hyk hy hk2 hb hc hb1 hb2 hc1 hc2
  · exact baseAP_Y y k b c hk hyk hy hk2 hb1 hb2 hc1 hc2
  · exact absurd ⟨hy, hk2⟩ hpar
  · exact baseAP_M y k b c hk hyk hy hk2 hb1 hb2 hc1 hc2

theorem bBe_E1 : ∀ (y k b : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → b < y - k → k % 2 = 1 → b % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + 0 + 1 ∧ ∃ q : List ℕ,
      IsLinearRealization (a₀ + b + 0 + 1) (prescribedLengths y k a₀ b 0) q ∧
      TopPairInv y (a₀ + b + 0 + 1) q ∧ IsEnd q 0 :=
by
  intro y k b hk hyk hy hb hk2 hb2
  obtain ⟨b', rfl⟩ : ∃ b', b = 2 * b' := ⟨b / 2, by omega⟩
  obtain ⟨hR, hS, h0, -⟩ := path_range y (by omega)
  obtain ⟨p, hp, hN, hK, hE⟩ := top_pairs (y - k) y b' _ (List.range y) (by omega) (by omega)
    (by omega) hR (fun i hi => by
      rw [show y - (y - k) + 2 * i = k + 2 * i by omega]
      exact hS _ (by omega))
  refine ⟨y - 1, by omega, by omega, p, ?_, ?_, hE 0 h0⟩
  · rw [show y - 1 + 2 * b' + 0 + 1 = y + 2 * b' by omega]
    have hM : prescribedLengths y k (y - 1) (2 * b') 0 =
        Multiset.replicate (y - 1) 1 + Multiset.replicate (2 * b') (y - k) := by
      unfold prescribedLengths
      rw [Multiset.replicate_zero, add_zero]
    rw [hM]
    exact hp
  · rw [show y - 1 + 2 * b' + 0 + 1 = y + 2 * b' by omega]
    unfold TopPairInv
    refine ⟨Nat.even_iff.mpr hy, fun j hj => ?_⟩
    have key : Adj p (y + 2 * b' - 2 - 2 * j) (y + 2 * b' - 2 - 2 * j + 1) := by
      by_cases h1 : y ≤ y + 2 * b' - 2 - 2 * j
      · have h := hN (b' - 1 - j) (by omega)
        rw [show y + 2 * (b' - 1 - j) = y + 2 * b' - 2 - 2 * j by omega] at h
        exact h
      · exact hK _ (hS _ (by omega)) (fun i hi => by omega)
    obtain ⟨l₁, l₂, h⟩ := key
    refine ⟨l₁, l₂, ?_⟩
    rw [show y + 2 * b' - 1 - 2 * j = y + 2 * b' - 2 - 2 * j + 1 by omega]
    exact h.symm

theorem bBe_EO1 : ∀ (y k b : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → b < y - k → b % 2 = 0 →
    (k % 2 = 1 ∨ b = 0) →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + 1 + 1 ∧ ∃ q : List ℕ,
