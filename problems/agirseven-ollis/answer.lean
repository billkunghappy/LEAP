  · rw [hV]
    refine ⟨Nat.even_iff.mpr hy, fun j hj => ?_⟩
    have key : Adj q (s + d + 2 * t + 1 + 2 * 3 + 1 - 2 - 2 * j)
        (s + d + 2 * t + 1 + 2 * 3 + 1 - 2 - 2 * j + 1) := by
